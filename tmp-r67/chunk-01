      }), municipalityRepKeys_());
    var coordDowngraded = 0;
    var coordReasons = {};

    var added = 0, updated = 0, skipped = 0, attrUpdated = 0;
    // 除外理由の区分 (LIVE §12)。キーは区分名そのもの。
