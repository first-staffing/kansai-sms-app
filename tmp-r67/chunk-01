/** SMS記録・フォーム発行の可否 (R4 O-06: サーバー側の最後の砦)。
 * 停止中なら理由文字列を返す (実行可なら '')。理由付きの抜け道は作らない:
 * 停止中の人へ送る正規手段は停止解除の整備が先。 */
function smsBlockedReason_(applicant) {
  if (!applicant) return '応募者が見つかりません';
  if (toBool_(applicant.mail_optout)) return '配信停止中のため実行できません';
  var em = normalizeEmail_(applicant.email);
  if (em && optoutEmailSet_()[em]) return '配信停止中のため実行できません';
  return '';
}

