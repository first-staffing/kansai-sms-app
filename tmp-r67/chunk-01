        if (failedIdx[i]) {
          // 書けなかった行は索引から外す (後続行が実在しない行を更新対象にしない)
          if (p.phone) indexRemove_(byPhone, p.phone, p.attrs);
          if (p.email) indexRemove_(byEmail, p.email, p.attrs);
          indexRemove_(byNameBirth, p.nbKey, p.attrs);
          return;
        }
        queueEvent_(p.attrs.applicant_id, '新規登録 batch=' + batchId);
