  var freshness = appliedDays == null ? 0 : Math.max(0, 1 - appliedDays / 90);
  var st = csvStageRank_(applicant.csv_status);
  var stageRatio = st.inFlow ? st.stage / 8 : 0;
  var sd = cellDateYmd_(applicant.desired_start_date);
  var dUntil = sd ? diffDaysYmd_(sd, today) : null;
  var startRatio = 0;
  if (dUntil != null) {
    startRatio = dUntil <= 14 ? 1.0 : (dUntil <= 30 ? 0.8 : (dUntil <= 60 ? 0.5 : (dUntil <= 90 ? 0.25 : 0.1)));
  }
  var contactBase = cellDateYmd_(applicant.last_contact_at) || appliedYmd;
  var gapDays = contactBase ? diffDaysYmd_(today, contactBase) : null;
  var gapRatio = (gapDays != null && gapDays >= 14) ? Math.min(1, (gapDays - 14) / 46) : 0;
  var parts = {
    freshness: { ratio: Math.round(freshness * 1000) / 1000, points: Math.round(35 * freshness * 10) / 10, max: 35, applied_days_ago: appliedDays },
    stage: { ratio: Math.round(stageRatio * 1000) / 1000, points: Math.round(25 * stageRatio * 10) / 10, max: 25, stage: st.stage, stage_label: st.stageLabel || st.label },
    start_proximity: { ratio: startRatio, points: Math.round(30 * startRatio * 10) / 10, max: 30, days_until: dUntil, desired_start_date: sd },
    contact_gap: { ratio: Math.round(gapRatio * 1000) / 1000, points: Math.round(10 * gapRatio * 10) / 10, max: 10, days: gapDays }
  };
  var score = Math.round(35 * freshness + 25 * stageRatio + 30 * startRatio + 10 * gapRatio);
  // 根拠文 (INNOVATION.md §2.4 の型。要素があるものだけを「／」で連結する)
  function md_(ymd) {
    if (!ymd) return '';
    var p = ymd.split('-'); return Number(p[1]) + '月' + Number(p[2]) + '日';
  }
  var texts = [];
  if (flags.response_open) texts.push('未対応の回答あり');
  if (flags.next_due) {
    var nd = cellDateYmd_(applicant.next_contact_date);
    texts.push('次回連絡日 ' + md_(nd) + 'を過ぎています');
  }
  if (appliedYmd) texts.push('最終応募 ' + md_(appliedYmd) + '（' + appliedDays + '日前）');
  if (st.inFlow && st.stageLabel) texts.push('止まっている段階: ' + st.stageLabel);
  var ms = digMilestone_(sd, today);
  if (sd && dUntil != null) {
    texts.push('入職希望 ' + md_(sd) + 'まで' + dUntil + '日' + (ms ? '（' + ms.label + 'の時期）' : ''));
  }
  if (gapDays != null && gapDays >= 14) texts.push('前回接触から' + gapDays + '日');
  return { score: score, parts: parts, reason_text: texts.join('／') };
}

/** open な回答がある応募者の集合 (applicant_id -> open_response)。1回の走査で作る */
function openResponseMap_() {
  var map = {};
  try {
    readTable_('responses').rows.forEach(function (r) {
      if (responseStatus_(r) === 'handled') return;
      var id = str_(r.applicant_id);
      if (!map[id]) map[id] = { response_id: str_(r.response_id), status: responseStatus_(r), status_by: str_(r.status_by) };
    });
  } catch (e) {}
  return map;
}

function digSortByScore_(out) {
  out.sort(function (a, b) {
    var fa = a.flags || {}, fb = b.flags || {};
    if (!!fa.response_open !== !!fb.response_open) return fa.response_open ? -1 : 1;
    if (!!fa.next_due !== !!fb.next_due) return fa.next_due ? -1 : 1;
    if (a.dig_score !== b.dig_score) return b.dig_score - a.dig_score;
    return a.applied_at < b.applied_at ? 1 : -1;
  });
}

/**
 * 掘り起こしリスト (読み取り)。
 * 理由 (reasons) を付けて返す:
 *  (a) past_fs        : FS登録歴あり (has_fs_history フィールドが正, 追補17。req.only_past_fs=true でこの条件だけに絞る)
 *  (b) next_due       : next_contact_date が今日以前
 *  (c) start_minus_60/30/14 : 入職希望日の逆算マイルストーン到来済み (革新2で拡張:
 *      完全一致ではなく「マイルストーン日 <= 今日 かつ 希望日が今日-7日以降」。
 *      付けるのは到来済みの最も直近のマイルストーン1つ)
 * 既定では (b) または (c) に該当する人を返し、(a) は理由として併記する。
 * 各 item には革新2の dig_score / score_parts / reason_text / flags を加算する。
 * 既定の並び (次回連絡日→応募日) は壊さず、req.sort='score' で優先スコア順に切り替えられる。
 */
/** 掘り起こしの除外判定 (R4 10-#4: getDigList / getDigToday で正本を共有する)。
 * 除外なら 'terminal' / 'optout' / 'started'、それ以外は '' を返す。
 * 選考中などの進行中 (stage 2-7) は除外しない。 */
function digExclusionReason_(r, optoutSet) {
  var st = csvStageRank_(r.csv_status);
  if (st.terminal) return 'terminal';
  if (toBool_(r.mail_optout) || (str_(r.email) && optoutSet[normalizeEmail_(r.email)])) return 'optout';
  if (st.inFlow && st.stage >= 8) return 'started';
  return '';
}

function actionGetDigList_(req) {
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var rows = filterApplicants_(readTable_('applicants').rows, req.filter || {});
  var openMap = openResponseMap_();
  var actCtx = null;
  try { actCtx = activityContext_(); } catch (e) { actCtx = null; }
  // R4 10-#4: getDigToday と同じ除外 (終了系/配信停止/稼働開始) を適用し、内訳を返す。
  var optoutSet = optoutEmailSet_();
  var counts = { candidates: 0, excluded_terminal: 0, excluded_optout: 0, excluded_started: 0 };
  var out = [];
  rows.forEach(function (r) {
    var excl = digExclusionReason_(r, optoutSet);
    if (excl) { counts['excluded_' + excl]++; return; }
    counts.candidates++;
    var reasons = [];
    if (hasFsHistory_(r)) reasons.push('past_fs');
    var nd = cellDateYmd_(r.next_contact_date);
    if (nd && nd <= today) reasons.push('next_due');
    var sd = cellDateYmd_(r.desired_start_date);
    var ms = digMilestone_(sd, today);
    if (ms) reasons.push('start_minus_' + ms.days);
    var hit = req.only_past_fs === true
      ? reasons.indexOf('past_fs') >= 0
      : (reasons.indexOf('next_due') >= 0 || reasons.some(function (x) { return x.indexOf('start_minus_') === 0; }));
    if (hit) {
      var flags = { next_due: reasons.indexOf('next_due') >= 0, response_open: !!openMap[str_(r.applicant_id)] };
      var ds = digScore_(r, today, flags);
      var act = null;
      if (actCtx) { try { act = activityForApplicant_(str_(r.applicant_id), actCtx, r); } catch (e2) { act = null; } }
      var item = applicantListItem_(r, act);
      item.reasons = reasons;
      item.dig_score = ds.score;
      item.score_parts = ds.parts;
      item.reason_text = ds.reason_text;
      item.flags = flags;
      out.push(item);
    }
  });
  if (req.sort === 'score' || req.order === 'score') {
    digSortByScore_(out);
  } else {
    // 既定: 次回連絡日が近い順 -> 応募日新しい順 (従来どおり)
    out.sort(function (a, b) {
      var x = a.next_contact_date || '9999', y = b.next_contact_date || '9999';
      if (x !== y) return x < y ? -1 : 1;
      return a.applied_at < b.applied_at ? 1 : -1;
    });
  }
  var limit = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
  return { total: out.length, items: out.slice(0, limit), today: today, counts: counts };
}

/**
 * 今日アプローチすべき人 (革新2, 読み取り専用)。
 * 母集団は FS登録歴あり (filterApplicants_ 経由でテスト求職者を除外) とし、
 * 終了/例外系・配信停止・稼働中は理由つきで母数から外し、counts の内訳で見えるようにする。
 * 並びは固定: response_open あり -> next_due あり -> DigScore 降順 -> 最終応募の新しい順。
 */
function actionGetDigToday_(req) {
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var rows = filterApplicants_(readTable_('applicants').rows,
    Object.assign({}, req.filter || {}, { has_fs_history: true }));
  var optoutSet = optoutEmailSet_();
  var openMap = openResponseMap_();
  var counts = { candidates: 0, excluded_terminal: 0, excluded_optout: 0, excluded_started: 0 };
  var out = [];
  rows.forEach(function (r) {
    var excl = digExclusionReason_(r, optoutSet);
    if (excl) { counts['excluded_' + excl]++; return; }
    counts.candidates++;
    var nd = cellDateYmd_(r.next_contact_date);
    var flags = { next_due: !!(nd && nd <= today), response_open: !!openMap[str_(r.applicant_id)] };
    var ds = digScore_(r, today, flags);
    var item = applicantListItem_(r);
    item.dig_score = ds.score;
    item.score_parts = ds.parts;
    item.reason_text = ds.reason_text;
    item.flags = flags;
    out.push(item);
  });
  digSortByScore_(out);
  var limit = Math.min(200, Math.max(1, parseInt(req.limit, 10) || 50));
  return { total: counts.candidates, counts: counts, items: out.slice(0, limit), today: today };
}

function addDaysYmd_(ymd, days) {
  var d = new Date(ymd + 'T00:00:00+09:00');
  if (isNaN(d.getTime())) return '';
  d.setDate(d.getDate() + days);
  return Utilities.formatDate(d, 'Asia/Tokyo', 'yyyy-MM-dd');
}

/**
 * 掘り起こしファネル集計 (読み取り)。
 * 対象 = FS登録歴あり (has_fs_history フィールド基準, 追補17) の人数を起点に、
 * applicant_events のイベント種別と現在の app_status / csv_status から
 * 各段の到達人数を数える (到達 = 一度でも到達)。
 */
function actionGetDigStats_(req) {
  var apps = readTable_('applicants').rows;
  // R7: req.area 指定時はそのエリアに絞る (未指定時は従来どおり全エリア)。
  // フロントの掘り起こしタブはエリア単位の表示なので、サーバーモードでは area を渡す。
  var area = str_((req && req.area) || '');
  // 追補22: テスト求職者は掘り起こし・ファネルの母数に入れない (has_fs_history の有無によらない)
  var targets = apps.filter(function (r) {
    return !isTestApplicant_(r) && hasFsHistory_(r) && (!area || str_(r.area) === area);
  });
  var targetIds = {};
  targets.forEach(function (r) { targetIds[str_(r.applicant_id)] = true; });

  var contacted = {}, replied = {};
  readTable_('applicant_events').rows.forEach(function (e) {
    var id = str_(e.applicant_id);
    if (!targetIds[id]) return;
    var t = str_(e.event_type);
    if (t === 'phone_contact' || t === 'sms_sent' || t === 'mail_sent') contacted[id] = true;
    if (t === 'response_received') replied[id] = true;
  });
  targets.forEach(function (r) {
    var id = str_(r.applicant_id);
    if (toBool_(r.sms_sent) || cellDateIso_(r.last_contact_at)) contacted[id] = true;
  });

  function countStage_(words) {
    var n = 0;
    targets.forEach(function (r) {
      var s = str_(r.app_status) + '|' + str_(r.csv_status);
      if (words.some(function (w) { return s.indexOf(w) >= 0; })) n++;
    });
    return n;
  }
  return {
    funnel: {
      target: targets.length,
      contacted: Object.keys(contacted).length,
      replied: Object.keys(replied).length,
      attend: countStage_(['アテンド']),
      fix: countStage_(['FIX']),
      offer: countStage_(['内定']),
      started: countStage_(['稼働開始', '稼働中'])
    },
    note: 'アテンド以降は現在の app_status / csv_status での到達数 (履歴ベースの厳密な到達管理はフェーズ3)',
    response_summary: responseSummarySafe_()
  };
}

// ===== ラウンド7: 特需・逆引き・掘り起こしビューのサーバー検索 =====
/**
 * 3ビューのカード表示専用アイテム。
 * 一覧 (searchApplicants) は連絡先を返さない方針 (DESIGN_V2 §10) だが、
 * 3ビューのカードは sms: / tel: リンクそのものを描画するため、電話番号だけは
 * 「表示に必要な分」として返す (メールは返さない)。返すのはページ分のみ。
 */
function r7CardItem_(r) {
  var item = applicantListItem_(r);
  item.phone = str_(r.phone);
  return item;
}

/** 距離は表示精度 (小数1桁) に丸めて返す (転送量削減。並び順は丸め前の値で決める) */
function r7Dist1_(d) { return d == null ? null : Math.round(d * 10) / 10; }

/**
 * 特需SMSの候補者検索 (フロント specialCandidates のサーバー移植)。
 * 業務ルールはフロント現行と同一:
 *  - 母集団: area 一致・職種一致・テスト求職者除外 (filterApplicants_ の既定)
 *  - セグメント「連絡停止」を除外
 *  - 案件座標 (市区町村代表点) からの直線距離が半径以内 (座標が引けない人は対象外)
 *  - 年齢上限: 上限を超える人は除外。年齢不明は外さない (要確認扱い)
 *  - 並び: 直近の応募順 (applied_at 降順)
 * req: { lat, lon, radius_km, job_type, area, max_age, page, page_size, count_only }
 * count_only=true のときは件数だけを返す (特需案件一覧の「対象 N名」表示用)。
 */
function actionSearchSpecialCandidates_(req) {
  req = req || {};
  var lat = toNum_(req.lat), lon = toNum_(req.lon);
  var radius = Number(req.radius_km);
  if (!(radius > 0)) radius = 10;
  if (lat == null || lon == null || coordBasicCheck_(lat, lon).state !== 'ok') {
    return { total: 0, page: 1, page_size: 0, items: [], reason: 'no_origin' };
  }
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = {};
  if (req.area) f.area = String(req.area);
  if (req.job_type) f.job_type = String(req.job_type);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var maxAge = (req.max_age === '' || req.max_age == null) ? null : Number(req.max_age);
  if (maxAge != null && isNaN(maxAge)) maxAge = null;
  var matched = [];
  rows.forEach(function (r) {
    if (segmentOfApplicant_(r, today) === '連絡停止') return;
    var d = distanceKm_(lat, lon, r.lat, r.lon);
    if (d == null || d > radius) return;
    if (maxAge != null) {
      var age = ageFromBirth_(r.birth_date);
      if (age != null && age > maxAge) return;
    }
    matched.push({ r: r, dist: d });
  });
  matched.sort(function (a, b) {
    var x = cellDateIso_(a.r.applied_at), y = cellDateIso_(b.r.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var total = matched.length;
  if (req.count_only === true) return { total: total };
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || 50));
  var start = (page - 1) * pageSize;
  return {
    total: total, page: page, page_size: pageSize,
    items: matched.slice(start, start + pageSize).map(function (m) {
      var item = r7CardItem_(m.r);
      item.dist = r7Dist1_(m.dist);
      return item;
    })
  };
}

/** 逆引きの条件一致数 (フロント reverseMatchCount と同一: 資格・週日数・時間帯・最寄駅の登録数) */
function reverseMatchCountServer_(r) {
  return [str_(r.qualifications), str_(r.desired_days_per_week), str_(r.desired_time_slots), str_(r.nearest_station)]
    .filter(function (v) { return v !== ''; }).length;
}

/**
 * 案件から近くの求職者を探す (逆引き) のサーバー検索。
 * フロント reverseResults の業務ルールをそのまま移植:
 *  - 母集団: 職種一致・テスト除外。エリアでは絞らない (府県境をまたいで検索)
 *  - セグメント「連絡停止」を除外、案件座標からの距離が半径以内 (既定5km)
 *  - cond: 'match' は条件一致3件以上 / 'unknown' は未確認項目あり /
 *          'consult' は条件一致1件以下。include_consult=true のとき match/consult の絞り込みを外す
 *  - municipality 指定時はその市区町村のみ (wide_muni=true で広げる)
 *  - 並び: 条件一致が多い順 -> 距離が近い順 -> 直近の応募順
 * req: { case: { lat, lon, job_type, prefecture }, radius_km, cond, include_consult,
 *        municipality, wide_muni, page, page_size }
 * facets.municipalities は市区町村ドロップダウン用 (母集団はフロント現行と同一:
 * 同職種・同府県・テスト除外の全応募者)。
 */
function actionSearchReverseCandidates_(req) {
  req = req || {};
  var c = req.case || {};
  var lat = toNum_(c.lat), lon = toNum_(c.lon);
  var radius = Number(req.radius_km);
  if (!(radius > 0)) radius = 5;
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = {};
  if (c.job_type) f.job_type = String(c.job_type);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var muniSet = {};
  rows.forEach(function (r) {
    if (str_(r.prefecture) === str_(c.prefecture) && str_(r.municipality)) muniSet[str_(r.municipality)] = true;
  });
  var facets = { municipalities: Object.keys(muniSet).sort() };
  if (lat == null || lon == null || coordBasicCheck_(lat, lon).state !== 'ok') {
    return { total: 0, page: 1, page_size: 0, items: [], reason: 'no_origin', facets: facets };
  }
  var includeConsult = req.include_consult === true;
  var matched = [];
  rows.forEach(function (r) {
    if (segmentOfApplicant_(r, today) === '連絡停止') return;
    var d = distanceKm_(lat, lon, r.lat, r.lon);
    if (d == null || !isFinite(d) || d > radius) return;
    var m = reverseMatchCountServer_(r);
    if (req.cond === 'match' && !includeConsult && m < 3) return;
    if (req.cond === 'unknown' && missingHearing_(r).length === 0) return;
    if (req.cond === 'consult' && !includeConsult && m > 1) return;
    if (req.municipality && req.wide_muni !== true && str_(r.municipality) !== String(req.municipality)) return;
    matched.push({ r: r, dist: d, match: m });
  });
  matched.sort(function (a, b) {
    if (b.match !== a.match) return b.match - a.match;
    if (a.dist !== b.dist) return a.dist - b.dist;
    var x = cellDateIso_(a.r.applied_at), y = cellDateIso_(b.r.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || 50));
  var start = (page - 1) * pageSize;
  return {
    total: matched.length, page: page, page_size: pageSize, facets: facets,
    items: matched.slice(start, start + pageSize).map(function (m) {
      var item = r7CardItem_(m.r);
      item.dist = r7Dist1_(m.dist);
      item.match = m.match;
      return item;
    })
  };
}

/** フロント contactSchedule と同一の逆算マイルストーン (60日前=状況確認 / 30日前=案件提案 / 14日前=選考状況確認) */
var DIG_MILESTONES_ = [[60, '状況確認'], [30, '案件提案'], [14, '選考状況確認']];

/**
 * 掘り起こし「今日連絡すべき人」 (フロント dueTodayList のサーバー移植)。
 * 母集団は掘り起こしタブと同一 (area 内・FS登録歴あり・テスト除外) で、
 * セグメント「連絡停止」「稼働中」を入口で除外し、理由を付けて返す:
 *  - 次回連絡日到来 (next_contact_date が今日以前)
 *  - 逆算予定の到来 (入職希望日の 60/30/14 日前を過ぎたもの。到来済みの全件を理由にする)
 *  - 前回接触から14日以上 (last_contact_at がある人のみ)
 * 並びはフロント現行と同一 (直近の応募順)。
 * req: { area, page, page_size }
 */
function actionGetDigTodayList_(req) {
  req = req || {};
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = { has_fs_history: true };
  if (req.area) f.area = String(req.area);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var out = [];
  rows.forEach(function (r) {
    var seg = segmentOfApplicant_(r, today);
    if (seg === '連絡停止' || seg === '稼働中') return;
    var reasons = [];
    var nd = cellDateYmd_(r.next_contact_date);
    if (nd && nd <= today) reasons.push('次回連絡日到来（' + nd + '）');
    var sd = cellDateYmd_(r.desired_start_date);
    if (sd && /^\d{4}-\d{2}-\d{2}$/.test(sd)) {
      var remain = diffDaysYmd_(sd, today);
      DIG_MILESTONES_.forEach(function (ms) {
        var at = addDaysYmd_(sd, -ms[0]);
        if (at && at <= today) reasons.push(ms[1] + '：希望日まで' + remain + '日（予定日 ' + at + '）');
      });
    }
    var lc = cellDateYmd_(r.last_contact_at);
    if (lc) {
      var diff = diffDaysYmd_(today, lc);
      if (diff != null && diff >= 14) reasons.push('前回接触から' + diff + '日');
    }
    if (reasons.length) out.push({ r: r, reasons: reasons });
  });
  out.sort(function (a, b) {
    var x = cellDateIso_(a.r.applied_at), y = cellDateIso_(b.r.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(500, Math.max(1, parseInt(req.page_size, 10) || 200));
  var start = (page - 1) * pageSize;
  return {
    total: out.length, page: page, page_size: pageSize, today: today,
    items: out.slice(start, start + pageSize).map(function (o) {
      var item = r7CardItem_(o.r);
      item.reasons = o.reasons;
      return item;
    })
  };
}

var DIG_SEGMENTS_ = ['即提案可能', '条件確認待ち', '時期先', '選考中', '稼働中', '連絡停止'];

/**
 * 掘り起こしのセグメント別件数と、セグメントで絞った応募者のページ。
 * 母集団は掘り起こしタブと同一 (area 内・FS登録歴あり・テスト除外)。
 * セグメント分類はサーバー正本 segmentOfApplicant_ (フロント segmentOfCalc と同一優先順)。
 * req: { area, segment ('' はすべて), page, page_size }
 */
function actionGetDigSegment_(req) {
  req = req || {};
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = { has_fs_history: true };
  if (req.area) f.area = String(req.area);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var counts = {};
  DIG_SEGMENTS_.forEach(function (s) { counts[s] = 0; });
  var withStart = 0;
  var seg = String(req.segment || '');
  var matched = [];
  rows.forEach(function (r) {
    var s = segmentOfApplicant_(r, today);
    if (counts[s] != null) counts[s]++;
    if (cellDateYmd_(r.desired_start_date)) withStart++;
    if (!seg || s === seg) matched.push(r);
  });
  matched = sortByAppliedDesc_(matched);
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || 50));
  var start = (page - 1) * pageSize;
  return {
    total_all: rows.length, counts: counts, with_start: withStart,
    total: matched.length, page: page, page_size: pageSize,
    items: matched.slice(start, start + pageSize).map(function (r) { return r7CardItem_(r); })
  };
}

// ===== 対外表示ヘルパー (求職者向け整形) =====
function publicJobKind_(jobType) {
