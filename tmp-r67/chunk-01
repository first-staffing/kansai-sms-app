      var startRow = 0;
      try { startRow = sheet_('cases').getLastRow() + 1; } catch (e) { startRow = 0; }
      var res = appendRows_('cases', batch.map(function (p) { return p.row; }));
      var failedIdx = {};
      res.errors.forEach(function (e) { failedIdx[e.index] = true; });
