    // 全表を読み直していた (565件の最新応募更新が分単位に膨らむ主因)。
    // 行番号 (_row) が判明している既存行はメモリ上で patch を適用し、
    // 書き込みはチャンク末尾に「行まるごと setValues」へまとめる。
    // 行番号不明 (同一チャンク内で新規追加された直後の行) は従来どおり
    // updateRowByPk_ で即時に書く。
    var pendingPatchRows = {}; // applicant_id -> row object (patch applied)
    function queuePatch_(existing, patch) {
