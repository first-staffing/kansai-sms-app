// ===== 【電話アポ】自動作成 (追補23・杉本のみ完全自動) =====
/**
 * submitResponse の保存後に呼ばれる追加経路。呼び出し側は withLock_ 取得済みの文脈。
 * 発火条件 (全て満たす場合だけ作成する):
 *  (a) 送信元 (responses.sender_email) が特定できている
 *  (b) その運営者の operators.auto_calendar が ON
 *  (c) フォーム処理の実行アカウント (Session.getEffectiveUser) が送信元と一致する
 *      ← 必須ガード。デプロイBは杉本のアカウントで動くため、現状この条件を満たすのは
 *        杉本宛ての回答だけ。他の運営者を ON にしても、実行アカウントが杉本である限り
 *        予定は作らない (作れば杉本のカレンダーに他人の予定が入ってしまうため)。
 *  (d) 面談希望日または電話相談希望がある (responseHasInterviewWish_)
 * 二重作成防止: calendar_event_id が既にあれば作らない (ワンタップ済み・自動済み共通の冪等キー)。
 * 失敗時: 例外を外へ出さず、responses.calendar_auto_failed=true と
 * applicant_events の phone_appointment_auto_failed (実行者つき) を残して通常 return する。
 * 回答保存・通知は止めない。回復は従来のワンタップ (createPhoneAppointment) がそのまま使える。
 * 成功時: calendar_registered_by は 'auto:<sender_email>' とし、自動作成だと分かる値にする。
 * applicant_events には phone_appointment_auto を実行者 (実行アカウント) つきで残す。
 */
function tryAutoCreatePhoneAppointment_(respInput) {
  var out = { attempted: false, created: false, reason: '' };
  var sender = String((respInput && respInput.sender_email) || '').trim().toLowerCase();
  try {
    if (!sender) { out.reason = 'no_sender'; return out; }
    if (!autoCalendarEnabledFor_(sender)) { out.reason = 'disabled'; return out; }
    var eff = effectiveUserEmail_();
    if (!eff || eff !== sender) { out.reason = 'executor_mismatch'; return out; }
    if (!responseHasInterviewWish_(respInput)) { out.reason = 'no_wish'; return out; }
    out.attempted = true;
    var fresh = respInput;
    try { fresh = findRow_('responses', 'response_id', respInput.response_id); } catch (e) { fresh = respInput; }
    if (str_(fresh.calendar_event_id)) {
      out.reason = 'already_registered';
      out.calendar_event_id = str_(fresh.calendar_event_id);
      return out;
    }
    var r = createPhoneAppointmentCore_(fresh, 'auto:' + sender, eff, 'phone_appointment_auto');
    out.created = !r.already_registered;
    out.calendar_event_id = r.calendar_event_id;
    out.reason = r.already_registered ? 'already_registered' : 'created';
    return out;
  } catch (err) {
    try {
      updateRowByPk_('responses', respInput.response_id, { calendar_auto_failed: true });
    } catch (e2) { /* フラグ書き込み失敗でも回答保存は守る */ }
    try {
      appendEvent_(str_(respInput.applicant_id), 'phone_appointment_auto_failed',
        effectiveUserEmail_() || 'system',
        '電話アポ自動作成に失敗: ' + errMsg_(err) + ' response=' + respInput.response_id,
        str_(respInput.delivery_id), respInput.response_id);
    } catch (e3) { /* ログ失敗は無視する */ }
    out.failed = true;
    out.reason = 'failed';
    out.error = errMsg_(err);
    return out;
  }
}

