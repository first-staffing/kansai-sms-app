 * 優先順: 連絡停止 > 稼働中 > 選考中 > 時期先 > 条件確認待ち > 即提案可能。
 * 選考中は正規化ラベル基準 (職見待ちは実施待ちとして扱う — フロントとの意図的な統一)。 */
function segmentOfApplicant_(r, today) {
  if (toBool_(r.mail_optout) || isTerminalStatus_(r)) return '連絡停止';
  var st = csvStageRank_(r.csv_status);
  if ((st.inFlow && st.stage >= 8) || str_(r.app_status) === '稼働開始') return '稼働中';
  var selLabel = st.label;
  if (['アテンド待ち', 'FIX待ち', '実施待ち', '職見待ち', '内定待ち', 'アテンド済み', 'FIX済み', '内定'].indexOf(selLabel) >= 0 ||
      ['FIX', 'アテンド', '内定'].indexOf(str_(r.app_status)) >= 0) return '選考中';
  var sd = cellDateYmd_(r.desired_start_date);
  if (sd && /^\d{4}-\d{2}-\d{2}$/.test(sd)) {
    var diffDays = Math.round((new Date(sd + 'T00:00:00+09:00').getTime() - new Date(today + 'T00:00:00+09:00').getTime()) / 86400000);
    if (diffDays > 60) return '時期先';
  }
  if (missingHearing_(r).length > 0) return '条件確認待ち';
  return '即提案可能';
}

function filterApplicants_(rows, f) {
  f = f || {};
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var munis = toList_(f.municipalities);
  var prefs = toList_(f.prefectures);
  var csvs = toList_(f.csv_statuses);
  var companies = toList_(f.source_companies);
  var quals = toList_(f.qualifications);
  return rows.filter(function (r) {
    if (f.include_test !== true && isTestApplicant_(r)) return false; // 追補22: テスト求職者は既定で除外
    if (f.keyword && str_(r.name).indexOf(String(f.keyword)) < 0 &&
        str_(r.name_raw).indexOf(String(f.keyword)) < 0 &&
        str_(r.applicant_id).indexOf(String(f.keyword)) < 0) return false; // R6.6 P2: ID部分一致も対象 (A000001 検索用)
    if (f.phone && str_(r.phone).replace(/-/g, '').indexOf(String(f.phone).replace(/-/g, '')) < 0) return false;
    if (f.age_min != null && f.age_min !== '' || f.age_max != null && f.age_max !== '') {
      var ageVal = ageFromBirth_(r.birth_date);
      if (ageVal == null) { if (f.age_include_unknown !== true) return false; }
      else {
        if (f.age_min != null && f.age_min !== '' && ageVal < Number(f.age_min)) return false;
        if (f.age_max != null && f.age_max !== '' && ageVal > Number(f.age_max)) return false;
      }
    }
    if (f.address_keyword) {
      var addrHay = str_(r.prefecture) + str_(r.municipality) + str_(r.address_rest);
      if (addrHay.indexOf(String(f.address_keyword)) < 0) return false;
    }
    if (f.area && str_(r.area) !== String(f.area)) return false;
    if (f.prefecture && str_(r.prefecture) !== String(f.prefecture)) return false;
    if (prefs.length && prefs.indexOf(str_(r.prefecture)) < 0) return false;
    if (f.desired_keyword) {
      var desiredHay = str_(r.desired_days_per_week) + str_(r.desired_time_slots);
      if (desiredHay.indexOf(String(f.desired_keyword)) < 0) return false;
    }
    if (munis.length && munis.indexOf(str_(r.municipality)) < 0) return false;
    if (f.job_type && str_(r.job_type) !== String(f.job_type)) return false;
    if (f.sms_state === 'sent' && !toBool_(r.sms_sent)) return false;
    if (f.sms_state === 'unsent' && toBool_(r.sms_sent)) return false;
    if (csvs.length && csvs.indexOf(str_(r.csv_status)) < 0) return false;
    if (f.app_status && str_(r.app_status) !== String(f.app_status)) return false;
    if (companies.length) {
      // 会社絞り込みは canonical で比較する (原文 source_company は保持したまま。DATA_MODEL §11)
      var canon = normalizeCompany_(r.source_company);
      var hitCo = companies.some(function (co) { return normalizeCompany_(co) === canon; });
      if (!hitCo) return false;
    }
    if (f.applied_from || f.applied_to) {
      var ad = cellDateYmd_(r.applied_at);
      if (!ad) return false;
      if (f.applied_from && ad < String(f.applied_from)) return false;
      if (f.applied_to && ad > String(f.applied_to)) return false;
    }
    if (f.start_from || f.start_to) {
      var sd = cellDateYmd_(r.desired_start_date);
      if (!sd) return false;
      if (f.start_from && sd < String(f.start_from)) return false;
      if (f.start_to && sd > String(f.start_to)) return false;
    }
    if (f.mail_only && !str_(r.email)) return false;
    if (quals.length) {
      // R3 (G2): 資格マッチの意味論をフロントと統一する。完全一致のみだと
      // 「正看護師」が「看護師」の対象から系統的に漏れるため、表記ゆれを
      // 吸収する qualTokenMatch_ で判定する (フロント qualMatch と同一ルール)。
      // include_no_qual=true のときは資格未登録の人も対象に含める (G2)。
      var haveQ = str_(r.qualifications);
      var anyQ = quals.some(function (q) { return qualTokenMatch_(haveQ, q); });
      if (!anyQ) {
        if (!(f.include_no_qual === true && !haveQ.replace(/\s/g, ''))) return false;
      }
    }
    // 追補7/17: FS登録歴あり。導出ではなく永続フィールド has_fs_history が正
    // (空の旧レコードのみ hasFsHistory_ 内で history 導出にフォールバック)。
    // searchApplicants / mailPreviewTargets / getDigList / SMSセグメントは本関数を共用するため、ここが唯一の判定点。
    if ((f.has_past_fs === true || f.has_fs_history === true) && !hasFsHistory_(r)) return false;
    // 追補7: 次回連絡日が今日以前 (未設定は対象外)
    if (f.due_next_contact === true) {
      var nd = cellDateYmd_(r.next_contact_date);
      if (!nd || nd > today) return false;
    }
    // R4 10-#1: セグメント分類そのものをフィルタとして受ける (掘り起こしからの引き継ぎ用)。
    // 分類は送信時点のデータでサーバーが再判定する (引き継ぎ時点の分類は固定しない)。
    if (f.segment && segmentOfApplicant_(r, today) !== String(f.segment)) return false;
    return true;
  });
}

function toList_(v) {
  if (v == null || v === '') return [];
  if (Object.prototype.toString.call(v) === '[object Array]') {
    return v.map(function (x) { return String(x).trim(); }).filter(function (x) { return x !== ''; });
  }
  return String(v).split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x !== ''; });
}

/** 応募日の新しい順に並べる (並び順の正: DATA_MODEL) */
function sortByAppliedDesc_(rows) {
  return rows.slice().sort(function (a, b) {
    var x = cellDateIso_(a.applied_at), y = cellDateIso_(b.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
}

function actionSearchApplicants_(req) {
  var t = readTable_('applicants');
  var matched = sortByAppliedDesc_(filterApplicants_(t.rows, req.filter || {}));
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || PAGE_SIZE));
  var start = (page - 1) * pageSize;
  var actCtx = null;
  try { actCtx = activityContext_(); } catch (e) { actCtx = null; }
  return {
    total: matched.length,
    page: page,
    page_size: pageSize,
    items: matched.slice(start, start + pageSize).map(function (r) {
      var act = null;
      if (actCtx) { try { act = activityForApplicant_(str_(r.applicant_id), actCtx, r); } catch (e2) { act = null; } }
      return applicantListItem_(r, act);
    })
    // 注: 一覧では phone / email を返さない (DESIGN_V2 §10)。詳細は getApplicant。
  };
}

/** R6: 一覧の件数サマリーをサーバー側で集計する。
 * フロントが全件を保持しなくても、入口・一覧の総数/送信済み/SMS対象/
 * 府県別・ステータス別件数を返す。個別の電話・メールは返さない。 */
function applicantSummaryForRows_(rows, area) {
  var matched = filterApplicants_(rows || [], area ? { area: String(area) } : {});
  var out = { area: area ? String(area) : '', total: matched.length, sent: 0, unsent: 0,
    sms_target: 0, fs_history: 0, area_unset: 0, pref_counts: {}, csv_status_counts: {}, company_counts: {} };
  matched.forEach(function (r) {
    if (toBool_(r.sms_sent)) out.sent++; else out.unsent++;
    // R6.6 P4: area が空または関西・関東のいずれでもない行 (総数から漏れる行を可視化)。
    // area 指定のサマリ (kansai/kanto) では常に 0。全体サマリ (area='') が正の値を持つ。
    if (str_(r.area) !== 'kansai' && str_(r.area) !== 'kanto') out.area_unset++;
    var digits = str_(r.phone).replace(/[^0-9]/g, '');
    // R6.6 P3(a): 先頭0落ち (例: 8091251382) の電話も SMS 対象に数える。
    // 根本修復 (actionRepairPhones_) までの対症療法。フロント areaSummary も同じ緩和。
    if (/^0?[789]0/.test(digits)) out.sms_target++;
    if (hasFsHistory_(r)) out.fs_history++;
    var pref = str_(r.prefecture); if (pref) out.pref_counts[pref] = (out.pref_counts[pref] || 0) + 1;
    var st = str_(r.csv_status); if (st) out.csv_status_counts[st] = (out.csv_status_counts[st] || 0) + 1;
    var co = normalizeCompany_(r.source_company); if (co) out.company_counts[co] = (out.company_counts[co] || 0) + 1;
  });
  return out;
}

function actionGetApplicantSummary_(req) {
  var rows = readTable_('applicants').rows;
  var area = str_((req && req.area) || '');
  var summary = applicantSummaryForRows_(rows, area);
  summary.areas = {
    kansai: applicantSummaryForRows_(rows, 'kansai'),
    kanto: applicantSummaryForRows_(rows, 'kanto')
  };
  return summary;
}

// ===== 応募者: 詳細 + タイムライン =====
function findApplicant_(applicantId) {
  var t = readTable_('applicants');
  for (var i = 0; i < t.rows.length; i++) {
    if (String(t.rows[i].applicant_id) === String(applicantId)) return t.rows[i];
  }
  throw new Error('応募者が見つかりません: ' + applicantId);
}

function actionGetApplicant_(req) {
  var r = findApplicant_(req.applicant_id);
  var detail = applicantListItem_(r);
  // 詳細でのみ個人情報を返す
  detail.phone = str_(r.phone);
  detail.email = str_(r.email);
  detail.name_raw = str_(r.name_raw);
  detail.postal_code = str_(r.postal_code);
  detail.address_rest = str_(r.address_rest);
  detail.lat = toNum_(r.lat);
  detail.lon = toNum_(r.lon);
  detail.experience_years = toNum_(r.experience_years);
  detail.desired_days_per_week = str_(r.desired_days_per_week);
  detail.desired_time_slots = str_(r.desired_time_slots);
  detail.hearing_json = str_(r.hearing_json);
  detail.import_batch_id = str_(r.import_batch_id);
  detail.missing_hearing = missingHearing_(r).map(function (h) { return h.label; });

  var ev = readTable_('applicant_events').rows.filter(function (e) {
    return String(e.applicant_id) === String(req.applicant_id);
  }).sort(function (a, b) {
    var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  }).slice(0, 200).map(function (e) {
    return {
      event_id: str_(e.event_id), event_type: str_(e.event_type), actor: str_(e.actor),
      delivery_id: str_(e.delivery_id), response_id: str_(e.response_id),
      detail: str_(e.detail), created_at: cellDateIso_(e.created_at),
      // 送信スナップショット (R3 検証 #12): SMS 単発送信のイベントにも保存される
      // 文面・提示案件を、詳細画面のタイムラインから参照できるよう一緒に返す。
      body_snapshot: str_(e.body_snapshot), case_ids: str_(e.case_ids),
      // R4 S-02: 記録時点の案件の写し (現在値の再引きではない)
      cases_snapshot: parseCasesSnapshot_(e.cases_snapshot)
    };
  });
  // 過去のフォーム送信について「いつ・どの案件を・どの文面で」がスナップショットで返る。
  detail.delivery_snapshots = deliverySnapshotsForApplicant_(req.applicant_id);
  // 横断ブレーキ用データ (革新3): 直近の送信・対応中かも詳細に付ける。
  try { detail.activity = activityForApplicant_(String(req.applicant_id), activityContext_(), r); }
  catch (e2) { detail.activity = null; }
  return { applicant: detail, events: ev };
}

/** 未確認ヒアリング項目 (DATA_MODEL §1) */
function missingHearing_(r) {
  return HEARING_FIELDS.filter(function (h) {
    var v = r[h.key];
    return v === '' || v == null;
  });
}

// ===== 応募者: ステータス変更 (要ドメイン認証) =====
function actionUpdateWorkflow_(req) {
  var me = requireKikariUser_();
  var status = String(req.status || '').trim();
  if (WORKFLOW_STATUSES.indexOf(status) < 0) {
    throw new Error('status は ' + WORKFLOW_STATUSES.join('/') + ' のいずれかです');
  }
  return withLock_(function () {
    var before = findApplicant_(req.applicant_id);
    var patch = { app_status: status, updated_at: nowIso_() };
    // 付帯日付 (任意): ステージごとの日付を hearing_json ではなく専用キーで受け、
    // app_status の変更と一緒に desired_start_date 等の既存列へ反映する
    if (req.desired_start_date) patch.desired_start_date = String(req.desired_start_date);
    if (req.next_contact_date !== undefined) patch.next_contact_date = String(req.next_contact_date || '');
    if (req.csv_status) patch.csv_status = String(req.csv_status);
    updateRowByPk_('applicants', req.applicant_id, patch);
    appendEvent_(req.applicant_id, 'status_change', me,
      '対応ステータス: ' + (str_(before.app_status) || '(未設定)') + ' -> ' + status +
      (req.note ? ' / ' + String(req.note) : ''), '', '');
    return { updated: req.applicant_id, app_status: status };
  });
}

// ===== SMS 送信記録 (要ドメイン認証)。実際の SMS 送信は iPhone の sms: リンク側で行う =====
function actionRecordSmsSent_(req) {
  var me = requireKikariUser_();
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  return withLock_(function () {
    // R4 O-06: 配信停止中の人への SMS 記録は受け付けない (画面を迂回した記録も通さない)。
    // 例外にせず戻り値で返す (outbox 経由の op が例外だと failed 滞留するため)。
    // あわせて sms_blocked イベントを残し、事後検出可能にする。
    var smsApplicant = null;
    try { smsApplicant = findApplicant_(req.applicant_id); } catch (eFind) { smsApplicant = null; }
    if (smsApplicant) {
      var blockedReason = smsBlockedReason_(smsApplicant);
      if (blockedReason) {
        try { appendEvent_(req.applicant_id, 'sms_blocked', me, blockedReason, String(req.delivery_id || ''), ''); } catch (eEv) {}
        return { recorded: false, blocked: 'optout', reason: blockedReason };
      }
    }
    // R4 S-11: 冪等キー。同一 applicant_id + client_request_id の sms_sent が
    // 既にあれば、append も recipients 更新もせず再送として返す (outbox 再送の二重記録防止)。
    var clientReqId = String(req.client_request_id || '');
    if (clientReqId) {
      var dupEv = readTable_('applicant_events').rows.filter(function (e) {
        return String(e.applicant_id) === String(req.applicant_id) && e.event_type === 'sms_sent' &&
          String(e.client_request_id || '') === clientReqId;
      });
      if (dupEv.length) return { recorded: req.applicant_id, idempotent_replay: true };
    }
    var now = nowIso_();
    // R3 (監査・高#1): スナップショットは配信レコードの有無に依存させず、
    // 本人のイベント (タイムライン) に必ず残す (従来は delivery_id がある
    // 場合に recipients へ書くだけで、通常の初回SMSではサーバーに残らなかった)。
    // R4 S-02: 案件の写し JSON もイベントに保存する (表示側の現在値再引きを廃止するため)。
    var smsCaseIds0 = toList_(req.case_ids || req.recommended_case_ids);
    var snapBody0 = snapshotBody_(req.body_snapshot || req.body || '');
    var snapCases0 = smsCaseIds0.length ? buildCasesSnapshot_(smsCaseIds0) : '';
    var detail0 = String(req.detail || req.template_kind || 'SMS送信 (sms:リンク)');
    if (req.campaign_id) detail0 += ' campaign=' + String(req.campaign_id);
    if (req.campaign_id && req.campaign_name) detail0 += ' name=' + String(req.campaign_name); // R4 S-10
    // R4 Lane J: SMS は配信レコードが無い場合があるため版キーを証跡にも残す。
    // req.template_version が無くても template_id / template_kind からサーバーで確定する。
    var smsTplVer = String(req.template_version || '');
    if (!smsTplVer && (req.template_id || req.template_kind)) {
      smsTplVer = templateVersionFor_({ template_id: req.template_id,
        template_kind: req.template_kind }, snapBody0).template_version;
    }
    if (smsTplVer) detail0 += ' tpl=' + smsTplVer;
    // R4 S-11: 証跡 (イベント) を状態 (applicants 更新) より先に書く。
    // append が失敗したら applicants は更新しない (状態だけ先行させない)。
    appendEvent_(req.applicant_id, 'sms_sent', me, detail0, String(req.delivery_id || ''), '',
      (snapBody0 || smsCaseIds0.length || clientReqId) ? {
        body_snapshot: snapBody0, case_ids: smsCaseIds0.join(','),
        cases_snapshot: snapCases0, client_request_id: clientReqId
      } : null);
    var patch = { sms_sent: true, sms_last_sent_at: now, last_contact_at: now, updated_at: now };
    updateRowByPk_('applicants', req.applicant_id, patch);
    // SMS記録系: 配信レコード (delivery_id 指定時) があれば、その時点で見せた
    // 案件と文面のスナップショットを delivery_recipients 側へ保存する (写し・不変)。
    // R4 S-07: form_link の発行記録行もこの時点で初めてスナップショット化する
    // (発行時点では書かない)。SMS経路の写しは記録時点で確定なので finalized=1。
    var smsCaseIds = smsCaseIds0;
    var snapshotSaved = null;
    if (req.delivery_id && (smsCaseIds.length || req.body || req.body_snapshot)) {
      try {
        var smsRecPatch = {
          cases_snapshot: snapCases0 || buildCasesSnapshot_(smsCaseIds),
          body_snapshot: snapshotBody_(req.body_snapshot || req.body || ''),
          snapshot_finalized: 1
        };
        if (smsTplVer) smsRecPatch.template_version = smsTplVer; // R4 レーンJ (c)3
        updateRecipientStatus_(String(req.delivery_id), String(req.applicant_id), smsRecPatch);
        snapshotSaved = true;
      } catch (e) { snapshotSaved = false; /* 配信レコードが無い SMS 単独記録ではスナップショットを持たない */ }
    }
    var smsRet = { recorded: req.applicant_id, sms_last_sent_at: now };
    if (snapshotSaved === false) smsRet.snapshot_saved = false; // R4 S-11: 画面は op を「反映待ち (証跡未保存)」として残す
    return smsRet;
  });
}

// ===== 取り込み進捗 (R6) =====
/** import_batches を読み取り専用で返す。フロントは確定の再送で競合せず、
 * この進捗表示でサーバー側の処理状況 (running/complete/partial と件数) を見る。 */
function actionGetImportStatus_(req) {
  requireKikariUser_();
  var rows = readTable_('import_batches').rows.slice();
  rows.sort(function (a, b) { return String(b.created_at || '').localeCompare(String(a.created_at || '')); });
  var totals = { batches: rows.length, running: 0, complete: 0, partial: 0, failed_batches: 0,
    rows: 0, added: 0, updated: 0, skipped: 0, failed: 0 };
  rows.forEach(function (r) {
    var st = str_(r.status);
    if (st === 'running') totals.running++;
    else if (st === 'complete') totals.complete++;
    else if (st === 'partial') totals.partial++;
    else if (st === 'failed') totals.failed_batches++;
    totals.rows += toNum_(r.row_count) || 0;
    totals.added += toNum_(r.added_count) || 0;
    totals.updated += toNum_(r.updated_count) || 0;
    totals.skipped += toNum_(r.skipped_count) || 0;
    totals.failed += toNum_(r.failed_count) || 0;
  });
  var recent = rows.slice(0, 30).map(function (r) {
    return { batch_id: str_(r.batch_id), file_name: str_(r.file_name), kind: str_(r.kind),
      row_count: toNum_(r.row_count) || 0, added: toNum_(r.added_count) || 0,
      updated: toNum_(r.updated_count) || 0, skipped: toNum_(r.skipped_count) || 0,
      failed: toNum_(r.failed_count) || 0, status: str_(r.status),
      created_at: str_(r.created_at), note: str_(r.note), client_op_id: str_(r.client_op_id),
      chunk_seq: (r.chunk_seq === undefined || r.chunk_seq === null) ? '' : r.chunk_seq };
  });
  // R6.5: サーバー側キューの進捗 (import_queue が無い環境では空集計)
  var queue = { pending_rows: 0, pending_chunks: 0, processing_rows: 0, done_rows: 0, failed_rows: 0 };
  try {
    var qrows = readTable_('import_queue').rows;
    var chunkKeys = {};
    qrows.forEach(function (r) {
      var st = str_(r.status);
      if (st === 'pending') { queue.pending_rows++; chunkKeys[str_(r.client_op_id) + '|' + String(r.chunk_seq === undefined || r.chunk_seq === null ? '' : r.chunk_seq)] = true; }
      else if (st === 'processing') queue.processing_rows++;
      else if (st === 'done') queue.done_rows++;
      else if (st === 'failed') queue.failed_rows++;
    });
    queue.pending_chunks = Object.keys(chunkKeys).length;
  } catch (e) { /* キュー未導入の環境では進捗なしとして扱う */ }
  return { batches: recent, totals: totals, queue: queue };
}

// ===== CSV 取り込み確定 (要ドメイン認証 / LockService で直列化) =====
/**
 * 追補3・追補4 のルールをサーバー側でも担保する:
 * - 照合キー: 電話 / メール / 氏名+生年月日。
 * - 過去に応募がある人でも、新しい応募は「本人の最新応募」として必ず登録する
 *   (applied_at / source_company / area / job_type 等の応募属性を現在化し、
 *    applicant_events に import イベント「新規応募あり」を残す)。
 * - 進行中の対応ステータス (csv_status / app_status) や SMS 送信済み記録は
 *   取り込みでリセットしない (patch に含めない)。
 * - 配信停止 (optouts テーブル) にあるメールは mail_optout=true を強制し、
 *   CSV 再取り込みでも復活させない (registerOptout のコメントも参照)。
 * - FS登録歴フラグ (追補17): 取り込んだ応募の正規化会社がファーストスタッフィングなら
 *   has_fs_history=true を永続化する。既存が true の場合はもちろん、既存行の history から
 *   導出できる場合も true を書き戻し、一度 true になったフラグは取り込みでは絶対に
 *   false にしない (patch に false を含めない)。「既存と同じ・古い応募」で属性更新を
 *   除外する行でも、フラグの立て直しだけは行う。
 * req: { file_name, kind:'applicants', rows:[{...applicants列...}] }
 * プレビュー (確認画面) はフロント側の責務。本関数は「確定」のみ。
 */
function actionImportCommit_(req) {
  var me = requireKikariUser_();
  // 案件取り込み修正 (案B): kind='cases' は案件専用バルクコアへ振り分ける。
  // dispatch は importCommit を共用し、フロントの op 形式は応募者と揃える。
