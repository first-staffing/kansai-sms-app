// ===== HTTP エントリポイント =====
function doGet(e) {
  try {
    var p = (e && e.parameter) || {};
    if (!p.action) {
      return appHtmlOutput_();
    }
    var req = {};
    Object.keys(p).forEach(function (k) { req[k] = p[k]; });
    if (p.payload) req = JSON.parse(p.payload);
    return jsonOut_({ ok: true, data: dispatch_(req) });
  } catch (err) {
    return jsonOut_({ ok: false, error: errMsg_(err) });
  }
}

function doPost(e) {
  try {
    var req = {};
    if (e && e.postData && e.postData.contents) req = JSON.parse(e.postData.contents);
    else if (e && e.parameter && e.parameter.payload) req = JSON.parse(e.parameter.payload);
    return jsonOut_({ ok: true, data: dispatch_(req || {}) });
  } catch (err) {
    return jsonOut_({ ok: false, error: errMsg_(err) });
  }
}

/** google.script.run 経由 (同一プロジェクトに画面を持たせる場合の互換入口) */
function apiCall(req) {
  try { return { ok: true, data: dispatch_(req || {}) }; }
  catch (err) { return { ok: false, error: errMsg_(err) }; }
}

