function verifyCaseSourceLinks() {
  var counts = {};
  readTable_('case_sources').rows.forEach(function (r) {
    var s = String(r.source);
    counts[s] = (counts[s] || 0) + 1;
  });
  return { case_sources_by_source: counts, cases_total: readTable_('cases').rows.length };
}

function caseDatesDigest_() {
  var parts = [];
  readTable_('cases').rows.forEach(function (c) {
    parts.push(String(c.case_id) + '=' + (cellDateIso_(c.updated_at_src) || ''));
  });
  parts.sort();
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,
    parts.join('\n'), Utilities.Charset.UTF_8);
  var hex = digest.map(function (b) {
    var v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
  return { count: parts.length, digest: hex };
}

function migrateCaseSourceLinks() {
  var src = readTable_('case_sources').rows;
  var csvMap = {}, smsKeys = {};
  src.forEach(function (r) {
    if (String(r.source) === 'csv') csvMap[String(r.source_case_key)] = String(r.case_id);
    if (String(r.source) === 'sms_app') smsKeys[String(r.source_case_key)] = true;
  });
  // バックアップ: case_sources シートを同ブック内に複製 (既にあれば中止)
  var sh = sheet_('case_sources');
  var ss = sh.getSpreadsheet();
  var bakName = 'bak_case_sources_' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd_HHmmss');
  if (ss.getSheetByName(bakName)) throw new Error('backup sheet already exists: ' + bakName);
  var vals = sh.getDataRange().getValues();
  var bak = ss.insertSheet(bakName);
  bak.getRange(1, 1, vals.length, vals[0].length).setValues(vals);

  var now = new Date().toISOString();
  var out = [], already = 0, notFound = [];
  CASE_LINK_PAIRS_.forEach(function (p) {
    var cid = csvMap[p[0]];
    if (!cid) { notFound.push(p[0]); return; }
    if (smsKeys[p[1]]) { already++; return; }
    out.push([cid, 'sms_app', p[1],
      JSON.stringify({ linked: true, via: 'migration-20261123' }), now]);
    smsKeys[p[1]] = true;
  });
  if (out.length) {
    sh.getRange(sh.getLastRow() + 1, 1, out.length, 5).setValues(out);
  }
  return { backup_sheet: bakName, linked: out.length, already: already,
    not_found: notFound.length, not_found_sample: notFound.slice(0, 5) };
}
