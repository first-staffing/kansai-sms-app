/**
 * sync-cases.gs — 案件シートからの新着案件 自動取り込み (追加ファイル)
 *
 * 設計: CASE_SYNC_DESIGN.md (2026-11-23 ユーザー承認: 毎朝1回・連結移行あり)
 * - 源は案件シート (タブ「案件」) のみ。人が編集する生きた台帳を毎日読む。
 * - 書き込みは既存の importCasesCommitCore_ (kind='cases') に一本化する。
 * - 重複排除は (source='sms_app', source_case_key=内容キー)。行番号は使わない。
 * - 日時規則: 新規は updated_at_src = 同期実行日時 (新着化のため)。
 *   既存は現在の保存値をそのまま渡して取得日を不変に保つ
 *   (コアは値を渡せば既存にも書くし、空なら now を書くため、明示が必須)。
 * - 所在地は郵便番号プレフィクス (〒...) を除去してから判定・キー化する
 *   (build_cases.py は除去しておらず府県不明が多発したため、同期側で是正)。
 */

var CASE_SYNC_SHEET_ID = '1GgRzu3_VrF63QIzIxduF4HgeIeCN7WsZuyetLJ8v1jI';
var CASE_SYNC_SHEET_TAB = '案件';
var CASE_SYNC_SOURCE = 'sms_app';
var CASE_SYNC_KANSAI = ['大阪府', '兵庫県', '京都府', '奈良県', '滋賀県', '和歌山県'];
var CASE_SYNC_CLOSED_KW = ['終了', '停止', '充足', 'クローズ', '募集なし', '募集終了'];
var CASE_SYNC_CHUNK = 500;
// 列 (0始まり): 取得日/担当営業/案件区分/事業所名/事業所形態/担当者名/担当TEL/
// 職種/資格/所在地/性別/年齢/勤務日数/シフト（日勤OR夜勤）/時間/請求単価/その他
var CASE_SYNC_HEADERS = ['取得日','担当営業','案件区分','事業所名','事業所形態','担当者名',
  '担当TEL','職種','資格','所在地','性別','年齢','勤務日数','シフト（日勤OR夜勤）','時間','請求単価','その他'];
var CASE_SYNC_PREFS = ['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県',
  '栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県',
  '山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県',
  '奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県',
  '高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];

/** 内容キー: 行の挿入・削除でずれない安定キー (build_merge のキー設計と同思想) */
function caseSyncSheetKey_(facility, address, jobType, serviceType, shift, days) {
  var base = [facility, address, jobType, serviceType, shift, days]
    .map(function (v) { return String(v || '').replace(/[\s　]/g, ''); }).join('|');
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, base, Utilities.Charset.UTF_8);
  var hex = digest.map(function (b) {
    var v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
  return 'sheet:' + hex.slice(0, 16);
}

/** 所在地の郵便番号プレフィクス (〒 000-0000 等) を除去する */
function caseSyncCleanAddr_(s) {
  var t = String(s || '').trim();
  t = t.replace(/^〒\s*\d{3}-\d{4}\s*/, '');
  t = t.replace(/^〒\s*/, '');
  return t.trim();
}

/** 住所から府県・市区町村を判定する (build_cases.py parse_pref_muni の移植) */
function caseSyncParsePrefMuni_(addr) {
  var s = String(addr || '').trim();
  var pref = '', rest = s;
  for (var i = 0; i < CASE_SYNC_PREFS.length; i++) {
    if (s.indexOf(CASE_SYNC_PREFS[i]) === 0) {
      pref = CASE_SYNC_PREFS[i]; rest = s.slice(pref.length); break;
    }
  }
  var muni = '';
  var m = rest.match(/^(.+?市.+?区)/) || rest.match(/^(.+?郡.+?[町村])/) || rest.match(/^(.+?[市町村区])/);
  if (m) muni = m[1];
  return { prefecture: pref, municipality: muni };
}

function caseSyncIsOpen_(row) {
  var hay = String(row[2] || '') + String(row[16] || '');
  for (var i = 0; i < CASE_SYNC_CLOSED_KW.length; i++) {
    if (hay.indexOf(CASE_SYNC_CLOSED_KW[i]) >= 0) return false;
  }
  return true;
}

/** シート行 (17列) → 案件フィールド。取り込み対象外なら null (理由は out.reason) */
function caseSyncRowToCase_(r, out) {
  var jobRaw = String(r[7] || '');
  var jobType = jobRaw.indexOf('看護') >= 0 ? 'kango'
    : (jobRaw.indexOf('介護') >= 0 ? 'kaigo' : '');
  if (!jobType) { out.reason = 'job_type_unknown'; return null; }
  var addr = caseSyncCleanAddr_(r[9]);
  var pm = caseSyncParsePrefMuni_(addr);
  if (CASE_SYNC_KANSAI.indexOf(pm.prefecture) < 0) { out.reason = 'not_kansai'; return null; }
  var salParts = [['時間', r[14]], ['勤務日数', r[12]], ['シフト', r[13]],
    ['資格', r[8]], ['性別', r[10]], ['年齢', r[11]]]
    .filter(function (p) { return String(p[1] || '').trim() !== ''; })
    .map(function (p) { return p[0] + ':' + String(p[1]).trim(); });
  var raw = {};
  CASE_SYNC_HEADERS.forEach(function (h, i) { raw[h] = r[i]; });
  return {
    facility_name: String(r[3] || '').trim(),
    service_type: String(r[4] || '').trim(),
    employment_type: String(r[2] || '').trim(),
    address: addr,
    prefecture: pm.prefecture,
    municipality: pm.municipality,
    job_type: jobType,
    salary_text: salParts.join(' / '),
    billing_rate_text: String(r[15] || '').trim(),
    description: String(r[16] || '').trim(),
    is_open: caseSyncIsOpen_(r),
    source: CASE_SYNC_SOURCE,
    source_case_key: caseSyncSheetKey_(r[3], addr, jobType, r[4], r[13], r[12]),
    case_source: { source: CASE_SYNC_SOURCE, raw_json: raw }
  };
}

/**
 * 本体: 案件シートを読んで差分を取り込む。トリガー / 手動のどちらからでも呼べる。
 * 日時規則 (CASE_SYNC_DESIGN §5.4):
 * - 新規キー: updated_at_src = 同期実行日時 → 取り込まれた時点で「新着」になる。
 * - 既存キー: updated_at_src = 現在の保存値 → 取得日は変わらない。
 */
function syncCasesFromSheet() {
  var syncNow = new Date().toISOString();
  var ss = SpreadsheetApp.openById(CASE_SYNC_SHEET_ID);
  var sh = ss.getSheetByName(CASE_SYNC_SHEET_TAB);
  if (!sh) throw new Error('案件シートのタブが見つかりません: ' + CASE_SYNC_SHEET_TAB);
  var values = sh.getDataRange().getValues();
  var dataRows = values.slice(1).filter(function (r) {
    return r.some(function (c) { return String(c || '').trim() !== ''; });
  });

  // 既存キー → case_id と、case_id → 現在の取得日 を先読みする
  var keyToCaseId = {};
  readTable_('case_sources').rows.forEach(function (r) {
    if (String(r.source) === CASE_SYNC_SOURCE) keyToCaseId[String(r.source_case_key)] = String(r.case_id);
  });
  var caseIdToSrcDate = {};
  readTable_('cases').rows.forEach(function (c) {
    caseIdToSrcDate[String(c.case_id)] = cellDateIso_(c.updated_at_src) || '';
  });

  var rows = [], skipped = { job_type_unknown: 0, not_kansai: 0 };
  var newCount = 0, existingCount = 0;
  dataRows.forEach(function (r) {
    var out = {};
    var c = caseSyncRowToCase_(r, out);
    if (!c) { skipped[out.reason] = (skipped[out.reason] || 0) + 1; return; }
    var existingId = keyToCaseId[c.source_case_key];
    if (existingId) {
      c.updated_at_src = caseIdToSrcDate[existingId] || syncNow; // 既存: 保存値を維持
      existingCount++;
    } else {
      c.updated_at_src = syncNow; // 新規: 取り込み日時に更新して新着化
      newCount++;
    }
    rows.push(c);
  });

  var day = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd');
  var totals = { added: 0, updated: 0, failed: 0 };
  for (var i = 0; i < rows.length; i += CASE_SYNC_CHUNK) {
    var chunk = rows.slice(i, i + CASE_SYNC_CHUNK);
    var res = importCasesCommitCore_({
      file_name: 'sheet_sync', kind: 'cases', rows: chunk,
      client_op_id: 'sheet-sync-' + day, chunk_seq: String(i / CASE_SYNC_CHUNK + 1)
    }, 'system:sheet-sync');
    totals.added += res.added || 0;
    totals.updated += res.updated || 0;
    totals.failed += res.failed || 0;
  }

  var summary = {
    at: syncNow, sheet_rows: dataRows.length, targets: rows.length,
    new_keys: newCount, existing_keys: existingCount,
    added: totals.added, updated: totals.updated, failed: totals.failed,
    skipped: skipped
  };
  try { runCaseIntegrityCheck(); } catch (e) {}
  try {
    var exists = false;
    readTable_('settings').rows.forEach(function (r) {
      if (String(r.key) === 'sheet_case_sync_last') exists = true;
    });
    var val = JSON.stringify(summary);
    if (exists) updateRowByPk_('settings', 'sheet_case_sync_last', { value: val });
    else appendRow_('settings', { key: 'sheet_case_sync_last', value: val });
  } catch (e) {}
  try { Logger.log('syncCasesFromSheet: ' + JSON.stringify(summary)); } catch (e) {}
  return summary;
}

/** 毎日1回 (朝7時台) のトリガーを設置する。既存があれば何もしない */
function installCaseSyncTrigger() {
  var existing = ScriptApp.getProjectTriggers();
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].getHandlerFunction() === 'syncCasesFromSheet') {
      return { installed: false, already_exists: true };
    }
  }
  ScriptApp.newTrigger('syncCasesFromSheet').timeBased()
    .atHour(7).nearMinute(0).everyDays(1).create();
  return { installed: true, handler: 'syncCasesFromSheet', hour: 7 };
}

function removeCaseSyncTriggers() {
  var n = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'syncCasesFromSheet') {
      ScriptApp.deleteTrigger(t); n++;
    }
  });
  return { removed: n };
}

