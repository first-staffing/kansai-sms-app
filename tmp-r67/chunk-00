}

/**
 * 一覧取得時に1回だけ作る活動コンテキスト (行ごとの全件走査をしない)。
 * 原材料は既存の3テーブルだけ: applicant_events / delivery_recipients+deliveries / responses。
 * 新しい記録の仕組みは作らない (導出のみ)。
 */
function activityContext_() {
  var ctx = { byApplicant: {}, names: operatorNameMap_(), deliveries: {} };
  try {
    readTable_('deliveries').rows.forEach(function (d) { ctx.deliveries[str_(d.delivery_id)] = d; });
  } catch (e) {}
  function slot_(id) {
    if (!ctx.byApplicant[id]) ctx.byApplicant[id] = { last_touch: null, last_send: null, open_response: null, sends: [] };
    return ctx.byApplicant[id];
  }
  try {
    readTable_('delivery_recipients').rows.forEach(function (r) {
      var at = cellDateIso_(r.sent_at) || cellDateIso_(r.updated_at) || cellDateIso_(r.created_at);
      if (!at) return;
      var d = ctx.deliveries[str_(r.delivery_id)] || {};
      var channel = '';
      try {
        var fj = JSON.parse(str_(d.filter_json) || '{}');
        if (fj && fj.form_invite && fj.channel) channel = String(fj.channel);
      } catch (e) {}
      var send = { sender_email: str_(d.sender_email), sender_name: str_(d.sender_name),
        at: at, channel: channel || 'mail', delivery_id: str_(r.delivery_id) };
      var s = slot_(str_(r.applicant_id));
      if (str_(r.status) === 'sent' || str_(r.sent_at)) {
        if (!s.last_send || send.at > s.last_send.at) s.last_send = send;
        s.sends.push(send);
      }
      if (!s.last_touch || at > s.last_touch.at) {
        s.last_touch = { actor_email: send.sender_email, actor_name: send.sender_name,
          type: channel === 'sms' ? 'sms_sent' : 'mail_sent', at: at, channel: send.channel };
      }
    });
  } catch (e) {}
  try {
    readTable_('applicant_events').rows.forEach(function (ev) {
      var at = cellDateIso_(ev.created_at);
      if (!at) return;
      var s = slot_(str_(ev.applicant_id));
      var touch = { actor_email: str_(ev.actor), actor_name: '', type: str_(ev.event_type),
        at: at, channel: str_(ev.event_type) === 'sms_sent' ? 'sms' : (str_(ev.event_type) === 'mail_sent' ? 'mail' : '') };
      if (!s.last_touch || at > s.last_touch.at) s.last_touch = touch;
      if (touch.type === 'sms_sent' || touch.type === 'mail_sent') {
        var send = { sender_email: touch.actor_email, sender_name: '', at: at,
          channel: touch.channel, delivery_id: str_(ev.delivery_id) };
        if (!s.last_send || at > s.last_send.at) s.last_send = send;
      }
    });
  } catch (e) {}
  try {
    readTable_('responses').rows.forEach(function (r) {
      if (responseStatus_(r) === 'handled') return;
      var s = slot_(str_(r.applicant_id));
      var open = { response_id: str_(r.response_id), status: responseStatus_(r),
        status_by: str_(r.status_by), sender_email: str_(r.sender_email),
        intent: str_(r.intent), created_at: cellDateIso_(r.created_at) };
      if (!s.open_response || open.created_at < s.open_response.created_at) s.open_response = open;
    });
  } catch (e) {}
  return ctx;
}

/** ブレーキ判定 (INNOVATION.md §3.4): 自分の記録は対象にしない */
function brakeForActivity_(act, applicantRow, meEmail, nowMs) {
  var me = str_(meEmail).trim().toLowerCase();
  function isOther(email) { var em = str_(email).trim().toLowerCase(); return !!em && em !== me && em !== 'system'; }
  if (act && act.open_response && act.open_response.status === 'in_progress' &&
      isOther(act.open_response.status_by)) {
    return { level: 'strong', reason: 'in_progress_other',
      actor_email: act.open_response.status_by, at: act.open_response.created_at };
  }
  var ref = (act && act.last_send) || (act && act.last_touch);
  if (ref && isOther(ref.sender_email || ref.actor_email) && ref.at) {
    var ageMs = nowMs - new Date(ref.at).getTime();
    if (isFinite(ageMs) && ageMs >= 0) {
      if (ageMs <= BRAKE_STRONG_HOURS * 3600000) return { level: 'strong', reason: 'sent_within_72h', actor_email: ref.sender_email || ref.actor_email, at: ref.at };
      if (ageMs <= BRAKE_WEAK_DAYS * 86400000) return { level: 'weak', reason: 'contact_within_7d', actor_email: ref.sender_email || ref.actor_email, at: ref.at };
      if (ageMs <= BRAKE_DETAIL_DAYS * 86400000) return { level: 'detail', reason: 'contact_within_14d', actor_email: ref.sender_email || ref.actor_email, at: ref.at };
    }
  }
  return { level: 'none', reason: '', actor_email: '', at: '' };
}

/** 人単位の活動サマリ (一覧の軽量版と getApplicantActivity の共通形) */
function activityForApplicant_(applicantId, ctx, applicantRow) {
  ctx = ctx || activityContext_();
  var act = ctx.byApplicant[String(applicantId)] || { last_touch: null, last_send: null, open_response: null, sends: [] };
  var me = '';
  try { me = currentUserEmail_(); } catch (e) {}
  var nowMs = new Date().getTime();
  function named_(o, emailKey) {
    if (!o) return null;
    var out = {}; Object.keys(o).forEach(function (k) { out[k] = o[k]; });
    var em = str_(o[emailKey]);
    out.actor_name = em === 'system' ? '' : actorDisplayName_(em, ctx.names);
    if (emailKey === 'sender_email') out.sender_name = out.actor_name;
    return out;
  }
  var brake = brakeForActivity_(act, applicantRow, me, nowMs);
  brake.actor_name = brake.actor_email ? actorDisplayName_(brake.actor_email, ctx.names) : '';
  var recentSenders = [], seenSender = {};
  (act.sends || []).filter(function (s) { return s.at && (nowMs - new Date(s.at).getTime()) <= BRAKE_DETAIL_DAYS * 86400000; })
    .sort(function (a, b) { return a.at < b.at ? 1 : -1; })
    .forEach(function (s) {
      var em = str_(s.sender_email).trim().toLowerCase();
      if (!em || seenSender[em]) return;
      seenSender[em] = true;
      recentSenders.push({ sender_email: em, sender_name: actorDisplayName_(em, ctx.names), last_at: s.at });
    });
  return {
    last_touch: named_(act.last_touch, 'actor_email'),
    last_send: named_(act.last_send, 'sender_email'),
    open_response: act.open_response,
    in_progress_by: (act.open_response && act.open_response.status === 'in_progress') ? act.open_response.status_by : '',
    next_contact_date: applicantRow ? cellDateYmd_(applicantRow.next_contact_date) : '',
    last_contact_at: applicantRow ? cellDateIso_(applicantRow.last_contact_at) : '',
    recent_senders: recentSenders,
    brake: brake
  };
}

/** getApplicantActivity (読み取り専用・革新3の読み取り口) */
function actionGetApplicantActivity_(req) {
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  var row = null;
  try { row = findApplicant_(req.applicant_id); } catch (e) { row = null; }
  var act = activityForApplicant_(String(req.applicant_id), activityContext_(), row);
  return { applicant_id: String(req.applicant_id), last_touch: act.last_touch, last_send: act.last_send,
    open_response: act.open_response, recent_senders: act.recent_senders, brake: act.brake,
    next_contact_date: act.next_contact_date, last_contact_at: act.last_contact_at };
}

