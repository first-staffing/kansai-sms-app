var QUEUE_CLAIM_STATUSES = { waiting: true, sending: true, sent: true, failed: true};

// csv_status のうち「対応中/進行中」として Gmail 配信対象から除外する区分。
// mailPreviewTargets では req.include_active=true で含有に切り替えられる (DESIGN_V2 §6.2)。
// R4 01-#3: 対応中判定の正は isActiveCsvStatus_ (csvStageRank_ の正規化判定)。
// 本定数は参照されなくなったが、旧データ・旧テストとの対照用に残す (判定には使わない)。
var ACTIVE_CSV_STATUSES = ['稼働中', '内定待ち', '職見待ち', 'FIX待ち', 'アテンド待ち', '誘致待ち'];

// ===== 終了系 (terminal) ステータスの単一定義 (R3 Z4) =====
// csv_status の終了判定は csvStageRank_().terminal を唯一の正とする
// (選考NG・接触NG・他社決定・登録辞退・退職済み・対象外・不通・応募除外・譲渡 等を
//  正規化込みで判定する既存の正本ロジック)。ここに個別リストを複製しない。
// app_status 側の終了 (NG / 譲渡) は行の現在状態として併せて判定する。
var TERMINAL_APP_STATUSES = ['NG', '譲渡'];
function isTerminalStatus_(r) {
  if (!r) return false;
  if (csvStageRank_(str_(r.csv_status)).terminal) return true;
  return TERMINAL_APP_STATUSES.indexOf(str_(r.app_status)) >= 0;
}
