      batch_id: batchId, kind: String(req.kind || 'applicants'), file_name: String(req.file_name || ''),
      row_count: rows.length, added_count: added, updated_count: updated, skipped_count: skipped,
      actor: me, created_at: now,
      status: finalStatus, failed_count: failedRows,
      client_op_id: clientOpId, chunk_seq: chunkSeq, note: batchNote
