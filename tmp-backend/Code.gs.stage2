// テーブル名 -> 主キー列 (採番・更新のキー)
var TABLE_PK_ = {
applicants: 'applicant_id', applicant_events: 'event_id', optouts: 'optout_id', import_batches: 'batch_id', import_queue: 'queue_id',
cases: 'case_id', deliveries: 'delivery_id', responses: 'response_id', send_queue: 'queue_id',
case_match_proposals: 'proposal_id', case_sync_log: 'log_id',
templates: 'template_id', settings: 'key', operators: 'email', campaigns: 'campaign_id', qualifications: 'code', companies: 'canonical'
};
// 採番プレフィックス
var ID_PREFIX_ = {
applicants: 'A', applicant_events: 'E', optouts: 'O', import_batches: 'B', import_queue: 'IQ',
cases: 'C', deliveries: 'D', responses: 'R', send_queue: 'Q', campaigns: 'CP',
case_match_proposals: 'P', case_sync_log: 'CSL'
};

// ===== Script Properties / ブック / シート =====
function prop_(key) {
var v = PropertiesService.getScriptProperties().getProperty(key);
if (!v) throw new Error('Script Properties に ' + key + ' が未設定です。init_sheets.gs の createAllBooks() を実行してください');
return v;
}

var bookCache_ = {};
function book_(propKey) {
if (!bookCache_[propKey]) bookCache_[propKey] = SpreadsheetApp.openById(prop_(propKey));
return bookCache_[propKey];
}

function sheet_(tableName) {
var def = TABLE_DEFS_[tableName];
if (!def) throw new Error('未知のテーブル: ' + tableName);
var sh = book_(def.book).getSheetByName(tableName);
if (!sh) throw new Error('シート「' + tableName + '」がありません。createAllBooks() を実行してください');
return sh;
}

// ===== 汎用テーブル IO (列はヘッダー名で解決する) =====
/** シートを { headers:[...], rows:[{列名:値, _row: シート行番号}]} で読む */
function readTable_(tableName) {
var sh = sheet_(tableName);
var values = sh.getDataRange().getValues();
if (!values.length) return { headers: TABLE_DEFS_[tableName].headers.slice(), rows: []};
var headers = values[0].map(function (h) { return String(h || '').trim();});
var rows = [];
for (var i = 1; i < values.length; i++) {
var obj = { _row: i + 1};
var empty = true;
for (var c = 0; c < headers.length; c++) {
if (!headers[c]) continue;
obj[headers[c]] = values[i][c];
if (values[i][c]!== '' && values[i][c]!= null) empty = false;
}
if (!empty) rows.push(obj);
}
return { headers: headers, rows: rows};
}

/** オブジェクトを1行追記する (ヘッダーに無いキーは無視、無い列は空) */
function appendRow_(tableName, obj) {
var sh = sheet_(tableName);
var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (h) { return String(h || '').trim();});
var row = headers.map(function (h) { return obj[h] == null? '': obj[h];});
sh.appendRow(row);
return sh.getLastRow();
}

/** 複数行をまとめて追記する (R4 06-07 のバッチ書き込みヘルパー)。
 * 内部は現行の書き込み経路 (appendRow_) を行ごとに呼ぶが、1行の失敗で残りを
 * 止めず、行ごとの成否を返す。呼び出し側は「一括で渡し、失敗分だけを数える」
 * 一括前提の構造にすること。実シートへの setValues 一括書き込みは appendRow_
 * 抽象の内側の最適化であり、本ヘルパーの契約 (戻り値) は変えない。 */
function appendRows_(tableName, objs) {
objs = objs || [];
if (!objs.length) return { written: 0, errors: [] };
// R6: 実シートでは setValues 一括書き込みにする (行ごとの appendRow は
// ヘッダー再読込+appendRow を行数分繰り返し、数千行で分単位に膨らむ)。
// 一括が使えない環境 (テストスタブ等) や一括自体が失敗した場合は、
// 従来の行単位書き込みにフォールバックして行ごとの成否契約を守る。
try {
var sh = sheet_(tableName);
var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (h) { return String(h || '').trim(); });
var rng = sh.getRange(sh.getLastRow() + 1, 1, objs.length, headers.length);
if (!rng || typeof rng.setValues !== 'function') throw new Error('bulk write unavailable');
var matrix = objs.map(function (obj) { return headers.map(function (h) { return obj[h] == null ? '' : obj[h]; }); });
rng.setValues(matrix);
return { written: objs.length, errors: [] };
} catch (bulkErr) {
var written = 0, errors = [];
objs.forEach(function (obj, i) {
try { appendRow_(tableName, obj); written++; }
catch (e) { errors.push({ index: i, message: errMsg_(e) }); }
});
return { written: written, errors: errors };
}
}

/** 主キーで1行を探して部分更新する。見つからなければ throw */
function updateRowByPk_(tableName, pkValue, patch) {
var pk = TABLE_PK_[tableName];
var t = readTable_(tableName);
var headers = t.headers;
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i][pk]) === String(pkValue)) {
var sh = sheet_(tableName);
Object.keys(patch).forEach(function (k) {
var col = headers.indexOf(k);
if (col >= 0) sh.getRange(t.rows[i]._row, col + 1).setValue(patch[k] == null? '': patch[k]);
});
return t.rows[i];
}
}
throw new Error(tableName + ' に ' + pk + '=' + pkValue + ' が見つかりません');
}

/** 連番IDを採番する (既存の最大番号+1。シート走査ベースの簡易実装) */
function nextId_(tableName) {
var pk = TABLE_PK_[tableName];
var prefix = ID_PREFIX_[tableName] || 'X';
var t = readTable_(tableName);
var max = 0;
t.rows.forEach(function (r) {
var m = String(r[pk] || '').match(new RegExp('^' + prefix + '(\\d+)$'));
if (m) max = Math.max(max, parseInt(m[1], 10));
});
var n = String(max + 1);
while (n.length < 6) n = '0' + n;
return prefix + n;
}

// ===== 小物ユーティリティ =====
function nowIso_() { return new Date().toISOString();}

function str_(v) { return v == null? '': String(v);}

/** メールアドレス正規化の唯一の実装 (R4 O-03: trim + NFKC + 小文字化)。
 * 前後空白・全角空白・全角英字/＠の表記ゆれを吸収する。照合・保存は全てこれを通す。 */
function normalizeEmail_(v) {
var s = str_(v);
try { s = s.normalize('NFKC'); } catch (e) {}
return s.replace(/^[\s　]+|[\s　]+$/g, '').toLowerCase();
}

/** メール形式の検証 (R4 01-#7: フロントと同じ簡易式)。正規化済み文字列に当てる。 */
function isValidEmail_(v) {
return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(str_(v));
}

/** 対応中 (進行中) 判定の正本 (R4 01-#3): csvStageRank_ の正規化判定で見る。
 * stage>=2 (誘致待ち〜稼働中) が対応中。接触待ち (stage1) は対象内に残す。
 * 表記ゆれ (内定済み/稼働済み/FIX済み 等) も正規化で拾う。 */
function isActiveCsvStatus_(raw) {
var st = csvStageRank_(raw);
return !!(st.inFlow && st.stage >= 2);
}

/** 本日 (JST) すでにメール送信済みの応募者 (R4 01-#10)。
 * 戻り値: applicant_id -> 送信元 delivery_id の配列 (自配信の自己ブロック回避に使う)。
 * delivery_recipients (status=sent) を主、applicant_events の mail_sent を補助とする。 */
function mailSentTodayMap_() {
var today = todayYmd_();
var map = {};
var add = function (aid, did) {
if (!aid) return;
map[aid] = map[aid] || [];
if (did && map[aid].indexOf(did) < 0) map[aid].push(did);
};
try {
readTable_('delivery_recipients').rows.forEach(function (r) {
if (str_(r.status) !== 'sent') return;
if (cellDateYmd_(r.sent_at) !== today) return;
add(str_(r.applicant_id), str_(r.delivery_id));
});
} catch (e) {}
try {
readTable_('applicant_events').rows.forEach(function (r) {
if (str_(r.event_type) !== 'mail_sent') return;
if (cellDateYmd_(r.created_at) !== today) return;
add(str_(r.applicant_id), str_(r.delivery_id));
});
} catch (e) {}
return map;
}

/** 本日作成され未送信 (pending) の宛先がある応募者の集合 (R4 01-#10: 警告表示用)。 */
function mailQueuedTodaySet_() {
var today = todayYmd_();
var set = {};
try {
readTable_('delivery_recipients').rows.forEach(function (r) {
if (str_(r.status) !== 'pending') return;
if (cellDateYmd_(r.created_at) !== today) return;
var aid = str_(r.applicant_id);
if (aid) set[aid] = true;
});
} catch (e) {}
return set;
}

function toBool_(v) {
if (v === true) return true;
var s = String(v == null? '': v).trim().toLowerCase();
return s === 'true' || s === '1' || s === 'yes';
}

function toNum_(v) {
if (v === '' || v == null) return null;
var n = Number(v);
return isFinite(n)? n: null;
}

/** セル値 (Date / 文字列) を ISO 文字列にする。空は '' */
function cellDateIso_(v) {
if (v == null || v === '') return '';
if (v instanceof Date) return v.toISOString();
var d = new Date(v);
return isNaN(d.getTime())? String(v): d.toISOString();
}

/** YYYY-MM-DD を返す (表示・比較用)。
 * R4 T-4: Date 型セルは Asia/Tokyo 基準で整形する。toISOString (UTC) 基準だと
 * JST 深夜0時のセルが前日にずれる (応募期間・年齢・カレンダー・掘り起こしに波及)。 */
function cellDateYmd_(v) {
if (v == null || v === '') return '';
if (v instanceof Date) {
if (isNaN(v.getTime())) return '';
try { return Utilities.formatDate(v, 'Asia/Tokyo', 'yyyy-MM-dd'); } catch (e) { /* フォールバックへ */ }
}
var iso = cellDateIso_(v);
return iso? iso.substring(0, 10): '';
}

/**
 * 日時文字列 / Date を Date に変換する (変換できなければ null)。
 * relay.gs の relayFormExpiresAt_ が依存する共通ユーティリティ。
 * R6.7: relay 単体テストではスタブで与えられていたため本番 Code.gs 側の
 * 定義漏れが検出されず、relay プッシュが毎回 ReferenceError になっていた。
 */
function parseDateTime_(v) {
if (v == null || v === '') return null;
var d = (v instanceof Date) ? v : new Date(v);
return isNaN(d.getTime()) ? null : d;
}

/** ハバーシン距離 (km)。座標が欠けていれば null */
function distanceKm_(lat1, lon1, lat2, lon2) {
var a = toNum_(lat1), b = toNum_(lon1), c = toNum_(lat2), d = toNum_(lon2);
if (a == null || b == null || c == null || d == null) return null;
// R4 I-3 (多層防御): 既存マスターに混入済みの異常座標 (0,0・入替・域外) は
// 距離として効かせない。ok でないペアは「距離不明」に倒し、同一市区町村
// フォールバックだけが残るようにする。
if (coordBasicCheck_(a, b).state !== 'ok' || coordBasicCheck_(c, d).state !== 'ok') return null;
var R = 6371, rad = Math.PI / 180;
var dLat = (c - a) * rad, dLon = (d - b) * rad;
var h = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
Math.cos(a * rad) * Math.cos(c * rad) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
return 2 * R * Math.asin(Math.sqrt(h));
}

// ===== R4 I-3: 座標チェック3点 (11-#7/#8 への組み込み) =====
// 範囲と40kmの閾値の出典は CHATGPT_INTEL §2 の ChatGPT 自己報告 (旧アプリ
// コードの直接検証ではない)。重複閾値10件は出典のない新規パラメータで、
// 運用開始後に computeCaseIntegrity_ の集計を見て調整する前提。
var COORD_JP_ = { latMin: 20, latMax: 46, lonMin: 122, lonMax: 154 };
var COORD_REP_LIMIT_KM = 40;
var COORD_DUP_THRESHOLD = 10;

/** 座標の基本チェック。第1層 (単体で判定できる範囲・入替・欠落)。
 * 戻り値: { state:'none'|'ok'|'invalid', lat, lon, reason } */
function coordBasicCheck_(latRaw, lonRaw) {
  var hasLat = !(latRaw === '' || latRaw == null);
  var hasLon = !(lonRaw === '' || lonRaw == null);
  if (!hasLat && !hasLon) return { state: 'none', lat: '', lon: '', reason: '' };
  if (hasLat !== hasLon) return { state: 'invalid', lat: '', lon: '', reason: 'partial' };
  var lat = toNum_(latRaw), lon = toNum_(lonRaw);
  if (lat == null || lon == null) return { state: 'invalid', lat: '', lon: '', reason: 'non_numeric' };
  if (lat === 0 && lon === 0) return { state: 'invalid', lat: '', lon: '', reason: 'zero' };
  if (lat >= COORD_JP_.latMin && lat <= COORD_JP_.latMax &&
      lon >= COORD_JP_.lonMin && lon <= COORD_JP_.lonMax) {
    return { state: 'ok', lat: lat, lon: lon, reason: '' };
  }
  // 入替検出: 交換すると日本域に入る場合だけ 'swapped' と断定する (自動補正はしない)。
  if (lon >= COORD_JP_.latMin && lon <= COORD_JP_.latMax &&
      lat >= COORD_JP_.lonMin && lat <= COORD_JP_.lonMax) {
    return { state: 'invalid', lat: '', lon: '', reason: 'swapped' };
  }
  return { state: 'invalid', lat: '', lon: '', reason: 'out_of_range' };
}

/** 精密扱いの判定 (第2層)。repPoint が引けない場合は (b) を判定しない。
 * dupCount は同一座標を使う「異なる住所」の件数 (代表点一致の座標は母数外)。 */
function coordPrecisionCheck_(lat, lon, repPoint, dupCount) {
  if (repPoint) {
    var d = distanceKm_(lat, lon, repPoint.lat, repPoint.lon);
    if (d != null && d > COORD_REP_LIMIT_KM) return { precise: false, reason: 'far_from_rep' };
  }
  if (dupCount != null && dupCount >= COORD_DUP_THRESHOLD) {
    return { precise: false, reason: 'duplicated' };
  }
  return { precise: true, reason: '' };
}

/** municipalities の代表点マップ (同一実行内はメモ化。bulk 取り込みでの再読みを防ぐ) */
var MUNICIPALITY_REP_MAP_ = null;
function municipalityRepMap_() {
  if (MUNICIPALITY_REP_MAP_) return MUNICIPALITY_REP_MAP_;
  var map = {};
  try {
    readTable_('municipalities').rows.forEach(function (m) {
      var chk = coordBasicCheck_(m.lat, m.lon);
      if (chk.state === 'ok') {
        map[str_(m.prefecture) + '|' + str_(m.municipality)] = { lat: chk.lat, lon: chk.lon };
      }
    });
  } catch (e) {}
  MUNICIPALITY_REP_MAP_ = map;
  return map;
}

/** municipalities マスターから代表点を引く (基本チェックを通ったものだけ返す) */
function municipalityRepPoint_(prefecture, municipality) {
  return municipalityRepMap_()[str_(prefecture) + '|' + str_(municipality)] || null;
}

/** 持ち込み座標の受け入れ判定。NG または精密でない場合は座標なしへ降格する
 * (サーバーに精度列が無いため。座標なしでも市区町村フォールバックで候補化される)。
 * 戻り値: { lat, lon, verdict:'none'|'precise'|'downgraded', reason } */
function acceptCoord_(latRaw, lonRaw, repPoint, dupCount) {
  var basic = coordBasicCheck_(latRaw, lonRaw);
  if (basic.state === 'none') return { lat: '', lon: '', verdict: 'none', reason: '' };
  if (basic.state === 'invalid') return { lat: '', lon: '', verdict: 'downgraded', reason: basic.reason };
  var prec = coordPrecisionCheck_(basic.lat, basic.lon, repPoint, dupCount);
  if (!prec.precise) return { lat: '', lon: '', verdict: 'downgraded', reason: prec.reason };
  return { lat: basic.lat, lon: basic.lon, verdict: 'precise', reason: '' };
}

/** 座標の正規キー (小数6桁)。基本チェック NG は空文字。 */
function coordKey_(lat, lon) {
  var chk = coordBasicCheck_(lat, lon);
  return chk.state === 'ok' ? chk.lat.toFixed(6) + ',' + chk.lon.toFixed(6) : '';
}

/** 同一座標キー → 異なる住所の件数マップ ((c) の集計用)。
 * rows: [{lat, lon, addressKey}]。excludeKeys にある座標 (市区町村代表点など、
 * 正常な共有) は 0 を返して母数から除く。 */
function coordDupCountMap_(rows, excludeKeys) {
  var byKey = {};
  rows.forEach(function (r) {
    var key = coordKey_(r.lat, r.lon);
    if (!key) return;
    if (!byKey[key]) byKey[key] = {};
    byKey[key][String(r.addressKey || '')] = true;
  });
  var out = {};
  Object.keys(byKey).forEach(function (key) {
    out[key] = (excludeKeys && excludeKeys[key]) ? 0 : Object.keys(byKey[key]).length;
  });
  return out;
}

/** municipalities 全行の代表点キー集合 ((c) の母数から除く用) */
function municipalityRepKeys_() {
  var keys = {};
  Object.keys(municipalityRepMap_()).forEach(function (k) {
    var p = municipalityRepMap_()[k];
    keys[p.lat.toFixed(6) + ',' + p.lon.toFixed(6)] = true;
  });
  return keys;
}

/** 書き込み系の直列化ラッパー
 * R6: インポート確定のチャンクが連続する運用では、短時間の競合を
 * エラーにせず待機して処理する。Apps Script の waitLock を優先し、
 * 利用できない実行環境/テストスタブでは tryLock を最大120秒まで
 * 小刻みに再試行する。待機し切れない場合だけ従来の競合エラーを返す。 */
function withLock_(fn) {
var lock = LockService.getScriptLock();
var acquired = false;
if (lock && typeof lock.waitLock === 'function') {
  try { lock.waitLock(120000); acquired = true; }
  catch (e) { throw new Error('別の書き込み処理が実行中です。少し待ってから再試行してください'); }
} else {
  var deadline = Date.now() + 120000;
  while (!acquired && Date.now() <= deadline) {
    if (lock.tryLock(5000)) { acquired = true; break; }
    if (typeof Utilities !== 'undefined' && Utilities && typeof Utilities.sleep === 'function') Utilities.sleep(250);
    else break;
  }
}
if (!acquired) throw new Error('別の書き込み処理が実行中です。少し待ってから再試行してください');
try { return fn();} finally { lock.releaseLock();}
}

/** applicant_events へ append-only で記録する (ロック取得済みの文脈から呼ぶこと) */
function appendEvent_(applicantId, eventType, actor, detail, deliveryId, responseId, extra) {
var row = {
event_id: nextId_('applicant_events'),
applicant_id: applicantId,
event_type: eventType,
actor: actor || 'system',
delivery_id: deliveryId || '',
response_id: responseId || '',
detail: detail || '',
created_at: nowIso_()
};
// R3: 送信スナップショット (本文・提示案件) をイベントにも残す (追補24)。
// シート側に body_snapshot / case_ids 列が無い環境では appendRow_ が黙って落とす。
if (extra && extra.body_snapshot) row.body_snapshot = extra.body_snapshot;
if (extra && extra.case_ids) row.case_ids = extra.case_ids;
// R4 S-02/S-11: 案件の写し JSON と冪等キーもイベントに残す (列が無い環境では appendRow_ が落とす)。
if (extra && extra.cases_snapshot) row.cases_snapshot = extra.cases_snapshot;
if (extra && extra.client_request_id) row.client_request_id = extra.client_request_id;
return appendRow_('applicant_events', row);
}

// ===== 認証 (ドメイン制限) =====
function currentUserEmail_() {
try { return String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();}
catch (e) { return '';}
}

/**
* 書き込み/送信系の必須チェック (DESIGN_V2 §3)。
* Session のメールが @kikari.co.jp で終わらなければ例外で拒否する。
* 画面側の制御には頼らず、サーバー側で必ずこれを通す。
*/
function requireKikariUser_() {
var email = currentUserEmail_();
if (!email || email.slice(-DOMAIN_SUFFIX.length)!== DOMAIN_SUFFIX) {
throw new Error('この操作は @kikari.co.jp のアカウントでのみ実行できます (現在: ' + (email || '未ログイン') + ')');
}
return email;
}

/** operators の1行を返す (無ければ null) */
function operatorByEmail_(email) {
var t = readTable_('operators');
var target = String(email || '').trim().toLowerCase();
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i].email || '').trim().toLowerCase() === target) return t.rows[i];
}
return null;
}

/** 送信 (配信作成) ができる人だけを通す: ドメイン認証 + operators.can_send=true */
function requireCanSend_() {
var email = requireKikariUser_();
var op = operatorByEmail_(email);
if (!op) throw new Error('operators に未登録のため送信できません: ' + email);
if (!toBool_(op.can_send)) throw new Error('このアカウントには送信権限 (can_send) がありません: ' + email);
return { email: email, operator: op};
}

/** settings テーブルの値を返す */
function getSettingValue_(key, defaultValue) {
var t = readTable_('settings');
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i].key) === key) {
var v = str_(t.rows[i].value);
return v === ''? (defaultValue || ''): v;
}
}
return defaultValue || '';
}

// ===== 【電話アポ】自動作成の設定とガード (追補23) =====
/** フォーム処理の実行アカウント (デプロイBではプロジェクトオーナー = 杉本) */
function effectiveUserEmail_() {
  try {
    var u = Session.getEffectiveUser();
    return String((u && u.getEmail()) || '').trim().toLowerCase();
  } catch (e) { return ''; }
}

/**
 * 運営者ごとの自動作成フラグ (operators.auto_calendar)。行が無い/列が空なら false。
 * 設定方法: 設定画面 (updateOperator の auto_calendar) または operators シートで切り替える。
 * 初期値: 杉本のみ ON、他の3人は OFF (init_sheets.gs の seed)。
 * 注意 (設定UI向け): ON にしても、フォーム処理の実行アカウントがその運営者本人でない限り
 * 自動作成は発火しない (tryAutoCreatePhoneAppointment_ のガード)。実行アカウントが杉本の間、
 * 他の運営者を ON にしても予定は作られない (杉本のカレンダーに他人の予定を混ぜないため)。
 */
function autoCalendarEnabledFor_(senderEmail) {
  var email = String(senderEmail || '').trim().toLowerCase();
  if (!email) return false;
  var op = null;
  try { op = operatorByEmail_(email); } catch (e) { op = null; }
  if (!op) return false;
  return toBool_(op.auto_calendar);
}

// ===== HTTP エントリポイント =====
function doGet(e) {
  try {
    var p = (e && e.parameter) || {};
    if (!p.action) {
      return appHtmlOutput_();
    }
    var req = {};
    Object.keys(p).forEach(function (k) { req[k] = p[k]; });
    if (p.payload) req = JSON.parse(p.payload);
    return jsonOut_({ ok: true, data: dispatch_(req) });
  } catch (err) {
    return jsonOut_({ ok: false, error: errMsg_(err) });
  }
}

function doPost(e) {
  try {
    var req = {};
    if (e && e.postData && e.postData.contents) req = JSON.parse(e.postData.contents);
    else if (e && e.parameter && e.parameter.payload) req = JSON.parse(e.parameter.payload);
    return jsonOut_({ ok: true, data: dispatch_(req || {}) });
  } catch (err) {
    return jsonOut_({ ok: false, error: errMsg_(err) });
  }
}

/** google.script.run 経由 (同一プロジェクトに画面を持たせる場合の互換入口) */
function apiCall(req) {
  try { return { ok: true, data: dispatch_(req || {}) }; }
  catch (err) { return { ok: false, error: errMsg_(err) }; }
}

// ===== 運営者フロントの HtmlService 配信 (ラウンド5) =====
// ドメイン制限デプロイへの cross-origin fetch は応答が CORS で読めないため、
// 運営者フロントはこのデプロイ自身の HtmlService で配信し、画面からの API は
// google.script.run の apiCall 経由にする。フロント本体は GitHub Pages の
// 公開HTMLを取得して配信する (取得元は下記 APP_FRONT_URL_)。
var APP_FRONT_URL_ = 'https://first-staffing.github.io/kansai-sms-app/';
// CacheService の1値上限 (100KB) に日本語3バイト換算でも収まる分割単位 (文字数)。
var APP_HTML_CHUNK_ = 25000;

/**
 * action 無し GET の応答: 運営者フロントHTMLを HtmlService で返す。
 * 実行アカウント固定デプロイ (フォーム/読み取り用) で開かれた場合は、
 * 開いた人とは別のアカウントで動作してしまうため、案内HTMLを返す。
 * 判定: アクティブユーザーと実効ユーザーのメールが両方そろっていて、
 * 大小文字を無視して異なる場合に、その固定デプロイとみなす。
 */
function appHtmlOutput_() {
  var activeEmail = '';
  var effectiveEmail = '';
  try { activeEmail = Session.getActiveUser().getEmail() || ''; } catch (e) {}
  try { effectiveEmail = Session.getEffectiveUser().getEmail() || ''; } catch (e2) {}
  if (activeEmail && effectiveEmail &&
      String(activeEmail).toLowerCase() !== String(effectiveEmail).toLowerCase()) {
    return HtmlService.createHtmlOutput(appWrongDeployHtml_());
  }
  return HtmlService.createHtmlOutput(fetchAppHtml_()).setTitle('応募者SMS・Gmail配信');
}

/**
 * フロントHTMLの取得。優先順位:
 * (a) 短期キャッシュ fh5_fresh_ (TTL 600秒)
 * (b) GitHub Pages から UrlFetch で取得 (200 のとき採用し、fresh/last 両方へ保存)
 * (c) 長期キャッシュ fh5_last_ (TTL 21600秒)
 * (d) フォールバックHTML
 */
function fetchAppHtml_() {
  var cache = null;
  try { cache = CacheService.getScriptCache(); } catch (e) { cache = null; }
  if (cache) {
    var fresh = readHtmlChunks_(cache, 'fh5_fresh_');
    if (fresh) return fresh;
  }
  var html = '';
  try {
    var res = UrlFetchApp.fetch(APP_FRONT_URL_, { muteHttpExceptions: true, followRedirects: true });
    if (res && res.getResponseCode() === 200) {
      html = res.getContentText('UTF-8') || '';
    }
  } catch (e2) { html = ''; }
  if (html) {
    if (cache) {
      try { writeHtmlChunks_(cache, 'fh5_fresh_', html, 600); } catch (e3) {}
      try { writeHtmlChunks_(cache, 'fh5_last_', html, 21600); } catch (e4) {}
    }
    return html;
  }
  if (cache) {
    var last = readHtmlChunks_(cache, 'fh5_last_');
    if (last) return last;
  }
  return appFallbackHtml_();
}

/**
 * prefix + 'meta' に記録されたチャンク数 (1から200の整数) に従い、
 * prefix + 0 .. n-1 を連結して返す。メタが無い/不正、チャンクが1つでも
 * 欠ける、例外が発生した場合は空文字を返す。
 */
function readHtmlChunks_(cache, prefix) {
  try {
    if (!cache) return '';
    var meta = cache.get(prefix + 'meta');
    if (meta === null || meta === undefined || meta === '') return '';
    var n = Number(meta);
    if (isNaN(n) || n < 1 || n > 200 || Math.floor(n) !== n) return '';
    var keys = [];
    for (var i = 0; i < n; i++) keys.push(prefix + String(i));
    var values = cache.getAll(keys) || {};
    var parts = [];
    for (var j = 0; j < n; j++) {
      var v = values[prefix + String(j)];
      if (v === null || v === undefined) return '';
      parts.push(String(v));
    }
    return parts.join('');
  } catch (e) {
    return '';
  }
}

/**
 * html を APP_HTML_CHUNK_ 文字ごとに分割して cache.putAll で書く。
 * 分割境界がサロゲートペアの途中 (高サロゲート) になる場合は1文字手前で切る。
 */
function writeHtmlChunks_(cache, prefix, html, ttlSec) {
  if (!cache || !html) return;
  var s = String(html);
  var chunks = [];
  var i = 0;
  while (i < s.length) {
    var end = Math.min(i + APP_HTML_CHUNK_, s.length);
    if (end < s.length) {
      var code = s.charCodeAt(end - 1);
      if (code >= 0xD800 && code <= 0xDBFF) end -= 1;
    }
    chunks.push(s.slice(i, end));
    i = end;
  }
  var values = {};
  values[prefix + 'meta'] = String(chunks.length);
  for (var j = 0; j < chunks.length; j++) {
    values[prefix + String(j)] = chunks[j];
  }
  cache.putAll(values, ttlSec);
}

/** フロントHTMLを取得できなかったときに配信する簡易HTML。 */
function appFallbackHtml_() {
  return '<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8">'
    + '<meta name="viewport" content="width=device-width, initial-scale=1">'
    + '<title>応募者SMS・Gmail配信</title></head><body>'
    + '<h1>画面を取得できませんでした</h1>'
    + '<p>運営者アプリの画面データの取得に失敗しました。通信環境を確認し、しばらく待ってからこのページを再読み込みしてください。</p>'
    + '<p>再読み込みしても表示されない場合は、公開ページから直接開けるかお試しください: '
    + '<a href="' + APP_FRONT_URL_ + '">' + APP_FRONT_URL_ + '</a></p>'
    + '</body></html>';
}

/** 実行アカウント固定デプロイで開かれたときに配信する案内HTML。 */
function appWrongDeployHtml_() {
  return '<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8">'
    + '<meta name="viewport" content="width=device-width, initial-scale=1">'
    + '<title>応募者SMS・Gmail配信</title></head><body>'
    + '<h1>このURLでは運営者アプリを開けません</h1>'
    + '<p>このURLは実行アカウントが固定されたデプロイ (フォーム/読み取り用) です。このまま開くと、開いたあなたとは別のアカウントで動作してしまいます。</p>'
    + '<p>運営者アプリは、管理者から案内された運営者用URLから開いてください。</p>'
    + '<p>公開ページ: <a href="' + APP_FRONT_URL_ + '">' + APP_FRONT_URL_ + '</a></p>'
    + '</body></html>';
}

function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
function errMsg_(err) { return String(err && err.message ? err.message : err); }

function dispatch_(req) {
  var action = String(req.action || '');
  switch (action) {
    // 疎通
    case 'ping': return actionPing_(req);
    // 応募者
    case 'searchApplicants': return actionSearchApplicants_(req);
    case 'getApplicantSummary': return actionGetApplicantSummary_(req);
    case 'getApplicant': return actionGetApplicant_(req);
    case 'updateWorkflow': return actionUpdateWorkflow_(req);
    case 'markSmsSent': return actionRecordSmsSent_(req);
    case 'recordSmsSent': return actionRecordSmsSent_(req);
    case 'importCommit': return actionImportCommit_(req);
    case 'importEnqueue': return actionImportEnqueue_(req);
    case 'importPreview': return actionImportPreview_(req); // R6.6 P1: プレビュー照合のサーバー側ドライラン
    case 'repairPhones': return actionRepairPhones_(req); // R6.6 P3(b): 電話の先頭0修復 (dry_run 付き)
    case 'repairArea': return actionRepairArea_(req); // R6.6 P4: area 未設定行の修復 (dry_run 付き)
    case 'getImportStatus': return actionGetImportStatus_(req);
    // 掘り起こし支援 (追補7)
    case 'recordContact': return actionRecordContact_(req);
    case 'setNextContact': return actionSetNextContact_(req);
    case 'getDigList': return actionGetDigList_(req);
    case 'getDigToday': return actionGetDigToday_(req);
    case 'getDigStats': return actionGetDigStats_(req);
    // ラウンド7: 特需・逆引き・掘り起こしビューのサーバー検索 (ページング)
    case 'searchSpecialCandidates': return actionSearchSpecialCandidates_(req);
    case 'searchReverseCandidates': return actionSearchReverseCandidates_(req);
    case 'getDigTodayList': return actionGetDigTodayList_(req);
    case 'getDigSegment': return actionGetDigSegment_(req);
    case 'getApplicantActivity': return actionGetApplicantActivity_(req);
    // 案件
    case 'getCases': return actionSearchCases_(req);
    case 'searchCases': return actionSearchCases_(req);
    case 'recommendForApplicants': return actionRecommendForApplicants_(req);
    // 案件マスター同期 (追補14: 案件アプリ連携のサーバー側)
    case 'getCaseMaster': return actionGetCaseMaster_(req);
    case 'getCaseSourceKeys': return actionGetCaseSourceKeys_(req);
    case 'pushCaseFromSms': return actionPushCaseFromSms_(req);
    case 'pushCasesFromAiPage': return actionPushCasesFromAiPage_(req);
    case 'getCaseSyncStatus': return actionGetCaseSyncStatus_(req);
    case 'runCaseIntegrityCheck': return actionRunCaseIntegrityCheck_(req);
    // 新着案件マッチ提案 (革新5)。生成・取得・状態更新のみで、送信は一切しない。
    case 'buildMatchProposals': return actionBuildMatchProposals_(req);
    case 'getMatchProposals': return actionGetMatchProposals_(req);
    case 'getCaseProposals': return actionGetMatchProposals_(req);
    case 'updateMatchProposalStatus': return actionUpdateMatchProposalStatus_(req);
    case 'updateCaseProposalStatus': return actionUpdateMatchProposalStatus_(req);
    // Gmail 配信
    case 'mailPreviewTargets': return actionMailPreviewTargets_(req);
    case 'mailCreateDelivery': return actionMailCreateDelivery_(req);
    case 'mailPreviewBody': return actionMailPreviewBody_(req);
    case 'processSendQueue': return processSendQueue();
    case 'getSendQueueStats': return actionGetSendQueueStats_(req);
    case 'sendNextBatch': return actionSendNextBatch_(req);
    // 回答フォーム / 回答一覧
    case 'submitResponse': return actionSubmitResponse_(req);
    case 'getFormContext': return actionGetFormContext_(req);
    case 'getResponses': return actionGetResponses_(req);
    case 'markResponseHandled': return actionMarkResponseHandled_(req);
    case 'setResponseStatus': return actionSetResponseStatus_(req);
    case 'assignResponseSender': return actionAssignResponseSender_(req);
    case 'resendResponseNotification': return actionResendResponseNotification_(req);
    case 'repairSnapshots': return actionRepairSnapshots_(req);
    case 'getResponseSummary': return actionGetResponseSummary_(req);
    case 'createPhoneAppointment': return actionCreatePhoneAppointment_(req);
    case 'issueFormToken': return actionIssueFormToken_(req);
    case 'relayPullNow': return relayPullNowAction_(req);
    case 'relayPushDelivery': return relayPushDeliveryAction_(req);
    // 設定
    case 'getOperators': return actionGetOperators_(req);
    case 'updateOperator': return actionUpdateOperator_(req);
    case 'getTemplates': return actionGetTemplates_(req);
    case 'updateTemplate': return actionUpdateTemplate_(req);
    case 'registerOptout': return actionRegisterOptout_(req);
    default: throw new Error('不明な action: ' + action);
  }
}

/** 疎通確認。実行者メールを返す (デプロイAでは自分の @kikari.co.jp が返るはず) */
function actionPing_() {
  var email = '';
  try { email = Session.getActiveUser().getEmail() || ''; } catch (e) {}
  // R3: 運営者の初回 API 利用時に送信トリガーの自動設置を試みる (ベストエフォート)。
  var trig = null;
  try { trig = maybeInstallSendTrigger_(); } catch (e) {}
  // R4 S-05: 定義 (TABLE_DEFS_) と実シートのヘッダーの突き合わせ結果も返す。
  // 列が無い環境では保存が無言で落ちるため、画面に常時警告を出すための検出。
  var schema = null;
  try { schema = schemaCheck_(); } catch (eS) { schema = null; }
  return { pong: true, time: nowIso_(), activeUserEmail: email, trigger_auto: trig, schema: schema };
}

/**
 * R4 S-05: TABLE_DEFS_ の headers と実シート1行目を比較し、不足列を返す。
 * スナップショット必須列は critical として区別する (保存が無言で落ちる列)。
 */
var SCHEMA_CRITICAL_COLS_ = {
  applicant_events: ['body_snapshot', 'case_ids', 'cases_snapshot', 'client_request_id'],
  delivery_recipients: ['cases_snapshot', 'body_snapshot', 'snapshot_finalized'],
  responses: ['notify_status', 'imported_at'],
  operators: ['handover_email']
};
function schemaCheck_() {
  var missing = [];
  Object.keys(TABLE_DEFS_).forEach(function (name) {
    var def = TABLE_DEFS_[name];
    var actual = [];
    try {
      var sheet = sheet_(name);
      if (sheet && sheet.getLastColumn() > 0) {
        actual = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(function (v) { return String(v || '').trim(); });
      }
    } catch (e) { actual = []; }
    var crit = SCHEMA_CRITICAL_COLS_[name] || [];
    def.headers.forEach(function (h) {
      if (actual.indexOf(h) < 0) missing.push({ table: name, column: h, critical: crit.indexOf(h) >= 0 });
    });
  });
  return { ok: missing.length === 0, missing: missing };
}

/**
 * R4 S-04: スナップショット再処理。status='sent' かつ未確定 (snapshot_finalized!=1) の
 * 受信者行について、送信時と同じ組み立てで実文を再生成して確定させる。冪等
 * (確定済みの行は触らない)。署名は operators の現在値で再構成されるため、送信後に
 * 署名が変わっていると完全一致しない可能性がある — 再処理した行は event で区別する。
 */
function actionRepairSnapshots_(req) {
  var me = requireKikariUser_();
  var limit = Math.min(Math.max(parseInt((req && req.limit) || 200, 10) || 200, 1), 1000);
  var repaired = 0, stillFailed = 0, scanned = 0;
  var recs = readTable_('delivery_recipients').rows;
  var delivById = {};
  readTable_('deliveries').rows.forEach(function (d) { delivById[String(d.delivery_id)] = d; });
  for (var i = 0; i < recs.length && repaired + stillFailed < limit; i++) {
    var r = recs[i];
    if (String(r.status) !== 'sent') continue;
    if (toBool_(r.snapshot_finalized)) continue;
    scanned++;
    try {
      var deliv = delivById[String(r.delivery_id)];
      if (!deliv) { stillFailed++; continue; }
      var app2 = null;
      try { app2 = findApplicant_(String(r.applicant_id)); } catch (eA) { app2 = null; }
      if (!app2) { stillFailed++; continue; }
      var recIds = toList_(r.recommended_case_ids);
      var casesById = {};
      openCases_().forEach(function (c) { casesById[String(c.case_id)] = c; });
      var recs2 = recIds.map(function (id) { return casesById[String(id)]; }).filter(Boolean);
      var opRow = null;
      try { opRow = operatorByEmail_(String(deliv.sender_email)); } catch (eO) { opRow = null; }
      var body = buildMailBody_(deliv, app2, recs2, {
        senderName: str_(deliv.sender_name), operator: opRow || undefined,
        formUrl: str_(r.form_token) ? formUrlForToken_(str_(r.form_token)) : '',
        optoutUrl: optoutUrlForApplicant_(app2)
      });
      var patch = { body_snapshot: snapshotBody_(body), snapshot_finalized: 1 };
      if (!str_(r.cases_snapshot)) patch.cases_snapshot = buildCasesSnapshot_(recIds);
      updateRecipientStatus_(String(r.delivery_id), String(r.applicant_id), patch);
      try {
        appendEvent_(String(r.applicant_id), 'snapshot_repaired', me,
          'スナップショット再処理で確定 ' + String(r.delivery_id), String(r.delivery_id), '');
      } catch (eEv) {}
      repaired++;
    } catch (eR) { stillFailed++; }
  }
  return { repaired: repaired, still_failed: stillFailed, scanned: scanned };
}

// ===== CSVステータスの段階 (追補18・補正2: 本流8段 + 終了/例外系の二層モデル) =====
/**
 * 正本: 現行 source/kansai-sms/web/applicant-profile-shared.js の status()。
 * 表記ゆれ正規化 (NFKC -> trim -> 空白除去 -> 大文字化) と寄せの順序
 * (完全一致 -> NG系 -> 正規表現) は正本どおりに写し、順位は確定した本流8段へ写像する:
 *   1 接触待ち / 2 誘致待ち / 3 アテンド待ち / 4 FIX待ち / 5 実施待ち (職見待ちは同段)
 *   6 内定待ち / 7 入職待ち / 8 稼働中
 * 正規表現の寄せの写像: 接触系->1 (接触待ち段)、誘致済み系->3 (アテンド待ち段)、
 *   アテンド系->4 (FIX待ち段)、FIX系->5 (実施待ち段)、内定系->7 (入職待ち段)、
 *   稼働済み系->8 (稼働中段)。誘致待ち/誘致待->2。
 * 譲渡・不通・対象外・他社決定・登録辞退・応募除外・NG系・退職済み は本流の外 (終了/例外系):
 *   stage=0・inFlow=false・terminal=true とし、「最も進んだ状況」の計算には算入しない
 *   (退職済み は正本 status() には無いが、補足指示の終了/例外系の例示に従い terminal 扱い)。
 * 戻り値: { label: 正規化ラベル, stage: 1-8 (本流外は0), stageLabel: 段名 (本流外は''),
 *           inFlow: 本流内か, terminal: 終了/例外系か }
 */
var CSV_STAGE_NAMES_ = ['', '接触待ち', '誘致待ち', 'アテンド待ち', 'FIX待ち', '実施待ち', '内定待ち', '入職待ち', '稼働中'];
function csvStageRank_(raw) {
  var s = str_(raw).normalize('NFKC').trim().replace(/\s/g, '').toUpperCase();
  if (!s) return { label: '', stage: 0, stageLabel: '', inFlow: false, terminal: false };
  function flow_(label, stage) { return { label: label, stage: stage, stageLabel: CSV_STAGE_NAMES_[stage], inFlow: true, terminal: false }; }
  function term_(label) { return { label: label, stage: 0, stageLabel: '', inFlow: false, terminal: true }; }
  // 完全一致 (正本 stages 表のうち本流内)
  var flowExact = { '接触待ち': 1, '誘致待ち': 2, 'アテンド待ち': 3, 'FIX待ち': 4, '職見待ち': 5, '実施待ち': 5, '内定待ち': 6, '入職待ち': 7, '稼働中': 8 };
  if (Object.prototype.hasOwnProperty.call(flowExact, s)) return flow_(s, flowExact[s]);
  // 完全一致 (終了/例外系)
  if (s === '対象外' || s === '応募除外' || s === '登録辞退' || s === '他社決定' || s === '不通' || s === '譲渡済み' || s === '譲渡' || s === '退職済み') return term_(s);
  // NG系 (正本: NG|キャンセル|辞退|終了|不採用 を含む。ラベルは 接触NG/誘致NG/選考NG) は終了/例外系
  if (/NG|キャンセル|辞退|終了|不採用/.test(s)) {
    return term_(/接触/.test(s) ? '接触NG' : (/誘致/.test(s) ? '誘致NG' : '選考NG'));
  }
  // 正規表現の寄せ (正本の並び順どおり) -> 本流8段へ写像
  if (/^(稼働済み|稼働中|入職済み|就業中|就業開始)$/.test(s)) return flow_('稼働済み', 8);
  if (/^(内定|内定済み|入職予定)$/.test(s)) return flow_('内定', 7);
  if (/^(FIX|FIX済み|FIX済)$/.test(s)) return flow_('FIX済み', 5);
  if (/^(アテンド|アテンド済み|アテンド済)$/.test(s)) return flow_('アテンド済み', 4);
  if (/^(誘致済み|誘致済)$/.test(s)) return flow_('誘致済み', 3);
  if (/^(誘致待ち|誘致待|アテンド待ち)$/.test(s)) return flow_('誘致待ち', 2);
  if (/^(接触|接触済み|接触済|連絡済み)$/.test(s)) return flow_('接触', 1);
  return { label: s, stage: 0, stageLabel: '', inFlow: false, terminal: false };
}

/**
 * 複数応募から「最も進んだ状況」(本流到達点 furthest) と「現在終了状態 terminal」を
 * 別々に返す二層モデル。正本 summarize() と同じく、会社 (normalizeCompany_ で正規化)
 * ごとに最初の応募だけを判定対象にする。終了/例外系は furthest に算入せず、
 * terminal として (ステータス・会社・日付) を返す (複数あれば日付が最新のもの)。
 * rows: [{ status|sourceStatus|csv_status, company|source_company, date|applied_at }]
 */
function csvStageSummary_(rows) {
  var seen = {}, best = null, terminals = [];
  (rows || []).forEach(function (r) {
    var rawStatus = (r.status != null && r.status !== '') ? r.status
      : ((r.sourceStatus != null && r.sourceStatus !== '') ? r.sourceStatus : r.csv_status);
    if (rawStatus == null || str_(rawStatus) === '') return;
    var company = str_(r.company || r.source_company || '');
    var key = normalizeCompany_(company);
    if (seen[key]) return;
    seen[key] = true;
    var st = csvStageRank_(rawStatus);
    var date = str_(r.date || r.applied_at || '');
    if (st.inFlow) {
      if (!best || st.stage > best.stage) {
        best = { label: st.label, stage: st.stage, stageLabel: st.stageLabel, company: company, date: date };
      }
    } else if (st.terminal) {
      terminals.push({ label: st.label, company: company, date: date });
    }
  });
  var terminal = null;
  terminals.forEach(function (t) { if (!terminal || t.date > terminal.date) terminal = t; });
  return {
    furthest: best || { label: '', stage: 0, stageLabel: '', company: '', date: '' },
    terminal: terminal
  };
}

// ===== 横断ブレーキ用データ (革新3, INNOVATION.md §3) =====
/** operators の email -> 表示名。解決できない actor はメールを出さず「他の担当」と表示する */
function operatorNameMap_() {
  var map = {};
  try {
    readTable_('operators').rows.forEach(function (o) {
      var em = str_(o.email).trim().toLowerCase();
      if (em) map[em] = str_(o.display_name) || em;
    });
  } catch (e) {}
  return map;
}
function actorDisplayName_(email, nameMap) {
  var em = str_(email).trim().toLowerCase();
  if (!em) return '';
  return (nameMap && nameMap[em]) || '他の担当';
}

/**
 * 一覧取得時に1回だけ作る活動コンテキスト (行ごとの全件走査をしない)。
 * 原材料は既存の3テーブルだけ: applicant_events / delivery_recipients+deliveries / responses。
 * 新しい記録の仕組みは作らない (導出のみ)。
 */
function activityContext_() {
  var ctx = { byApplicant: {}, names: operatorNameMap_(), deliveries: {} };
  try {
    readTable_('deliveries').rows.forEach(function (d) { ctx.deliveries[str_(d.delivery_id)] = d; });
  } catch (e) {}
  function slot_(id) {
    if (!ctx.byApplicant[id]) ctx.byApplicant[id] = { last_touch: null, last_send: null, open_response: null, sends: [] };
    return ctx.byApplicant[id];
  }
  try {
    readTable_('delivery_recipients').rows.forEach(function (r) {
      var at = cellDateIso_(r.sent_at) || cellDateIso_(r.updated_at) || cellDateIso_(r.created_at);
      if (!at) return;
      var d = ctx.deliveries[str_(r.delivery_id)] || {};
      var channel = '';
      try {
        var fj = JSON.parse(str_(d.filter_json) || '{}');
        if (fj && fj.form_invite && fj.channel) channel = String(fj.channel);
      } catch (e) {}
      var send = { sender_email: str_(d.sender_email), sender_name: str_(d.sender_name),
        at: at, channel: channel || 'mail', delivery_id: str_(r.delivery_id) };
      var s = slot_(str_(r.applicant_id));
      if (str_(r.status) === 'sent' || str_(r.sent_at)) {
        if (!s.last_send || send.at > s.last_send.at) s.last_send = send;
        s.sends.push(send);
      }
      if (!s.last_touch || at > s.last_touch.at) {
        s.last_touch = { actor_email: send.sender_email, actor_name: send.sender_name,
          type: channel === 'sms' ? 'sms_sent' : 'mail_sent', at: at, channel: send.channel };
      }
    });
  } catch (e) {}
  try {
    readTable_('applicant_events').rows.forEach(function (ev) {
      var at = cellDateIso_(ev.created_at);
      if (!at) return;
      var s = slot_(str_(ev.applicant_id));
      var touch = { actor_email: str_(ev.actor), actor_name: '', type: str_(ev.event_type),
        at: at, channel: str_(ev.event_type) === 'sms_sent' ? 'sms' : (str_(ev.event_type) === 'mail_sent' ? 'mail' : '') };
      if (!s.last_touch || at > s.last_touch.at) s.last_touch = touch;
      if (touch.type === 'sms_sent' || touch.type === 'mail_sent') {
        var send = { sender_email: touch.actor_email, sender_name: '', at: at,
          channel: touch.channel, delivery_id: str_(ev.delivery_id) };
        if (!s.last_send || at > s.last_send.at) s.last_send = send;
      }
    });
  } catch (e) {}
  try {
    readTable_('responses').rows.forEach(function (r) {
      if (responseStatus_(r) === 'handled') return;
      var s = slot_(str_(r.applicant_id));
      var open = { response_id: str_(r.response_id), status: responseStatus_(r),
        status_by: str_(r.status_by), sender_email: str_(r.sender_email),
        intent: str_(r.intent), created_at: cellDateIso_(r.created_at) };
      if (!s.open_response || open.created_at < s.open_response.created_at) s.open_response = open;
    });
  } catch (e) {}
  return ctx;
}

/** ブレーキ判定 (INNOVATION.md §3.4): 自分の記録は対象にしない */
function brakeForActivity_(act, applicantRow, meEmail, nowMs) {
  var me = str_(meEmail).trim().toLowerCase();
  function isOther(email) { var em = str_(email).trim().toLowerCase(); return !!em && em !== me && em !== 'system'; }
  if (act && act.open_response && act.open_response.status === 'in_progress' &&
      isOther(act.open_response.status_by)) {
    return { level: 'strong', reason: 'in_progress_other',
      actor_email: act.open_response.status_by, at: act.open_response.created_at };
  }
  var ref = (act && act.last_send) || (act && act.last_touch);
  if (ref && isOther(ref.sender_email || ref.actor_email) && ref.at) {
    var ageMs = nowMs - new Date(ref.at).getTime();
    if (isFinite(ageMs) && ageMs >= 0) {
      if (ageMs <= BRAKE_STRONG_HOURS * 3600000) return { level: 'strong', reason: 'sent_within_72h', actor_email: ref.sender_email || ref.actor_email, at: ref.at };
      if (ageMs <= BRAKE_WEAK_DAYS * 86400000) return { level: 'weak', reason: 'contact_within_7d', actor_email: ref.sender_email || ref.actor_email, at: ref.at };
      if (ageMs <= BRAKE_DETAIL_DAYS * 86400000) return { level: 'detail', reason: 'contact_within_14d', actor_email: ref.sender_email || ref.actor_email, at: ref.at };
    }
  }
  return { level: 'none', reason: '', actor_email: '', at: '' };
}

/** 人単位の活動サマリ (一覧の軽量版と getApplicantActivity の共通形) */
function activityForApplicant_(applicantId, ctx, applicantRow) {
  ctx = ctx || activityContext_();
  var act = ctx.byApplicant[String(applicantId)] || { last_touch: null, last_send: null, open_response: null, sends: [] };
  var me = '';
  try { me = currentUserEmail_(); } catch (e) {}
  var nowMs = new Date().getTime();
  function named_(o, emailKey) {
    if (!o) return null;
    var out = {}; Object.keys(o).forEach(function (k) { out[k] = o[k]; });
    var em = str_(o[emailKey]);
    out.actor_name = em === 'system' ? '' : actorDisplayName_(em, ctx.names);
    if (emailKey === 'sender_email') out.sender_name = out.actor_name;
    return out;
  }
  var brake = brakeForActivity_(act, applicantRow, me, nowMs);
  brake.actor_name = brake.actor_email ? actorDisplayName_(brake.actor_email, ctx.names) : '';
  var recentSenders = [], seenSender = {};
  (act.sends || []).filter(function (s) { return s.at && (nowMs - new Date(s.at).getTime()) <= BRAKE_DETAIL_DAYS * 86400000; })
    .sort(function (a, b) { return a.at < b.at ? 1 : -1; })
    .forEach(function (s) {
      var em = str_(s.sender_email).trim().toLowerCase();
      if (!em || seenSender[em]) return;
      seenSender[em] = true;
      recentSenders.push({ sender_email: em, sender_name: actorDisplayName_(em, ctx.names), last_at: s.at });
    });
  return {
    last_touch: named_(act.last_touch, 'actor_email'),
    last_send: named_(act.last_send, 'sender_email'),
    open_response: act.open_response,
    in_progress_by: (act.open_response && act.open_response.status === 'in_progress') ? act.open_response.status_by : '',
    next_contact_date: applicantRow ? cellDateYmd_(applicantRow.next_contact_date) : '',
    last_contact_at: applicantRow ? cellDateIso_(applicantRow.last_contact_at) : '',
    recent_senders: recentSenders,
    brake: brake
  };
}

/** getApplicantActivity (読み取り専用・革新3の読み取り口) */
function actionGetApplicantActivity_(req) {
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  var row = null;
  try { row = findApplicant_(req.applicant_id); } catch (e) { row = null; }
  var act = activityForApplicant_(String(req.applicant_id), activityContext_(), row);
  return { applicant_id: String(req.applicant_id), last_touch: act.last_touch, last_send: act.last_send,
    open_response: act.open_response, recent_senders: act.recent_senders, brake: act.brake,
    next_contact_date: act.next_contact_date, last_contact_at: act.last_contact_at };
}

// ===== 応募者: 一覧用整形 (電話・メールは返さない) =====
function applicantListItem_(r, activity) {
  var csvStage = csvStageRank_(r.csv_status);  // 追補18・補正2: 本流8段の正規化ラベル/段と終了系フラグ
  var item = {
    applicant_id: str_(r.applicant_id),
    area: str_(r.area),
    name: str_(r.name),
    surname: str_(r.surname),
    birth_date: cellDateYmd_(r.birth_date),
    age: ageFromBirth_(r.birth_date),
    prefecture: str_(r.prefecture),
    municipality: str_(r.municipality),
    nearest_station: str_(r.nearest_station),
    lat: toNum_(r.lat),
    lon: toNum_(r.lon),
    job_type: str_(r.job_type),
    qualifications: str_(r.qualifications),
    experience_years: toNum_(r.experience_years),
    desired_days_per_week: str_(r.desired_days_per_week),
    desired_time_slots: str_(r.desired_time_slots),
    source_company: str_(r.source_company),
    applied_at: cellDateIso_(r.applied_at),
    csv_status: str_(r.csv_status),
    csv_stage_label: csvStage.label,
    csv_stage: csvStage.stage,
    csv_stage_name: csvStage.stageLabel,
    csv_terminal: csvStage.terminal,
    app_status: str_(r.app_status),
    sms_sent: toBool_(r.sms_sent),
    sms_last_sent_at: cellDateIso_(r.sms_last_sent_at),
    mail_optout: toBool_(r.mail_optout),
    is_active_target: toBool_(r.is_active_target),
    desired_start_date: cellDateYmd_(r.desired_start_date),
    last_contact_at: cellDateIso_(r.last_contact_at),       // 追補7
    next_contact_date: cellDateYmd_(r.next_contact_date),    // 追補7
    has_fs_history: hasFsHistory_(r),                        // 追補17: 永続フィールドが正
    has_past_fs: hasFsHistory_(r),                            // 追補7の旧キー (互換。同値)
    is_test: isTestApplicant_(r)                             // 追補22: テスト求職者フラグ (バッジ表示用)
  };
  // 革新3: 呼び出し側が活動コンテキストから付けた場合だけ軽量 activity を加算する
  // (単体呼び出しでは従来形のまま。電話・メールは従来どおり含めない)。
  if (activity) {
    item.activity = {
      last_actor_name: activity.last_touch ? (activity.last_touch.actor_name || '') : '',
      last_type: activity.last_touch ? activity.last_touch.type : '',
      last_at: activity.last_touch ? activity.last_touch.at : '',
      last_send: activity.last_send,
      open_response_status: activity.open_response ? activity.open_response.status : '',
      in_progress_by: activity.in_progress_by || '',
      brake: activity.brake
    };
  }
  return item;
}

function ageFromBirth_(v) {
  var ymd = cellDateYmd_(v);
  if (!ymd) return null;
  var b = new Date(ymd + 'T00:00:00+09:00');
  if (isNaN(b.getTime())) return null;
  var now = new Date();
  var age = now.getFullYear() - b.getFullYear();
  var m = now.getMonth() - b.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
  return age;
}

/**
 * ファーストスタッフィング登録歴フラグ (追補7 -> 追補17で永続化)。
 * 正は applicants.has_fs_history (永続フィールド, bool) であり、掘り起こしタブ・
 * 一覧検索・Gmail対象条件・SMSセグメントの絞り込みはすべてこのフィールドを参照する。
 * 定義: 取り込み時に、会社正規化 (normalizeCompany_) 後の応募履歴 (全CSVの応募 +
 * ファースト親データ突合で得た応募歴) の中に canonical=ファーストスタッフィング の
 * 応募が1件でもあれば true。一度 true になったら再取り込み・上書き更新でも
 * false に戻さない (履歴が増えることはあっても登録歴が消えることはないため)。
 * 応募履歴そのものは (a) applicants.source_company (最新の応募元) と
 * (b) hearing_json 内の history (過去の応募履歴。例: {"history":[{company, applied_at}, ...]}
 *     または import 時に hearing_json へマージされる会社名) で保持する。
 * applicant_events の import イベント detail にも会社名が残るが、全件走査は重いため
 * 導出は applicants 行内 (source_company + hearing_json) で完結させる。
 */
var FS_COMPANY = 'ファーストスタッフィング';
/** 会社名 (原文) の canonical がファーストスタッフィングか */
function isFsCompany_(company) {
  return normalizeCompany_(company) === FS_COMPANY;
}
/**
 * history からの導出 (フォールバック専用)。
 * source_company と hearing_json.history の各 company を正規化して canonical 比較する。
 * hearing_json が構造化されていない旧データ向けに、文字列としての含有チェックも残す。
 */
function deriveFsHistory_(r) {
  if (isFsCompany_(r.source_company)) return true;
  var hj = str_(r.hearing_json);
  if (!hj) return false;
  try {
    var parsed = JSON.parse(hj);
    var history = (parsed && parsed.history) || [];
    if (Object.prototype.toString.call(history) === '[object Array]') {
      for (var i = 0; i < history.length; i++) {
        var h = history[i];
        var co = (h && typeof h === 'object') ? (h.company || h.source_company || h.name || '') : h;
        if (isFsCompany_(co)) return true;
      }
    }
  } catch (e) { /* JSONでない旧 hearing_json は下の文字列チェックで拾う */ }
  return hj.indexOf(FS_COMPANY) >= 0;
}
/**
 * 登録歴フラグの正 (追補17)。
 * has_fs_history フィールドが入っている行はフィールドを正とする (明示 false も尊重する)。
 * フィールドが空 (未設定) の旧レコードだけ、history からの導出にフォールバックする。
 */
function hasFsHistory_(r) {
  var v = r ? r.has_fs_history : undefined;
  if (v !== undefined && v !== null && v !== '') return toBool_(v);
  return deriveFsHistory_(r || {});
}
/** 旧名の互換エイリアス (値は has_fs_history フィールド基準) */
function hasPastFs_(r) { return hasFsHistory_(r); }
/**
 * 親データ突合からフラグを立てる入口 (追補17)。
 * ステージング取り込みや将来のファースト親データ照合が、突合で得た
 * applicant_id の配列を渡して呼ぶ想定。true を立てるだけで、false には戻さない。
 * 書き込み系の文脈 (withLock_ 取得中) から呼ぶこと。存在しない ID は落とさず not_found に返す。
 * @param {Array} applicantIds applicant_id の配列
 * @param {string} [actor] applicant_events に残す実行者 (既定 'system')
 * @return {{marked:number, already:number, not_found:Array, total:number}}
 */
function markFsHistoryFromParent_(applicantIds, actor) {
  var ids = toList_(applicantIds);
  var seen = {}, marked = 0, already = 0, notFound = [];
  ids.forEach(function (id) {
    if (seen[id]) return;
    seen[id] = true;
    var row = null;
    try { row = findApplicant_(id); } catch (e) { row = null; }
    if (!row) { notFound.push(id); return; }
    if (toBool_(row.has_fs_history)) { already++; return; }
    updateRowByPk_('applicants', id, { has_fs_history: true, updated_at: nowIso_() });
    appendEvent_(id, 'import', actor || 'system',
      'ファーストスタッフィング登録歴あり (親データ突合でフラグ永続化)', '', '');
    marked++;
  });
  return { marked: marked, already: already, not_found: notFound, total: Object.keys(seen).length };
}

// ===== 会社名の正規化 (DATA_MODEL §11 / LIVE §3) =====
// 短縮名 -> 正式名 (canonical) の対応表。companies マスターの variants が正だが、
// マスター未投入でも効くよう主要な短縮名はコード側にも持つ。
var COMPANY_SHORT_MAP_ = {
  'カナミック': 'カナミックネットワーク',
  'ファーストスタッフィング': 'ファーストスタッフィング',
  'グローバルヒューマンブリッジ': 'グローバルヒューマンブリッジ',
  'ジョブコレ大阪': 'ジョブコレ大阪',
  'FIDIASOLUTIONS': 'FIDIA SOLUTIONS',
  'FIDIA SOLUTIONS': 'FIDIA SOLUTIONS'
};
var companyCanonicalCache_ = null;
function companyVariantMap_() {
  if (companyCanonicalCache_) return companyCanonicalCache_;
  var map = {};
  Object.keys(COMPANY_SHORT_MAP_).forEach(function (k) { map[k] = COMPANY_SHORT_MAP_[k]; });
  try {
    readTable_('companies').rows.forEach(function (r) {
      var canonical = str_(r.canonical).trim();
      if (!canonical) return;
      map[canonical] = canonical;
      toList_(r.variants).forEach(function (v) { map[v] = canonical; });
    });
  } catch (e) { /* companies シート未作成時はコード側マップのみで動く */ }
  companyCanonicalCache_ = map;
  return map;
}
/**
 * 会社名を canonical (正規化名) に寄せる。原文は保持せず変換結果だけを返す純関数寄りヘルパー。
 * ルール: 全角/半角・空白正規化 -> 法人格 (株式会社/有限会社等) 除去 ->
 * (数字)・-コピー等のサフィックス除去 -> 短縮名マッピング (companies マスター + コード側表)。
 */
function normalizeCompany_(name) {
  var s = str_(name).trim();
  if (!s) return '';
  // 全角英数 -> 半角, 空白正規化
  s = s.replace(/[\uFF01-\uFF5E]/g, function (ch) { return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0); });
  s = s.replace(/\s+/g, ' ').trim();
  // サフィックス除去: (数字) / -コピー / コピー (末尾)
  s = s.replace(/\(\d+\)\s*$/, '').replace(/[-\u30FC]?コピー\s*$/, '').trim();
  // 法人格の除去 (接頭辞・接尾辞とも)
  s = s.replace(/^(株式会社|有限会社|合同会社|合資会社|合名会社)\s*/, '');
  s = s.replace(/\s*(株式会社|有限会社|合同会社|合資会社|合名会社)$/, '');
  s = s.replace(/\s+/g, ' ').trim();
  var map = companyVariantMap_();
  if (map[s]) return map[s];
  // 空白ゆれ (FIDIA SOLUTIONS 等) もマップで拾う
  var noSpace = s.replace(/ /g, '');
  if (map[noSpace]) return map[noSpace];
  return s;
}
function sameCompany_(a, b) { return normalizeCompany_(a) !== '' && normalizeCompany_(a) === normalizeCompany_(b); }

/** テスト求職者か (追補22)。is_test=true の行だけがテスト対象。本番データと混ぜないための唯一の判定点 */
function isTestApplicant_(r) { return !!r && toBool_(r.is_test); }

/** テスト送信の固定宛先 (追補22)。settings.test_send_email があればそれ、無ければ既定の固定宛先 */
function testSendEmail_() {
  try { return getSettingValue_('test_send_email', TEST_SEND_EMAIL) || TEST_SEND_EMAIL; }
  catch (e) { return TEST_SEND_EMAIL; }
}

/**
 * テスト求職者を冪等に投入する初期化関数 (追補22。要ドメイン認証・実送信はしない)。
 * - 既に同じ電話番号の行があれば、その行に is_test=true を立てるだけ (重複投入しない)。
 * - 座標は municipalities マスター (大阪府 / 大阪市中央区) の代表点を引けた場合だけ入れる。
 *   マスターに代表点が無い場合は座標なし (lat/lon 空) + 市区町村のみとし、推測座標は入れない。
 * - 求職者側メールはテスト送信先とは別物なので空にする (テスト送信先は settings.test_send_email 側で持つ)。
 * 実行方法: デプロイ後に運営者が Apps Script エディタから seedTestApplicant_ を1回実行する。
 */
function seedTestApplicant_() {
  var me = requireKikariUser_();
  return withLock_(function () {
    var t = readTable_('applicants');
    for (var i = 0; i < t.rows.length; i++) {
      if (normalizePhoneDigits_(t.rows[i].phone) === TEST_APPLICANT_PHONE) {
        if (!isTestApplicant_(t.rows[i])) {
          updateRowByPk_('applicants', t.rows[i].applicant_id, { is_test: true, updated_at: nowIso_() });
        }
        return { seeded: false, already_exists: true, applicant_id: str_(t.rows[i].applicant_id), is_test: true };
      }
    }
    var lat = '', lon = '';
    try {
      var munis = readTable_('municipalities').rows;
      for (var j = 0; j < munis.length; j++) {
        if (str_(munis[j].prefecture) === TEST_APPLICANT_PREFECTURE &&
            str_(munis[j].municipality) === TEST_APPLICANT_MUNICIPALITY) {
          // R4 I-3: 代表点にも基本チェックを通す (無効なら座標なし)。
          var repChk = coordBasicCheck_(munis[j].lat, munis[j].lon);
          if (repChk.state === 'ok') { lat = repChk.lat; lon = repChk.lon; }
          break;
        }
      }
    } catch (e) { lat = ''; lon = ''; /* municipalities 未作成時は座標なしで投入する */ }
    var now = nowIso_();
    var row = {
      applicant_id: nextId_('applicants'), area: 'kansai',
      name: TEST_APPLICANT_NAME, name_raw: TEST_APPLICANT_NAME, surname: '杉本',
      phone: TEST_APPLICANT_PHONE, email: '', birth_date: '', postal_code: '',
      prefecture: TEST_APPLICANT_PREFECTURE, municipality: TEST_APPLICANT_MUNICIPALITY,
      address_rest: TEST_APPLICANT_ADDRESS_REST, nearest_station: '', lat: lat, lon: lon,
      job_type: TEST_APPLICANT_JOB_TYPE, qualifications: '', experience_years: '',
      desired_days_per_week: '', desired_time_slots: '', desired_start_date: '',
      source_company: '', applied_at: now, csv_status: '未対応', app_status: '',
      sms_sent: false, sms_last_sent_at: '', mail_optout: false, is_active_target: false,
      has_fs_history: false, hearing_json: '', import_batch_id: '',
      last_contact_at: '', next_contact_date: '', created_at: now, updated_at: now, is_test: true
    };
    appendRow_('applicants', row);
    appendEvent_(row.applicant_id, 'note', me, 'テスト求職者を登録 (追補22: E2E確認専用・通常集計/配信から除外)', '', '');
    return { seeded: true, already_exists: false, applicant_id: row.applicant_id, is_test: true,
      lat: row.lat, lon: row.lon, coord_note: (lat === '' ? '代表点が引けなかったため座標なし (市区町村のみ)' : 'municipalities 代表点を使用') };
  });
}

// ===== 応募者: 絞り込み (searchApplicants / mailPreviewTargets 共用) =====
/**
 * filter のキー:
 *  keyword (氏名 部分一致), phone (電話 部分一致), area, prefecture,
 *  prefectures (配列 or カンマ区切り: 複数都道府県。単一 prefecture と併用した場合は両方を満たす AND),
 *  desired_keyword (希望条件キーワード: desired_days_per_week + desired_time_slots への部分一致),
 *  municipalities (配列 or カンマ区切り), job_type,
 *  sms_state ('sent'|'unsent'|''), csv_statuses (配列), app_status,
 *  applied_from / applied_to (YYYY-MM-DD), source_companies (配列),
 *  start_from / start_to (入職希望日範囲),
 *  has_past_fs (bool, 追補7。追補17以降は has_fs_history フィールドが正で、has_fs_history でも同じ絞り込み可),
 *  due_next_contact (bool: next_contact_date が今日以前, 追補7),
 *  mail_only (bool: メールありのみ。Gmail 用), qualifications (コード配列, OR),
 *  include_test (bool, 追補22: 既定 false。is_test=true のテスト求職者は既定で除外し、
 *    true を明示したときだけ含める。searchApplicants / mailPreviewTargets /
 *    computeMailTargets_ / getDigList はすべて本関数経由なので、ここが除外の唯一の判定点)
 */
/**
 * 資格マッチ (R3・G2 でフロント qualMatch と統一した唯一のルール):
 * 保有資格文字列 (カンマ/読点/スラッシュ区切り) の各トークンと希望資格を
 * NFKC+空白除去で正規化して比較し、次のいずれかで一致とする。
 *  - 完全一致
 *  - 希望「看護師」× 保有「正看護師」(正看護師は看護師に含める)
 *  - 希望「正看護師」× 保有「看護師」(登録表記が略称のケース)
 *  - 保有トークンが希望資格を含む (例: 介護福祉士（登録済）等)
 *    ただし希望「看護師」× 保有「准看護師」は別資格なので一致させない。
 */
function qualTokenMatch_(haveStr, want) {
  var w = str_(want).normalize('NFKC').replace(/\s/g, '');
  if (!w) return false;
  var tokens = str_(haveStr).split(/[,、\/／・]/).map(function (s) {
    return s.normalize('NFKC').replace(/\s/g, '');
  }).filter(function (s) { return s !== ''; });
  for (var i = 0; i < tokens.length; i++) {
    var t = tokens[i];
    if (t === w) return true;
    if (w === '看護師' && t === '正看護師') return true;
    if (w === '正看護師' && t === '看護師') return true;
    if (t.indexOf(w) >= 0 && !(w === '看護師' && t === '准看護師')) return true;
  }
  return false;
}

/** セグメント分類のサーバー正本 (R4 10-#1)。
 * フロント segmentOfCalc (index.html) と同じ優先順で分類する。定義を変えたら
 * フロント側も合わせること (表示用と送信用の二重実装である点に注意)。
 * 優先順: 連絡停止 > 稼働中 > 選考中 > 時期先 > 条件確認待ち > 即提案可能。
 * 選考中は正規化ラベル基準 (職見待ちは実施待ちとして扱う — フロントとの意図的な統一)。 */
function segmentOfApplicant_(r, today) {
  if (toBool_(r.mail_optout) || isTerminalStatus_(r)) return '連絡停止';
  var st = csvStageRank_(r.csv_status);
  if ((st.inFlow && st.stage >= 8) || str_(r.app_status) === '稼働開始') return '稼働中';
  var selLabel = st.label;
  if (['アテンド待ち', 'FIX待ち', '実施待ち', '職見待ち', '内定待ち', 'アテンド済み', 'FIX済み', '内定'].indexOf(selLabel) >= 0 ||
      ['FIX', 'アテンド', '内定'].indexOf(str_(r.app_status)) >= 0) return '選考中';
  var sd = cellDateYmd_(r.desired_start_date);
  if (sd && /^\d{4}-\d{2}-\d{2}$/.test(sd)) {
    var diffDays = Math.round((new Date(sd + 'T00:00:00+09:00').getTime() - new Date(today + 'T00:00:00+09:00').getTime()) / 86400000);
    if (diffDays > 60) return '時期先';
  }
  if (missingHearing_(r).length > 0) return '条件確認待ち';
  return '即提案可能';
}

function filterApplicants_(rows, f) {
  f = f || {};
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var munis = toList_(f.municipalities);
  var prefs = toList_(f.prefectures);
  var csvs = toList_(f.csv_statuses);
  var companies = toList_(f.source_companies);
  var quals = toList_(f.qualifications);
  return rows.filter(function (r) {
    if (f.include_test !== true && isTestApplicant_(r)) return false; // 追補22: テスト求職者は既定で除外
    if (f.keyword && str_(r.name).indexOf(String(f.keyword)) < 0 &&
        str_(r.name_raw).indexOf(String(f.keyword)) < 0 &&
        str_(r.applicant_id).indexOf(String(f.keyword)) < 0) return false; // R6.6 P2: ID部分一致も対象 (A000001 検索用)
    if (f.phone && str_(r.phone).replace(/-/g, '').indexOf(String(f.phone).replace(/-/g, '')) < 0) return false;
    if (f.age_min != null && f.age_min !== '' || f.age_max != null && f.age_max !== '') {
      var ageVal = ageFromBirth_(r.birth_date);
      if (ageVal == null) { if (f.age_include_unknown !== true) return false; }
      else {
        if (f.age_min != null && f.age_min !== '' && ageVal < Number(f.age_min)) return false;
        if (f.age_max != null && f.age_max !== '' && ageVal > Number(f.age_max)) return false;
      }
    }
    if (f.address_keyword) {
      var addrHay = str_(r.prefecture) + str_(r.municipality) + str_(r.address_rest);
      if (addrHay.indexOf(String(f.address_keyword)) < 0) return false;
    }
    if (f.area && str_(r.area) !== String(f.area)) return false;
    if (f.prefecture && str_(r.prefecture) !== String(f.prefecture)) return false;
    if (prefs.length && prefs.indexOf(str_(r.prefecture)) < 0) return false;
    if (f.desired_keyword) {
      var desiredHay = str_(r.desired_days_per_week) + str_(r.desired_time_slots);
      if (desiredHay.indexOf(String(f.desired_keyword)) < 0) return false;
    }
    if (munis.length && munis.indexOf(str_(r.municipality)) < 0) return false;
    if (f.job_type && str_(r.job_type) !== String(f.job_type)) return false;
    if (f.sms_state === 'sent' && !toBool_(r.sms_sent)) return false;
    if (f.sms_state === 'unsent' && toBool_(r.sms_sent)) return false;
    if (csvs.length && csvs.indexOf(str_(r.csv_status)) < 0) return false;
    if (f.app_status && str_(r.app_status) !== String(f.app_status)) return false;
    if (companies.length) {
      // 会社絞り込みは canonical で比較する (原文 source_company は保持したまま。DATA_MODEL §11)
      var canon = normalizeCompany_(r.source_company);
      var hitCo = companies.some(function (co) { return normalizeCompany_(co) === canon; });
      if (!hitCo) return false;
    }
    if (f.applied_from || f.applied_to) {
      var ad = cellDateYmd_(r.applied_at);
      if (!ad) return false;
      if (f.applied_from && ad < String(f.applied_from)) return false;
      if (f.applied_to && ad > String(f.applied_to)) return false;
    }
    if (f.start_from || f.start_to) {
      var sd = cellDateYmd_(r.desired_start_date);
      if (!sd) return false;
      if (f.start_from && sd < String(f.start_from)) return false;
      if (f.start_to && sd > String(f.start_to)) return false;
    }
    if (f.mail_only && !str_(r.email)) return false;
    if (quals.length) {
      // R3 (G2): 資格マッチの意味論をフロントと統一する。完全一致のみだと
      // 「正看護師」が「看護師」の対象から系統的に漏れるため、表記ゆれを
      // 吸収する qualTokenMatch_ で判定する (フロント qualMatch と同一ルール)。
      // include_no_qual=true のときは資格未登録の人も対象に含める (G2)。
      var haveQ = str_(r.qualifications);
      var anyQ = quals.some(function (q) { return qualTokenMatch_(haveQ, q); });
      if (!anyQ) {
        if (!(f.include_no_qual === true && !haveQ.replace(/\s/g, ''))) return false;
      }
    }
    // 追補7/17: FS登録歴あり。導出ではなく永続フィールド has_fs_history が正
    // (空の旧レコードのみ hasFsHistory_ 内で history 導出にフォールバック)。
    // searchApplicants / mailPreviewTargets / getDigList / SMSセグメントは本関数を共用するため、ここが唯一の判定点。
    if ((f.has_past_fs === true || f.has_fs_history === true) && !hasFsHistory_(r)) return false;
    // 追補7: 次回連絡日が今日以前 (未設定は対象外)
    if (f.due_next_contact === true) {
      var nd = cellDateYmd_(r.next_contact_date);
      if (!nd || nd > today) return false;
    }
    // R4 10-#1: セグメント分類そのものをフィルタとして受ける (掘り起こしからの引き継ぎ用)。
    // 分類は送信時点のデータでサーバーが再判定する (引き継ぎ時点の分類は固定しない)。
    if (f.segment && segmentOfApplicant_(r, today) !== String(f.segment)) return false;
    return true;
  });
}

function toList_(v) {
  if (v == null || v === '') return [];
  if (Object.prototype.toString.call(v) === '[object Array]') {
    return v.map(function (x) { return String(x).trim(); }).filter(function (x) { return x !== ''; });
  }
  return String(v).split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x !== ''; });
}

/** 応募日の新しい順に並べる (並び順の正: DATA_MODEL) */
function sortByAppliedDesc_(rows) {
  return rows.slice().sort(function (a, b) {
    var x = cellDateIso_(a.applied_at), y = cellDateIso_(b.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
}

function actionSearchApplicants_(req) {
  var t = readTable_('applicants');
  var matched = sortByAppliedDesc_(filterApplicants_(t.rows, req.filter || {}));
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || PAGE_SIZE));
  var start = (page - 1) * pageSize;
  var actCtx = null;
  try { actCtx = activityContext_(); } catch (e) { actCtx = null; }
  return {
    total: matched.length,
    page: page,
    page_size: pageSize,
    items: matched.slice(start, start + pageSize).map(function (r) {
      var act = null;
      if (actCtx) { try { act = activityForApplicant_(str_(r.applicant_id), actCtx, r); } catch (e2) { act = null; } }
      return applicantListItem_(r, act);
    })
    // 注: 一覧では phone / email を返さない (DESIGN_V2 §10)。詳細は getApplicant。
  };
}

/** R6: 一覧の件数サマリーをサーバー側で集計する。
 * フロントが全件を保持しなくても、入口・一覧の総数/送信済み/SMS対象/
 * 府県別・ステータス別件数を返す。個別の電話・メールは返さない。 */
function applicantSummaryForRows_(rows, area) {
  var matched = filterApplicants_(rows || [], area ? { area: String(area) } : {});
  var out = { area: area ? String(area) : '', total: matched.length, sent: 0, unsent: 0,
    sms_target: 0, fs_history: 0, area_unset: 0, pref_counts: {}, csv_status_counts: {}, company_counts: {}, muni_by_pref: {} };
  matched.forEach(function (r) {
    if (toBool_(r.sms_sent)) out.sent++; else out.unsent++;
    // R6.6 P4: area が空または関西・関東のいずれでもない行 (総数から漏れる行を可視化)。
    // area 指定のサマリ (kansai/kanto) では常に 0。全体サマリ (area='') が正の値を持つ。
    if (str_(r.area) !== 'kansai' && str_(r.area) !== 'kanto') out.area_unset++;
    var digits = str_(r.phone).replace(/[^0-9]/g, '');
    // R6.6 P3(a): 先頭0落ち (例: 8091251382) の電話も SMS 対象に数える。
    // 根本修復 (actionRepairPhones_) までの対症療法。フロント areaSummary も同じ緩和。
    if (/^0?[789]0/.test(digits)) out.sms_target++;
    if (hasFsHistory_(r)) out.fs_history++;
    var pref = str_(r.prefecture); if (pref) out.pref_counts[pref] = (out.pref_counts[pref] || 0) + 1;
    var muni = str_(r.municipality); if (pref && muni) { var mbp = out.muni_by_pref[pref] || (out.muni_by_pref[pref] = {}); mbp[muni] = (mbp[muni] || 0) + 1; }
    var st = str_(r.csv_status); if (st) out.csv_status_counts[st] = (out.csv_status_counts[st] || 0) + 1;
    var co = normalizeCompany_(r.source_company); if (co) out.company_counts[co] = (out.company_counts[co] || 0) + 1;
  });
  return out;
}

function actionGetApplicantSummary_(req) {
  var rows = readTable_('applicants').rows;
  var area = str_((req && req.area) || '');
  var summary = applicantSummaryForRows_(rows, area);
  summary.areas = {
    kansai: applicantSummaryForRows_(rows, 'kansai'),
    kanto: applicantSummaryForRows_(rows, 'kanto')
  };
  return summary;
}

// ===== 応募者: 詳細 + タイムライン =====
function findApplicant_(applicantId) {
  var t = readTable_('applicants');
  for (var i = 0; i < t.rows.length; i++) {
    if (String(t.rows[i].applicant_id) === String(applicantId)) return t.rows[i];
  }
  throw new Error('応募者が見つかりません: ' + applicantId);
}

function actionGetApplicant_(req) {
  var r = findApplicant_(req.applicant_id);
  var detail = applicantListItem_(r);
  // 詳細でのみ個人情報を返す
  detail.phone = str_(r.phone);
  detail.email = str_(r.email);
  detail.name_raw = str_(r.name_raw);
  detail.postal_code = str_(r.postal_code);
  detail.address_rest = str_(r.address_rest);
  detail.lat = toNum_(r.lat);
  detail.lon = toNum_(r.lon);
  detail.experience_years = toNum_(r.experience_years);
  detail.desired_days_per_week = str_(r.desired_days_per_week);
  detail.desired_time_slots = str_(r.desired_time_slots);
  detail.hearing_json = str_(r.hearing_json);
  detail.import_batch_id = str_(r.import_batch_id);
  detail.missing_hearing = missingHearing_(r).map(function (h) { return h.label; });

  var ev = readTable_('applicant_events').rows.filter(function (e) {
    return String(e.applicant_id) === String(req.applicant_id);
  }).sort(function (a, b) {
    var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  }).slice(0, 200).map(function (e) {
    return {
      event_id: str_(e.event_id), event_type: str_(e.event_type), actor: str_(e.actor),
      delivery_id: str_(e.delivery_id), response_id: str_(e.response_id),
      detail: str_(e.detail), created_at: cellDateIso_(e.created_at),
      // 送信スナップショット (R3 検証 #12): SMS 単発送信のイベントにも保存される
      // 文面・提示案件を、詳細画面のタイムラインから参照できるよう一緒に返す。
      body_snapshot: str_(e.body_snapshot), case_ids: str_(e.case_ids),
      // R4 S-02: 記録時点の案件の写し (現在値の再引きではない)
      cases_snapshot: parseCasesSnapshot_(e.cases_snapshot)
    };
  });
  // 過去のフォーム送信について「いつ・どの案件を・どの文面で」がスナップショットで返る。
  detail.delivery_snapshots = deliverySnapshotsForApplicant_(req.applicant_id);
  // 横断ブレーキ用データ (革新3): 直近の送信・対応中かも詳細に付ける。
  try { detail.activity = activityForApplicant_(String(req.applicant_id), activityContext_(), r); }
  catch (e2) { detail.activity = null; }
  return { applicant: detail, events: ev };
}

/** 未確認ヒアリング項目 (DATA_MODEL §1) */
function missingHearing_(r) {
  return HEARING_FIELDS.filter(function (h) {
    var v = r[h.key];
    return v === '' || v == null;
  });
}

// ===== 応募者: ステータス変更 (要ドメイン認証) =====
function actionUpdateWorkflow_(req) {
  var me = requireKikariUser_();
  var status = String(req.status || '').trim();
  if (WORKFLOW_STATUSES.indexOf(status) < 0) {
    throw new Error('status は ' + WORKFLOW_STATUSES.join('/') + ' のいずれかです');
  }
  return withLock_(function () {
    var before = findApplicant_(req.applicant_id);
    var patch = { app_status: status, updated_at: nowIso_() };
    // 付帯日付 (任意): ステージごとの日付を hearing_json ではなく専用キーで受け、
    // app_status の変更と一緒に desired_start_date 等の既存列へ反映する
    if (req.desired_start_date) patch.desired_start_date = String(req.desired_start_date);
    if (req.next_contact_date !== undefined) patch.next_contact_date = String(req.next_contact_date || '');
    if (req.csv_status) patch.csv_status = String(req.csv_status);
    updateRowByPk_('applicants', req.applicant_id, patch);
    appendEvent_(req.applicant_id, 'status_change', me,
      '対応ステータス: ' + (str_(before.app_status) || '(未設定)') + ' -> ' + status +
      (req.note ? ' / ' + String(req.note) : ''), '', '');
    return { updated: req.applicant_id, app_status: status };
  });
}

// ===== SMS 送信記録 (要ドメイン認証)。実際の SMS 送信は iPhone の sms: リンク側で行う =====
function actionRecordSmsSent_(req) {
  var me = requireKikariUser_();
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  return withLock_(function () {
    // R4 O-06: 配信停止中の人への SMS 記録は受け付けない (画面を迂回した記録も通さない)。
    // 例外にせず戻り値で返す (outbox 経由の op が例外だと failed 滞留するため)。
    // あわせて sms_blocked イベントを残し、事後検出可能にする。
    var smsApplicant = null;
    try { smsApplicant = findApplicant_(req.applicant_id); } catch (eFind) { smsApplicant = null; }
    if (smsApplicant) {
      var blockedReason = smsBlockedReason_(smsApplicant);
      if (blockedReason) {
        try { appendEvent_(req.applicant_id, 'sms_blocked', me, blockedReason, String(req.delivery_id || ''), ''); } catch (eEv) {}
        return { recorded: false, blocked: 'optout', reason: blockedReason };
      }
    }
    // R4 S-11: 冪等キー。同一 applicant_id + client_request_id の sms_sent が
    // 既にあれば、append も recipients 更新もせず再送として返す (outbox 再送の二重記録防止)。
    var clientReqId = String(req.client_request_id || '');
    if (clientReqId) {
      var dupEv = readTable_('applicant_events').rows.filter(function (e) {
        return String(e.applicant_id) === String(req.applicant_id) && e.event_type === 'sms_sent' &&
          String(e.client_request_id || '') === clientReqId;
      });
      if (dupEv.length) return { recorded: req.applicant_id, idempotent_replay: true };
    }
    var now = nowIso_();
    // R3 (監査・高#1): スナップショットは配信レコードの有無に依存させず、
    // 本人のイベント (タイムライン) に必ず残す (従来は delivery_id がある
    // 場合に recipients へ書くだけで、通常の初回SMSではサーバーに残らなかった)。
    // R4 S-02: 案件の写し JSON もイベントに保存する (表示側の現在値再引きを廃止するため)。
    var smsCaseIds0 = toList_(req.case_ids || req.recommended_case_ids);
    var snapBody0 = snapshotBody_(req.body_snapshot || req.body || '');
    var snapCases0 = smsCaseIds0.length ? buildCasesSnapshot_(smsCaseIds0) : '';
    var detail0 = String(req.detail || req.template_kind || 'SMS送信 (sms:リンク)');
    if (req.campaign_id) detail0 += ' campaign=' + String(req.campaign_id);
    if (req.campaign_id && req.campaign_name) detail0 += ' name=' + String(req.campaign_name); // R4 S-10
    // R4 Lane J: SMS は配信レコードが無い場合があるため版キーを証跡にも残す。
    // req.template_version が無くても template_id / template_kind からサーバーで確定する。
    var smsTplVer = String(req.template_version || '');
    if (!smsTplVer && (req.template_id || req.template_kind)) {
      smsTplVer = templateVersionFor_({ template_id: req.template_id,
        template_kind: req.template_kind }, snapBody0).template_version;
    }
    if (smsTplVer) detail0 += ' tpl=' + smsTplVer;
    // R4 S-11: 証跡 (イベント) を状態 (applicants 更新) より先に書く。
    // append が失敗したら applicants は更新しない (状態だけ先行させない)。
    appendEvent_(req.applicant_id, 'sms_sent', me, detail0, String(req.delivery_id || ''), '',
      (snapBody0 || smsCaseIds0.length || clientReqId) ? {
        body_snapshot: snapBody0, case_ids: smsCaseIds0.join(','),
        cases_snapshot: snapCases0, client_request_id: clientReqId
      } : null);
    var patch = { sms_sent: true, sms_last_sent_at: now, last_contact_at: now, updated_at: now };
    updateRowByPk_('applicants', req.applicant_id, patch);
    // SMS記録系: 配信レコード (delivery_id 指定時) があれば、その時点で見せた
    // 案件と文面のスナップショットを delivery_recipients 側へ保存する (写し・不変)。
    // R4 S-07: form_link の発行記録行もこの時点で初めてスナップショット化する
    // (発行時点では書かない)。SMS経路の写しは記録時点で確定なので finalized=1。
    var smsCaseIds = smsCaseIds0;
    var snapshotSaved = null;
    if (req.delivery_id && (smsCaseIds.length || req.body || req.body_snapshot)) {
      try {
        var smsRecPatch = {
          cases_snapshot: snapCases0 || buildCasesSnapshot_(smsCaseIds),
          body_snapshot: snapshotBody_(req.body_snapshot || req.body || ''),
          snapshot_finalized: 1
        };
        if (smsTplVer) smsRecPatch.template_version = smsTplVer; // R4 レーンJ (c)3
        updateRecipientStatus_(String(req.delivery_id), String(req.applicant_id), smsRecPatch);
        snapshotSaved = true;
      } catch (e) { snapshotSaved = false; /* 配信レコードが無い SMS 単独記録ではスナップショットを持たない */ }
    }
    var smsRet = { recorded: req.applicant_id, sms_last_sent_at: now };
    if (snapshotSaved === false) smsRet.snapshot_saved = false; // R4 S-11: 画面は op を「反映待ち (証跡未保存)」として残す
    return smsRet;
  });
}

// ===== 取り込み進捗 (R6) =====
/** import_batches を読み取り専用で返す。フロントは確定の再送で競合せず、
 * この進捗表示でサーバー側の処理状況 (running/complete/partial と件数) を見る。 */
function actionGetImportStatus_(req) {
  requireKikariUser_();
  var rows = readTable_('import_batches').rows.slice();
  rows.sort(function (a, b) { return String(b.created_at || '').localeCompare(String(a.created_at || '')); });
  var totals = { batches: rows.length, running: 0, complete: 0, partial: 0, failed_batches: 0,
    rows: 0, added: 0, updated: 0, skipped: 0, failed: 0 };
  rows.forEach(function (r) {
    var st = str_(r.status);
    if (st === 'running') totals.running++;
    else if (st === 'complete') totals.complete++;
    else if (st === 'partial') totals.partial++;
    else if (st === 'failed') totals.failed_batches++;
    totals.rows += toNum_(r.row_count) || 0;
    totals.added += toNum_(r.added_count) || 0;
    totals.updated += toNum_(r.updated_count) || 0;
    totals.skipped += toNum_(r.skipped_count) || 0;
    totals.failed += toNum_(r.failed_count) || 0;
  });
  var recent = rows.slice(0, 30).map(function (r) {
    return { batch_id: str_(r.batch_id), file_name: str_(r.file_name), kind: str_(r.kind),
      row_count: toNum_(r.row_count) || 0, added: toNum_(r.added_count) || 0,
      updated: toNum_(r.updated_count) || 0, skipped: toNum_(r.skipped_count) || 0,
      failed: toNum_(r.failed_count) || 0, status: str_(r.status),
      created_at: str_(r.created_at), note: str_(r.note), client_op_id: str_(r.client_op_id),
      chunk_seq: (r.chunk_seq === undefined || r.chunk_seq === null) ? '' : r.chunk_seq };
  });
  // R6.5: サーバー側キューの進捗 (import_queue が無い環境では空集計)
  var queue = { pending_rows: 0, pending_chunks: 0, processing_rows: 0, done_rows: 0, failed_rows: 0 };
  try {
    var qrows = readTable_('import_queue').rows;
    var chunkKeys = {};
    qrows.forEach(function (r) {
      var st = str_(r.status);
      if (st === 'pending') { queue.pending_rows++; chunkKeys[str_(r.client_op_id) + '|' + String(r.chunk_seq === undefined || r.chunk_seq === null ? '' : r.chunk_seq)] = true; }
      else if (st === 'processing') queue.processing_rows++;
      else if (st === 'done') queue.done_rows++;
      else if (st === 'failed') queue.failed_rows++;
    });
    queue.pending_chunks = Object.keys(chunkKeys).length;
  } catch (e) { /* キュー未導入の環境では進捗なしとして扱う */ }
  return { batches: recent, totals: totals, queue: queue };
}

// ===== CSV 取り込み確定 (要ドメイン認証 / LockService で直列化) =====
/**
 * 追補3・追補4 のルールをサーバー側でも担保する:
 * - 照合キー: 電話 / メール / 氏名+生年月日。
 * - 過去に応募がある人でも、新しい応募は「本人の最新応募」として必ず登録する
 *   (applied_at / source_company / area / job_type 等の応募属性を現在化し、
 *    applicant_events に import イベント「新規応募あり」を残す)。
 * - 進行中の対応ステータス (csv_status / app_status) や SMS 送信済み記録は
 *   取り込みでリセットしない (patch に含めない)。
 * - 配信停止 (optouts テーブル) にあるメールは mail_optout=true を強制し、
 *   CSV 再取り込みでも復活させない (registerOptout のコメントも参照)。
 * - FS登録歴フラグ (追補17): 取り込んだ応募の正規化会社がファーストスタッフィングなら
 *   has_fs_history=true を永続化する。既存が true の場合はもちろん、既存行の history から
 *   導出できる場合も true を書き戻し、一度 true になったフラグは取り込みでは絶対に
 *   false にしない (patch に false を含めない)。「既存と同じ・古い応募」で属性更新を
 *   除外する行でも、フラグの立て直しだけは行う。
 * req: { file_name, kind:'applicants', rows:[{...applicants列...}] }
 * プレビュー (確認画面) はフロント側の責務。本関数は「確定」のみ。
 */
function actionImportCommit_(req) {
  var me = requireKikariUser_();
  // 案件取り込み修正 (案B): kind='cases' は案件専用バルクコアへ振り分ける。
  // dispatch は importCommit を共用し、フロントの op 形式は応募者と揃える。
  if (str_(req.kind || '') === 'cases') return importCasesCommitCore_(req, me);
  return importCommitCore_(req, me);
}

/**
 * R6.6 P1: 取り込みプレビューのサーバー側ドライラン。
 * 背景 (POOL_DIAGNOSIS §2): フロントのプレビューは端末プール (サーバーモードでは
 * シード25行) で照合するため、新規/変化なしが原理的に出ない。判定そのものを
 * サーバー側で行い、フロントはこの結果を表示するだけにする。
 * 判定は importCommitCore_ と同一ロジック (索引: 電話/メール/氏名+生年月日、
 * 除外順序: 曖昧 → 必須情報不備 → 年齢不明 → 63歳以上 → 対象職種以外 →
 * 対象エリア以外、attr-only 更新は diffApplicantAttrs_) を、書き込みなしで流す。
 * 同期維持の要所: (a) 新規と判定した行は同一ファイル内の後続行の照合のため
 * メモリ上の索引へ入れる (commit の indexAdd_ と同一)。(b) 既存行への更新は
 * メモリ上の行オブジェクトへ patch を当ててから次行を判定する (commit の
 * queuePatch_ が in-memory の既存行を書き換えるのと同一。ただし _row がある
 * シート行だけ。チャンク内新規行は索引側が変わらないため当てない)。
 * (c) 座標降格・FSフラグ永続化・optout は件数に影響しないためプレビューでは行わない。
 * 読み取りは applicants テーブルのみ。applicants / applicant_events /
 * import_batches / import_queue への書き込みは一切しない (冪等リプレイの参照も
 * しない。プレビューは「今のシートに対する判定」を返す)。ロックも取らない。
 * req: { file_name, kind:'applicants', rows:[importRow...], client_op_id, chunk_seq }
 * (importCommitCore_ と同じ行形式。1回の呼び出しは1ファイル分 = 上限 5000 行)。
 * 戻り値は importCommitCore_ と同じキー体系 (added/updated/skipped/attr_updated/
 * skipped_reasons) に、フロント表示語彙の別名 (latest_application / excluded /
 * unclassified / counts / preview_counts_by_chunk) を加えたもの。
 * 注意: フロント判定は姓のみ+生年月日、サーバーは氏名全体+生年月日 (POOL_DIAGNOSIS
 * §2.5)。数行の差は想定内。サーバー実績 (import_batches) を正とする。
 */
function actionImportPreview_(req) {
  // 読み取り専用: searchApplicants / getApplicantSummary と同じ扱い
  // (requireKikariUser_ は不要)。
  return importPreviewCore_(req);
}

function importPreviewCore_(req) {
  var rows = req.rows || [];
  if (!rows.length) throw new Error('rows が空です');
  if (rows.length > 5000) throw new Error('1回のプレビューは 5000 行までです (分割してください)');
  var clientOpId = str_(req.client_op_id || '');
  var chunkSeq = (req.chunk_seq === undefined || req.chunk_seq === null || req.chunk_seq === '') ? '' : req.chunk_seq;
  // 索引構築は importCommitCore_ と同一 (電話/メール/氏名+生年月日)。
  var t = readTable_('applicants');
  var byPhone = {}, byEmail = {}, byNameBirth = {};
  function indexAdd_(map, key, row) {
    if (!key) return;
    (map[key] = map[key] || []).push(row);
  }
  t.rows.forEach(function (r) {
    var ph = normalizePhoneDigits_(r.phone);
    indexAdd_(byPhone, ph, r);
    var em = normalizeEmail_(r.email);
    indexAdd_(byEmail, em, r);
    var nb = str_(r.name) + '|' + cellDateYmd_(r.birth_date);
    if (str_(r.name)) indexAdd_(byNameBirth, nb, r);
  });
  var added = 0, updated = 0, skipped = 0, attrUpdated = 0;
  var skippedReasons = {
    'ファイル内の重複': 0, '対応履歴があり保護': 0, '既存と同じ・古い応募': 0,
    '年齢条件の対象外': 0, '対象エリア以外': 0, '対象職種以外': 0,
    '年齢不明': 0, '必須情報不備': 0, '重複の確認が必要': 0
  };
  function skip_(reason) { skipped++; if (skippedReasons[reason] != null) skippedReasons[reason]++; }
  var seenInFile = {};
  // 未分類ステータス (csv_status が CSV_STATUSES_ 18区分に無い行)。判定とは独立に
  // 全行を数える (除外行も含む。フロント renderImportPreview と同一ルール)。
  var unclassified = 0;
  rows.forEach(function (input) {
    if (str_(input.csv_status) && CSV_STATUSES_.indexOf(str_(input.csv_status)) < 0) unclassified++;
  });
  rows.forEach(function (input) {
    var fileKey = normalizePhoneDigits_(input.phone) + '|' + normalizeEmail_(input.email) + '|' + str_(input.name);
    if ((str_(input.phone) || str_(input.email)) && seenInFile[fileKey]) { skip_('ファイル内の重複'); return; }
    seenInFile[fileKey] = true;
    var phone = normalizePhoneDigits_(input.phone);
    var email = normalizeEmail_(input.email);
    var nbKey = str_(input.name) + '|' + cellDateYmd_(input.birth_date);
    var candById = {};
    function collectCands_(arr) {
      (arr || []).forEach(function (r) { candById[r.applicant_id] = r; });
    }
    if (phone) collectCands_(byPhone[phone]);
    if (email) collectCands_(byEmail[email]);
    if (str_(input.name)) collectCands_(byNameBirth[nbKey]);
    var candIds = Object.keys(candById);
    var existing = candIds.length === 1 ? candById[candIds[0]] : null;
    var attrs = pickApplicantAttrs_(input);
    var ageVal = null;
    if (input.birth_date) ageVal = ageFromBirth_(input.birth_date);
    else if (input.age !== undefined && input.age !== null && input.age !== '') ageVal = toNum_(input.age);
    // 除外順序は importCommitCore_ と同一。
    var exclusion = '';
    if (candIds.length > 1) exclusion = '重複の確認が必要';
    else if (!attrs.name || (!phone && !email)) exclusion = '必須情報不備';
    else if (ageVal == null) exclusion = '年齢不明';
    else if (ageVal >= 63) exclusion = '年齢条件の対象外';
    else if (['kaigo', 'kango'].indexOf(str_(input.job_type)) < 0) exclusion = '対象職種以外';
    else if (str_(input.prefecture) &&
             KANSAI_PREFECTURES_.indexOf(str_(input.prefecture)) < 0 &&
             KANTO_PREFECTURES_.indexOf(str_(input.prefecture)) < 0) exclusion = '対象エリア以外';
    if (exclusion) { skip_(exclusion); return; }
    if (existing) {
      var exApplied = cellDateIso_(existing.applied_at), inApplied = cellDateIso_(input.applied_at);
      if (inApplied && exApplied && inApplied <= exApplied) {
        var attrPatch = diffApplicantAttrs_(existing, attrs);
        if (Object.keys(attrPatch).length) {
          // メモリ上のみ patch を当てる (commit の queuePatch_ と同一。
          // _row があるシート行だけが in-memory で書き換わる。チャンク内新規行
          // (_row なし) は updateRowByPk_ でシートだけ書かれ、索引側は変わらない)。
          if (existing._row) Object.keys(attrPatch).forEach(function (k) { existing[k] = attrPatch[k]; });
          updated++; attrUpdated++;
          return;
        }
        skip_('既存と同じ・古い応募'); return;
      }
      // 新しい応募として最新化。メモリ上のみ attrs を当てる (commit と同一。_row がある行だけ)。
      if (existing._row) Object.keys(attrs).forEach(function (k) { existing[k] = attrs[k]; });
      updated++;
    } else {
      // 新規と判定した行は、同一ファイル内の後続行の照合のため索引へ入れる
      // (commit の新規行 indexAdd_ と同一。applicant_id は照合キーに使わない
      // ため、候補の一意化だけに使う仮IDでよい)。
      var newRow = {};
      Object.keys(attrs).forEach(function (k) { newRow[k] = attrs[k]; });
      newRow.applicant_id = 'PREVIEW_NEW_' + added;
      indexAdd_(byPhone, phone, newRow);
      indexAdd_(byEmail, email, newRow);
      if (str_(newRow.name)) indexAdd_(byNameBirth, nbKey, newRow);
      added++;
    }
  });
  var latest = updated - attrUpdated; // 「最新応募として登録」= 更新のうち属性のみ以外
  return {
    preview: true, dry_run: true, status: 'preview',
    file_name: String(req.file_name || ''), kind: String(req.kind || 'applicants'),
    row_count: rows.length, added: added, updated: updated, skipped: skipped,
    attr_updated: attrUpdated, latest_application: latest,
    failed: 0, row_errors: [],
    skipped_reasons: skippedReasons, excluded: skippedReasons,
    unclassified: unclassified,
    client_op_id: clientOpId, chunk_seq: chunkSeq,
    // importCommitCore_ へ渡す preview_counts と同じ三つ組 (確定時の突合せ用)。
    preview_counts: { added: added, updated: updated, skipped: skipped },
    // フロント表示語彙 (renderImportPreview の counts と同名)。
    counts: { new: added, latest: latest, updated: attrUpdated, skip: skipped,
      excluded: skipped, unclassified: unclassified },
    // 1回の呼び出しは1ファイル分。複数ファイルの合算はフロント側で行う。
    preview_counts_by_chunk: [{ chunk_seq: chunkSeq, file_name: String(req.file_name || ''),
      added: added, updated: updated, skipped: skipped }]
  };
}

/**
 * R6.5: 取り込み確定の本体。Web 経由は actionImportCommit_ から、
 * サーバー側継続処理 (processImportQueue) からは登録時の actor で呼ぶ。
 * 照合はチャンクごとに applicants を1回だけ読み、メモリ上の索引
 * (電話/メール/氏名+生年月日) で行う (行ごとの読み直しはしない)。
 */
function importCommitCore_(req, me) {
  var rows = req.rows || [];
  if (!rows.length) throw new Error('rows が空です');
  if (rows.length > 5000) throw new Error('1回の取り込みは 5000 行までです (分割してください)');
  // R4 06-06: 冪等キー。フロントの二重送信・outbox 再送で同一の
  // (client_op_id, chunk_seq) が再投入されても二重登録しない。
  // キーが無い旧経路は従来動作 (チェック自体をスキップする)。
  var clientOpId = str_(req.client_op_id || '');
  var chunkSeq = (req.chunk_seq === undefined || req.chunk_seq === null || req.chunk_seq === '') ? '' : req.chunk_seq;
  // R6.5: フロントのプレビュー件数 (任意)。確定後にサーバー実績と突合し、
  // 差異があればその内容をバッチの note に残す (プレビューと確定の一致保証)。
  var previewCounts = (req.preview_counts && typeof req.preview_counts === 'object') ? req.preview_counts : null;
  // R6.5: 処理開始後に致命的エラーで中断した場合に、そのバッチを failed として
  // 残すための受け渡し。ロック未取得など開始前の失敗では何も記録しない。
  var r65Batch = { id: null };
  try {
  return withLock_(function () {
    if (clientOpId) {
      var prevBatches = readTable_('import_batches').rows;
      for (var bi = 0; bi < prevBatches.length; bi++) {
        var pb = prevBatches[bi];
        if (str_(pb.client_op_id) === clientOpId &&
            String(pb.chunk_seq == null ? '' : pb.chunk_seq) === String(chunkSeq) &&
            str_(pb.status) === 'complete') {
          // committed 済みの再送: 書き込みを再実行せず、前回のサーバー実績を返す。
          // partial / running のバッチはここでは返さず再処理を続行する (適用済みの
          // 行は既存照合で skip / 属性更新に倒れるため、二重登録にはならない)。
          return { batch_id: pb.batch_id, row_count: toNum_(pb.row_count) || rows.length,
            added: toNum_(pb.added_count) || 0, updated: toNum_(pb.updated_count) || 0,
            skipped: toNum_(pb.skipped_count) || 0, attr_updated: 0,
            failed: toNum_(pb.failed_count) || 0, status: str_(pb.status),
            row_errors: [], skipped_reasons: {},
            note: str_(pb.note),
            idempotent_replay: true, client_op_id: clientOpId, chunk_seq: chunkSeq };
        }
      }
    }
    var batchId = nextId_('import_batches');
    var now = nowIso_();
    // R4 06-07 段階1: バッチレコードを status=running で先行作成し、完了時に
    // 結果で更新する。途中失敗や強制終了でもバッチの存在と進捗が残る。
    // バッチ記録自体の失敗で取り込み本体は止めない (記録は best-effort)。
    var batchRecorded = false;
    try {
      appendRow_('import_batches', {
        batch_id: batchId, kind: String(req.kind || 'applicants'), file_name: String(req.file_name || ''),
        row_count: rows.length, added_count: 0, updated_count: 0, skipped_count: 0,
        actor: me, created_at: now, status: 'running', failed_count: 0,
        client_op_id: clientOpId, chunk_seq: chunkSeq
      });
      batchRecorded = true;
      r65Batch.id = batchId;
    } catch (batchErr) {
      try { Logger.log('importCommit batch pre-create failed batch=' + batchId + ': ' + errMsg_(batchErr)); } catch (e) {}
    }
    var t = readTable_('applicants');
    // R4 06-13: 索引は「キー -> 既存応募者の配列」。同一キーに複数名いる場合も
    // 潰さず全員を候補に残し、候補が2名以上なら曖昧として自動統合しない
    // (フロントの配列索引 + ambiguous 除外と対称にする)。
    var byPhone = {}, byEmail = {}, byNameBirth = {};
    function indexAdd_(map, key, row) {
      if (!key) return;
      (map[key] = map[key] || []).push(row);
    }
    function indexRemove_(map, key, row) {
      var arr = key ? map[key] : null;
      if (!arr) return;
      var i = arr.indexOf(row);
      if (i >= 0) arr.splice(i, 1);
      if (!arr.length) delete map[key];
    }
    t.rows.forEach(function (r) {
      var ph = normalizePhoneDigits_(r.phone); // R3: 全角数字も照合可能にする
      indexAdd_(byPhone, ph, r);
      var em = normalizeEmail_(r.email);
      indexAdd_(byEmail, em, r);
      var nb = str_(r.name) + '|' + cellDateYmd_(r.birth_date);
      if (str_(r.name)) indexAdd_(byNameBirth, nb, r);
    });
    // R4 06-07: 新規応募者の採番は、開始時点に読み済みの既存最大番号からの
    // 連番予約に変える (行ごとの nextId_ 全表走査をやめる)。書き込みは
    // withLock_ 内に直列化されているため、メモリ上の連番で衝突しない。
    var appPrefix = ID_PREFIX_['applicants'] || 'A';
    var appSeq = 0;
    t.rows.forEach(function (r) {
      var m = String(r.applicant_id || '').match(new RegExp('^' + appPrefix + '(\\d+)$'));
      if (m) appSeq = Math.max(appSeq, parseInt(m[1], 10));
    });
    function allocApplicantId_() {
      appSeq++;
      var n = String(appSeq);
      while (n.length < 6) n = '0' + n;
      return appPrefix + n;
    }
    // R6: イベント書き込みの高速化。従来は appendEvent_ が行ごとに
    // nextId_ で applicant_events 全表を走査して採番しており、件数増で
    // 二乗オーダーに膨らんでいた (実地: 約30行/分)。開始時点で最大番号を
    // 1回だけ読み、連番予約 + appendRows_ 一括書き込みに変える。
    // detail 文言・event_type・actor は従来の appendEvent_ 呼び出しと同一。
    var evPrefix = ID_PREFIX_['applicant_events'] || 'E';
    var evSeq = 0;
    try {
      readTable_('applicant_events').rows.forEach(function (r) {
        var m = String(r.event_id || '').match(new RegExp('^' + evPrefix + '(\\d+)$'));
        if (m) evSeq = Math.max(evSeq, parseInt(m[1], 10));
      });
    } catch (e) {}
    var pendingEvents = [];
    function flushEvents_() {
      if (!pendingEvents.length) return;
      var evs = pendingEvents; pendingEvents = [];
      var res = appendRows_('applicant_events', evs);
      res.errors.forEach(function (e) {
        try { Logger.log('importCommit event write failed batch=' + batchId + ': ' + e.message); } catch (e2) {}
      });
    }
    function queueEvent_(applicantId, detail) {
      evSeq++;
      var n = String(evSeq);
      while (n.length < 6) n = '0' + n;
      pendingEvents.push({ event_id: evPrefix + n, applicant_id: applicantId,
        event_type: 'import', actor: me, delivery_id: '', response_id: '',
        detail: detail || '', created_at: nowIso_() });
      if (pendingEvents.length >= 200) flushEvents_();
    }
    // R6: 既存行の更新の高速化。従来は updateRowByPk_ が行ごとに applicants
    // 全表を読み直していた (565件の最新応募更新が分単位に膨らむ主因)。
    // 行番号 (_row) が判明している既存行はメモリ上で patch を適用し、
    // 書き込みはチャンク末尾に「行まるごと setValues」へまとめる。
    // 行番号不明 (同一チャンク内で新規追加された直後の行) は従来どおり
    // updateRowByPk_ で即時に書く。
    var pendingPatchRows = {}; // applicant_id -> row object (patch applied)
    function queuePatch_(existing, patch) {
      if (!existing || !existing._row) {
        updateRowByPk_('applicants', existing && existing.applicant_id, patch);
        return;
      }
      Object.keys(patch).forEach(function (k) { existing[k] = patch[k]; });
      pendingPatchRows[existing.applicant_id] = existing;
    }
    function flushPatches_() {
      var ids = Object.keys(pendingPatchRows);
      if (!ids.length) return;
      pendingPatchRows = {};
      var sh = null, headers = t.headers;
      try { sh = sheet_('applicants'); } catch (e) { sh = null; }
      ids.forEach(function (id) {
        // row object は索引経由で再取得する (pendingPatchRows の値そのもの)
        var rowObj = null;
        t.rows.forEach(function (r) { if (String(r.applicant_id) === String(id)) rowObj = r; });
        if (!rowObj || !rowObj._row) return;
        try {
          if (!sh) throw new Error('sheet unavailable');
          var arr = headers.map(function (h) { return rowObj[h] == null ? '' : rowObj[h]; });
          sh.getRange(rowObj._row, 1, 1, headers.length).setValues([arr]);
        } catch (e) {
          failedRows++;
          if (rowErrors.length < 5) rowErrors.push(errMsg_(e));
          try { Logger.log('importCommit patch write failed batch=' + batchId + ': ' + errMsg_(e)); } catch (e2) {}
        }
      });
    }
    var optoutSet = optoutEmailSet_();
    // R4 I-3: 座標の同一重複 (c) はバッチ + 既存全体で事前に数える。
    var coordDupMap = coordDupCountMap_(
      rows.concat(t.rows).map(function (r) {
        return { lat: r.lat, lon: r.lon,
          addressKey: str_(r.prefecture) + str_(r.municipality) + str_(r.address_rest) };
      }), municipalityRepKeys_());
    var coordDowngraded = 0;
    var coordReasons = {};

    var added = 0, updated = 0, skipped = 0, attrUpdated = 0;
    // 除外理由の区分 (LIVE §12)。キーは区分名そのもの。
    // 注: '対応履歴があり保護' は旧区分。追補4で「対応履歴があっても最新応募として登録する」
    // 方式に変更済みのため、現在はこの理由では除外しない (区分としてのみ残し、通常は 0)。
    var skippedReasons = {
      'ファイル内の重複': 0, '対応履歴があり保護': 0, '既存と同じ・古い応募': 0,
      '年齢条件の対象外': 0, '対象エリア以外': 0, '対象職種以外': 0,
      '年齢不明': 0, '必須情報不備': 0, '重複の確認が必要': 0
    };
    function skip_(reason) { skipped++; if (skippedReasons[reason] != null) skippedReasons[reason]++; }
    var seenInFile = {};
    // F-03 (堅牢化): 行ごとの処理を個別に隔離する。1行の書き込み失敗で
    // バッチ全体を止めず、取り込めた分は確定させ、最後に必ずバッチ記録を残す。
    var failedRows = 0, rowErrors = [];
    // R4 06-07 段階2: 新規応募者の書き込みはバッファに溜め、200行ごとに
    // appendRows_ でまとめてフラッシュする (行ごとの appendRow_ を排除)。
    // 判定・索引への反映は従来どおり行単位で即時に行い、書き込み失敗の
    // 帰属だけがフラッシュ単位になる (F-03 の「1行失敗でも止めない」は維持)。
    var pendingNew = []; // {attrs, phone, email, nbKey}
    var pendingIds = {}; // applicant_id -> true (未フラッシュの新規行)
    function flushNew_() {
      if (!pendingNew.length) return;
      var batch = pendingNew;
      pendingNew = []; pendingIds = {};
      var res = appendRows_('applicants', batch.map(function (p) { return p.attrs; }));
      var failedIdx = {};
      res.errors.forEach(function (e) {
        failedIdx[e.index] = true;
        failedRows++;
        if (rowErrors.length < 5) rowErrors.push(e.message);
        try { Logger.log('importCommit new-row write failed batch=' + batchId + ': ' + e.message); } catch (e2) {}
      });
      batch.forEach(function (p, i) {
        if (failedIdx[i]) {
          // 書けなかった行は索引から外す (後続行が実在しない行を更新対象にしない)
          if (p.phone) indexRemove_(byPhone, p.phone, p.attrs);
          if (p.email) indexRemove_(byEmail, p.email, p.attrs);
          indexRemove_(byNameBirth, p.nbKey, p.attrs);
          return;
        }
        queueEvent_(p.attrs.applicant_id, '新規登録 batch=' + batchId);
        added++;
      });
    }
    // 未フラッシュの新規行を更新対象にする前に、その書き込みを確定させる
    function ensurePersisted_(existing) {
      if (existing && pendingIds[existing.applicant_id]) flushNew_();
    }
    rows.forEach(function (input) {
    try {
      var fileKey = normalizePhoneDigits_(input.phone) + '|' + normalizeEmail_(input.email) + '|' + str_(input.name);
      if ((str_(input.phone) || str_(input.email)) && seenInFile[fileKey]) { skip_('ファイル内の重複'); return; }
      seenInFile[fileKey] = true;
      var phone = normalizePhoneDigits_(input.phone);
      var email = normalizeEmail_(input.email);
      var nbKey = str_(input.name) + '|' + cellDateYmd_(input.birth_date);
      // R3: 照合はキーごとに候補を集める。複数人へ当たる行は自動統合しない
      // (曖昧な行は '重複の確認が必要' として人手確認に回す)。
      var candById = {};
      function collectCands_(arr) {
        (arr || []).forEach(function (r) { candById[r.applicant_id] = r; });
      }
      if (phone) collectCands_(byPhone[phone]);
      if (email) collectCands_(byEmail[email]);
      if (str_(input.name)) collectCands_(byNameBirth[nbKey]);
      var candIds = Object.keys(candById);
      var existing = candIds.length === 1 ? candById[candIds[0]] : null;

      // 応募属性だけを集める (ステータス類は含めない = リセットしない)
      var attrs = pickApplicantAttrs_(input);
      // R4 I-3: 持ち込み座標の受け入れ判定。降格したら座標なしで取り込む
      // (原文の保持先が無いため、件数と理由は結果に必ず含めて可視化する)。
      if (attrs.lat !== undefined || attrs.lon !== undefined) {
        var cKey = coordKey_(attrs.lat, attrs.lon);
        var cAcc = acceptCoord_(attrs.lat, attrs.lon,
          municipalityRepPoint_(attrs.prefecture, attrs.municipality),
          cKey ? coordDupMap[cKey] : null);
        if (cAcc.verdict === 'downgraded') {
          attrs.lat = ''; attrs.lon = '';
          coordDowngraded++;
          coordReasons[cAcc.reason] = (coordReasons[cAcc.reason] || 0) + 1;
        } else if (cAcc.verdict === 'precise') { attrs.lat = cAcc.lat; attrs.lon = cAcc.lon; }
      }
      attrs.import_batch_id = batchId;
      attrs.updated_at = now;
      if (email && optoutSet[email]) attrs.mail_optout = true; // 停止は絶対に維持
      // 追補17: 今回取り込む応募 (正規化後) がFSか + 既存行にFS登録歴があるか。
      // has_fs_history はこの2つの OR で true にする一方通行 (false は決して書かない)。
      var incomingFs = deriveFsHistory_({ source_company: input.source_company, hearing_json: attrs.hearing_json });
      var existingFs = existing ? hasFsHistory_(existing) : false;
      if (incomingFs || existingFs) attrs.has_fs_history = true;

      // R3 (X4): フロント判定と一致させる除外。新規登録はしない。
      // 既存行が一意に特定できた除外行については、登録・現在化はせず、
      // FS フラグの永続化だけを行う (全行送信の既存要件と両立させる)。
      var ageVal = null;
      if (input.birth_date) ageVal = ageFromBirth_(input.birth_date);
      else if (input.age !== undefined && input.age !== null && input.age !== '') ageVal = toNum_(input.age);
      var exclusion = '';
      if (candIds.length > 1) exclusion = '重複の確認が必要';
      else if (!attrs.name || (!phone && !email)) exclusion = '必須情報不備';
      else if (ageVal == null) exclusion = '年齢不明';
      else if (ageVal >= 63) exclusion = '年齢条件の対象外';
      else if (['kaigo', 'kango'].indexOf(str_(input.job_type)) < 0) exclusion = '対象職種以外';
      else if (str_(input.prefecture) &&
               KANSAI_PREFECTURES_.indexOf(str_(input.prefecture)) < 0 &&
               KANTO_PREFECTURES_.indexOf(str_(input.prefecture)) < 0) exclusion = '対象エリア以外';
      if (exclusion) {
        if (existing && (incomingFs || existingFs) && !toBool_(existing.has_fs_history)) {
          ensurePersisted_(existing);
          queuePatch_(existing, { has_fs_history: true, updated_at: now });
        }
        skip_(exclusion); return;
      }

      if (existing) {
        // 既存と同じ・古い応募は現在化しない (LIVE §12)。applied_at が既存以下なら除外。
        var exApplied = cellDateIso_(existing.applied_at), inApplied = cellDateIso_(input.applied_at);
        if (inApplied && exApplied && inApplied <= exApplied) {
          // FS登録歴フラグの永続化は担保する (追補17)
          if ((incomingFs || existingFs) && !toBool_(existing.has_fs_history)) {
            ensurePersisted_(existing);
            queuePatch_(existing, { has_fs_history: true, updated_at: now });
          }
          // R3 (I8): 属性のみ変更された行は黙って捨てない。最新応募の同一性
          // (applied_at / source_company) とステータス類は守ったまま、応募属性の
          // 差分だけを反映し「更新」に数える (冪等性 = 差分のみ)。
          var attrPatch = diffApplicantAttrs_(existing, attrs);
          if (Object.keys(attrPatch).length) {
            attrPatch.updated_at = now;
            attrPatch.import_batch_id = batchId;
            if (incomingFs || existingFs) attrPatch.has_fs_history = true;
            if (email && optoutSet[email]) attrPatch.mail_optout = true;
            ensurePersisted_(existing);
            queuePatch_(existing, attrPatch);
            queueEvent_(existing.applicant_id,
              '属性のみ更新 (応募日は既存が最新) batch=' + batchId);
            updated++; attrUpdated++;
            return;
          }
          skip_('既存と同じ・古い応募'); return;
        }
        // 会社照合は canonical で行う (原文は attrs.source_company のまま保持する)
        if (attrs.source_company) attrs.source_company = str_(input.source_company);
        ensurePersisted_(existing);
        queuePatch_(existing, attrs);
        queueEvent_(existing.applicant_id,
          '新規応募あり (再応募として最新化) batch=' + batchId +
          (attrs.source_company ? ' / ' + attrs.source_company : ''));
        updated++;
      } else {
        attrs.applicant_id = allocApplicantId_(); // R4 06-07: 連番予約から採番
        attrs.created_at = now;
        // 追補17: 新規行はフラグを明示値で永続化する (FS応募なら true、それ以外は false)
        attrs.has_fs_history = !!incomingFs;
        // R3 (T4): 新規行の csv_status は CSV の値をそのまま保持する
        // (従来は pickApplicantAttrs_ の対象外で常に '未対応' に潰れていた)。
        // 空のときだけ '未対応'。未知の値は未分類として表示側で扱う。
        attrs.csv_status = str_(input.csv_status) || '未対応';
        if (attrs.sms_sent === undefined) attrs.sms_sent = false;
        if (attrs.mail_optout === undefined) attrs.mail_optout = !!attrs.mail_optout;
        // 同一バッチ内の重複行が次の照合で当たるよう索引にも入れる (配列へ push)
        indexAdd_(byPhone, phone, attrs);
        indexAdd_(byEmail, email, attrs);
        if (str_(attrs.name)) indexAdd_(byNameBirth, nbKey, attrs);
        // R4 06-07: 実書き込みはバッファへ (イベント記録と added 加算は
        // フラッシュ成功時に行う)。200行たまったらその場でフラッシュする。
        pendingNew.push({ attrs: attrs, phone: phone, email: email, nbKey: nbKey });
        pendingIds[attrs.applicant_id] = true;
        if (pendingNew.length >= 200) flushNew_();
      }
    } catch (rowErr) {
      failedRows++;
      if (rowErrors.length < 5) rowErrors.push(errMsg_(rowErr));
      try { Logger.log('importCommit row failed batch=' + batchId + ': ' + errMsg_(rowErr)); } catch (e) {}
    }
    });

    // 残りの新規行を書き切ってから件数を確定させる (R4 06-07)。
    flushNew_();
    // R6: 既存行の更新とイベントも書き切ってから件数を確定させる。
    flushPatches_();
    flushEvents_();
    // F-03: 途中失敗時も「どこまで入ったか」が後から検証できるよう、
    // バッチ記録は常に行う (全件成功=complete / 1件でも失敗=partial + failed_count)。
    // R4 06-07: 記録は開始時に先行作成した running 行を更新して確定させる。
    // 先行作成できなかった場合と更新に失敗した場合は、従来どおり最終結果を
    // 新規行として残す (バッチ記録を欠かさないためのフォールバック)。
    // R6.5: プレビューとの差異と行失敗を note に残す。差異ゼロ・失敗ゼロなら空。
    var batchNote = '';
    if (previewCounts) {
      var pcA = toNum_(previewCounts.added) || 0;
      var pcU = toNum_(previewCounts.updated) || 0;
      var pcS = toNum_(previewCounts.skipped) || 0;
      if (pcA !== added || pcU !== updated || pcS !== skipped) {
        batchNote = 'プレビュー差異: プレビュー(新規' + pcA + '/更新' + pcU + '/除外' + pcS +
          ') → サーバー実績(新規' + added + '/更新' + updated + '/除外' + skipped + ')';
      }
    }
    if (failedRows) {
      batchNote += (batchNote ? ' / ' : '') + '行単位の処理失敗 ' + failedRows + '件 (詳細はサーバーログ)';
    }
    var finalStatus = failedRows ? 'partial' : 'complete';
    var finalBatch = {
      batch_id: batchId, kind: String(req.kind || 'applicants'), file_name: String(req.file_name || ''),
      row_count: rows.length, added_count: added, updated_count: updated, skipped_count: skipped,
      actor: me, created_at: now,
      status: finalStatus, failed_count: failedRows,
      client_op_id: clientOpId, chunk_seq: chunkSeq, note: batchNote
    };
    if (batchRecorded) {
      try {
        updateRowByPk_('import_batches', batchId, {
          added_count: added, updated_count: updated, skipped_count: skipped,
          status: finalStatus, failed_count: failedRows, note: batchNote
        });
      } catch (updErr) {
        try { appendRow_('import_batches', finalBatch); } catch (e) {}
      }
    } else {
      appendRow_('import_batches', finalBatch);
    }
    // R4 06-02: 戻り値はサーバー実績そのもの (新規/更新/除外の実件数 + 除外理由の
    // 内訳 + 行失敗) を含む。フロントはこれを集計してプレビューと突合する。
    return { batch_id: batchId, row_count: rows.length, added: added, updated: updated, skipped: skipped,
      attr_updated: attrUpdated,
      failed: failedRows, status: finalStatus, row_errors: rowErrors,
      coord_downgraded: coordDowngraded, coord_reasons: coordReasons,
      client_op_id: clientOpId, chunk_seq: chunkSeq,
      skipped_reasons: skippedReasons, note: batchNote };
  });
  } catch (commitErr) {
    // R6.5: 処理開始後の致命的中断はバッチを failed として残す
    // (running のまま放置すると「処理中なのか失敗なのか」判別できなくなる)。
    // 生エラーはサーバーログ側に残し、画面向けの翻訳はフロントが行う。
    if (r65Batch.id) {
      try {
        // status は 'running' のまま残す (R4 06-07 の不変条件: 先行作成した
        // バッチ記録は途中死でも残る)。中断したことは note と failed_count で
        // 記録し、画面側は「running + 中断note」を失敗として表示・再実行可能にする。
        updateRowByPk_('import_batches', r65Batch.id, {
          failed_count: rows.length,
          note: '処理中に中断しました: ' + errMsg_(commitErr)
        });
      } catch (e) {}
    }
    throw commitErr;
  }
}

/**
 * 案件取り込み修正 (案B): 案件専用バルク取り込みコア。
 * 従来の案件経路 (pushCasesFromAiPage → upsertCaseFromSource_ の行ごと全表読み)
 * では 7,221 件規模が Apps Script の実行時間上限に収まらない (監査 C-2) ため、
 * 応募者の importCommitCore_ と同じ作法で新設した:
 * - チャンクごとに cases / case_sources を各1回だけ読み、(source, source_case_key)
 *   の索引をメモリに構築して照合する (行ごとの読み直しはしない)。
 * - 新規行は最大IDからの連番一括予約 + appendRows_ (setValues 一括) で書く。
 *   更新行は行番号が判明しているため、メモリ上で patch を適用し、チャンク末尾に
 *   「行まるごと setValues」へまとめる (case_sources 側も同じ)。
 * - import_batches に kind='cases' で記録する (running 先行作成 → 実績で確定。
 *   中断時は status='running' のまま note + failed_count を残す R6.5 不変条件)。
 * - 冪等性は (client_op_id, chunk_seq) の完了バッチ再生 + (source, source_case_key)
 *   の既存照合の二重構え (応募者側と同一水準)。
 * - 照合・更新セマンティクスは upsertCaseFromSource_ と同一に保つ: 空値で既存を
 *   潰さない、source_flags に出所を加える、座標は acceptCoord_ を通し、原文は
 *   case_sources.raw_json に残す。新規案件はマッチ提案の生成待ちキューに積む
 *   (一括版 enqueueMatchProposalCasesBulk_ で settings の読み書きはチャンク1回)。
 * req: { file_name, kind:'cases', rows:[{...案件フィールド, source, source_case_key}] }
 */
function importCasesCommitCore_(req, me) {
  var rows = req.rows || [];
  if (!rows.length) throw new Error('rows が空です');
  if (rows.length > 5000) throw new Error('1回の取り込みは 5000 行までです (分割してください)');
  var clientOpId = str_(req.client_op_id || '');
  var chunkSeq = (req.chunk_seq === undefined || req.chunk_seq === null || req.chunk_seq === '') ? '' : req.chunk_seq;
  var previewCounts = (req.preview_counts && typeof req.preview_counts === 'object') ? req.preview_counts : null;
  var r65Batch = { id: null };
  try {
  return withLock_(function () {
    if (clientOpId) {
      var prevBatches = readTable_('import_batches').rows;
      for (var bi = 0; bi < prevBatches.length; bi++) {
        var pb = prevBatches[bi];
        if (str_(pb.client_op_id) === clientOpId &&
            String(pb.chunk_seq == null ? '' : pb.chunk_seq) === String(chunkSeq) &&
            str_(pb.kind) === 'cases' &&
            str_(pb.status) === 'complete') {
          return { batch_id: pb.batch_id, kind: 'cases', row_count: toNum_(pb.row_count) || rows.length,
            added: toNum_(pb.added_count) || 0, updated: toNum_(pb.updated_count) || 0,
            skipped: toNum_(pb.skipped_count) || 0,
            failed: toNum_(pb.failed_count) || 0, status: str_(pb.status),
            row_errors: [], note: str_(pb.note),
            idempotent_replay: true, client_op_id: clientOpId, chunk_seq: chunkSeq };
        }
      }
    }
    var batchId = nextId_('import_batches');
    var now = nowIso_();
    var batchRecorded = false;
    try {
      appendRow_('import_batches', {
        batch_id: batchId, kind: 'cases', file_name: String(req.file_name || ''),
        row_count: rows.length, added_count: 0, updated_count: 0, skipped_count: 0,
        actor: me, created_at: now, status: 'running', failed_count: 0,
        client_op_id: clientOpId, chunk_seq: chunkSeq
      });
      batchRecorded = true;
      r65Batch.id = batchId;
    } catch (batchErr) {
      try { Logger.log('importCasesCommit batch pre-create failed batch=' + batchId + ': ' + errMsg_(batchErr)); } catch (e) {}
    }
    // チャンクで1回だけ読む (cases / case_sources)。以降はメモリ索引で照合する。
    var casesT = readTable_('cases');
    var srcT = readTable_('case_sources');
    var srcIndex = {}; // 'source|source_case_key' -> case_sources 行
    srcT.rows.forEach(function (r) {
      srcIndex[str_(r.source) + '|' + str_(r.source_case_key)] = r;
    });
    var caseById = {}; // case_id -> cases 行
    casesT.rows.forEach(function (r) { caseById[str_(r.case_id)] = r; });
    // 新規案件の採番は開始時点の最大番号からの連番予約 (行ごとの nextId_ 全表走査をしない)
    var casePrefix = ID_PREFIX_['cases'] || 'C';
    var caseSeq = 0;
    casesT.rows.forEach(function (r) {
      var m = String(r.case_id || '').match(new RegExp('^' + casePrefix + '(\\d+)$'));
      if (m) caseSeq = Math.max(caseSeq, parseInt(m[1], 10));
    });
    function allocCaseId_() {
      caseSeq++;
      var n = String(caseSeq);
      while (n.length < 6) n = '0' + n;
      return casePrefix + n;
    }
    // 座標の同一重複 (c) はバッチ + 既存全体で事前に数える (応募者側と同じ作法)。
    // 住所キーは cases の address 列そのもの (upsertCaseFromSource_ の集計と同一)。
    var coordDupMap = coordDupCountMap_(
      rows.concat(casesT.rows).map(function (r) {
        return { lat: r.lat, lon: r.lon, addressKey: str_(r.address) };
      }), municipalityRepKeys_());
    var coordDowngraded = 0;
    var coordReasons = {};

    var added = 0, updated = 0, failedRows = 0, rowErrors = [];
    // 新規行の書き込みバッファ (200行ごとに appendRows_ で一括フラッシュ)
    var pendingNew = []; // {row, srcRow, sKey}
    var newCaseIds = [];
    function flushNew_() {
      if (!pendingNew.length) return;
      var batch = pendingNew;
      pendingNew = [];
      // 書き込み先の開始行を控える (ロック内で直列化されているため確定できる)。
      // 成功した行には _row を割り当て、同一チャンク内の後続の更新行が
      // flushPatches_ で「行まるごと setValues」に乗るようにする。
      var startRow = 0;
      try { startRow = sheet_('cases').getLastRow() + 1; } catch (e) { startRow = 0; }
      var res = appendRows_('cases', batch.map(function (p) { return p.row; }));
      var failedIdx = {};
      res.errors.forEach(function (e) { failedIdx[e.index] = true; });
      var okSrc = [];
      var okCount = 0;
      batch.forEach(function (p, i) {
        if (failedIdx[i]) {
          failedRows++;
          if (rowErrors.length < 5) rowErrors.push('案件の書き込みに失敗しました: ' + p.row.case_id);
          // 書けなかった行は索引から外す (後続行が実在しない行を更新対象にしない)
          delete srcIndex[p.sKey];
          delete caseById[p.row.case_id];
          var ni = newCaseIds.indexOf(p.row.case_id);
          if (ni >= 0) newCaseIds.splice(ni, 1);
          try { Logger.log('importCasesCommit case write failed batch=' + batchId + ': ' + p.row.case_id); } catch (e2) {}
          return;
        }
        if (startRow) p.row._row = startRow + okCount;
        okCount++;
        okSrc.push(p.srcRow);
        added++;
      });
      if (okSrc.length) {
        var startRowS = 0;
        try { startRowS = sheet_('case_sources').getLastRow() + 1; } catch (e) { startRowS = 0; }
        var res2 = appendRows_('case_sources', okSrc);
        var failedSrc = {};
        res2.errors.forEach(function (e) {
          failedSrc[e.index] = true;
          failedRows++;
          if (rowErrors.length < 5) rowErrors.push('案件の出所記録の書き込みに失敗しました');
          try { Logger.log('importCasesCommit source write failed batch=' + batchId + ': ' + e.message); } catch (e2) {}
        });
        if (startRowS) {
          var okS = 0;
          okSrc.forEach(function (sr, i) { if (!failedSrc[i]) { sr._row = startRowS + okS; okS++; } });
        }
      }
    }
    // 既存行の更新はメモリ上で patch を適用し、末尾に「行まるごと setValues」へまとめる
    var pendingCasePatch = {}; // case_id -> cases 行 (patch 適用済み)
    var pendingSrcPatch = {};  // 'source|key' -> case_sources 行 (raw_json/imported_at 適用済み)
    function flushPatches_() {
      var cIds = Object.keys(pendingCasePatch);
      var sRows = Object.keys(pendingSrcPatch).map(function (k) { return pendingSrcPatch[k]; });
      pendingCasePatch = {}; pendingSrcPatch = {};
      if (cIds.length) {
        var shC = null;
        try { shC = sheet_('cases'); } catch (e) { shC = null; }
        cIds.forEach(function (id) {
          var rowObj = caseById[id];
          if (!rowObj || !rowObj._row) return;
          try {
            if (!shC) throw new Error('sheet unavailable');
            var arr = casesT.headers.map(function (h) { return rowObj[h] == null ? '' : rowObj[h]; });
            shC.getRange(rowObj._row, 1, 1, casesT.headers.length).setValues([arr]);
          } catch (e) {
            failedRows++;
            if (rowErrors.length < 5) rowErrors.push(errMsg_(e));
            try { Logger.log('importCasesCommit patch write failed batch=' + batchId + ': ' + errMsg_(e)); } catch (e2) {}
          }
        });
      }
      if (sRows.length) {
        var shS = null;
        try { shS = sheet_('case_sources'); } catch (e) { shS = null; }
        sRows.forEach(function (rowObj) {
          if (!rowObj || !rowObj._row) return;
          try {
            if (!shS) throw new Error('sheet unavailable');
            var arr = srcT.headers.map(function (h) { return rowObj[h] == null ? '' : rowObj[h]; });
            shS.getRange(rowObj._row, 1, 1, srcT.headers.length).setValues([arr]);
          } catch (e) {
            failedRows++;
            if (rowErrors.length < 5) rowErrors.push(errMsg_(e));
            try { Logger.log('importCasesCommit source patch write failed batch=' + batchId + ': ' + errMsg_(e)); } catch (e2) {}
          }
        });
      }
    }
    rows.forEach(function (input) {
    try {
      if (!input || typeof input !== 'object') throw new Error('案件データが空です');
      var source = String(input.source || 'csv').trim() || 'csv';
      if (CASE_SYNC_SOURCES_.indexOf(source) < 0) {
        throw new Error('source は ' + CASE_SYNC_SOURCES_.join('/') + ' のいずれかです: ' + source);
      }
      var srcObj = input.case_source || {};
      var sourceCaseKey = String(input.source_case_key || srcObj.source_case_key || '').trim();
      if (!sourceCaseKey) throw new Error('source_case_key が必要です (冪等キーの一部です)');
      var raw = srcObj.raw_json || input.raw_json || input;
      var rawJson = (typeof raw === 'string') ? raw : JSON.stringify(raw);
      // 入力から案件フィールドだけを拾う (upsertCaseFromSource_ と同じホワイトリスト。
      // 空値は含めない = 既存値を空で潰さない)
      var fields = {};
      CASE_SYNC_FIELDS_.forEach(function (k) {
        if (k === 'case_id' || k === 'created_at' || k === 'updated_at' || k === 'source_flags') return;
        if (input[k] !== undefined && input[k] !== null && input[k] !== '') fields[k] = input[k];
      });
      if (fields.is_open !== undefined) fields.is_open = toBool_(fields.is_open);
      if (!fields.updated_at_src) fields.updated_at_src = now;
      fields.updated_at = now;
      // 座標の受け入れ判定 (upsert と同一規則。重複数は事前集計マップから引く)
      if (fields.lat !== undefined || fields.lon !== undefined) {
        var rep = municipalityRepPoint_(fields.prefecture || input.prefecture,
          fields.municipality || input.municipality);
        var inKey = coordKey_(fields.lat, fields.lon);
        var dupCount = inKey ? (coordDupMap[inKey] === undefined ? null : coordDupMap[inKey]) : null;
        var acc = acceptCoord_(fields.lat, fields.lon, rep, dupCount);
        if (acc.verdict === 'downgraded') {
          fields.lat = ''; fields.lon = '';
          coordDowngraded++;
          coordReasons[acc.reason] = (coordReasons[acc.reason] || 0) + 1;
        } else if (acc.verdict === 'precise') { fields.lat = acc.lat; fields.lon = acc.lon; }
      }
      var sKey = source + '|' + sourceCaseKey;
      var existingSrc = srcIndex[sKey];
      if (existingSrc) {
        var caseId = str_(existingSrc.case_id);
        var crow = caseById[caseId];
        if (!crow) throw new Error('case_sources に対応する案件が見つかりません: ' + caseId);
        Object.keys(fields).forEach(function (k) { crow[k] = fields[k]; });
        crow.source_flags = mergeSourceFlags_(crow.source_flags, source);
        if (!crow.facility_name_norm && crow.facility_name) {
          crow.facility_name_norm = String(crow.facility_name).replace(/\s+/g, '');
        }
        // 未フラッシュの新規行を更新対象にする場合は、先に書き込みを確定させる
        if (!crow._row) flushNew_();
        pendingCasePatch[caseId] = crow;
        existingSrc.raw_json = rawJson;
        existingSrc.imported_at = now;
        pendingSrcPatch[sKey] = existingSrc;
        updated++;
      } else {
        var newId = allocCaseId_();
        var row = {
          case_id: newId, facility_id: '', facility_name: '', facility_name_norm: '',
          corporation_name: '', prefecture: '', municipality: '', address: '', lat: '', lon: '',
          job_type: '', service_type: '', employment_type: '', title: '', description: '',
          nearest_station: '', salary_text: '', is_open: true, merged_from: '',
          created_at: now
        };
        Object.keys(fields).forEach(function (k) { row[k] = fields[k]; });
        row.source_flags = mergeSourceFlags_('', source);
        if (!row.facility_name_norm && row.facility_name) {
          row.facility_name_norm = String(row.facility_name).replace(/\s+/g, '');
        }
        var srcRow = { case_id: newId, source: source, source_case_key: sourceCaseKey,
          raw_json: rawJson, imported_at: now };
        pendingNew.push({ row: row, srcRow: srcRow, sKey: sKey });
        srcIndex[sKey] = srcRow;
        caseById[newId] = row;
        newCaseIds.push(newId);
        if (pendingNew.length >= 200) flushNew_();
      }
    } catch (rowErr) {
      failedRows++;
      if (rowErrors.length < 5) rowErrors.push(errMsg_(rowErr));
      try { Logger.log('importCasesCommit row failed batch=' + batchId + ': ' + errMsg_(rowErr)); } catch (e) {}
    }
    });

    flushNew_();
    flushPatches_();
    // 新規案件だけ生成待ちキューに積む (upsert と同じ。読み書きはチャンクで1回に集約)
    if (newCaseIds.length) enqueueMatchProposalCasesBulk_(newCaseIds);
    // バッチ記録の確定 (応募者側と同じ: プレビュー差異と行失敗を note に残す)
    var batchNote = '';
    if (previewCounts) {
      var pcA = toNum_(previewCounts.added) || 0;
      var pcU = toNum_(previewCounts.updated) || 0;
      var pcS = toNum_(previewCounts.skipped) || 0;
      if (pcA !== added || pcU !== updated || pcS !== 0) {
        batchNote = 'プレビュー差異: プレビュー(新規' + pcA + '/更新' + pcU + '/除外' + pcS +
          ') → サーバー実績(新規' + added + '/更新' + updated + '/除外0)';
      }
    }
    if (failedRows) {
      batchNote += (batchNote ? ' / ' : '') + '行単位の処理失敗 ' + failedRows + '件 (詳細はサーバーログ)';
    }
    var finalStatus = failedRows ? 'partial' : 'complete';
    var finalBatch = {
      batch_id: batchId, kind: 'cases', file_name: String(req.file_name || ''),
      row_count: rows.length, added_count: added, updated_count: updated, skipped_count: 0,
      actor: me, created_at: now,
      status: finalStatus, failed_count: failedRows,
      client_op_id: clientOpId, chunk_seq: chunkSeq, note: batchNote
    };
    if (batchRecorded) {
      try {
        updateRowByPk_('import_batches', batchId, {
          added_count: added, updated_count: updated, skipped_count: 0,
          status: finalStatus, failed_count: failedRows, note: batchNote
        });
      } catch (updErr) {
        try { appendRow_('import_batches', finalBatch); } catch (e) {}
      }
    } else {
      appendRow_('import_batches', finalBatch);
    }
    return { batch_id: batchId, kind: 'cases', row_count: rows.length, added: added, updated: updated,
      skipped: 0, failed: failedRows, status: finalStatus, row_errors: rowErrors,
      coord_downgraded: coordDowngraded, coord_reasons: coordReasons,
      client_op_id: clientOpId, chunk_seq: chunkSeq, note: batchNote };
  });
  } catch (commitErr) {
    if (r65Batch.id) {
      try {
        updateRowByPk_('import_batches', r65Batch.id, {
          failed_count: rows.length,
          note: '処理中に中断しました: ' + errMsg_(commitErr)
        });
      } catch (e) {}
    }
    throw commitErr;
  }
}

/** 新規案件の生成待ちキューへの一括登録 (enqueueMatchProposalCase_ の一括版)。
 * settings の読み取り・書き込みをチャンクで各1回に集約する。失敗しても
 * 取り込み自体は成功として扱う (単件版と同じ)。ロック取得済みの文脈から呼ぶこと。 */
function enqueueMatchProposalCasesBulk_(caseIds) {
  try {
    var cur = toList_(getSettingValue_(MATCH_QUEUE_SETTING_KEY, ''));
    var have = {};
    cur.forEach(function (id) { have[id] = true; });
    var changed = false;
    (caseIds || []).forEach(function (id) {
      id = String(id);
      if (!have[id]) { cur.push(id); have[id] = true; changed = true; }
    });
    if (!changed) return;
    var exists = false;
    readTable_('settings').rows.forEach(function (r) { if (String(r.key) === MATCH_QUEUE_SETTING_KEY) exists = true; });
    if (exists) updateRowByPk_('settings', MATCH_QUEUE_SETTING_KEY, { value: cur.join(',') });
    else appendRow_('settings', { key: MATCH_QUEUE_SETTING_KEY, value: cur.join(',') });
  } catch (e) { /* キュー積みに失敗しても案件取り込み自体は成功として扱う */ }
}

// ===== R6.5: 大ファイル取り込みのサーバー側継続処理 (キュー) =====
/**
 * 背景: 数千行の取り込みはフロントがチャンクを送り続ける方式だと、アプリを
 * 閉じた時点で止まってしまう。そこで大ファイルでは、フロントはまず全チャンクを
 * import_queue に「登録」だけし (1チャンク=500行の一括 append で速い)、実際の
 * 照合・書き込みは時間主導トリガー processImportQueue が importCommitCore_ で
 * 行う。アプリを閉じてもサーバー側で最後まで処理され、次に開いたときに
 * getImportStatus (totals.queue + batches) で進捗・完了が分かる。
 * 冪等性: (client_op_id, chunk_seq) で登録・処理とも重複を防ぐ。再登録は
 * already_queued / already_complete を返して何もしない。
 */

/** チャンクをキューに登録する (照合はしない)。 */
function actionImportEnqueue_(req) {
  var me = requireKikariUser_();
  var rows = req.rows || [];
  if (!rows.length) throw new Error('rows が空です');
  if (rows.length > 5000) throw new Error('1回の登録は 5000 行までです (分割してください)');
  var clientOpId = str_(req.client_op_id || '');
  if (!clientOpId) throw new Error('client_op_id が必要です');
  var chunkSeq = (req.chunk_seq === undefined || req.chunk_seq === null || req.chunk_seq === '') ? '' : req.chunk_seq;
  return withLock_(function () {
    var batches = readTable_('import_batches').rows;
    for (var i = 0; i < batches.length; i++) {
      var b = batches[i];
      if (str_(b.client_op_id) === clientOpId && String(b.chunk_seq === undefined || b.chunk_seq === null ? '' : b.chunk_seq) === String(chunkSeq) && str_(b.status) === 'complete') {
        return { registered: false, reason: 'already_complete', batch_id: str_(b.batch_id), client_op_id: clientOpId, chunk_seq: chunkSeq };
      }
    }
    var q = readTable_('import_queue');
    var existing = 0, maxQ = 0;
    q.rows.forEach(function (r) {
      var m = /^IQ(\d+)$/.exec(str_(r.queue_id));
      if (m) maxQ = Math.max(maxQ, parseInt(m[1], 10));
      if (str_(r.client_op_id) === clientOpId && String(r.chunk_seq === undefined || r.chunk_seq === null ? '' : r.chunk_seq) === String(chunkSeq)) existing++;
    });
    if (existing) return { registered: false, reason: 'already_queued', queued_rows: existing, client_op_id: clientOpId, chunk_seq: chunkSeq };
    var now = nowIso_();
    var metaJson = JSON.stringify({ preview_counts: req.preview_counts || null });
    var objs = rows.map(function (r, i) {
      maxQ++;
      return { queue_id: 'IQ' + ('000000' + maxQ).slice(-6), client_op_id: clientOpId, chunk_seq: chunkSeq, row_seq: i,
        file_name: str_(req.file_name || ''), kind: str_(req.kind || 'applicants'), target_area: str_(req.target_area || ''),
        actor: me, payload_json: JSON.stringify(r || {}), meta_json: metaJson,
        status: 'pending', batch_id: '', created_at: now, processed_at: '' };
    });
    appendRows_('import_queue', objs);
    ensureImportQueueTrigger_();
    return { registered: true, queued_rows: objs.length, client_op_id: clientOpId, chunk_seq: chunkSeq };
  });
}

/** 継続処理トリガーを設置する (既にあれば何もしない)。ベストエフォート。 */
function ensureImportQueueTrigger_() {
  try {
    if (typeof ScriptApp === 'undefined' || !ScriptApp.newTrigger) return false;
    var triggers = ScriptApp.getProjectTriggers();
    for (var i = 0; i < triggers.length; i++) {
      if (triggers[i].getHandlerFunction && triggers[i].getHandlerFunction() === 'processImportQueue') return true;
    }
    ScriptApp.newTrigger('processImportQueue').timeBased().everyMinutes(1).create();
    return true;
  } catch (e) { return false; }
}

/** import_queue の指定列を、行オブジェクト群に対して連続範囲でまとめて書く。 */
function writeQueueColumn_(sh, rows, colIdx, value) {
  if (!sh || colIdx < 0 || !rows.length) return;
  var nums = rows.map(function (r) { return r._row; }).sort(function (a, b) { return a - b; });
  var start = nums[0], len = 1;
  for (var i = 1; i <= nums.length; i++) {
    if (i < nums.length && nums[i] === start + len) { len++; continue; }
    var vals = [];
    for (var k = 0; k < len; k++) vals.push([value]);
    sh.getRange(start, colIdx + 1, len, 1).setValues(vals);
    start = nums[i]; len = 1;
  }
}

/** 最も古い pending チャンクを1つ claim する (短いロックで processing にする)。
 * processing のまま15分以上経ったチャンクは中断とみなして再び拾う。 */
function claimNextImportChunk_() {
  var claim = null;
  withLock_(function () {
    var t = readTable_('import_queue');
    var nowMs = Date.now();
    var groups = {}, order = [];
    t.rows.forEach(function (r) {
      var st = str_(r.status);
      var stale = st === 'processing' && r.processed_at && (nowMs - Date.parse(str_(r.processed_at)) > 15 * 60 * 1000);
      if (st !== 'pending' && !stale) return;
      var key = str_(r.client_op_id) + '|' + String(r.chunk_seq === undefined || r.chunk_seq === null ? '' : r.chunk_seq);
      if (!groups[key]) { groups[key] = []; order.push(key); }
      groups[key].push(r);
    });
    if (!order.length) return;
    var grows = groups[order[0]].slice().sort(function (a, b) { return (toNum_(a.row_seq) || 0) - (toNum_(b.row_seq) || 0); });
    var sh = sheet_('import_queue');
    var nowIso = nowIso_();
    writeQueueColumn_(sh, grows, t.headers.indexOf('status'), 'processing');
    writeQueueColumn_(sh, grows, t.headers.indexOf('processed_at'), nowIso);
    var first = grows[0];
    var meta = {};
    try { meta = JSON.parse(str_(first.meta_json) || '{}'); } catch (e) { meta = {}; }
    var rows = grows.map(function (r) { try { return JSON.parse(str_(r.payload_json) || '{}'); } catch (e) { return {}; } });
    claim = { queueIds: grows.map(function (r) { return str_(r.queue_id); }), actor: str_(first.actor),
      req: { file_name: str_(first.file_name), kind: str_(first.kind || 'applicants'), rows: rows,
        client_op_id: str_(first.client_op_id),
        chunk_seq: (first.chunk_seq === undefined || first.chunk_seq === null) ? '' : first.chunk_seq,
        preview_counts: meta.preview_counts || null } };
  });
  return claim;
}

/** 処理済みチャンクのキュー行を始末する。成功時は行を削除し (履歴は import_batches が正)、
 * 失敗時は failed として残す (claim 対象から外れ、原因調査に使える)。 */
function finishImportChunk_(group, res, err) {
  withLock_(function () {
    var t = readTable_('import_queue');
    var byId = {};
    t.rows.forEach(function (r) { byId[str_(r.queue_id)] = r; });
    var rows = group.queueIds.map(function (id) { return byId[id]; }).filter(function (r) { return !!r; });
    if (!rows.length) return;
    var sh = sheet_('import_queue');
    if (!err) {
      var deleted = false;
      try {
        if (sh && typeof sh.deleteRows === 'function') {
          var nums = rows.map(function (r) { return r._row; }).sort(function (a, b) { return b - a; });
          var runTop = nums[0], runLen = 1;
          for (var i = 1; i <= nums.length; i++) {
            if (i < nums.length && nums[i] === runTop - runLen) { runLen++; continue; }
            sh.deleteRows(runTop - runLen + 1, runLen);
            runTop = nums[i]; runLen = 1;
          }
          deleted = true;
        }
      } catch (e) { deleted = false; }
      if (deleted) return;
    }
    writeQueueColumn_(sh, rows, t.headers.indexOf('status'), err ? 'failed' : 'done');
    if (res) writeQueueColumn_(sh, rows, t.headers.indexOf('batch_id'), str_(res.batch_id));
    writeQueueColumn_(sh, rows, t.headers.indexOf('processed_at'), nowIso_());
  });
}

/**
 * 時間主導トリガーの入口。キューが空になるまで (1回の実行では最大3チャンク /
 * 約4分まで) 処理する。ロックは claim / finish の短い区間と importCommitCore_
 * 内部でのみ取る (二重ロックで待たせない)。
 */
function processImportQueue() {
  var startedAt = Date.now();
  var processed = 0, errors = 0;
  while (processed < 3 && Date.now() - startedAt < 240000) {
    var group = claimNextImportChunk_();
    if (!group) break;
    var res = null, err = null;
    // 案件取り込み修正 (案B): kind='cases' のチャンクは案件コアへ振り分ける
    // (従来は kind を見ずに応募者コアへ渡しており、案件行が応募者として
    // 照合・記録される誤処理になった。監査 C-4)。
    try { res = (group.req && group.req.kind === 'cases')
      ? importCasesCommitCore_(group.req, group.actor)
      : importCommitCore_(group.req, group.actor); }
    catch (e) { err = e; errors++; }
    try { finishImportChunk_(group, res, err); } catch (e2) { /* 始末に失敗しても次回の stale 回収で拾う */ }
    processed++;
  }
  return { processed_chunks: processed, errors: errors };
}

// ===== R6.6 P3(b)/P4: 電話・area のデータ修復 (ドライラン付き移行関数) =====
/**
 * 電話列の書式化 + 先頭0落ちの修復。POOL_DIAGNOSIS §4(b) のデータ不整合の是正。
 * 原因: appendRow_/setValues の USER_ENTERED 解釈で数字文字列が数値化され、
 * 先頭0が落ちた (例: 08091251382 → 8091251382)。その結果 sms_target 判定と
 * 電話キー照合が全行不発になっている。手順は PHONE_MIGRATION.md 参照。
 * 実行前に必ずシートのバックアップを取ること。
 * req: { dry_run: true/false (既定 true) }
 * dry_run=true: 変更内容だけを返し、何も書かない。
 * dry_run=false: 電話列を文字列書式 ('@') にしてから、修復対象をバルク setValues
 *   (連続行は1回の setValues にまとめる。writeColumnRuns_) で書く。
 *   冪等 (2回目は何もしない)。
 * 判定 (planPhoneRepair_): 日本の電話番号は必ず 0 始まりであることを利用する。
 *  - 携帯: 10桁で [789]0 始まり → 0 を補う (090/080/070)。
 *  - 固定: 0を補った形が既知の市外局番で始まり、原則10桁 (050 のみ11桁) → 0 を補う。
 *    0120/0800/0570 も同様。
 *  - 上記のいずれにも当てはまらない行は「要人手判断」として needs_manual に回し、
 *    推測で補完しない。電話が空の行は no_phone として数えるだけ。
 */
function planPhoneRepair_(rawPhone) {
  var rawDigits = str_(rawPhone).replace(/[^0-9０-９]/g, '').replace(/[０-９]/g, function (c) {
    return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
  });
  if (!rawDigits) return { action: 'empty' };
  var digits = normalizePhoneDigits_(rawPhone);
  if (digits.charAt(0) === '0') {
    // 既に 0 始まり。+81 形や全角で格納されていた場合のみ正規形へ寄せる。
    if (rawDigits !== digits) {
      if (/^0[789]0\d{8}$/.test(digits) || isPlausibleLandline_(digits)) {
        return { action: 'repair', repaired: digits, kind: 'normalize' };
      }
      return { action: 'manual', reason: '正規化後の番号が携帯・固定のいずれの形にも合わない: ' + digits };
    }
    // 0 始まりでも、携帯 (11桁)・固定 (原則10桁/050は11桁) のいずれの形にも
    // 合わなければ要人手判断にする (例: 途中で1桁欠けた 090... (10桁))。
    // 黙って ok にすると欠損番号が見えなくなる。
    if (/^0[789]0\d{8}$/.test(digits) || isPlausibleLandline_(digits)) return { action: 'ok' };
    return { action: 'manual', reason: '0始まりだが携帯・固定のいずれの形にも合わない: ' + digits };
  }
  // 先頭0落ちの疑い。
  if (digits.length === 10 && /^[789]0/.test(digits)) {
    return { action: 'repair', repaired: '0' + digits, kind: 'mobile' };
  }
  if (digits.length === 9 || digits.length === 10) {
    var cand = '0' + digits;
    if (isPlausibleLandline_(cand)) return { action: 'repair', repaired: cand, kind: 'landline' };
  }
  return { action: 'manual', reason: '桁数・市外局番から判定できない: ' + digits };
}

/** 0 始まりの電話番号が固定電話として妥当か (市外局番プレフィクス + 桁数)。
 * 固定電話は原則10桁、050 (IP電話) のみ11桁。携帯 (090/080/070) は対象外。 */
function isPlausibleLandline_(candidate) {
  if (!candidate || candidate.charAt(0) !== '0') return false;
  if (candidate.indexOf('050') === 0) return candidate.length === 11;
  if (candidate.length !== 10) return false;
  // 最長一致で市外局番プレフィクスを確認する (0120/0800/0570 が先)。
  var codes = PHONE_AREA_CODES_.slice().sort(function (a, b) { return b.length - a.length; });
  for (var i = 0; i < codes.length; i++) {
    if (candidate.indexOf(codes[i]) === 0) return true;
  }
  return false;
}

/** 指定列を指定行へバルクで書く。連続する行は1回の setValues にまとめる。
 * pairs: [{ row: シート行番号, value }]。戻り値は setValues の呼び出し回数。 */
function writeColumnRuns_(sh, colIdx, pairs) {
  if (!sh || colIdx < 0 || !pairs.length) return 0;
  var sorted = pairs.slice().sort(function (a, b) { return a.row - b.row; });
  var calls = 0;
  var start = sorted[0].row, vals = [[sorted[0].value]];
  for (var i = 1; i <= sorted.length; i++) {
    if (i < sorted.length && sorted[i].row === start + vals.length) { vals.push([sorted[i].value]); continue; }
    sh.getRange(start, colIdx + 1, vals.length, 1).setValues(vals);
    calls++;
    if (i < sorted.length) { start = sorted[i].row; vals = [[sorted[i].value]]; }
  }
  return calls;
}

function actionRepairPhones_(req) {
  requireKikariUser_();
  var dryRun = !(req && req.dry_run === false);
  return withLock_(function () {
    var t = readTable_('applicants');
    var phoneCol = t.headers.indexOf('phone');
    if (phoneCol < 0) throw new Error('applicants に phone 列がありません');
    var repaired = [], needsManual = [];
    var alreadyOk = 0, noPhone = 0;
    var pairs = [];
    t.rows.forEach(function (r) {
      var plan = planPhoneRepair_(r.phone);
      if (plan.action === 'ok') { alreadyOk++; return; }
      if (plan.action === 'empty') { noPhone++; return; }
      if (plan.action === 'repair') {
        repaired.push({ applicant_id: str_(r.applicant_id), old_phone: str_(r.phone),
          new_phone: plan.repaired, kind: plan.kind });
        if (r._row) pairs.push({ row: r._row, value: plan.repaired });
        return;
      }
      needsManual.push({ applicant_id: str_(r.applicant_id), phone: str_(r.phone), reason: plan.reason });
    });
    var formatSet = false, setValuesCalls = 0;
    if (!dryRun && pairs.length) {
      var sh = sheet_('applicants');
      // 書き込み前に電話列を文字列書式にする (USER_ENTERED の数値化で先頭0が
      // 再び落ちるのを防ぐ。これが無いと修復が無意味になる)。
      try {
        var lastRow = sh.getLastRow();
        if (lastRow > 1) {
          sh.getRange(2, phoneCol + 1, lastRow - 1, 1).setNumberFormat('@');
          formatSet = true;
        }
      } catch (e) { formatSet = false; }
      setValuesCalls = writeColumnRuns_(sh, phoneCol, pairs);
    }
    return { dry_run: dryRun, scanned: t.rows.length, already_ok: alreadyOk, no_phone: noPhone,
      repaired_count: repaired.length, repaired: repaired,
      needs_manual_count: needsManual.length, needs_manual: needsManual,
      format_set: formatSet, written: dryRun ? 0 : pairs.length,
      set_values_calls: setValuesCalls };
  });
}

/**
 * R6.6 P4: area 未設定行の修復。POOL_DIAGNOSIS §3.3 の 12行 (is_test 2行を除く
 * 総数差) の是正。手順は AREA_MIGRATION.md 参照。実行前に必ずバックアップを取ること。
 * req: { dry_run: true/false (既定 true) }。dry_run=true は変更内容だけを返し、
 * 何も書かない。dry_run=false は prefecture/area 列をバルク setValues で書く。
 * 冪等 (2回目は何もしない)。
 */
function planAreaRepair_(r) {
  var area = str_(r.area);
  if (area === 'kansai' || area === 'kanto') return { action: 'ok' };
  var pref = str_(r.prefecture);
  if (pref) {
    if (KANSAI_PREFECTURES_.indexOf(pref) >= 0) return { action: 'repair', prefecture: pref, area: 'kansai', source: 'prefecture' };
    if (KANTO_PREFECTURES_.indexOf(pref) >= 0) return { action: 'repair', prefecture: pref, area: 'kanto', source: 'prefecture' };
    return { action: 'manual', reason: '都道府県が関西・関東のいずれでもない: ' + pref };
  }
  // 都道府県が空の場合のみ、住所 (address_rest) の先頭が都道府県名で始まる場合に補完する。
  var addr = str_(r.address_rest);
  var hit = '';
  for (var i = 0; i < PREFECTURES_.length; i++) {
    if (addr.indexOf(PREFECTURES_[i]) === 0) { hit = PREFECTURES_[i]; break; }
  }
  if (hit) {
    if (KANSAI_PREFECTURES_.indexOf(hit) >= 0) return { action: 'repair', prefecture: hit, area: 'kansai', source: 'address_head' };
    if (KANTO_PREFECTURES_.indexOf(hit) >= 0) return { action: 'repair', prefecture: hit, area: 'kanto', source: 'address_head' };
    return { action: 'manual', reason: '住所先頭の都道府県が関西・関東外: ' + hit };
  }
  return { action: 'manual', reason: '都道府県・住所から導出できない' };
}

function actionRepairArea_(req) {
  requireKikariUser_();
  var dryRun = !(req && req.dry_run === false);
  return withLock_(function () {
    var t = readTable_('applicants');
    var prefCol = t.headers.indexOf('prefecture');
    var areaCol = t.headers.indexOf('area');
    if (prefCol < 0 || areaCol < 0) throw new Error('applicants に prefecture/area 列がありません');
    var repaired = [], needsManual = [], alreadyOk = 0;
    var prefPairs = [], areaPairs = [];
    t.rows.forEach(function (r) {
      var plan = planAreaRepair_(r);
      if (plan.action === 'ok') { alreadyOk++; return; }
      if (plan.action === 'repair') {
        repaired.push({ applicant_id: str_(r.applicant_id), prefecture: plan.prefecture,
          area: plan.area, source: plan.source });
        if (r._row) {
          // 都道府県が空だった行 (address_head 経由) は prefecture 列も書く。
          if (!str_(r.prefecture)) prefPairs.push({ row: r._row, value: plan.prefecture });
          areaPairs.push({ row: r._row, value: plan.area });
        }
        return;
      }
      needsManual.push({ applicant_id: str_(r.applicant_id), prefecture: str_(r.prefecture),
        address_rest: str_(r.address_rest), reason: plan.reason });
    });
    var setValuesCalls = 0;
    if (!dryRun && (prefPairs.length || areaPairs.length)) {
      var sh = sheet_('applicants');
      setValuesCalls += writeColumnRuns_(sh, prefCol, prefPairs);
      setValuesCalls += writeColumnRuns_(sh, areaCol, areaPairs);
    }
    return { dry_run: dryRun, scanned: t.rows.length, already_ok: alreadyOk,
      repaired_count: repaired.length, repaired: repaired,
      needs_manual_count: needsManual.length, needs_manual: needsManual,
      written: dryRun ? 0 : areaPairs.length, set_values_calls: setValuesCalls };
  });
}

/** 取り込み行から「応募属性」だけを抜く (ステータス・送信済みは既存値を守るため含めない) */
function pickApplicantAttrs_(input) {
  var keys = ['area','name','name_raw','surname','phone','email','birth_date','postal_code','prefecture',
    'municipality','address_rest','nearest_station','lat','lon','job_type','qualifications',
    'experience_years','desired_days_per_week','desired_time_slots','desired_start_date',
    'source_company','applied_at','is_active_target','hearing_json'];
  var out = {};
  keys.forEach(function (k) {
    if (input[k] !== undefined && input[k] !== null && input[k] !== '') out[k] = input[k];
  });
  if (out.phone) out.phone = String(out.phone).replace(/-/g, '');
  if (out.email) out.email = normalizeEmail_(out.email);
  if (!out.name_raw && out.name) out.name_raw = out.name;
  // hearing_json に応募履歴 (history) をマージする: 過去の source_company を残し、
  // has_fs_history (追補17) の導出フォールバックと importCommit のフラグ判定の材料にする (追補7)
  if (out.source_company) {
    var hj = {};
    try { hj = JSON.parse(str_(input.hearing_json) || '{}'); } catch (e) { hj = {}; }
    hj.history = hj.history || [];
    hj.history.push({ company: out.source_company, applied_at: str_(out.applied_at || ''),
      csv_status: str_(input.csv_status || '') });
    out.hearing_json = JSON.stringify(hj);
  }
  return out;
}

/** optouts テーブルのメール集合 (正規化済み) */
function optoutEmailSet_() {
  var set = {};
  readTable_('optouts').rows.forEach(function (r) {
    var em = normalizeEmail_(r.email);
    if (em) set[em] = true;
  });
  return set;
}

/** SMS記録・フォーム発行の可否 (R4 O-06: サーバー側の最後の砦)。
 * 停止中なら理由文字列を返す (実行可なら '')。理由付きの抜け道は作らない:
 * 停止中の人へ送る正規手段は停止解除の整備が先。 */
function smsBlockedReason_(applicant) {
  if (!applicant) return '応募者が見つかりません';
  if (toBool_(applicant.mail_optout)) return '配信停止中のため実行できません';
  var em = normalizeEmail_(applicant.email);
  if (em && optoutEmailSet_()[em]) return '配信停止中のため実行できません';
  return '';
}

// ===== 掘り起こし支援 (追補7) =====
/** 接触記録 (要ドメイン認証)。event_type は phone_contact / sms_sent / note 等を受け付ける */
function actionRecordContact_(req) {
  var me = requireKikariUser_();
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  var type = String(req.event_type || 'phone_contact');
  return withLock_(function () {
    var now = nowIso_();
    // R3 (C5): 画面で入力された最終接触日があればそれを正として保存する
    // (従来は入力値を捨てて実行時刻で上書きしていた)。
    var enteredLast = req.last_contact_at ? cellDateIso_(req.last_contact_at) : '';
    var patch = { last_contact_at: enteredLast || now, updated_at: now };
    if (req.next_contact_date !== undefined) patch.next_contact_date = String(req.next_contact_date || '');
    if (type === 'sms_sent') { patch.sms_sent = true; patch.sms_last_sent_at = now; }
    updateRowByPk_('applicants', req.applicant_id, patch);
    appendEvent_(req.applicant_id, type, me, String(req.detail || '接触記録'), '', '');
    return { recorded: req.applicant_id, last_contact_at: patch.last_contact_at, next_contact_date: patch.next_contact_date };
  });
}

/** 次回連絡日の設定/クリア (要ドメイン認証)。next_contact_date='' でクリア */
function actionSetNextContact_(req) {
  var me = requireKikariUser_();
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  return withLock_(function () {
    var ymd = String(req.next_contact_date || '');
    updateRowByPk_('applicants', req.applicant_id, { next_contact_date: ymd, updated_at: nowIso_() });
    appendEvent_(req.applicant_id, 'note', me,
      ymd ? '次回連絡日を設定: ' + ymd : '次回連絡日をクリア', '', '');
    return { applicant_id: req.applicant_id, next_contact_date: ymd };
  });
}

/** ===== 掘り起こし自動優先順位 (革新2, INNOVATION.md §2.3 の確定式) =====
 * DigScore = round(35*freshness + 25*stage + 30*startProximity + 10*contactGap)
 *  freshness: 最終応募 applied_at から max(0, 1 - 経過日数/90)
 *  stage: 本流8段 csvStageRank_ の stage/8 (終了/例外系は 0)
 *  startProximity: 入職希望日まで d 日: d<=14 (過去含む)=1.0 / 〜30=0.8 / 〜60=0.5 / 〜90=0.25 / 90超=0.1 / 未定=0
 *  contactGap: 最終接触 (無ければ応募日) から14日以上で min(1, (経過-14)/46)、14日未満は0
 * 根拠文 reason_text は要素があるものだけを連結し、人が読んで納得できる形にする。 */
function digMilestone_(sdYmd, today) {
  if (!sdYmd) return null;
  if (sdYmd < addDaysYmd_(today, -7)) return null; // 希望日を7日過ぎたら逆算対象から外す
  var labels = { 60: '状況確認', 30: '案件提案', 14: '選考状況確認' };
  var best = null;
  [60, 30, 14].forEach(function (days) {
    var at = addDaysYmd_(sdYmd, -days);
    if (at && at <= today && (!best || at > best.at)) best = { days: days, at: at, label: labels[days] };
  });
  return best;
}

function digScore_(applicant, today, flags) {
  flags = flags || {};
  var appliedYmd = cellDateYmd_(applicant.applied_at);
  var appliedDays = appliedYmd ? diffDaysYmd_(today, appliedYmd) : null;
  var freshness = appliedDays == null ? 0 : Math.max(0, 1 - appliedDays / 90);
  var st = csvStageRank_(applicant.csv_status);
  var stageRatio = st.inFlow ? st.stage / 8 : 0;
  var sd = cellDateYmd_(applicant.desired_start_date);
  var dUntil = sd ? diffDaysYmd_(sd, today) : null;
  var startRatio = 0;
  if (dUntil != null) {
    startRatio = dUntil <= 14 ? 1.0 : (dUntil <= 30 ? 0.8 : (dUntil <= 60 ? 0.5 : (dUntil <= 90 ? 0.25 : 0.1)));
  }
  var contactBase = cellDateYmd_(applicant.last_contact_at) || appliedYmd;
  var gapDays = contactBase ? diffDaysYmd_(today, contactBase) : null;
  var gapRatio = (gapDays != null && gapDays >= 14) ? Math.min(1, (gapDays - 14) / 46) : 0;
  var parts = {
    freshness: { ratio: Math.round(freshness * 1000) / 1000, points: Math.round(35 * freshness * 10) / 10, max: 35, applied_days_ago: appliedDays },
    stage: { ratio: Math.round(stageRatio * 1000) / 1000, points: Math.round(25 * stageRatio * 10) / 10, max: 25, stage: st.stage, stage_label: st.stageLabel || st.label },
    start_proximity: { ratio: startRatio, points: Math.round(30 * startRatio * 10) / 10, max: 30, days_until: dUntil, desired_start_date: sd },
    contact_gap: { ratio: Math.round(gapRatio * 1000) / 1000, points: Math.round(10 * gapRatio * 10) / 10, max: 10, days: gapDays }
  };
  var score = Math.round(35 * freshness + 25 * stageRatio + 30 * startRatio + 10 * gapRatio);
  // 根拠文 (INNOVATION.md §2.4 の型。要素があるものだけを「／」で連結する)
  function md_(ymd) {
    if (!ymd) return '';
    var p = ymd.split('-'); return Number(p[1]) + '月' + Number(p[2]) + '日';
  }
  var texts = [];
  if (flags.response_open) texts.push('未対応の回答あり');
  if (flags.next_due) {
    var nd = cellDateYmd_(applicant.next_contact_date);
    texts.push('次回連絡日 ' + md_(nd) + 'を過ぎています');
  }
  if (appliedYmd) texts.push('最終応募 ' + md_(appliedYmd) + '（' + appliedDays + '日前）');
  if (st.inFlow && st.stageLabel) texts.push('止まっている段階: ' + st.stageLabel);
  var ms = digMilestone_(sd, today);
  if (sd && dUntil != null) {
    texts.push('入職希望 ' + md_(sd) + 'まで' + dUntil + '日' + (ms ? '（' + ms.label + 'の時期）' : ''));
  }
  if (gapDays != null && gapDays >= 14) texts.push('前回接触から' + gapDays + '日');
  return { score: score, parts: parts, reason_text: texts.join('／') };
}

/** open な回答がある応募者の集合 (applicant_id -> open_response)。1回の走査で作る */
function openResponseMap_() {
  var map = {};
  try {
    readTable_('responses').rows.forEach(function (r) {
      if (responseStatus_(r) === 'handled') return;
      var id = str_(r.applicant_id);
      if (!map[id]) map[id] = { response_id: str_(r.response_id), status: responseStatus_(r), status_by: str_(r.status_by) };
    });
  } catch (e) {}
  return map;
}

function digSortByScore_(out) {
  out.sort(function (a, b) {
    var fa = a.flags || {}, fb = b.flags || {};
    if (!!fa.response_open !== !!fb.response_open) return fa.response_open ? -1 : 1;
    if (!!fa.next_due !== !!fb.next_due) return fa.next_due ? -1 : 1;
    if (a.dig_score !== b.dig_score) return b.dig_score - a.dig_score;
    return a.applied_at < b.applied_at ? 1 : -1;
  });
}

/**
 * 掘り起こしリスト (読み取り)。
 * 理由 (reasons) を付けて返す:
 *  (a) past_fs        : FS登録歴あり (has_fs_history フィールドが正, 追補17。req.only_past_fs=true でこの条件だけに絞る)
 *  (b) next_due       : next_contact_date が今日以前
 *  (c) start_minus_60/30/14 : 入職希望日の逆算マイルストーン到来済み (革新2で拡張:
 *      完全一致ではなく「マイルストーン日 <= 今日 かつ 希望日が今日-7日以降」。
 *      付けるのは到来済みの最も直近のマイルストーン1つ)
 * 既定では (b) または (c) に該当する人を返し、(a) は理由として併記する。
 * 各 item には革新2の dig_score / score_parts / reason_text / flags を加算する。
 * 既定の並び (次回連絡日→応募日) は壊さず、req.sort='score' で優先スコア順に切り替えられる。
 */
/** 掘り起こしの除外判定 (R4 10-#4: getDigList / getDigToday で正本を共有する)。
 * 除外なら 'terminal' / 'optout' / 'started'、それ以外は '' を返す。
 * 選考中などの進行中 (stage 2-7) は除外しない。 */
function digExclusionReason_(r, optoutSet) {
  var st = csvStageRank_(r.csv_status);
  if (st.terminal) return 'terminal';
  if (toBool_(r.mail_optout) || (str_(r.email) && optoutSet[normalizeEmail_(r.email)])) return 'optout';
  if (st.inFlow && st.stage >= 8) return 'started';
  return '';
}

function actionGetDigList_(req) {
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var rows = filterApplicants_(readTable_('applicants').rows, req.filter || {});
  var openMap = openResponseMap_();
  var actCtx = null;
  try { actCtx = activityContext_(); } catch (e) { actCtx = null; }
  // R4 10-#4: getDigToday と同じ除外 (終了系/配信停止/稼働開始) を適用し、内訳を返す。
  var optoutSet = optoutEmailSet_();
  var counts = { candidates: 0, excluded_terminal: 0, excluded_optout: 0, excluded_started: 0 };
  var out = [];
  rows.forEach(function (r) {
    var excl = digExclusionReason_(r, optoutSet);
    if (excl) { counts['excluded_' + excl]++; return; }
    counts.candidates++;
    var reasons = [];
    if (hasFsHistory_(r)) reasons.push('past_fs');
    var nd = cellDateYmd_(r.next_contact_date);
    if (nd && nd <= today) reasons.push('next_due');
    var sd = cellDateYmd_(r.desired_start_date);
    var ms = digMilestone_(sd, today);
    if (ms) reasons.push('start_minus_' + ms.days);
    var hit = req.only_past_fs === true
      ? reasons.indexOf('past_fs') >= 0
      : (reasons.indexOf('next_due') >= 0 || reasons.some(function (x) { return x.indexOf('start_minus_') === 0; }));
    if (hit) {
      var flags = { next_due: reasons.indexOf('next_due') >= 0, response_open: !!openMap[str_(r.applicant_id)] };
      var ds = digScore_(r, today, flags);
      var act = null;
      if (actCtx) { try { act = activityForApplicant_(str_(r.applicant_id), actCtx, r); } catch (e2) { act = null; } }
      var item = applicantListItem_(r, act);
      item.reasons = reasons;
      item.dig_score = ds.score;
      item.score_parts = ds.parts;
      item.reason_text = ds.reason_text;
      item.flags = flags;
      out.push(item);
    }
  });
  if (req.sort === 'score' || req.order === 'score') {
    digSortByScore_(out);
  } else {
    // 既定: 次回連絡日が近い順 -> 応募日新しい順 (従来どおり)
    out.sort(function (a, b) {
      var x = a.next_contact_date || '9999', y = b.next_contact_date || '9999';
      if (x !== y) return x < y ? -1 : 1;
      return a.applied_at < b.applied_at ? 1 : -1;
    });
  }
  var limit = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
  return { total: out.length, items: out.slice(0, limit), today: today, counts: counts };
}

/**
 * 今日アプローチすべき人 (革新2, 読み取り専用)。
 * 母集団は FS登録歴あり (filterApplicants_ 経由でテスト求職者を除外) とし、
 * 終了/例外系・配信停止・稼働中は理由つきで母数から外し、counts の内訳で見えるようにする。
 * 並びは固定: response_open あり -> next_due あり -> DigScore 降順 -> 最終応募の新しい順。
 */
function actionGetDigToday_(req) {
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var rows = filterApplicants_(readTable_('applicants').rows,
    Object.assign({}, req.filter || {}, { has_fs_history: true }));
  var optoutSet = optoutEmailSet_();
  var openMap = openResponseMap_();
  var counts = { candidates: 0, excluded_terminal: 0, excluded_optout: 0, excluded_started: 0 };
  var out = [];
  rows.forEach(function (r) {
    var excl = digExclusionReason_(r, optoutSet);
    if (excl) { counts['excluded_' + excl]++; return; }
    counts.candidates++;
    var nd = cellDateYmd_(r.next_contact_date);
    var flags = { next_due: !!(nd && nd <= today), response_open: !!openMap[str_(r.applicant_id)] };
    var ds = digScore_(r, today, flags);
    var item = applicantListItem_(r);
    item.dig_score = ds.score;
    item.score_parts = ds.parts;
    item.reason_text = ds.reason_text;
    item.flags = flags;
    out.push(item);
  });
  digSortByScore_(out);
  var limit = Math.min(200, Math.max(1, parseInt(req.limit, 10) || 50));
  return { total: counts.candidates, counts: counts, items: out.slice(0, limit), today: today };
}

function addDaysYmd_(ymd, days) {
  var d = new Date(ymd + 'T00:00:00+09:00');
  if (isNaN(d.getTime())) return '';
  d.setDate(d.getDate() + days);
  return Utilities.formatDate(d, 'Asia/Tokyo', 'yyyy-MM-dd');
}

/**
 * 掘り起こしファネル集計 (読み取り)。
 * 対象 = FS登録歴あり (has_fs_history フィールド基準, 追補17) の人数を起点に、
 * applicant_events のイベント種別と現在の app_status / csv_status から
 * 各段の到達人数を数える (到達 = 一度でも到達)。
 */
function actionGetDigStats_(req) {
  var apps = readTable_('applicants').rows;
  // R7: req.area 指定時はそのエリアに絞る (未指定時は従来どおり全エリア)。
  // フロントの掘り起こしタブはエリア単位の表示なので、サーバーモードでは area を渡す。
  var area = str_((req && req.area) || '');
  // 追補22: テスト求職者は掘り起こし・ファネルの母数に入れない (has_fs_history の有無によらない)
  var targets = apps.filter(function (r) {
    return !isTestApplicant_(r) && hasFsHistory_(r) && (!area || str_(r.area) === area);
  });
  var targetIds = {};
  targets.forEach(function (r) { targetIds[str_(r.applicant_id)] = true; });

  var contacted = {}, replied = {};
  readTable_('applicant_events').rows.forEach(function (e) {
    var id = str_(e.applicant_id);
    if (!targetIds[id]) return;
    var t = str_(e.event_type);
    if (t === 'phone_contact' || t === 'sms_sent' || t === 'mail_sent') contacted[id] = true;
    if (t === 'response_received') replied[id] = true;
  });
  targets.forEach(function (r) {
    var id = str_(r.applicant_id);
    if (toBool_(r.sms_sent) || cellDateIso_(r.last_contact_at)) contacted[id] = true;
  });

  function countStage_(words) {
    var n = 0;
    targets.forEach(function (r) {
      var s = str_(r.app_status) + '|' + str_(r.csv_status);
      if (words.some(function (w) { return s.indexOf(w) >= 0; })) n++;
    });
    return n;
  }
  return {
    funnel: {
      target: targets.length,
      contacted: Object.keys(contacted).length,
      replied: Object.keys(replied).length,
      attend: countStage_(['アテンド']),
      fix: countStage_(['FIX']),
      offer: countStage_(['内定']),
      started: countStage_(['稼働開始', '稼働中'])
    },
    note: 'アテンド以降は現在の app_status / csv_status での到達数 (履歴ベースの厳密な到達管理はフェーズ3)',
    response_summary: responseSummarySafe_()
  };
}

// ===== ラウンド7: 特需・逆引き・掘り起こしビューのサーバー検索 =====
/**
 * 3ビューのカード表示専用アイテム。
 * 一覧 (searchApplicants) は連絡先を返さない方針 (DESIGN_V2 §10) だが、
 * 3ビューのカードは sms: / tel: リンクそのものを描画するため、電話番号だけは
 * 「表示に必要な分」として返す (メールは返さない)。返すのはページ分のみ。
 */
function r7CardItem_(r) {
  var item = applicantListItem_(r);
  item.phone = str_(r.phone);
  return item;
}

/** 距離は表示精度 (小数1桁) に丸めて返す (転送量削減。並び順は丸め前の値で決める) */
function r7Dist1_(d) { return d == null ? null : Math.round(d * 10) / 10; }

/**
 * 特需SMSの候補者検索 (フロント specialCandidates のサーバー移植)。
 * 業務ルールはフロント現行と同一:
 *  - 母集団: area 一致・職種一致・テスト求職者除外 (filterApplicants_ の既定)
 *  - セグメント「連絡停止」を除外
 *  - 案件座標 (市区町村代表点) からの直線距離が半径以内 (座標が引けない人は対象外)
 *  - 年齢上限: 上限を超える人は除外。年齢不明は外さない (要確認扱い)
 *  - 並び: 直近の応募順 (applied_at 降順)
 * req: { lat, lon, radius_km, job_type, area, max_age, page, page_size, count_only }
 * count_only=true のときは件数だけを返す (特需案件一覧の「対象 N名」表示用)。
 */
function actionSearchSpecialCandidates_(req) {
  req = req || {};
  var lat = toNum_(req.lat), lon = toNum_(req.lon);
  var radius = Number(req.radius_km);
  if (!(radius > 0)) radius = 10;
  if (lat == null || lon == null || coordBasicCheck_(lat, lon).state !== 'ok') {
    return { total: 0, page: 1, page_size: 0, items: [], reason: 'no_origin' };
  }
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = {};
  if (req.area) f.area = String(req.area);
  if (req.job_type) f.job_type = String(req.job_type);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var maxAge = (req.max_age === '' || req.max_age == null) ? null : Number(req.max_age);
  if (maxAge != null && isNaN(maxAge)) maxAge = null;
  var matched = [];
  // 是正 (2026-11-23): 除外は配信停止のみ (smsBlockedReason_ と同じ判定)。
  // 終了系ステータスを「連絡停止」ラベルに混ぜて無言で落とさない。
  var smsOptoutSet = optoutEmailSet_();
  rows.forEach(function (r) {
    if (toBool_(r.mail_optout) || smsOptoutSet[normalizeEmail_(r.email)]) return;
    var d = distanceKm_(lat, lon, r.lat, r.lon);
    if (d == null || d > radius) return;
    if (maxAge != null) {
      var age = ageFromBirth_(r.birth_date);
      if (age != null && age > maxAge) return;
    }
    matched.push({ r: r, dist: d });
  });
  matched.sort(function (a, b) {
    var x = cellDateIso_(a.r.applied_at), y = cellDateIso_(b.r.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var total = matched.length;
  if (req.count_only === true) return { total: total };
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || 50));
  var start = (page - 1) * pageSize;
  return {
    total: total, page: page, page_size: pageSize,
    items: matched.slice(start, start + pageSize).map(function (m) {
      var item = r7CardItem_(m.r);
      item.dist = r7Dist1_(m.dist);
      return item;
    })
  };
}

/** 逆引きの条件一致数 (フロント reverseMatchCount と同一: 資格・週日数・時間帯・最寄駅の登録数) */
function reverseMatchCountServer_(r) {
  return [str_(r.qualifications), str_(r.desired_days_per_week), str_(r.desired_time_slots), str_(r.nearest_station)]
    .filter(function (v) { return v !== ''; }).length;
}

/**
 * 案件から近くの求職者を探す (逆引き) のサーバー検索。
 * フロント reverseResults の業務ルールをそのまま移植:
 *  - 母集団: 職種一致・テスト除外。エリアでは絞らない (府県境をまたいで検索)
 *  - セグメント「連絡停止」を除外、案件座標からの距離が半径以内 (既定5km)
 *  - cond: 'match' は条件一致3件以上 / 'unknown' は未確認項目あり /
 *          'consult' は条件一致1件以下。include_consult=true のとき match/consult の絞り込みを外す
 *  - municipality 指定時はその市区町村のみ (wide_muni=true で広げる)
 *  - 並び: 条件一致が多い順 -> 距離が近い順 -> 直近の応募順
 * req: { case: { lat, lon, job_type, prefecture }, radius_km, cond, include_consult,
 *        municipality, wide_muni, page, page_size }
 * facets.municipalities は市区町村ドロップダウン用 (母集団はフロント現行と同一:
 * 同職種・同府県・テスト除外の全応募者)。
 */
function actionSearchReverseCandidates_(req) {
  req = req || {};
  var c = req.case || {};
  var lat = toNum_(c.lat), lon = toNum_(c.lon);
  var radius = Number(req.radius_km);
  if (!(radius > 0)) radius = 5;
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = {};
  if (c.job_type) f.job_type = String(c.job_type);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var muniSet = {};
  rows.forEach(function (r) {
    if (str_(r.prefecture) === str_(c.prefecture) && str_(r.municipality)) muniSet[str_(r.municipality)] = true;
  });
  var facets = { municipalities: Object.keys(muniSet).sort() };
  if (lat == null || lon == null || coordBasicCheck_(lat, lon).state !== 'ok') {
    return { total: 0, page: 1, page_size: 0, items: [], reason: 'no_origin', facets: facets };
  }
  var includeConsult = req.include_consult === true;
  var matched = [];
  // 是正 (2026-11-23): 除外は配信停止のみ (特需SMSと同じ判定に統一)。
  var smsOptoutSetR = optoutEmailSet_();
  rows.forEach(function (r) {
    if (toBool_(r.mail_optout) || smsOptoutSetR[normalizeEmail_(r.email)]) return;
    var d = distanceKm_(lat, lon, r.lat, r.lon);
    if (d == null || !isFinite(d) || d > radius) return;
    var m = reverseMatchCountServer_(r);
    if (req.cond === 'match' && !includeConsult && m < 3) return;
    if (req.cond === 'unknown' && missingHearing_(r).length === 0) return;
    if (req.cond === 'consult' && !includeConsult && m > 1) return;
    if (req.municipality && req.wide_muni !== true && str_(r.municipality) !== String(req.municipality)) return;
    matched.push({ r: r, dist: d, match: m });
  });
  matched.sort(function (a, b) {
    if (b.match !== a.match) return b.match - a.match;
    if (a.dist !== b.dist) return a.dist - b.dist;
    var x = cellDateIso_(a.r.applied_at), y = cellDateIso_(b.r.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || 50));
  var start = (page - 1) * pageSize;
  return {
    total: matched.length, page: page, page_size: pageSize, facets: facets,
    items: matched.slice(start, start + pageSize).map(function (m) {
      var item = r7CardItem_(m.r);
      item.dist = r7Dist1_(m.dist);
      item.match = m.match;
      return item;
    })
  };
}

/** フロント contactSchedule と同一の逆算マイルストーン (60日前=状況確認 / 30日前=案件提案 / 14日前=選考状況確認) */
var DIG_MILESTONES_ = [[60, '状況確認'], [30, '案件提案'], [14, '選考状況確認']];

/**
 * 掘り起こし「今日連絡すべき人」 (フロント dueTodayList のサーバー移植)。
 * 母集団は掘り起こしタブと同一 (area 内・FS登録歴あり・テスト除外) で、
 * セグメント「連絡停止」「稼働中」を入口で除外し、理由を付けて返す:
 *  - 次回連絡日到来 (next_contact_date が今日以前)
 *  - 逆算予定の到来 (入職希望日の 60/30/14 日前を過ぎたもの。到来済みの全件を理由にする)
 *  - 前回接触から14日以上 (last_contact_at がある人のみ)
 * 並びはフロント現行と同一 (直近の応募順)。
 * req: { area, page, page_size }
 */
function actionGetDigTodayList_(req) {
  req = req || {};
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = { has_fs_history: true };
  if (req.area) f.area = String(req.area);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var out = [];
  rows.forEach(function (r) {
    var seg = segmentOfApplicant_(r, today);
    if (seg === '連絡停止' || seg === '稼働中') return;
    var reasons = [];
    var nd = cellDateYmd_(r.next_contact_date);
    if (nd && nd <= today) reasons.push('次回連絡日到来（' + nd + '）');
    var sd = cellDateYmd_(r.desired_start_date);
    if (sd && /^\d{4}-\d{2}-\d{2}$/.test(sd)) {
      var remain = diffDaysYmd_(sd, today);
      DIG_MILESTONES_.forEach(function (ms) {
        var at = addDaysYmd_(sd, -ms[0]);
        if (at && at <= today) reasons.push(ms[1] + '：希望日まで' + remain + '日（予定日 ' + at + '）');
      });
    }
    var lc = cellDateYmd_(r.last_contact_at);
    if (lc) {
      var diff = diffDaysYmd_(today, lc);
      if (diff != null && diff >= 14) reasons.push('前回接触から' + diff + '日');
    }
    if (reasons.length) out.push({ r: r, reasons: reasons });
  });
  out.sort(function (a, b) {
    var x = cellDateIso_(a.r.applied_at), y = cellDateIso_(b.r.applied_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(500, Math.max(1, parseInt(req.page_size, 10) || 200));
  var start = (page - 1) * pageSize;
  return {
    total: out.length, page: page, page_size: pageSize, today: today,
    items: out.slice(start, start + pageSize).map(function (o) {
      var item = r7CardItem_(o.r);
      item.reasons = o.reasons;
      return item;
    })
  };
}

var DIG_SEGMENTS_ = ['即提案可能', '条件確認待ち', '時期先', '選考中', '稼働中', '連絡停止'];

/**
 * 掘り起こしのセグメント別件数と、セグメントで絞った応募者のページ。
 * 母集団は掘り起こしタブと同一 (area 内・FS登録歴あり・テスト除外)。
 * セグメント分類はサーバー正本 segmentOfApplicant_ (フロント segmentOfCalc と同一優先順)。
 * req: { area, segment ('' はすべて), page, page_size }
 */
function actionGetDigSegment_(req) {
  req = req || {};
  var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
  var f = { has_fs_history: true };
  if (req.area) f.area = String(req.area);
  var rows = filterApplicants_(readTable_('applicants').rows, f);
  var counts = {};
  DIG_SEGMENTS_.forEach(function (s) { counts[s] = 0; });
  var withStart = 0;
  var seg = String(req.segment || '');
  var matched = [];
  rows.forEach(function (r) {
    var s = segmentOfApplicant_(r, today);
    if (counts[s] != null) counts[s]++;
    if (cellDateYmd_(r.desired_start_date)) withStart++;
    if (!seg || s === seg) matched.push(r);
  });
  matched = sortByAppliedDesc_(matched);
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || 50));
  var start = (page - 1) * pageSize;
  return {
    total_all: rows.length, counts: counts, with_start: withStart,
    total: matched.length, page: page, page_size: pageSize,
    items: matched.slice(start, start + pageSize).map(function (r) { return r7CardItem_(r); })
  };
}

// ===== 対外表示ヘルパー (求職者向け整形) =====
function publicJobKind_(jobType) {
  var t = str_(jobType);
  if (t === 'kango' || t.indexOf('\u770b\u8b77') >= 0) return 'kango';
  if (t === 'kaigo' || t.indexOf('\u4ecb\u8b77') >= 0) return 'kaigo';
  return '';
}
function publicSalaryBandText_(jobType) {
  var k = publicJobKind_(jobType);
  if (k === 'kango') return '\u770b\u8b77\u5e2b ' + PUBLIC_SALARY_BAND_KANGO_;
  if (k === 'kaigo') return '\u4ecb\u8b77\u58eb ' + PUBLIC_SALARY_BAND_KAIGO_;
  return '\u4ecb\u8b77\u58eb ' + PUBLIC_SALARY_BAND_KAIGO_ + ' / \u770b\u8b77\u5e2b ' + PUBLIC_SALARY_BAND_KANGO_;
}
function publicSalaryText_(jobType) {
  return publicSalaryBandText_(jobType) + '\n' + PUBLIC_SALARY_NOTE_;
}
function publicCaseHoursText_(jobType) {
  var k = publicJobKind_(jobType);
  var ex = (k === 'kango') ? PUBLIC_HOURS_EXAMPLE_KANGO_ : PUBLIC_HOURS_EXAMPLE_KAIGO_;
  return '\u52e4\u52d9\u6642\u9593\u306e\u4f8b\uff1a' + ex + '\n' + PUBLIC_HOURS_CONSULT_;
}
function publicCaseHoursShortText_(jobType) { return PUBLIC_HOURS_SHORT_; }
function stripCaseSpecificHours_(text) {
  return str_(text)
    .replace(/[0-9\uff10-\uff19]{1,2}[:\uff1a][0-9\uff10-\uff19]{2}\s*[\u301c~\uff5e\-]\s*(\u7fcc\u65e5?\s*)?[0-9\uff10-\uff19]{1,2}[:\uff1a][0-9\uff10-\uff19]{2}/g, '')
    .replace(/\s{2,}/g, ' ').trim();
}
function publicDescription_(text) { return stripCaseSpecificHours_(text); }
function publicFromListItem_(item) {
  if (!item) return item;
  var out = {}; Object.keys(item).forEach(function (k) { out[k] = item[k]; });
  out.salary_text = publicSalaryBandText_(item.job_type);
  out.salary_band_text = publicSalaryBandText_(item.job_type);
  out.salary_note = PUBLIC_SALARY_NOTE_;
  out.hours_text = publicCaseHoursText_(item.job_type);
  out.hours_short_text = publicCaseHoursShortText_(item.job_type);
  out.description = publicDescription_(item.description);
  return out;
}
function publicCaseItem_(c, distanceKm) { return publicFromListItem_(caseListItem_(c, distanceKm)); }

// ===== 案件検索 (読み取り。座標・距離つき) =====
// caseListItem_ は内部向け (運営者画面用) の原文整形。求職者向けには publicCaseItem_ を使うこと。
function caseListItem_(c, distanceKm) {
  return {
    case_id: str_(c.case_id),
    facility_id: str_(c.facility_id),
    facility_name: str_(c.facility_name),
    corporation_name: str_(c.corporation_name),
    prefecture: str_(c.prefecture),
    municipality: str_(c.municipality),
    address: str_(c.address),
    lat: toNum_(c.lat), lon: toNum_(c.lon),
    job_type: str_(c.job_type),
    service_type: str_(c.service_type),
    employment_type: str_(c.employment_type),
    title: str_(c.title),
    description: str_(c.description),
    nearest_station: str_(c.nearest_station),
    salary_text: str_(c.salary_text),
    is_open: toBool_(c.is_open),
    updated_at_src: cellDateIso_(c.updated_at_src),
    distance_km: (distanceKm == null ? null : Math.round(distanceKm * 10) / 10)
  };
}

function actionSearchCases_(req) {
  var f = req.filter || {};
  var rows = readTable_('cases').rows.filter(function (c) {
    if (f.only_open !== false && !toBool_(c.is_open)) return false;
    if (f.keyword) {
      var hay = str_(c.facility_name) + ' ' + str_(c.corporation_name) + ' ' + str_(c.title) + ' ' + str_(c.address);
      if (hay.indexOf(String(f.keyword)) < 0) return false;
    }
    if (f.prefecture && str_(c.prefecture) !== String(f.prefecture)) return false;
    if (f.municipality && str_(c.municipality) !== String(f.municipality)) return false;
    if (f.job_type && str_(c.job_type) !== String(f.job_type)) return false;
    if (f.service_type && str_(c.service_type).indexOf(String(f.service_type)) < 0) return false;
    return true;
  });
  var hasOrigin = f.lat != null && f.lon != null;
  var items = rows.map(function (c) {
    var d = hasOrigin ? distanceKm_(f.lat, f.lon, c.lat, c.lon) : null;
    return caseListItem_(c, d);
  });
  if (f.radius_km && hasOrigin) {
    var rk = Number(f.radius_km);
    items = items.filter(function (it) { return it.distance_km != null && it.distance_km <= rk; });
  }
  if (hasOrigin) items.sort(function (a, b) {
    var x = a.distance_km == null ? 1e9 : a.distance_km;
    var y = b.distance_km == null ? 1e9 : b.distance_km;
    return x - y;
  });
  var page = Math.max(1, parseInt(req.page, 10) || 1);
  var pageSize = Math.min(200, Math.max(1, parseInt(req.page_size, 10) || PAGE_SIZE));
  var start = (page - 1) * pageSize;
  return { total: items.length, page: page, page_size: pageSize, items: items.slice(start, start + pageSize) };
}

// ===== 案件マスター同期アクション (追補14: 案件アプリ連携のサーバー側) =====
/**
 * 案件同期で返す案件1件分 (ホワイトリスト方式)。
 * CASE_SYNC_FIELDS_ に列挙した案件データのみを明示的に拾うため、応募者情報が
 * 構造的に混ざらないことをここで保証する (応募者は別ブック・別テーブルであり、
 * 本関数は cases 行しか受け取らない)。
 */
function caseSyncItem_(c) {
  var out = {};
  CASE_SYNC_FIELDS_.forEach(function (k) {
    if (k === 'lat' || k === 'lon') out[k] = toNum_(c[k]);
    else if (k === 'is_open') out[k] = toBool_(c[k]);
    else if (k === 'updated_at_src' || k === 'created_at' || k === 'updated_at') out[k] = cellDateIso_(c[k]);
    else out[k] = str_(c[k]);
  });
  return out;
}

/**
 * getCaseMaster (読み取り): 案件マスターのスナップショット / 差分。
 * req.updated_since (ISO日時) 指定時は cases.updated_at がそれより後の案件だけを返す
 * (updated_at が空の行は updated_at_src で代用判定する)。無指定なら全件スナップショット。
 * 返却は案件データのみ (caseSyncItem_ のホワイトリスト)。
 */
function actionGetCaseMaster_(req) {
  var since = String(req.updated_since || '').trim();
  var sinceMs = since ? new Date(since).getTime() : null;
  if (since && isNaN(sinceMs)) throw new Error('updated_since は日時 (ISO形式) で指定してください');
  var rows = readTable_('cases').rows;
  var items = [];
  rows.forEach(function (c) {
    if (sinceMs != null) {
      var stamp = cellDateIso_(c.updated_at) || cellDateIso_(c.updated_at_src);
      var ms = stamp ? new Date(stamp).getTime() : NaN;
      if (isNaN(ms) || ms <= sinceMs) return;
    }
    items.push(caseSyncItem_(c));
  });
  items.sort(function (a, b) {
    var x = a.updated_at || a.updated_at_src, y = b.updated_at || b.updated_at_src;
    return x < y ? -1 : (x > y ? 1 : 0);
  });
  return {
    cases: items, total: items.length,
    updated_since: since || '', snapshot: !since,
    server_time: nowIso_()
  };
}

/** source_flags (カンマ区切り) に source を重複なく加える */
function mergeSourceFlags_(flags, source) {
  var list = toList_(flags);
  if (list.indexOf(source) < 0) list.push(source);
  return list.join(',');
}

/**
 * getCaseSourceKeys (読み取り): 案件プレビューの重複判定をサーバーの実案件と
 * 照合するための軽量版 (監査 C-5)。返すのは (source, source_case_key) の
 * 一覧だけで、案件の内容・応募者情報は含まない。req.source 指定時はその
 * source のキーだけを返す。
 */
function actionGetCaseSourceKeys_(req) {
  requireKikariUser_();
  var onlySource = str_(req.source || '');
  var bySource = {};
  readTable_('case_sources').rows.forEach(function (r) {
    var s = str_(r.source);
    if (onlySource && s !== onlySource) return;
    (bySource[s] = bySource[s] || []).push(str_(r.source_case_key));
  });
  var total = 0;
  Object.keys(bySource).forEach(function (k) { total += bySource[k].length; });
  return { by_source: bySource, total: total };
}

/** case_sources で (source, source_case_key) の既存行を探す。無ければ null */
function findCaseSource_(source, sourceCaseKey) {
  var t = readTable_('case_sources');
  for (var i = 0; i < t.rows.length; i++) {
    if (String(t.rows[i].source) === String(source) &&
        String(t.rows[i].source_case_key) === String(sourceCaseKey)) return t.rows[i];
  }
  return null;
}

/** case_sources の既存行を raw_json / imported_at だけ更新する (主キーが無い表のため行番号で書く) */
function updateCaseSourceRow_(rowObj, rawJson, importedAt) {
  var sh = sheet_('case_sources');
  var headers = readTable_('case_sources').headers;
  var patch = { raw_json: rawJson, imported_at: importedAt };
  Object.keys(patch).forEach(function (k) {
    var col = headers.indexOf(k);
    if (col >= 0) sh.getRange(rowObj._row, col + 1).setValue(patch[k]);
  });
}

/**
 * 案件 upsert の本体 (冪等性の担保):
 * - 照合キーは (source, source_case_key) のみ。case_sources で既存を検索し、
 *   あればその case_id を更新、無ければ case_id を新規採番して case_sources に
 *   (source, source_case_key) を登録する。
 * - したがって同じキーの再 push は「更新」になり、案件は増殖しない。
 * - cases 側の更新は空値で既存値を潰さない (未指定フィールドは既存維持)。
 * - source_flags には出所を加え (証跡)、case_sources.raw_json には出所原文を残す
 *   (DATA_MODEL §5: マージで負けた値を捨てない)。
 * ロック取得済みの文脈から呼ぶこと。
 */
function upsertCaseFromSource_(input, defaultSource) {
  if (!input || typeof input !== 'object') throw new Error('案件データが空です');
  var source = String(input.source || defaultSource || '').trim();
  if (CASE_SYNC_SOURCES_.indexOf(source) < 0) {
    throw new Error('source は ' + CASE_SYNC_SOURCES_.join('/') + ' のいずれかです: ' + source);
  }
  var src = input.case_source || {};
  var sourceCaseKey = String(input.source_case_key || src.source_case_key || '').trim();
  if (!sourceCaseKey) throw new Error('source_case_key が必要です (冪等キーの一部です)');
  var raw = src.raw_json || input.raw_json || input;
  var rawJson = (typeof raw === 'string') ? raw : JSON.stringify(raw);
  var now = nowIso_();
  var existingSrc = findCaseSource_(source, sourceCaseKey);

  // 入力から案件フィールドだけを拾う (ホワイトリスト。余分なキーは cases に入れない)
  var fields = {};
  CASE_SYNC_FIELDS_.forEach(function (k) {
    if (k === 'case_id' || k === 'created_at' || k === 'updated_at' || k === 'source_flags') return;
    if (input[k] !== undefined && input[k] !== null && input[k] !== '') fields[k] = input[k];
  });
  if (fields.is_open !== undefined) fields.is_open = toBool_(fields.is_open);
  if (!fields.updated_at_src) fields.updated_at_src = str_(input.updated_at_src || now);
  fields.updated_at = now;
  // R4 I-3: 持ち込み座標は受け入れ判定を通す。NG・精密でない座標は座標なしへ
  // 降格する (原文は case_sources.raw_json に残る)。(c) の重複集計は単件経路
  // では既存 cases 全体 + この1件で数える。
  var coordVerdict = null;
  if (fields.lat !== undefined || fields.lon !== undefined) {
    var rep = municipalityRepPoint_(fields.prefecture || input.prefecture,
      fields.municipality || input.municipality);
    var dupCount = null;
    var inKey = coordKey_(fields.lat, fields.lon);
    if (inKey) {
      var repKeys = municipalityRepKeys_();
      if (repKeys[inKey]) dupCount = 0;
      else {
        var addrSet = {};
        try {
          readTable_('cases').rows.forEach(function (c) {
            if (coordKey_(c.lat, c.lon) === inKey) addrSet[str_(c.address)] = true;
          });
        } catch (e) {}
        addrSet[str_(fields.address || input.address || '')] = true;
        dupCount = Object.keys(addrSet).length;
      }
    }
    var acc = acceptCoord_(fields.lat, fields.lon, rep, dupCount);
    coordVerdict = { verdict: acc.verdict, reason: acc.reason };
    if (acc.verdict === 'downgraded') { fields.lat = ''; fields.lon = ''; }
    else if (acc.verdict === 'precise') { fields.lat = acc.lat; fields.lon = acc.lon; }
  }

  if (existingSrc) {
    var caseId = str_(existingSrc.case_id);
    var before = findRow_('cases', 'case_id', caseId);
    fields.source_flags = mergeSourceFlags_(before.source_flags, source);
    if (!fields.facility_name_norm && fields.facility_name) {
      fields.facility_name_norm = String(fields.facility_name).replace(/\s+/g, '');
    }
    updateRowByPk_('cases', caseId, fields);
    updateCaseSourceRow_(existingSrc, rawJson, now);
    return { case_id: caseId, created: false, source: source, source_case_key: sourceCaseKey,
      coord: coordVerdict };
  }
  var newId = nextId_('cases');
  var row = {
    case_id: newId, facility_id: '', facility_name: '', facility_name_norm: '',
    corporation_name: '', prefecture: '', municipality: '', address: '', lat: '', lon: '',
    job_type: '', service_type: '', employment_type: '', title: '', description: '',
    nearest_station: '', salary_text: '', is_open: true, merged_from: '',
    created_at: now
  };
  Object.keys(fields).forEach(function (k) { row[k] = fields[k]; });
  row.source_flags = mergeSourceFlags_('', source);
  if (!row.facility_name_norm && row.facility_name) {
    row.facility_name_norm = String(row.facility_name).replace(/\s+/g, '');
  }
  appendRow_('cases', row);
  appendRow_('case_sources', {
    case_id: newId, source: source, source_case_key: sourceCaseKey,
    raw_json: rawJson, imported_at: now
  });
  // 革新5: 新規案件だけ生成待ちキューに積む (更新では生成しない)。生成自体は
  // buildMatchProposals がロック外のタイミングで行う (送信はしない)。
  enqueueMatchProposalCase_(newId);
  return { case_id: newId, created: true, source: source, source_case_key: sourceCaseKey,
    coord: coordVerdict };
}

/**
 * pushCaseFromSms (要ドメイン認証): SMS側の手動案件・確認済み情報の単件 upsert。
 * req.case に案件オブジェクトを入れる形式と、req 自体に案件フィールドを入れる形式の両対応。
 */
function actionPushCaseFromSms_(req) {
  var me = requireKikariUser_();
  var input = req.case || req;
  return withLock_(function () {
    var res = upsertCaseFromSource_(input, 'sms_app');
    res.pushed_by = me;
    return res;
  });
}

/**
 * pushCasesFromAiPage (要ドメイン認証): 案件ページ側からのバルク upsert。
 * req.cases (配列) を受け取り、各要素を (source=ai_page 既定, source_case_key) で
 * 冪等に upsert する。1件の失敗で全体を止めず、件数と失敗明細を返す。
 */
function actionPushCasesFromAiPage_(req) {
  var me = requireKikariUser_();
  var list = req.cases || req.items || req.rows || [];
  if (!list.length) throw new Error('cases が空です');
  if (list.length > 1000) throw new Error('1回の push は 1000 件までです (分割してください)');
  return withLock_(function () {
    var created = 0, updated = 0, errors = [];
    list.forEach(function (input, idx) {
      try {
        var res = upsertCaseFromSource_(input, 'ai_page');
        if (res.created) created++; else updated++;
      } catch (err) {
        errors.push({ index: idx, source_case_key: String((input && input.source_case_key) || ''),
          error: errMsg_(err) });
      }
    });
    return { total: list.length, created: created, updated: updated,
      failed: errors.length, errors: errors, pushed_by: me };
  });
}

/**
 * getCaseSyncStatus (読み取り): 出所ごとの最終取り込み日時・件数を返す。
 * case_sources の imported_at 最大値と行数が正。あわせて cases 総数と
 * source_flags 別の案件数 (両方に存在する案件の把握用) も返す。個人情報は含まない。
 */
function actionGetCaseSyncStatus_(req) {
  var bySource = {};
  CASE_SYNC_SOURCES_.forEach(function (s) {
    bySource[s] = { source: s, count: 0, last_imported_at: '' };
  });
  readTable_('case_sources').rows.forEach(function (r) {
    var s = str_(r.source);
    if (!bySource[s]) bySource[s] = { source: s, count: 0, last_imported_at: '' };
    bySource[s].count++;
    var at = cellDateIso_(r.imported_at);
    if (at && at > bySource[s].last_imported_at) bySource[s].last_imported_at = at;
  });
  var flagCounts = {};
  var caseRows = readTable_('cases').rows;
  caseRows.forEach(function (c) {
    toList_(c.source_flags).forEach(function (f) {
      flagCounts[f] = (flagCounts[f] || 0) + 1;
    });
  });
  return {
    sources: Object.keys(bySource).map(function (k) { return bySource[k]; }),
    total_cases: caseRows.length,
    source_flag_counts: flagCounts,
    latest_integrity_check: latestCaseIntegrity_(),
    server_time: nowIso_()
  };
}

/** ===== 案件連携の最終形: 毎日18時の整合性チェック =====
 * マスター件数・府県別内訳・前回チェックとの差分・未解決の競合
 * (case_sources で複数出所が残っている = 敗者保持の件数) を集計し、
 * case_sync_log に1行記録する。結果は getCaseSyncStatus の
 * latest_integrity_check でも返る。 */
function computeCaseIntegrity_() {
  var caseRows = readTable_('cases').rows;
  var byPref = {};
  caseRows.forEach(function (c) {
    var p = str_(c.prefecture) || '(未設定)';
    byPref[p] = (byPref[p] || 0) + 1;
  });
  var srcRows = [];
  try { srcRows = readTable_('case_sources').rows; } catch (e) { srcRows = []; }
  var perCase = {};
  srcRows.forEach(function (r) { perCase[str_(r.case_id)] = (perCase[str_(r.case_id)] || 0) + 1; });
  var loserKept = 0, multiSourceCases = 0;
  Object.keys(perCase).forEach(function (cid) {
    if (perCase[cid] > 1) { multiSourceCases++; loserKept += perCase[cid] - 1; }
  });
  // R4 I-3: 既存マスターの座標異常の棚卸し (受け入れ側の修正とは別に検出する)。
  var coordInvalid = 0, coordFar = 0;
  var caseDupMap = coordDupCountMap_(caseRows.map(function (c) {
    return { lat: c.lat, lon: c.lon, addressKey: str_(c.address) };
  }), municipalityRepKeys_());
  var coordDup = 0;
  caseRows.forEach(function (c) {
    var chk = coordBasicCheck_(c.lat, c.lon);
    if (chk.state === 'invalid') { coordInvalid++; return; }
    if (chk.state !== 'ok') return;
    var rep = municipalityRepPoint_(c.prefecture, c.municipality);
    if (rep) {
      var d = distanceKm_(chk.lat, chk.lon, rep.lat, rep.lon);
      if (d != null && d > COORD_REP_LIMIT_KM) coordFar++;
    }
    if ((caseDupMap[coordKey_(c.lat, c.lon)] || 0) >= COORD_DUP_THRESHOLD) coordDup++;
  });
  return {
    total_cases: caseRows.length,
    by_prefecture: byPref,
    case_sources_rows: srcRows.length,
    multi_source_cases: multiSourceCases,
    loser_kept_rows: loserKept,
    // 未解決の競合 = 複数出所の原文が併存し、代表値の最終判断が人手に残っている案件数
    unresolved_conflicts: multiSourceCases,
    coord_invalid: coordInvalid,
    coord_far_from_rep: coordFar,
    coord_duplicated: coordDup
  };
}

function latestCaseIntegrity_() {
  try {
    var rows = readTable_('case_sync_log').rows;
    if (!rows.length) return null;
    var last = rows[0];
    rows.forEach(function (r) { if (cellDateIso_(r.checked_at) >= cellDateIso_(last.checked_at)) last = r; });
    var detail = {};
    try { detail = JSON.parse(str_(last.detail_json) || '{}'); } catch (e) { detail = {}; }
    return {
      log_id: str_(last.log_id), checked_at: cellDateIso_(last.checked_at),
      total_cases: toNum_(last.total_cases),
      by_prefecture: detail.by_prefecture || {},
      delta_total: toNum_(last.delta_total),
      delta_by_prefecture: detail.delta_by_prefecture || {},
      unresolved_conflicts: toNum_(last.unresolved_conflicts),
      loser_kept_rows: toNum_(last.loser_kept_rows)
    };
  } catch (e) { return null; }
}

/** トリガー / 手動のどちらからでも呼べる本体 (認証はアクション側で行う) */
function runCaseIntegrityCheck() {
  return withLock_(function () {
    var cur = computeCaseIntegrity_();
    var prev = latestCaseIntegrity_();
    var deltaByPref = {};
    var keys = {};
    Object.keys(cur.by_prefecture).forEach(function (k) { keys[k] = true; });
    if (prev) Object.keys(prev.by_prefecture || {}).forEach(function (k) { keys[k] = true; });
    Object.keys(keys).forEach(function (k) {
      deltaByPref[k] = (cur.by_prefecture[k] || 0) - ((prev && prev.by_prefecture[k]) || 0);
    });
    var now = nowIso_();
    var row = {
      log_id: nextId_('case_sync_log'), checked_at: now,
      total_cases: cur.total_cases,
      by_prefecture_json: JSON.stringify(cur.by_prefecture),
      delta_total: prev ? cur.total_cases - (prev.total_cases || 0) : 0,
      delta_by_prefecture_json: JSON.stringify(deltaByPref),
      unresolved_conflicts: cur.unresolved_conflicts,
      loser_kept_rows: cur.loser_kept_rows,
      detail_json: JSON.stringify({ by_prefecture: cur.by_prefecture,
        delta_by_prefecture: deltaByPref, case_sources_rows: cur.case_sources_rows,
        multi_source_cases: cur.multi_source_cases }),
      created_at: now
    };
    appendRow_('case_sync_log', row);
    return { log_id: row.log_id, checked_at: now, total_cases: cur.total_cases,
      by_prefecture: cur.by_prefecture, delta_total: row.delta_total,
      delta_by_prefecture: deltaByPref, unresolved_conflicts: cur.unresolved_conflicts,
      loser_kept_rows: cur.loser_kept_rows, first_check: !prev };
  });
}

function actionRunCaseIntegrityCheck_(req) {
  requireKikariUser_();
  return runCaseIntegrityCheck();
}

/** 毎日18時台の time-driven トリガーを用意する (この関数自体はチェックを実行しない) */
function installCaseIntegrityTrigger() {
  var existing = ScriptApp.getProjectTriggers();
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].getHandlerFunction() === 'runCaseIntegrityCheck') {
      return { installed: false, already_exists: true };
    }
  }
  ScriptApp.newTrigger('runCaseIntegrityCheck').timeBased()
    .atHour(18).nearMinute(0).everyDays(1).create();
  return { installed: true, handler: 'runCaseIntegrityCheck', hour: 18 };
}

// ===== 新着案件マッチ提案 (革新5, INNOVATION.md §5) =====
/** おすすめ減衰スコアの単体計算 (recommendCasesFor_ と同じ式・同じ足切り) */
function caseRecommendScore_(applicant, c) {
  var sameMuni = str_(c.municipality) !== '' && str_(c.municipality) === str_(applicant.municipality);
  var d = distanceKm_(applicant.lat, applicant.lon, c.lat, c.lon);
  if (d == null && !sameMuni) return null;
  if (d != null && d > RECOMMEND_RADIUS_KM) return null;
  var effDist = (d == null) ? 1 : d;
  var srcIso = cellDateIso_(c.updated_at_src);
  var srcMs = srcIso ? new Date(srcIso).getTime() : NaN;
  var nowMs = new Date().getTime();
  var ageDays = (!isFinite(srcMs) || srcMs > nowMs) ? Infinity : (nowMs - srcMs) / 86400000;
  return { score: 1 / ((1 + ageDays / 30) * (1 + effDist / 5)), distance_km: d };
}

/** 新規案件の生成待ちを settings のキューに積む (upsert のロック内で重い計算をしないため) */
function enqueueMatchProposalCase_(caseId) {
  try {
    var cur = toList_(getSettingValue_(MATCH_QUEUE_SETTING_KEY, ''));
    if (cur.indexOf(String(caseId)) >= 0) return;
    cur.push(String(caseId));
    var exists = false;
    readTable_('settings').rows.forEach(function (r) { if (String(r.key) === MATCH_QUEUE_SETTING_KEY) exists = true; });
    if (exists) updateRowByPk_('settings', MATCH_QUEUE_SETTING_KEY, { value: cur.join(',') });
    else appendRow_('settings', { key: MATCH_QUEUE_SETTING_KEY, value: cur.join(',') });
  } catch (e) { /* キュー積みに失敗しても案件 upsert 自体は成功として扱う */ }
}

function clearMatchProposalQueue_(caseIds) {
  try {
    var done = {}; (caseIds || []).forEach(function (id) { done[String(id)] = true; });
    var rest = toList_(getSettingValue_(MATCH_QUEUE_SETTING_KEY, '')).filter(function (id) { return !done[id]; });
    updateRowByPk_('settings', MATCH_QUEUE_SETTING_KEY, { value: rest.join(',') });
  } catch (e) {}
}

/** 募集終了した案件の suggested/seen 提案を dismissed (理由: 募集終了) へ寄せる。ロック内から呼ぶこと */
function dismissProposalsForClosedCase_(caseId, actor) {
  var n = 0;
  try {
    readTable_('case_match_proposals').rows.forEach(function (p) {
      if (String(p.case_id) !== String(caseId)) return;
      if (p.status !== 'suggested' && p.status !== 'seen') return;
      updateRowByPk_('case_match_proposals', p.proposal_id, {
        status: 'dismissed', dismiss_reason: '募集終了',
        status_by: actor || 'system', status_at: nowIso_(), updated_at: nowIso_()
      });
      n++;
    });
  } catch (e) {}
  return n;
}

/**
 * buildMatchProposals (要ドメイン認証): 生成待ち (または req.case_id / req.case_ids で
 * 指定された) 新規案件について、候補者をリスト化して case_match_proposals に保存する。
 * 候補の定義は「その人の既存おすすめ上位5件 (recommendCasesFor_) に当該案件が入ること」。
 * 足切り: 終了/例外系・配信停止・テスト求職者・直近14日に同じ案件を提示済みの人は候補にしない。
 * 1案件あたり上限50名 (スコア順)。切り捨て件数は結果に明記する。送信は一切しない。
 */
function actionBuildMatchProposals_(req) {
  var me = requireKikariUser_();
  var caseIds = toList_(req.case_ids || req.case_id);
  var fromQueue = !caseIds.length;
  if (fromQueue) caseIds = toList_(getSettingValue_(MATCH_QUEUE_SETTING_KEY, ''));
  return withLock_(function () {
    var open = openCases_();
    var allApps = readTable_('applicants').rows;
    var optoutSet = optoutEmailSet_();
    var existing = {};
    try {
      readTable_('case_match_proposals').rows.forEach(function (p) {
        existing[String(p.case_id) + '|' + String(p.applicant_id)] = true;
      });
    } catch (e) {}
    // 直近14日の提示済み (再提案しない)
    var cutoffMs = new Date().getTime() - PROPOSAL_REPRESENTED_DAYS * 86400000;
    var presented = {};
    try {
      readTable_('delivery_recipients').rows.forEach(function (r) {
        var at = cellDateIso_(r.sent_at) || cellDateIso_(r.created_at);
        var ms = at ? new Date(at).getTime() : NaN;
        if (!isFinite(ms) || ms < cutoffMs) return;
        toList_(r.recommended_case_ids).forEach(function (cid) {
          presented[String(r.applicant_id) + '|' + cid] = true;
        });
      });
    } catch (e) {}
    var summary = { processed: 0, created: 0, skipped_existing: 0, by_case: [] };
    caseIds.forEach(function (caseId) {
      summary.processed++;
      var c = null;
      try { c = findRow_('cases', 'case_id', caseId); } catch (e) { c = null; }
      if (!c) { summary.by_case.push({ case_id: caseId, error: 'case_not_found' }); return; }
      if (!toBool_(c.is_open)) {
        var closed = dismissProposalsForClosedCase_(caseId, me);
        summary.by_case.push({ case_id: caseId, closed: true, dismissed: closed });
        return;
      }
      // 計算量の歯止め: 同職種 + (同一市区町村 または 距離20km以内) の人だけに絞ってから回す
      var pool = filterApplicants_(allApps, {}).filter(function (a) {
        if (str_(a.job_type) !== str_(c.job_type)) return false;
        if (csvStageRank_(a.csv_status).terminal) return false;
        if (toBool_(a.mail_optout)) return false;
        if (str_(a.email) && optoutSet[normalizeEmail_(a.email)]) return false;
        var d = distanceKm_(a.lat, a.lon, c.lat, c.lon);
        return (d != null && d <= RECOMMEND_RADIUS_KM) ||
          (str_(a.municipality) !== '' && str_(a.municipality) === str_(c.municipality));
      });
      var cands = [];
      pool.forEach(function (a) {
        var pairKey = String(caseId) + '|' + String(a.applicant_id);
        if (presented[String(a.applicant_id) + '|' + String(caseId)]) return;
        var recs = recommendCasesFor_(a, open, 5);
        for (var i = 0; i < recs.length; i++) {
          if (String(recs[i].case_id) === String(caseId)) {
            var sc = caseRecommendScore_(a, c);
            cands.push({ applicant: a, rank: i + 1,
              score: sc ? Math.round(sc.score * 10000) / 10000 : 0,
              distance_km: recs[i].distance_km });
            break;
          }
        }
      });
      cands.sort(function (x, y) { return y.score - x.score; });
      var truncated = Math.max(0, cands.length - PROPOSAL_CANDIDATE_LIMIT);
      var made = 0, skipped = 0, now = nowIso_();
      cands.slice(0, PROPOSAL_CANDIDATE_LIMIT).forEach(function (cand) {
        var pairKey = String(caseId) + '|' + String(cand.applicant.applicant_id);
        if (existing[pairKey]) { skipped++; return; }
        existing[pairKey] = true;
        appendRow_('case_match_proposals', {
          proposal_id: nextId_('case_match_proposals'), case_id: String(caseId),
          applicant_id: str_(cand.applicant.applicant_id),
          rank_in_recommend: cand.rank, score: cand.score,
          distance_km: (cand.distance_km == null ? '' : cand.distance_km),
          status: 'suggested', status_by: '', status_at: '', dismiss_reason: '',
          delivery_id: '', created_at: now, updated_at: now
        });
        made++;
      });
      summary.created += made;
      summary.skipped_existing += skipped;
      summary.by_case.push({ case_id: caseId, candidates: cands.length, created: made,
        skipped_existing: skipped, truncated: truncated });
    });
    if (fromQueue) clearMatchProposalQueue_(caseIds);
    return summary;
  });
}

var PROPOSAL_TRANSITIONS_ = {
  suggested: ['seen', 'dismissed', 'ready'],
  seen: ['dismissed', 'ready'],
  ready: ['sent', 'dismissed'],
  dismissed: [], sent: []
};

function proposalItem_(p) {
  var caseName = '', applicantName = '';
  try { caseName = str_(findRow_('cases', 'case_id', p.case_id).facility_name); } catch (e) {}
  try { applicantName = str_(findApplicant_(p.applicant_id).name); } catch (e) {}
  return {
    proposal_id: str_(p.proposal_id), case_id: str_(p.case_id), facility_name: caseName,
    applicant_id: str_(p.applicant_id), applicant_name: applicantName,
    rank_in_recommend: toNum_(p.rank_in_recommend), score: toNum_(p.score),
    distance_km: toNum_(p.distance_km),
    status: str_(p.status), status_by: str_(p.status_by), status_at: cellDateIso_(p.status_at),
    dismiss_reason: str_(p.dismiss_reason), delivery_id: str_(p.delivery_id),
    created_at: cellDateIso_(p.created_at), updated_at: cellDateIso_(p.updated_at)
  };
}

/** getMatchProposals (読み取り): 提案一覧。未読 (suggested) 件数も返す。送信はしない */
function actionGetMatchProposals_(req) {
  var rows = [];
  try { rows = readTable_('case_match_proposals').rows; } catch (e) { rows = []; }
  var unread = 0;
  rows.forEach(function (p) { if (p.status === 'suggested') unread++; });
  var filtered = rows.filter(function (p) {
    if (req.status && String(p.status) !== String(req.status)) return false;
    if (req.case_id && String(p.case_id) !== String(req.case_id)) return false;
    if (req.applicant_id && String(p.applicant_id) !== String(req.applicant_id)) return false;
    return true;
  });
  filtered.sort(function (a, b) {
    var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  var limit = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
  return { total: filtered.length, unread_count: unread,
    items: filtered.slice(0, limit).map(proposalItem_) };
}

/**
 * updateMatchProposalStatus (要ドメイン認証): 提案の状態遷移。
 * suggested -> seen / dismissed / ready、ready -> sent (人が送信を記録したときだけ)。
 * ready は issueFormToken の delivery_id を紐付けられるが、本アクション自体は送信しない。
 */
function actionUpdateMatchProposalStatus_(req) {
  var me = requireKikariUser_();
  if (!req.proposal_id) throw new Error('proposal_id が必要です');
  var status = String(req.status || '');
  return withLock_(function () {
    var p = findRow_('case_match_proposals', 'proposal_id', req.proposal_id);
    var allowed = PROPOSAL_TRANSITIONS_[str_(p.status)] || [];
    if (allowed.indexOf(status) < 0) {
      throw new Error('提案の状態遷移が不正です: ' + str_(p.status) + ' -> ' + status);
    }
    var now = nowIso_();
    var patch = { status: status, status_by: me, status_at: now, updated_at: now };
    if (status === 'dismissed') patch.dismiss_reason = String(req.dismiss_reason || req.reason || '');
    if (req.delivery_id) patch.delivery_id = String(req.delivery_id);
    updateRowByPk_('case_match_proposals', req.proposal_id, patch);
    return { proposal_id: req.proposal_id, status: status, status_by: me };
  });
}

// ===== おすすめ案件マッチング (DATA_MODEL §12) =====
/**
 * 同一 job_type 必須。並び: 距離昇順 + 同一市区町村ボーナス + 新しさ (updated_at_src)。
 * 座標が無い応募者/案件は「同一市区町村 = 近距離 (仮 1km)」として扱う。
 * 対象は呼び出し側で絞った応募者だけに限定し、全件総当たりはしない。
 */
// 施設形態の同点時優先順 (LIVE §6。介護の例: 有料 -> サ高住・GH・デイ -> 特養)
var SERVICE_ORDER_ = ['有料', 'サ高住', 'GH', 'グループホーム', 'デイ', '特養', '老健', '病院'];
function serviceRank_(serviceType) {
  var st = str_(serviceType);
  for (var i = 0; i < SERVICE_ORDER_.length; i++) if (st.indexOf(SERVICE_ORDER_[i]) >= 0) return i;
  return SERVICE_ORDER_.length;
}
function salaryNum_(c) {
  var m = str_(c.salary_text).replace(/,/g, '').match(/(\d{3,5})/);
  return m ? parseInt(m[1], 10) : 0;
}
/**
 * 順位の減衰スコア (LIVE §6。フロントと一致させる):
 *   score = 1 / ((1 + 経過日数/30) x (1 + 距離km/5))
 * 経過日数は取得日 (updated_at_src) から。経過30日・距離5kmでそれぞれ評価が半分になる。
 * 取得日がパースできない場合と未来日の場合はスコア 0 (SPEC_REFERENCE §4.2、フロントと一致)。
 * 対象は 20km 以内 (距離不明は同一市区町村の場合のみ近距離扱いで含める)。
 * 同点時は 距離 -> 取得日 (新しい順) -> 施設形態 (SERVICE_ORDER_) -> 単価 (高い順)。
 */
function recommendCasesFor_(applicant, openCases, count) {
  var nowMs = new Date().getTime();
  var scored = [];
  for (var i = 0; i < openCases.length; i++) {
    var c = openCases[i];
    if (str_(c.job_type) !== str_(applicant.job_type)) continue; // 同職種必須
    var sameMuni = str_(c.municipality) !== '' && str_(c.municipality) === str_(applicant.municipality);
    var d = distanceKm_(applicant.lat, applicant.lon, c.lat, c.lon);
    if (d == null && !sameMuni) continue; // 距離も市区町村も判定できない案件は出さない
    if (d != null && d > RECOMMEND_RADIUS_KM) continue; // 20km超は出さない (LIVE §6)
    var effDist = (d == null) ? 1 : d;    // 同一市区町村で座標なし = 近距離扱い
    var srcIso = cellDateIso_(c.updated_at_src);
    var srcMs = srcIso ? new Date(srcIso).getTime() : NaN;
    // 仕様 (SPEC_REFERENCE §4.2 / 現行 JOB_RECOMMENDATIONS.md 2026-10-24 節): 取得日が
    // パースできない (不明・不正) 場合と未来日の場合はスコア 0。フロントの
    // recommendationScore (index.html) も同じ扱い。除外はせず、ageDays=Infinity として
    // 減衰式の結果を 0 にし、同点タイブレーク (距離→取得日→形態→単価) で下位に残す。
    var ageDays = (!isFinite(srcMs) || srcMs > nowMs) ? Infinity : (nowMs - srcMs) / 86400000;
    var score = 1 / ((1 + ageDays / 30) * (1 + effDist / 5));
    scored.push({ c: c, d: d, effDist: effDist, score: score, fresh: srcIso });
  }
  scored.sort(function (a, b) {
    if (a.score !== b.score) return b.score - a.score; // スコア降順
    if (a.effDist !== b.effDist) return a.effDist - b.effDist;
    if (a.fresh !== b.fresh) return a.fresh < b.fresh ? 1 : -1;
    var sr = serviceRank_(a.c.service_type) - serviceRank_(b.c.service_type);
    if (sr !== 0) return sr;
    return salaryNum_(b.c) - salaryNum_(a.c);
  });
  return scored.slice(0, count).map(function (x) { return caseListItem_(x.c, x.d); });
}

function openCases_() {
  return readTable_('cases').rows.filter(function (c) { return toBool_(c.is_open); });
}

function actionRecommendForApplicants_(req) {
  var ids = toList_(req.applicant_ids);
  if (!ids.length) throw new Error('applicant_ids が空です');
  if (ids.length > MAX_RECOMMEND_APPLICANT_IDS) {
    throw new Error('applicant_ids は最大 ' + MAX_RECOMMEND_APPLICANT_IDS + ' 件までです (全件総当たり防止)');
  }
  // SMS側の既定は上位5件 (SMS_RECOMMEND_DEFAULT, LIVE §6)。
  // Gmail の recommend_count (初期3・1〜5可変) とは別: そちらは clampRecommendCount_ を使う。
  var count = (req.recommend_count == null || req.recommend_count === '')
    ? SMS_RECOMMEND_DEFAULT
    : Math.min(MAX_RECOMMEND_COUNT, Math.max(1, parseInt(req.recommend_count, 10) || SMS_RECOMMEND_DEFAULT));
  var cases = openCases_();
  var out = {};
  ids.forEach(function (id) {
    var a = findApplicant_(id);
    out[id] = recommendCasesFor_(a, cases, count).map(publicFromListItem_); // SMS向けは対外整形で返す
  });
  return { recommendations: out, recommend_count: count };
}

function clampRecommendCount_(v) {
  var n = parseInt(v, 10);
  if (isNaN(n)) n = parseInt(getSettingValue_('default_recommend_count', '3'), 10) || 3;
  return Math.min(MAX_RECOMMEND_COUNT, Math.max(1, n));
}

function defaultTopN_() {
  var n = parseInt(getSettingValue_('default_top_n', '700'), 10);
  return isNaN(n) ? 700 : Math.min(MAX_TOP_N, Math.max(1, n));
}

// ===== Gmail 配信: 対象決定 (順序固定。DESIGN_V2 §6.2 / DATA_MODEL §12) =====
/**
 * 順序: 絞り込み -> 除外 (メール重複 / 配信停止 / 対応中) -> 応募日新しい順
 *       -> 上限N人 -> そのN人分だけおすすめ照合。
 * 戻り値に件数内訳を必ず含める (条件一致 / 送信可能 / 除外理由別 / おすすめなし)。
 */
// R4 I-2: 回答済み者の Gmail 対象ルール (明文化)
// 1. 回答したこと自体は配信停止にならない (抑止リストへの自動登録はしない)。
// 2. 回答キューで対応中 (responses.status = in_progress) の回答が1件でもある人は
//    既定で除外する (担当が誰かは問わない)。csv_status 側の対応中除外
//    (include_active) とは独立で、include_active=true でも外れない。
//    含める場合だけ include_response_in_progress=true を明示する。
// 3. 未対応・対応済みのみの人は除外しない。
// 4. 直近回答者 (最終回答が RECENT_RESPONSE_DAYS 日以内) は除外とは別に
//    内訳へ常に表示する。30日は FORM_TOKEN_TTL_DAYS に合わせた運用パラメータ。
// 是正 (2026-11-23・手順B): 上記2の既定を反転した。回答対応中・csv対応中とも
// 既定は「含める」。外す場合だけ include_response_in_progress=false /
// include_active=false を明示する (解決済みフラグで計算・指紋・保存を揃える)。
var RECENT_RESPONSE_DAYS = 30;

/** responses を1回走査して対象計算用の集合を作る (読めない環境では空集合に倒す) */
function responseTargetSets_() {
  var inProgress = {}, latestMs = {};
  try {
    readTable_('responses').rows.forEach(function (r) {
      var id = str_(r.applicant_id);
      if (!id) return;
      if (responseStatus_(r) === 'in_progress') inProgress[id] = true;
      var ms = new Date(cellDateIso_(r.created_at)).getTime();
      if (isFinite(ms) && (!latestMs[id] || ms > latestMs[id])) latestMs[id] = ms;
    });
  } catch (e) { return { in_progress: {}, recent: {} }; }
  var cutoff = new Date().getTime() - RECENT_RESPONSE_DAYS * 86400000;
  var recent = {};
  Object.keys(latestMs).forEach(function (id) {
    if (latestMs[id] >= cutoff) recent[id] = true;
  });
  return { in_progress: inProgress, recent: recent };
}

function computeMailTargets_(filter, topN, includeActive, opts) {
  opts = opts || {};
  var all = readTable_('applicants').rows;
  // 手順F: mail_only を外し、メールなしの人も matched に入れて no_email で数える
  // (従来は前段で落ちて、条件一致と送信可能の差分に現れなかった)。
  var matched = sortByAppliedDesc_(filterApplicants_(all, Object.assign({}, filter)));
  var optoutSet = optoutEmailSet_();
  var sentToday = mailSentTodayMap_();
  var respSets = responseTargetSets_();
  var seenEmail = {};
  // R4 レーンC: 判定順序を統一する (形式 → 停止 → 回答対応中 → csv対応中 →
  // 重複は最後)。seen には全判定を通過した行だけを登録する (除外される最新行が、
  // 送信可能な古い行まで重複で落とすのを防ぐ)。
  // 是正 (2026-11-23): 終了系・年齢・同日送信済みは除外から外した (手順C/D)。
  // 対象に含めた内訳として notes で返す (手順G)。
  // duplicate_email は「他の除外理由を持たず、通過済みの先行行と重複した行」だけを数える。
  var excluded = { duplicate_email: 0, optout: 0, active: 0, no_email: 0, invalid_email: 0, terminal: 0, age_over: 0, sent_today: 0, no_recommend: 0, response_in_progress: 0 };
  var sendable = [];
  var recentMatched = 0;
  matched.forEach(function (r) {
    if (respSets.recent[str_(r.applicant_id)]) recentMatched++;
    var email = normalizeEmail_(r.email);
    if (!email) { excluded.no_email++; return; }
    if (!isValidEmail_(email)) { excluded.invalid_email++; return; }
    if (toBool_(r.mail_optout) || optoutSet[email]) { excluded.optout++; return; }
    // R4 I-2: 回答キュー対応中の人 (手順Bで既定は含める。外す明示があったときだけ除外)。
    if (!opts.include_response_in_progress && respSets.in_progress[str_(r.applicant_id)]) {
      excluded.response_in_progress++; return;
    }
    // R4 01-#3: 対応中判定は csvStageRank_ の正規化判定 (表記ゆれを拾う)。
    // 手順Bで既定は含める (includeActive は解決済みフラグ。外す明示時のみ false)。
    if (!includeActive && isActiveCsvStatus_(r.csv_status)) { excluded.active++; return; }
    if (seenEmail[email]) { excluded.duplicate_email++; return; }
    seenEmail[email] = true;
    sendable.push(r);
  });
  var targets = sendable.slice(0, topN);
  // R4 01-#1: おすすめ照合は上限適用後に行い (上限の意味を変えない)、結果は行の
  // _r4_recs に保持して preview/create が再照合しないようにする。
  // 手順E: おすすめ0件でも対象から落とさない (案件なしで送る)。件数は notes で返す。
  if (opts.mode === 'per_person') {
    var cases = opts.open_cases || openCases_();
    var rc = opts.recommend_count || 1;
    targets.forEach(function (r) {
      r._r4_recs = recommendCasesFor_(r, cases, rc);
    });
  }
  // R4 01-#10: 他配信で本日作成・未送信の宛先が重なる人数 (警告表示用。除外はしない)。
  var queuedSet = mailQueuedTodaySet_();
  var queuedToday = 0;
  targets.forEach(function (r) { if (queuedSet[str_(r.applicant_id)]) queuedToday++; });
  // R4 I-2: 直近回答者の内訳 (対象に残る人数つき)。
  var recentTargets = 0;
  targets.forEach(function (r) { if (respSets.recent[str_(r.applicant_id)]) recentTargets++; });
  // 手順G: 除外ではなく「対象に含めた内訳」。画面側が平易な言葉で見せるための件数。
  var notes = { sent_today: 0, terminal: 0, age_over: 0, active: 0, response_in_progress: 0, no_recommend: 0 };
  targets.forEach(function (r) {
    var nid = str_(r.applicant_id);
    if (sentToday[nid]) notes.sent_today++;
    if (isTerminalStatus_(r)) notes.terminal++;
    var nAge = ageFromBirth_(r.birth_date);
    if (nAge != null && nAge > MAIL_TARGET_MAX_AGE) notes.age_over++;
    if (isActiveCsvStatus_(r.csv_status)) notes.active++;
    if (respSets.in_progress[nid]) notes.response_in_progress++;
    if (opts.mode === 'per_person' && !(r._r4_recs && r._r4_recs.length)) notes.no_recommend++;
  });
  return {
    matched_count: matched.length,
    sendable_count: sendable.length,
    excluded: excluded,
    notes: notes,
    queued_today_count: queuedToday,
    responder: {
      recent_count: recentMatched,
      recent_target_count: recentTargets,
      in_progress_excluded: excluded.response_in_progress
    },
    targets: targets
  };
}

function actionMailPreviewTargets_(req) {
  var topN = Math.min(MAX_TOP_N, Math.max(1, parseInt(req.top_n, 10) || defaultTopN_()));
  var count = clampRecommendCount_(req.recommend_count);
  var mode = String(req.mode || 'per_person');
  var cases = (mode === 'per_person') ? openCases_() : [];
  // R4 01-#1: おすすめ照合は computeMailTargets_ 側で一度だけ行う (二重走査の廃止)。
  // 手順B: 解決済みフラグ (未指定 = 含める)。作成経路と必ず同じ規則にする。
  var includeActiveP = req.include_active !== false;
  var includeRespP = req.include_response_in_progress !== false;
  var res = computeMailTargets_(req.filter || {}, topN, includeActiveP,
    { mode: mode, recommend_count: count, open_cases: cases,
      include_response_in_progress: includeRespP });
  // R6.7 欠陥3: テスト時は作成経路 (actionMailCreateDelivery_) と同じく対象を
  // テスト応募者1名に差し替える。従来はプレビューに test 分岐が無く、is_test
  // 除外が効いたまま target_count 0 になり、実送信と食い違っていた。
  if (req.test === true) {
    var testBaseP = null;
    readTable_('applicants').rows.forEach(function (r) {
      if (!testBaseP && isTestApplicant_(r)) testBaseP = r;
    });
    if (!testBaseP) throw new Error('テスト求職者が未登録です。seedTestApplicant_ を実行してください');
    res = Object.assign({}, res, {
      targets: [Object.assign({}, testBaseP, { email: testSendEmail_() })]
    });
  }
  var preview = res.targets.slice(0, 50).map(function (r) {
    var recs = (mode === 'per_person') ? (r._r4_recs || recommendCasesFor_(r, cases, count)) : [];
    // 予備候補: 確認画面で案件を外したときの補充用。表示分より多めに取得し、
    // recommended と重ならない残りを最大5件返す。作成時の _r4_recs (count 件) は
    // 変えない (作成経路の再計算と一致させるため、spare はプレビュー専用)。
    var spare = [];
    if (mode === 'per_person') {
      var wide = recommendCasesFor_(r, cases, count + 5);
      var shownIds = {};
      recs.forEach(function (x) { shownIds[str_(x.case_id)] = true; });
      spare = wide.filter(function (x) { return !shownIds[str_(x.case_id)]; }).slice(0, 5);
    }
    return {
      applicant_id: str_(r.applicant_id), name: str_(r.name), surname: str_(r.surname),
      prefecture: str_(r.prefecture), municipality: str_(r.municipality),
      job_type: str_(r.job_type), applied_at: cellDateIso_(r.applied_at),
      recommended: recs,
      recommended_spare: spare
    };
  });
  return {
    matched_count: res.matched_count,       // 条件一致
    sendable_count: res.sendable_count,     // 除外後に送信可能な総数
    target_count: res.targets.length,       // 上限N適用後の対象数
    excluded: res.excluded,                 // 除外理由別
    responder: res.responder,               // R4 I-2: 直近回答者の内訳
    no_recommend_count: (res.notes && res.notes.no_recommend) || 0, // おすすめなし人数 (手順E: 除外せず対象に含めた内訳)
    notes: res.notes || {},                 // 手順G: 対象に含めた内訳 (sent_today / terminal / age_over / active / response_in_progress / no_recommend)
    queued_today_count: res.queued_today_count || 0,    // 他配信で本日作成・未送信の重なり (警告用)
    top_n: topN, recommend_count: count, mode: mode,
    preview: preview // 先頭50人分のみ返す (全対象は mailCreateDelivery でサーバー側再計算)
  };
}

// ===== Gmail 配信: 配信作成 (要ドメイン認証 + can_send)。この関数自体は送信しない =====
/**
 * deliveries / delivery_recipients / send_queue を一括作成するだけ。
 * 実際の送信は processSendQueue (送信者本人の時間トリガー) が行う。
 * 対象はサーバー側で computeMailTargets_ を再計算して確定する
 * (画面の言い値を信用しない)。
 */
// ===== 配信作成の冪等性 (R3 Z4 / G6) =====
// 二重作成 (ボタンの連打・通信リトライ・outbox 再送) で同じ配信が2件でき、
// 全員へ二重送信になるのを防ぐ。照合の優先順位:
//   (1) client_request_id (クライアント生成ID) があればそれで照合 (時間窓なし)。
//       キーは deliveries.filter_json の _idem に埋めて保存する。
//   (2) キーが無い場合も、同一送信者・同一内容 (件名/本文/フィルタ/モード/
//       おすすめ件数/予約時刻/テスト区分) の配信が IDEMPOTENCY_WINDOW_MS 以内に
//       あれば、それを既存として返す (内容フィンガープリント照合)。
var IDEMPOTENCY_WINDOW_MS = 180000; // 3分

function canonFilterJson_(filterObj) {
  var src = filterObj || {};
  var out = {};
  Object.keys(src).sort().forEach(function (k) {
    if (k === '_idem') return;
    // include_active / _top_n / _test は filter_json に保存されるが、指紋では
    // findIdempotentDelivery_ が個別に比較する (作成リクエスト側の filter には
    // 含まれないキー、または個別の意味を持つメタ情報のため)。
    if (k === 'include_active') return;
    if (k === 'include_response_in_progress') return; // R4 I-2: include_active と同扱い
    if (k === '_top_n' || k === '_test') return;
    if (k === '_case_overrides') return; // 案件の上書き指定も個別に比較する (include_active と同扱い)
    out[k] = src[k];
  });
  return JSON.stringify(out);
}

// 案件の上書き指定 { applicant_id: [case_id, ...] } の指紋用正規化。
// 応募者IDをソートし、各IDの案件リストをそのまま連結する (順序も意味を持つ)。
function canonCaseOverrides_(ov) {
  if (!ov || typeof ov !== 'object') return '';
  var parts = [];
  Object.keys(ov).sort().forEach(function (id) {
    var arr = Array.isArray(ov[id]) ? ov[id] : [];
    parts.push(id + ':' + arr.map(function (x) { return String(x); }).join(','));
  });
  return parts.join('|');
}

function deliveryReplayResult_(d) {
  return {
    delivery_id: str_(d.delivery_id),
    target_count: toNum_(d.target_count) || 0,
    sent_count: toNum_(d.sent_count) || 0,
    failed_count: toNum_(d.failed_count) || 0,
    status: str_(d.status),
    idempotent_replay: true,
    note: '同一の配信作成リクエストが既に処理済みのため、既存の配信を返しました (二重作成・二重送信はしません)'
  };
}

function findIdempotentDelivery_(senderEmail, fp) {
  var key = String(fp.clientRequestId || '');
  var rows = readTable_('deliveries').rows;
  var nowMs = new Date().getTime();
  for (var i = rows.length - 1; i >= 0; i--) {
    var d = rows[i];
    if (String(d.sender_email || '').toLowerCase() !== String(senderEmail).toLowerCase()) continue;
    if (String(d.status || '') === 'cancelled') continue;
    var stored = null;
    try { stored = JSON.parse(String(d.filter_json || '{}')); } catch (e) { stored = null; }
    if (key) {
      if (stored && String(stored._idem || '') === key) {
        // R4 01-#9: キー一致でも内容が違えば replay しない。黙って旧配信を返すと
        // 編集後の内容が送られない事故になるため、例外にして出し直しを促す
        // (新規作成に倒すと元の作成が成功していた場合に二重送信になる)。
        var sameContent = String(d.subject || '') === fp.subject &&
          String(d.body_template || '') === fp.body &&
          String(d.mode || '') === fp.mode &&
          (toNum_(d.recommend_count) || 0) === fp.count &&
          String(d.scheduled_at || '') === fp.scheduledAt &&
          canonFilterJson_(stored) === canonFilterJson_(fp.filter) &&
          (stored.include_active === true) === (fp.includeActive === true) &&
          (stored.include_response_in_progress === true) === (fp.includeResponseInProgress === true) &&
          (stored._top_n == null || Number(stored._top_n) === Number(fp.topN)) &&
          (stored._test == null || (stored._test === true) === (fp.test === true)) &&
          canonCaseOverrides_(stored._case_overrides) === String(fp.caseOverrides || '');
        if (!sameContent) throw new Error('client_request_id が既存の配信と内容が異なります (二重送信防止のため作成を止めました。新しい操作として出し直してください)');
        return deliveryReplayResult_(d);
      }
      continue;
    }
    var createdMs = new Date(cellDateIso_(d.created_at)).getTime();
    if (!(createdMs > 0) || nowMs - createdMs > IDEMPOTENCY_WINDOW_MS) continue;
    if (String(d.subject || '') !== fp.subject) continue;
    if (String(d.body_template || '') !== fp.body) continue;
    if (String(d.mode || '') !== fp.mode) continue;
    if ((toNum_(d.recommend_count) || 0) !== fp.count) continue;
    if (String(d.scheduled_at || '') !== fp.scheduledAt) continue;
    if (!stored || canonFilterJson_(stored) !== canonFilterJson_(fp.filter)) continue;
    if ((stored.include_active === true) !== (fp.includeActive === true)) continue;
    if ((stored.include_response_in_progress === true) !== (fp.includeResponseInProgress === true)) continue;
    // R4 01-#9: top_n / テスト区分も指紋に含める。メタが無い旧配信は検証不能として replay しない。
    if (stored._top_n == null || stored._test == null) continue;
    if (Number(stored._top_n) !== Number(fp.topN)) continue;
    if ((stored._test === true) !== (fp.test === true)) continue;
    if (canonCaseOverrides_(stored._case_overrides) !== String(fp.caseOverrides || '')) continue;
    return deliveryReplayResult_(d);
  }
  return null;
}

/**
 * R4 13-#8 後半: 送信者 (operators) の署名ガード。sender_address ガードと同型で、
 * 署名が未設定 (空) のまま、またはシード等のプレースホルダ文言を含んだまま
 * 送信できないよう、配信作成時点で止める。プレースホルダ判定は実データの
 * 初期値文言だけを狙う部分一致: '設定してください' / 'プレースホルダ' /
 * '(本人' / '（本人' / '初回に設定'。
 */
function assertOperatorSignatureReady_(operator) {
  var sig = str_(operator && operator.signature);
  if (!sig.trim()) {
    throw new Error('送信者の署名 (signature) が未設定です。設定画面で署名を設定してください');
  }
  var placeholders = ['設定してください', 'プレースホルダ', '(本人', '（本人', '初回に設定'];
  for (var i = 0; i < placeholders.length; i++) {
    if (sig.indexOf(placeholders[i]) >= 0) {
      throw new Error('送信者の署名 (signature) にプレースホルダが含まれています。設定画面で実際の署名を設定してください');
    }
  }
}

function actionMailCreateDelivery_(req) {
  var auth = requireCanSend_();
  var subject = String(req.subject || '').trim();
  var body = String(req.body_template || '');
  // R6.6 include_form: 送信時にフォームURLを付けるか (既定 true)。
  // false の場合も form_token 自体は発行する — 配信停止リンクの本人確認に
  // 同じトークンを使うため、空にすると外部からの配信停止登録が壊れる。
  // フラグが制御するのは文面へのフォームURLの載せ方だけ。
  var includeForm = req.include_form !== false;
  if (!subject) throw new Error('件名が空です');
  if (!body) throw new Error('本文テンプレが空です');
  // R4 レーンD 13-#5: 件名・本文テンプレ自体への許可リスト外タグの混入は作成時点で拒否する
  // (宛名等の対象者依存タグは展開後でないと判定できないため、ここでは未知タグの検出に限る)。
  var badSubjectTags = disallowedTags_(subject, 'mail');
  if (badSubjectTags.length) {
    throw new Error('件名にメールでは使えないプレースホルダが含まれています: ' + badSubjectTags.join(' '));
  }
  var badBodyTags = disallowedTags_(body, 'mail');
  if (badBodyTags.length) {
    throw new Error('本文にメールでは使えないプレースホルダが含まれています: ' + badBodyTags.join(' '));
  }
  if (body.indexOf('{不足ヒアリング}') >= 0 || subject.indexOf('{不足ヒアリング}') >= 0) {
    throw new Error('{不足ヒアリング} は誤字です。正しくは {不足ヒヤリング} です。直してから作成してください');
  }
  // R4 レーンJ 項目1: 使ったテンプレートの版キーを確定する。フロントが
  // req.template_version を渡した場合はそれを素通しで記録し、無ければ
  // template_id / template_kind (= mail_body) の行と本文の一致からサーバーで決める。
  var tplVer = req.template_version
    ? { template_id: String(req.template_id || ''), template_version: String(req.template_version) }
    : templateVersionFor_({ template_id: req.template_id,
        template_kind: req.template_kind || 'mail_body' }, body);
  // R3 検証 #30: フォーム/配信停止 URL が未設定のまま作成すると「(配信停止URL未設定)」
  // 等のリテラル入りのメールがそのまま送られてしまう。作成時点で検出して止める。
  if (!String(getSettingValue_('form_base_url', '') || '').trim()) {
    throw new Error('回答フォームURL (form_base_url) が未設定です。設定を確認してください');
  }
  if (!String(getSettingValue_('optout_base_url', '') || '').trim()) {
    throw new Error('配信停止URL (optout_base_url) が未設定です。設定を確認してください');
  }
  // R4 (法令ブロッカー): 送信者住所が未設定のまま送ると特定電子メール法の
  // 表示義務を欠くため、作成時点で止める (値は運用開始前に設定が必要)。
  if (!String(getSettingValue_('sender_address', '') || '').trim()) {
    throw new Error('送信者住所 (sender_address) が未設定です。設定を確認してください');
  }
  // R4 13-#8 後半: 署名も sender_address と同型に、未設定・プレースホルダのまま
  // 送信できないよう作成時点で止める (送信者は requireCanSend_ の operators 行)。
  assertOperatorSignatureReady_(auth.operator);
  var mode = (String(req.mode || 'per_person') === 'same_body') ? 'same_body' : 'per_person';
  var count = clampRecommendCount_(req.recommend_count);
  var topN = Math.min(MAX_TOP_N, Math.max(1, parseInt(req.top_n, 10) || defaultTopN_()));
  var scheduledAt = String(req.scheduled_at || '');
  // 手順B: 解決済みフラグ (未指定 = 含める)。計算・指紋 (findIdempotentDelivery_)・
  // filter_json 保存の3か所で必ずこの値を使う。
  var includeActiveResolved = req.include_active !== false;
  var includeRespResolved = req.include_response_in_progress !== false;
  // 案件の上書き指定 (確認画面で外す/補充した結果)。形式は
  // { applicant_id: [case_id, ...] } で「その人の最終的な案件リスト」を表す。
  // 空配列は「案件なしで送る」の明示。検証 (上限・存在・募集中) は作成ループ側。
  var caseOverridesReq = (req.case_overrides && typeof req.case_overrides === 'object') ? req.case_overrides : {};
  if (req.test === true && subject.indexOf('【テスト】') !== 0) subject = '【テスト】' + subject;

  var createdDelivery = withLock_(function () {
    // R3 Z4: 冪等性チェック (上記 findIdempotentDelivery_ 参照)。
    var replay = findIdempotentDelivery_(auth.email, {
      clientRequestId: String(req.client_request_id || ''),
      subject: subject, body: body, mode: mode, count: count,
      scheduledAt: scheduledAt, filter: req.filter || {},
      includeActive: includeActiveResolved,
      includeResponseInProgress: includeRespResolved,
      topN: topN, test: req.test === true,
      caseOverrides: canonCaseOverrides_(caseOverridesReq)
    });
    if (replay) return replay;
    var cases = (mode === 'per_person') ? openCases_() : [];
    var res = computeMailTargets_(req.filter || {}, topN, includeActiveResolved,
      { mode: mode, recommend_count: count, open_cases: cases,
        include_response_in_progress: includeRespResolved });
    var testEmail = '';
    if (req.test === true) {
      testEmail = testSendEmail_();
      // 手順A: テスト宛先の事前検証。送れない場合は作成時点で理由を出して止める
      // (作成できたのに送信時に無言で落ちる状態を無くす)。
      var testEmailNorm = normalizeEmail_(testEmail);
      if (!testEmailNorm || !isValidEmail_(testEmailNorm)) {
        throw new Error('テスト送信先のメールアドレス形式が不正です: ' + testEmail);
      }
      if (optoutEmailSet_()[testEmailNorm]) {
        throw new Error('テスト送信先が配信停止に登録されているため送れません: ' + testEmail);
      }
      var testBase = null;
      var allRowsForTest = readTable_('applicants').rows;
      for (var ti = 0; ti < allRowsForTest.length; ti++) {
        if (isTestApplicant_(allRowsForTest[ti])) { testBase = allRowsForTest[ti]; break; }
      }
      // R4 S-12: 実在応募者へのフォールバックは廃止 (テスト送信のスナップショットが
      // 実在者のタイムラインに混入する経路だった)。テスト求職者がいなければ作成自体を止める。
      if (!testBase) throw new Error('テスト求職者が未登録です。seedTestApplicant_ を実行してください');
      if (toBool_(testBase.mail_optout)) {
        throw new Error('テスト求職者が配信停止に登録されているためテスト送信を作成できません');
      }
      res = Object.assign({}, res, { targets: [Object.assign({}, testBase, { email: testEmail })] });
    }
    if (!res.targets.length) throw new Error('送信対象が0人です (条件一致 ' + res.matched_count + ' 人 / 除外 ' + JSON.stringify(res.excluded) + ' / おすすめなし (対象に含めた内訳) ' + ((res.notes && res.notes.no_recommend) || 0) + ' 人)');
    var deliveryId = nextId_('deliveries');
    var now = nowIso_();
    appendRow_('deliveries', {
      delivery_id: deliveryId, sender_email: auth.email,
      sender_name: str_(auth.operator.display_name), subject: subject, body_template: body,
      mode: mode, recommend_count: count,
      filter_json: JSON.stringify(Object.assign({}, req.filter || {},
        { include_active: includeActiveResolved },
        { include_response_in_progress: includeRespResolved },
        { _top_n: topN, _test: req.test === true },
        Object.keys(caseOverridesReq).length ? { _case_overrides: caseOverridesReq } : {},
        req.client_request_id ? { _idem: String(req.client_request_id) } : {})),
      target_count: res.targets.length, sent_count: 0, failed_count: 0,
      status: 'queued', scheduled_at: scheduledAt, created_by: auth.email,
      created_at: now, started_at: '', finished_at: '',
      template_id: tplVer.template_id, template_version: tplVer.template_version,
      include_form: includeForm
    });
    // F-03 (堅牢化): 対象ごとの作成を個別に隔離し、実際に作成できた件数で
    // target_count を確定させる (乖離すると bumpDeliveryCounts_ の完了判定に
    // 永遠に届かず status が done にならないため)。
    var createdCount = 0, createFailed = 0, createErrors = [];
    // 案件の上書き指定の検証用: 募集中の案件ID集合 (指定があるときだけ作る)。
    var openCaseIdSet = null;
    if (Object.keys(caseOverridesReq).length) {
      openCaseIdSet = {};
      cases.forEach(function (c) { openCaseIdSet[str_(c.case_id)] = true; });
    }
    res.targets.forEach(function (r) {
    try {
      var recs = (mode === 'per_person') ? (r._r4_recs || recommendCasesFor_(r, cases, count)) : [];
      var recIds = recs.map(function (x) { return x.case_id; });
      // 案件の上書き指定があれば、その人の最終リストとして使う。無効な指定が
      // 混ざれば throw し、この宛先だけを作成失敗として隔離する (既存の仕組み)。
      if (mode === 'per_person' && Object.prototype.hasOwnProperty.call(caseOverridesReq, str_(r.applicant_id))) {
        var ovRaw = caseOverridesReq[str_(r.applicant_id)];
        var ovIds = (Array.isArray(ovRaw) ? ovRaw : toList_(ovRaw)).map(function (x) { return String(x); });
        if (ovIds.length > MAX_RECOMMEND_COUNT) {
          throw new Error('案件の上書き指定が上限 (' + MAX_RECOMMEND_COUNT + ' 件) を超えています');
        }
        ovIds.forEach(function (cid) {
          if (!openCaseIdSet || !openCaseIdSet[cid]) {
            throw new Error('案件の上書き指定に存在しない/募集終了の案件が含まれています: ' + cid);
          }
        });
        recIds = ovIds;
      }
      // R4 レーンD 13-#5: 作成時スナップショット展開後にも残存検査を行う。
      // 残存があれば throw し、この受信者だけが作成失敗として隔離される (既存処理)。
      var snapshotExpanded = expandTemplate_(body, r,
        { recommended_case_ids: recIds.join(',') }, '', '', auth.operator);
      assertNoLeftoverTags_(snapshotExpanded, 'メール本文');
      appendRow_('delivery_recipients', {
        delivery_id: deliveryId, applicant_id: str_(r.applicant_id), email: str_(r.email),
        recommended_case_ids: recIds.join(','),
        status: 'pending', error: '', sent_at: '',
        form_token: Utilities.getUuid() + Utilities.getUuid().replace(/-/g, ''), // 推測不能・受信者ごとに一意
        created_at: now, updated_at: now,
        // 送信スナップショット: この時点で見せる案件の写し + 展開済み文面。
        // 送信確定時に processSendQueue が body_snapshot を実際に送った全文で確定させる。
        cases_snapshot: buildCasesSnapshot_(recIds),
        body_snapshot: snapshotBody_(snapshotExpanded),
        template_version: tplVer.template_version
      });
      appendRow_('send_queue', {
        queue_id: nextId_('send_queue'), delivery_id: deliveryId, applicant_id: str_(r.applicant_id),
        sender_email: auth.email, status: 'waiting', try_count: 0,
        scheduled_at: scheduledAt, created_at: now, sent_at: '', updated_at: now
      });
      createdCount++;
    } catch (createErr) {
      createFailed++;
      if (createErrors.length < 5) createErrors.push(errMsg_(createErr));
      try { Logger.log('mailCreateDelivery target failed delivery=' + deliveryId +
        ' applicant=' + str_(r.applicant_id) + ': ' + errMsg_(createErr)); } catch (e) {}
    }
    });
    if (!createdCount) {
      try { updateRowByPk_('deliveries', deliveryId, { target_count: 0, status: 'cancelled', finished_at: nowIso_() }); } catch (e) {}
      throw new Error('配信対象の作成に全件失敗しました (delivery=' + deliveryId + '): ' + createErrors.join(' / '));
    }
    if (createdCount !== res.targets.length) {
      // 実作成件数で target_count を確定させる (部分失敗時の補償)。
      updateRowByPk_('deliveries', deliveryId, { target_count: createdCount });
    }
    var result = {
      delivery_id: deliveryId, target_count: createdCount,
      template_id: tplVer.template_id, template_version: tplVer.template_version,
      requested_target_count: res.targets.length,
      create_failed_count: createFailed, create_errors: createErrors,
      matched_count: res.matched_count, excluded: res.excluded,
      notes: res.notes || {},
      queued_today_count: res.queued_today_count || 0,
      note: '配信を作成しました。送信はこの画面からバッチ送信されます (画面を閉じると止まりますが、キューはサーバーに残り、次に開いたとき続きから再開できます)'
    };
    if (req.test === true) { result.test = true; result.test_email = testEmail; }
    return result;
  });
  try {
    createdDelivery.relay_push = createdDelivery.idempotent_replay
      ? { skipped: 'idempotent_replay' }
      : relayPushContextsForDelivery_(createdDelivery.delivery_id);
  } catch (e) {
    Logger.log('relay push (mailCreateDelivery) failed delivery=' +
      createdDelivery.delivery_id + ': ' + errMsg_(e));
    createdDelivery.relay_push = { error: errMsg_(e) };
  }
  return createdDelivery;
}

/**
 * Gmail プレビュー生成 (R4 レーンD 13-#3 修正1)。
 * プレビューを実送信と同一の buildMailBody_ で生成し、生成経路を1本にする。
 * 実送信と異なるのはフォーム/配信停止 URL のトークン値だけ (固定文字列 'preview')。
 * req: { applicant_id, body_template, recommended_case_ids, sender_email, subject? }
 * 戻り値には展開後の件名も含める (13-#5 の件名展開と連動)。
 */
function actionMailPreviewBody_(req) {
  var auth = requireCanSend_();
  if (!req.applicant_id) throw new Error('applicant_id が必要です');
  var applicant = findApplicant_(String(req.applicant_id));
  var operator = auth.operator;
  if (req.sender_email) {
    var specified = null;
    try { specified = operatorByEmail_(String(req.sender_email)); } catch (e) { specified = null; }
    if (specified) operator = specified;
  }
  var recIds = toList_(req.recommended_case_ids);
  // R6.7 欠陥3: おすすめ未指定なら作成経路と同じく自動でおすすめを解決する。
  // 従来は空のまま {おすすめ案件} が空欄で描画され、実送信と食い違っていた。
  if (!recIds.length) {
    recIds = recommendCasesFor_(applicant, openCases_(), clampRecommendCount_(req.recommend_count))
      .map(function (x) { return x.case_id; });
  }
  var recipient = { recommended_case_ids: recIds.join(','), form_token: 'preview' };
  var delivery = {
    body_template: String(req.body_template || ''),
    subject: String(req.subject || ''),
    sender_email: str_(operator.email) || auth.email,
    sender_name: str_(operator.display_name),
    // R6.6 include_form: プレビューも実送信と同じ文面にするため、要求をそのまま載せる。
    include_form: req.include_form !== false
  };
  var body = buildMailBody_(delivery, applicant, recipient, operator);
  var urls = mailUrlsForRecipient_(recipient, deliveryIncludeForm_(delivery));
  var subject = expandTemplate_(delivery.subject, applicant, recipient,
    urls.formUrl, urls.optoutUrl, operator);
  assertNoLeftoverTags_(subject, '件名');
  return { applicant_id: str_(applicant.applicant_id), subject: subject, body: body };
}

// ===== Gmail 送信: キュープロセッサ (時間トリガー用) =====
/**
* 送信者本人のアカウントで動く時間トリガー (init_sheets.gs の installMySendTrigger) から呼ばれる。
* - sender_email が実行者本人の行だけを古い順に拾う (他人の行は絶対に送らない)。
* - 1日の上限 = min(MailApp.getRemainingDailyQuota(), 1500) で停止する。
 *   (R3 P0: 残量取得は MailApp の API。GmailApp に同名メソッドは存在しない。
 *    取得に失敗した場合は remainingMailQuota_ が当日送信実績のカウントで
 *    ハードキャップ管理にフォールバックする。送信自体は止めない。)
* - 二重送信防止: 送信前に status を 'sending' へ先行更新 + LockService。
* - 1回の実行は Apps Script の実行時間上限 (6分) を見て最大 200 件まで。
*/
/**
 * 送信後処理の1ステップを隔離実行する (F-01 堅牢化)。
 * updateRecipientStatus_ / appendEvent_ / bumpDeliveryCounts_ 等の記録処理が
 * throw しても、例外をここで止めて result.post_errors に残し、呼び出し側
 * (キューの残り処理) には伝播させない。送信自体の成否とは切り分けること:
 * GmailApp 送信が成功した後に記録処理が失敗しても、その行を failed にはしない
 * (failed に倒すと再試行で二重送信になる)。
 */
function queuePostStep_(result, label, fn) {
  try { fn(); return true; } catch (e) {
    result.post_errors++;
    if (result.post_error_details.length < 10) result.post_error_details.push(label + ': ' + errMsg_(e));
    try { Logger.log('processSendQueue post-step failed [' + label + ']: ' + errMsg_(e)); } catch (e2) {}
    return false;
  }
}

/** キュー行の経過時間判定に使う時刻 (updated_at 優先、旧行は created_at) */
function queueTimestampMs_(q) {
  var iso = cellDateIso_(q.updated_at) || cellDateIso_(q.created_at);
  var ms = iso ? new Date(iso).getTime() : NaN;
  return isFinite(ms) ? ms : 0;
}

/**
 * 'sending' 残留行の回収 (F-02)。processSendQueue のロック取得後に呼ぶこと
 * (ロック中は他の processSendQueue が送信していないため、古い 'sending' は
 * 前回実行が送信直後に落ちた残留と判断できる)。
 * - 経過時間が QUEUE_STALE_SENDING_MINUTES 未満の行は触らない (stale_sending_kept)。
 * - 受信者側が既に 'sent' の行は再送せずキューを 'sent' に倒す (recovered_as_sent)。
 *   この場合 bumpDeliveryCounts_ は行わない (落ちた時点で加算済みか不明なため、
 *   二重加算を避ける。件数の最終確認は deliveries の棚卸しで行う)。
 * - それ以外は 'waiting' に戻し (recovered)、同じ実行の送信対象に含める。
 * 回収処理自体の失敗も行ごとに隔離し、recovery_errors に残して次へ進む。
 */
function recoverStaleSending_(me, nowMs, result) {
  var rows = [];
  try { rows = readTable_('send_queue').rows; } catch (e) { result.recovery_errors++; return; }
  rows.filter(function (q) {
    return String(q.sender_email).toLowerCase() === me && String(q.status) === 'sending';
  }).forEach(function (q) {
    var baseMs = queueTimestampMs_(q);
    if (baseMs && (nowMs - baseMs) < QUEUE_STALE_SENDING_MINUTES * 60000) {
      result.stale_sending_kept++;
      return;
    }
    try {
      var alreadySent = false;
      try {
        var rec = findRecipient_(q.delivery_id, q.applicant_id);
        alreadySent = String(rec.status) === 'sent';
      } catch (e) { alreadySent = false; }
      if (alreadySent) {
        updateRowByPk_('send_queue', q.queue_id,
          { status: 'sent', sent_at: cellDateIso_(rec.sent_at) || nowIso_(), updated_at: nowIso_() });
        result.recovered_as_sent++;
      } else {
        updateRowByPk_('send_queue', q.queue_id, { status: 'waiting', updated_at: nowIso_() });
        result.recovered++;
      }
    } catch (e) {
      result.recovery_errors++;
      try { Logger.log('processSendQueue recovery failed queue=' + q.queue_id + ': ' + errMsg_(e)); } catch (e2) {}
    }
  });
}

/**
 * 送信キュー滞留の参照 (読み取り専用・書き込みは一切しない)。
 * 実行ユーザー (Session のメールアドレス) の send_queue 行だけを集計する。
 * send_queue の列: queue_id / delivery_id / applicant_id / sender_email / status /
 *   try_count / scheduled_at / created_at / sent_at / updated_at。
 * status の値は waiting / sending / sent / failed (QUEUE_CLAIM_STATUSES)。
 * 戻り値: { sender_email, total, counts (status別件数。未知の status 値もそのまま集計),
 *   waiting, waiting_count (waiting 件数), oldest_waiting_at (waiting の最古 created_at, ISO。無ければ '') }
 * 該当行が無い場合はゼロ件で正常に応答する。
 */
function actionGetSendQueueStats_(req) {
  var me = currentUserEmail_();
  var counts = {};
  Object.keys(QUEUE_CLAIM_STATUSES).forEach(function (s) { counts[s] = 0; });
  var total = 0;
  var oldestWaiting = '';
  if (me) {
    readTable_('send_queue').rows.forEach(function (q) {
      if (String(q.sender_email || '').trim().toLowerCase() !== me) return;
      var st = str_(q.status);
      if (!st) return;
      if (!Object.prototype.hasOwnProperty.call(counts, st)) counts[st] = 0;
      counts[st]++;
      total++;
      if (st === 'waiting') {
        var ca = cellDateIso_(q.created_at);
        if (ca && (!oldestWaiting || ca < oldestWaiting)) oldestWaiting = ca;
      }
    });
  }
  // R4 O-05(3): 中継 Pull の死活を可視化する (30分以上成功が無ければ stale)。
  // relay 未配置の環境では relay: null のまま (従来動作を壊さない)。
  var relayHealth = null;
  try {
    if (typeof relayLastPull_ === 'function') {
      var lastPull = relayLastPull_();
      var lastAt = lastPull && lastPull.at ? Date.parse(lastPull.at) : NaN;
      relayHealth = {
        last_pull_at: lastPull ? String(lastPull.at || '') : '',
        stale: !(isFinite(lastAt) && (Date.now() - lastAt) < 30 * 60 * 1000),
        last_summary: lastPull ? lastPull.summary : null
      };
    }
  } catch (e) { relayHealth = null; }
  return {
    sender_email: me,
    total: total,
    counts: counts,
    waiting: counts.waiting || 0,
    waiting_count: counts.waiting || 0,
    oldest_waiting_at: oldestWaiting,
    trigger_auto: triggerAutoStatus_(),
    relay: relayHealth
  };
}

/**
 * 当日の残り送信可能数 (R3 P0)。
 * 正規の取得は MailApp.getRemainingDailyQuota() (GmailApp には存在しない)。
 * 取得が例外/不正値の場合は「送信を止めない」方針でフォールバックする:
 * send_queue の当日 sent 実績 (自アカウント分) を数え、ハードキャップ
 * (GMAIL_DAILY_HARD_CAP) から差し引いた残量を返す。それも失敗したら
 * ハードキャップ自体を返す (上限管理はキューの実績側でも効く)。
 */
function remainingMailQuota_() {
  try {
    var q = MailApp.getRemainingDailyQuota();
    if (typeof q === 'number' && isFinite(q) && q >= 0) return Math.floor(q);
  } catch (e) { /* fall through to the counted fallback */ }
  try {
    var me = currentUserEmail_();
    var today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
    var sentToday = 0;
    readTable_('send_queue').rows.forEach(function (q) {
      if (String(q.sender_email || '').toLowerCase() === me &&
          String(q.status || '') === 'sent' &&
          cellDateIso_(q.sent_at).slice(0, 10) === today) sentToday++;
    });
    return Math.max(0, GMAIL_DAILY_HARD_CAP - sentToday);
  } catch (e2) { return GMAIL_DAILY_HARD_CAP; }
}

/**
 * 送信直前再チェック (R3 Z4 / G4-D9)。作成時点で対象だった人でも、予約配信の
 * 実行時点までに状態が変わっていれば送らない。戻り値: 除外理由 / 送信可なら ''。
 * - optout: mail_optout フラグ、または配信停止リストにメールが一致
 * - test: テスト求職者は、宛先が固定のテスト送信先のときだけ許可する
 * 是正 (2026-11-23): 終了系・年齢上限・同日送信済みの送信時再判定は撤去した
 * (手順C/D。作成時の担当者判断を正とする)。対応中・回答対応中は、作成時に
 * 含めると決めた配信 (filter_json の解決済みフラグ) では送る (手順B)。
 * テスト配信 (opts.is_test_delivery) は裁量系の理由では落とさない (手順A)。
 */
function sendTimeExclusionReason_(applicant, recipient, optoutSet, opts) {
  if (!applicant) return '応募者が見つかりません';
  var email = normalizeEmail_(applicant.email);
  var recEmail = normalizeEmail_(recipient && recipient.email);
  if (toBool_(applicant.mail_optout) ||
      (email && optoutSet && optoutSet[email]) ||
      (recEmail && optoutSet && optoutSet[recEmail])) {
    return '配信停止のため送信しません';
  }
  // R4 01-#11: 宛先が作成後に変わっていたら送らない (旧アドレスへの誤送信防止)。
  // テスト配信は宛先が固定テスト送信先に差し替わるため照合をスキップする。
  var isTestDest = false;
  try { isTestDest = !!recEmail && recEmail === normalizeEmail_(testSendEmail_()); } catch (e) {}
  if (!isTestDest && email !== recEmail) {
    return '宛先メールアドレスが変更されているため送信しません (配信を作り直してください)';
  }
  // R4 01-#7: 形式不正の宛先は failed (リトライ浪費) ではなく skipped に倒す。
  if (recEmail && !isValidEmail_(recEmail)) {
    return 'メールアドレスの形式が不正なため送信しません';
  }
  // 手順A: テスト配信は、ここから先の裁量系の理由 (対応中・回答対応中・
  // テスト求職者ガード) では落とさない。配信停止・宛先変更・形式不正は
  // 上の判定で既に止めている (テスト宛先は宛先変更の照合対象外)。
  if (opts && opts.is_test_delivery) return '';
  // R3 検証 #4 残存分: 作成後に「対応中」(稼働中・内定待ち・職見待ち・FIX待ち・
  // アテンド待ち・誘致待ち) へ状態変化した人も、送信直前に再チェックして送らない。
  // 配信作成時に include_active=true が明示された配信だけは対象に含める
  // (作成時の filter_json に保存した include_active を processSendQueue が渡す)。
  // R4 01-#3: 判定は csvStageRank_ の正規化判定 (表記ゆれも拾う)。
  if (!(opts && opts.include_active) && isActiveCsvStatus_(applicant.csv_status)) {
    return '対応中ステータスのため送信しません';
  }
  // R4 I-2: 作成後に回答キューで「対応中」になった人も送らない
  // (作成時に include_response_in_progress=true が明示された配信は除く)。
  if (!(opts && opts.include_response_in_progress) &&
      opts && opts.response_in_progress_ids &&
      opts.response_in_progress_ids[str_(applicant.applicant_id)]) {
    return '回答対応中のため送信しません';
  }
  // 手順C/D: 同日送信済み・年齢上限の送信時再判定は撤去した (作成時の判断が正)。
  if (isTestApplicant_(applicant)) {
    var isTestDelivery = false;
    try { isTestDelivery = !!recEmail && recEmail === String(testSendEmail_()).toLowerCase(); } catch (e) {}
    if (!isTestDelivery) return 'テスト求職者のため送信しません';
  }
  return '';
}

/**
 * 送信キューの処理。呼び出し経路は2つ:
 *  (a) 時間トリガー (引数 = トリガーイベント。batch_limit は無いので既定上限)
 *  (b) 画面からのバッチ送信 (actionSendNextBatch_ 経由で { batch_limit: 25 })
 * どちらでも「送信対象は sender_email が実行ユーザー本人の行だけ」という
 * 帰属仕様は同じ。画面を閉じれば (b) は止まるが、キューの状態はサーバーに
 * 残るため、次に開いたとき getSendQueueStats / sendNextBatch で再開できる。
 */
/**
 * 送信トリガーの自動設置 (ベストエフォート / R3 方式変更)。
 * 主経路は「画面からのバッチ送信」(actionSendNextBatch_) であり、トリガーは
 * 必須ではない。運営者 (can_send) の API 利用時に、実行ユーザーとして
 * processSendQueue の時間トリガーが無ければ設置を試みる。失敗しても
 * 無言で継続し (画面方式で送信は成立する)、成否は Script Properties に
 * 記録して getSendQueueStats の trigger_auto で本人に見えるようにする。
 * 再試行は24時間に1回まで (失敗の連打防止)。
 * 制約: Web App の「アクセスユーザーとして実行」文脈での ScriptApp は、
 * そのユーザーがプロジェクトの編集者である場合にのみトリガーを作れる。
 * 本プロジェクトの運営者4名は全員編集者として共有済みのため設置できる
 * 見込みだが、保証はされない — だからこそ必須にはしない。
 */
function maybeInstallSendTrigger_() {
  var me = '';
  try { me = currentUserEmail_(); } catch (e) { return { attempted: false }; }
  if (!me) return { attempted: false };
  try {
    var op = operatorByEmail_(me);
    if (!op || !toBool_(op.can_send)) return { attempted: false };
    var props = PropertiesService.getScriptProperties();
    var key = 'TRIGGER_AUTO_' + me;
    var prev = {};
    try { prev = JSON.parse(props.getProperty(key) || '{}'); } catch (e) { prev = {}; }
    if (prev.installed) return { attempted: false, installed: true };
    var nowMs = new Date().getTime();
    if (prev.attempt_at && nowMs - prev.attempt_at < 24 * 3600 * 1000) {
      return { attempted: false, installed: false, error: String(prev.error || '') };
    }
    var exists = false;
    ScriptApp.getProjectTriggers().forEach(function (t) {
      try { if (t.getHandlerFunction && t.getHandlerFunction() === 'processSendQueue') exists = true; } catch (e) {}
    });
    if (!exists) {
      ScriptApp.newTrigger('processSendQueue').timeBased().everyMinutes(5).create();
    }
    props.setProperty(key, JSON.stringify({ installed: true, attempt_at: nowMs, via: exists ? 'existing' : 'auto' }));
    return { attempted: true, installed: true };
  } catch (err) {
    try {
      PropertiesService.getScriptProperties().setProperty('TRIGGER_AUTO_' + me,
        JSON.stringify({ installed: false, attempt_at: new Date().getTime(), error: errMsg_(err) }));
    } catch (e2) {}
    return { attempted: true, installed: false, error: errMsg_(err) };
  }
}

/** getSendQueueStats 用: トリガー自動設置の状態 (本人の分のみ)。 */
function triggerAutoStatus_() {
  var me = '';
  try { me = currentUserEmail_(); } catch (e) { return null; }
  if (!me) return null;
  var st = { installed: false, attempted: false };
  try {
    var raw = PropertiesService.getScriptProperties().getProperty('TRIGGER_AUTO_' + me);
    if (raw) {
      var p = JSON.parse(raw);
      st.installed = !!p.installed;
      st.attempted = !!p.attempt_at;
      if (p.error) st.error = String(p.error);
      if (p.attempt_at) st.attempt_at = new Date(p.attempt_at).toISOString();
    }
  } catch (e) {}
  st.note = '送信の主経路は画面からのバッチ送信です。トリガーは補助 (未送信分の自動再開) で、無くても送信できます。';
  return st;
}

/**
 * 画面からのバッチ送信 (R3 方式変更: 施設メール配信と同じ方式)。
 * 1回の呼び出しで最大 batch_size 件 (既定25・上限50) を自分のキューから送り、
 * 進捗 (今回の送信結果 + 残り件数 + キュー統計) を返す。フロントは
 * remaining が 0 になるまで繰り返し呼び、中断ボタンで止める。
 * 実行はアクセスユーザーとして走るため、送信はその人の Gmail から行われ、
 * 送信済みフォルダにも残る。
 */
function actionSendNextBatch_(req) {
  requireKikariUser_();
  var size = parseInt(req && req.batch_size, 10);
  if (!(size > 0)) size = 25;
  size = Math.min(50, Math.max(1, size));
  maybeInstallSendTrigger_();
  var res = processSendQueue({ batch_limit: size });
  var out = Object.assign({}, res);
  out.stats = actionGetSendQueueStats_({});
  return out;
}

function processSendQueue(e) {
  var batchLimit = (e && typeof e.batch_limit === 'number' && e.batch_limit > 0)
    ? Math.floor(e.batch_limit) : 0;
  // R4 O-05(3): 送信直前に中継の未取り込み分 (特に配信停止) を取り込む。
  // Pull は1分トリガーでも回っているが、停止が届いた直後の送信で競合する
  // 窓を塞ぐ。失敗しても送信は止めない (fail-open)。relay 未配置の環境
  // (code_additions.gs 未導入) では typeof ガードで素通りする。
  try {
    if (typeof relayPullResponses === 'function' && relayEnabled_()) {
      relayPullResponses();
    }
  } catch (pullErr) {
    try { Logger.log('processSendQueue: 送信前 Pull に失敗 (送信は継続): ' + errMsg_(pullErr)); } catch (e2) {}
  }
  var me = currentUserEmail_();
  if (!me || me.slice(-DOMAIN_SUFFIX.length) !== DOMAIN_SUFFIX) {
    Logger.log('processSendQueue: 実行者が @kikari.co.jp ではないため終了 (' + (me || '不明') + ')');
    return { sent: 0, skipped: 'not_kikari_user' };
  }
  var quota = Math.min(remainingMailQuota_(), GMAIL_DAILY_HARD_CAP);
  if (quota <= 0) return { sent: 0, skipped: 'quota_exhausted' };

  // F-01/F-02: サマリには復旧・再試行・諦め・後処理失敗の件数も含め、
  // 宙吊りや記録失敗が「件数で分かる」形にする。
  var result = { sent: 0, failed: 0, recovered: 0, recovered_as_sent: 0, retried: 0,
    gave_up: 0, stale_sending_kept: 0, claim_errors: 0, recovery_errors: 0,
    post_errors: 0, post_error_details: [] };
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return { sent: 0, skipped: 'locked' };
  try {
    var nowMs = new Date().getTime();
    recoverStaleSending_(me, nowMs, result);

    var myRows = readTable_('send_queue').rows.filter(function (q) {
      return String(q.sender_email).toLowerCase() === me;
    });
    myRows.forEach(function (q) {
      if (String(q.status) === 'failed' && (toNum_(q.try_count) || 0) >= QUEUE_MAX_TRY_COUNT) result.gave_up++;
    });
    function due_(q) {
      var sc = cellDateIso_(q.scheduled_at);
      return !sc || new Date(sc).getTime() <= nowMs;
    }
    var dueRows = myRows.filter(function (q) {
      if (!due_(q)) return false;
      if (String(q.status) === 'waiting') return true;
      // F-02: failed は try_count が上限未満の間だけ再試行対象に含める
      if (String(q.status) === 'failed') return (toNum_(q.try_count) || 0) < QUEUE_MAX_TRY_COUNT;
      return false;
    });
    var dueCount = dueRows.length;
    var processedCount = 0; // claim まで進んだ件数 (remaining の算出用)
    var queue = dueRows.sort(function (a, b) {
      var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
      return x < y ? -1 : (x > y ? 1 : 0);
    }).slice(0, Math.min(quota, QUEUE_BATCH_LIMIT, batchLimit > 0 ? batchLimit : QUEUE_BATCH_LIMIT));

    var deliveriesCache = {};
    var queueOptoutSet = optoutEmailSet_();
    // R4 01-#10 / 11-#3: バッチ内で1回だけ構築する (行ごとの読み直しはしない)。
    var queueSentTodayMap = mailSentTodayMap_();
    // R4 I-2: 回答キュー対応中の集合もバッチ冒頭で1回だけ作る。
    var queueRespInProgressIds = responseTargetSets_().in_progress;
    var queueCaseOpenMap = {};
    try {
      readTable_('cases').rows.forEach(function (c) {
        queueCaseOpenMap[str_(c.case_id)] = toBool_(c.is_open);
      });
    } catch (eCaseMap) {}
    queue.forEach(function (q) {
      var isRetry = String(q.status) === 'failed';
      // claim (先行更新) 自体の失敗も行ごとに隔離し、残りを止めない。
      try {
        updateRowByPk_('send_queue', q.queue_id,
          { status: 'sending', try_count: (toNum_(q.try_count) || 0) + 1, updated_at: nowIso_() });
      } catch (claimErr) {
        result.claim_errors++;
        if (result.post_error_details.length < 10) {
          result.post_error_details.push('claim ' + q.queue_id + ': ' + errMsg_(claimErr));
        }
        return;
      }
      processedCount++;
      if (isRetry) result.retried++;
      try {
        var delivery = deliveriesCache[q.delivery_id] ||
          (deliveriesCache[q.delivery_id] = findRow_('deliveries', 'delivery_id', q.delivery_id));
        var recipient = findRecipient_(q.delivery_id, q.applicant_id);
        var applicant = findApplicant_(q.applicant_id);
        // R3 Z4: 送信直前の再チェック (optout / 宛先変更 / 形式 / test ガード)。
        // 作成時点では対象でも、実行までに配信停止になった行は送らない。
        // 是正 (2026-11-23): 終了系・年齢・同日は再判定しない (手順C/D)。
        // R3 検証 #4: 対応中への状態変化も再チェックする。作成時の include_active は
        // 配信の filter_json に保存してあるので、配信ごとに読み取って渡す。
        var sendOpts = { include_active: false, sent_today_map: queueSentTodayMap, delivery_id: str_(q.delivery_id),
          response_in_progress_ids: queueRespInProgressIds, include_response_in_progress: false, is_test_delivery: false };
        try {
          var fjq = JSON.parse(str_(delivery && delivery.filter_json) || '{}');
          sendOpts.include_active = fjq.include_active === true;
          sendOpts.include_response_in_progress = fjq.include_response_in_progress === true;
          // 手順A: テスト配信かどうかも渡す (filter_json の _test)。
          sendOpts.is_test_delivery = fjq._test === true;
        } catch (eFj) {}
        var skipReason = sendTimeExclusionReason_(applicant, recipient, queueOptoutSet, sendOpts);
        // R4 11-#3: 送信直前に案件の募集状態を再判定する。終了した案件は本文から
        // 除く (recipient の複製を渡す。保存済みの写しは変えない)。same_body 等で
        // おすすめを使わない配信 (recommended_case_ids が空) は対象外。
        // 手順E: すべて終了していた場合も「送らない」にはせず、案件なしで送る。
        // 手順A: テスト配信は案件の状態にかかわらず送るため、絞り込み自体をしない。
        var sendRecipient = recipient;
        var closedCaseIds = [];
        if (!skipReason && !sendOpts.is_test_delivery) {
          var recIds0 = toList_(recipient.recommended_case_ids);
          if (recIds0.length) {
            var validIds = recIds0.filter(function (cid) { return queueCaseOpenMap[cid] === true; });
            closedCaseIds = recIds0.filter(function (cid) { return queueCaseOpenMap[cid] !== true; });
            if (closedCaseIds.length) {
              sendRecipient = Object.assign({}, recipient, { recommended_case_ids: validIds.join(',') });
            }
          }
        }
        if (skipReason) {
          result.skipped_excluded = (result.skipped_excluded || 0) + 1;
          queuePostStep_(result, 'queue->skipped ' + q.queue_id, function () {
            updateRowByPk_('send_queue', q.queue_id, { status: 'skipped', updated_at: nowIso_() });
          });
          queuePostStep_(result, 'recipient->skipped ' + q.queue_id, function () {
            updateRecipientStatus_(q.delivery_id, q.applicant_id, { status: 'skipped', error: skipReason });
          });
          queuePostStep_(result, 'event mail_skipped ' + q.queue_id, function () {
            appendEvent_(q.applicant_id, 'mail_skipped', me,
              'Gmail配信 ' + q.delivery_id + ' を送信しませんでした: ' + skipReason, q.delivery_id, '');
          });
          queuePostStep_(result, 'bump skipped ' + q.queue_id, function () {
            // 初回は failed 側に数えて配信を完了判定に進める。再試行行は加算済みのため 0 で状態だけ再計算する。
            bumpDeliveryCounts_(q.delivery_id, 0, isRetry ? 0 : 1);
          });
          return;
        }
        var op = operatorByEmail_(me) || {};
        var body = buildMailBody_(delivery, applicant, sendRecipient, op);
        // R4 レーンD 13-#5: 件名にも expandTemplate_ を適用してから残存検査し、
        // 展開後の件名を GmailApp へ渡す (従来は delivery.subject が無展開で送られていた)。
        var subjectUrls = mailUrlsForRecipient_(sendRecipient, deliveryIncludeForm_(delivery));
        var subject = expandTemplate_(str_(delivery.subject), applicant, sendRecipient,
          subjectUrls.formUrl, subjectUrls.optoutUrl, op);
        assertNoLeftoverTags_(subject, '件名');
        var options = {};
        if (str_(op.reply_to)) options.replyTo = str_(op.reply_to);
        if (str_(op.display_name)) options.name = str_(op.display_name);
        GmailApp.sendEmail(str_(recipient.email), subject, body, options);

        // 送信成功。ここからの記録処理は1つずつ隔離し (F-01)、失敗しても
        // 送信済みの行を failed に倒さない・残りの行を止めない。
        result.sent++;
        var sentAt = nowIso_();
        queuePostStep_(result, 'queue->sent ' + q.queue_id, function () {
          updateRowByPk_('send_queue', q.queue_id, { status: 'sent', sent_at: sentAt, updated_at: sentAt });
        });
        queuePostStep_(result, 'recipient->sent ' + q.queue_id, function () {
          updateRecipientStatus_(q.delivery_id, q.applicant_id, { status: 'sent', sent_at: sentAt, error: '' });
        });
        queuePostStep_(result, 'recipient snapshot ' + q.queue_id, function () {
          // 実際に送った全文を body_snapshot として確定させる (写しのため以後不変)。
          // cases_snapshot は配信作成時の写しが正なので、無い場合だけここで補う。
          // R4 S-06: 実文で上書きするのと同時に確定フラグを立てる (仮文面との区別)。
          var patch = { body_snapshot: snapshotBody_(body), snapshot_finalized: 1 };
          if (!str_(recipient.cases_snapshot)) {
            patch.cases_snapshot = buildCasesSnapshot_(toList_(recipient.recommended_case_ids));
          }
          updateRecipientStatus_(q.delivery_id, q.applicant_id, patch);
        });
        queuePostStep_(result, 'event mail_sent ' + q.queue_id, function () {
          appendEvent_(q.applicant_id, 'mail_sent', me,
            'Gmail配信 ' + q.delivery_id + ' / ' + subject +
            (closedCaseIds.length ? ' (募集終了のため除外した案件: ' + closedCaseIds.join(',') + ')' : ''), q.delivery_id, '');
        });
        queuePostStep_(result, 'bump sent ' + q.queue_id, function () {
          // 再試行で成功した行は、前回加算済みの failed_count を取り消してから sent を加算する
          bumpDeliveryCounts_(q.delivery_id, 1, isRetry ? -1 : 0);
        });
      } catch (err) {
        // 送信 (または送信前の参照解決) の失敗。後処理も1つずつ隔離し、
        // 後処理の例外で forEach の外へ伝播させない (F-01: 監査シナリオA)。
        result.failed++;
        queuePostStep_(result, 'queue->failed ' + q.queue_id, function () {
          updateRowByPk_('send_queue', q.queue_id, { status: 'failed', updated_at: nowIso_() });
        });
        queuePostStep_(result, 'recipient->failed ' + q.queue_id, function () {
          updateRecipientStatus_(q.delivery_id, q.applicant_id, { status: 'failed', error: errMsg_(err) });
        });
        queuePostStep_(result, 'bump failed ' + q.queue_id, function () {
          // 再試行の再失敗は failed_count を二重加算しない (初回失敗で加算済み)
          if (!isRetry) bumpDeliveryCounts_(q.delivery_id, 0, 1);
        });
      }
    });
    // 画面バッチ送信の進捗表示用: この実行で処理しきれなかった到期分と、
    // 予約分も含む waiting の総数を返す。
    result.remaining = Math.max(0, dueCount - processedCount);
    result.waiting_total = myRows.filter(function (q) { return String(q.status) === 'waiting'; }).length;
    result.batch_limit_applied = batchLimit > 0 ? batchLimit : QUEUE_BATCH_LIMIT;
    return result;
  } finally {
    lock.releaseLock();
  }
}

function findRow_(tableName, key, value) {
var t = readTable_(tableName);
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i][key]) === String(value)) return t.rows[i];
}
throw new Error(tableName + ' に ' + key + '=' + value + ' が見つかりません');
}

function findRecipient_(deliveryId, applicantId) {
var t = readTable_('delivery_recipients');
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i].delivery_id) === String(deliveryId) &&
String(t.rows[i].applicant_id) === String(applicantId)) return t.rows[i];
}
throw new Error('delivery_recipients が見つかりません: ' + deliveryId + '/' + applicantId);
}

function updateRecipientStatus_(deliveryId, applicantId, patch) {
var r = findRecipient_(deliveryId, applicantId);
var sh = sheet_('delivery_recipients');
var headers = readTable_('delivery_recipients').headers;
patch.updated_at = nowIso_();
Object.keys(patch).forEach(function (k) {
var col = headers.indexOf(k);
if (col >= 0) sh.getRange(r._row, col + 1).setValue(patch[k]);
});
}

function bumpDeliveryCounts_(deliveryId, sentDelta, failedDelta) {
var d = findRow_('deliveries', 'delivery_id', deliveryId);
var sent = (toNum_(d.sent_count) || 0) + sentDelta;
var failed = (toNum_(d.failed_count) || 0) + failedDelta;
var patch = { sent_count: sent, failed_count: failed};
if (!str_(d.started_at)) patch.started_at = nowIso_();
if (sent + failed >= (toNum_(d.target_count) || 0)) {
patch.status = 'done';
patch.finished_at = nowIso_();
} else {
patch.status = 'sending';
}
updateRowByPk_('deliveries', deliveryId, patch);
}

// ===== メール本文の組み立て (差し込み + フッター) =====
/**
* テンプレ差し込み: {宛名} {おすすめ案件} {回答フォームURL} {配信停止URL} {不足ヒヤリング}
* 末尾には必ず: 回答フォームリンク、配信停止リンク、署名+特定電子メール法の
* 統合ブロックを付ける (DESIGN_V2 §6.2 / R4: 番号返信はメールでは廃止しフォーム一本化)。
* フォーム/停止の URL は settings の form_base_url / optout_base_url に
*?token=<form_token> を付けたもの。未設定時はプレースホルダ文になる (README 参照)。
*/
/** 受信者ごとのフォーム/配信停止 URL の組み立て (件名展開と本文生成で共用。R4 レーンD 13-#5)。
 * R6.6 include_form: includeForm===false のとき formUrl は '' を返す
 * (文面にフォーム案内を載せない)。optoutUrl は常に従来どおりトークン付きで返す
 * (配信停止リンクの本人確認に同じトークンを使うため。空にしないこと)。
 * トークン自体が空の場合も formUrl は '' (従来の '?token=' 垂れ流しをやめる)。 */
function mailUrlsForRecipient_(recipient, includeForm) {
var token = str_(recipient && recipient.form_token);
var formBase = getSettingValue_('form_base_url', '');
var optoutBase = getSettingValue_('optout_base_url', '');
var showForm = includeForm !== false && !!token;
return {
formUrl: showForm ? (formBase ? formBase + (formBase.indexOf('?') >= 0 ? '&' : '?') + 'token=' + token : '(回答フォームURL未設定)') : '',
optoutUrl: optoutBase? optoutBase + (optoutBase.indexOf('?') >= 0? '&': '?') + 'token=' + token: '(配信停止URL未設定)'
};
}

/** R6.6: 配信行の include_form 判定。列追加前の旧行 (空欄) は既定 true。 */
function deliveryIncludeForm_(delivery) {
  if (!delivery) return true;
  var v = delivery.include_form;
  if (v === undefined || v === null || v === '') return true;
  if (v === false || v === 0) return false;
  var s = String(v).trim().toLowerCase();
  return s !== 'false' && s !== '0' && s !== 'no';
}

function buildMailBody_(delivery, applicant, recipient, operator) {
var urls = mailUrlsForRecipient_(recipient, deliveryIncludeForm_(delivery));
var formUrl = urls.formUrl;
var optoutUrl = urls.optoutUrl;

var body = str_(delivery.body_template);
body = expandTemplate_(body, applicant, recipient, formUrl, optoutUrl, operator);
// R4 レーンD 13-#5: 送信直前の残存ガード。未展開の {…} が残る文面は送らない
// (processSendQueue の行単位失敗処理に乗り、その受信者だけが failed になる)。
assertNoLeftoverTags_(body, 'メール本文');

// 構成分離 (2026-11-21): 本文 = 案内文 + 案件紹介 + 番号返信の案内 まで。
// フォーム導線は区切り線 + 独立ブロックとして末尾側に置き、フォーム項目
// (経験年数・資格・入職可能日・見学希望日・電話相談希望日時・連絡のつく時間帯・
//  自由記入 等) の説明文は本文に混ぜ込まない (それらはフォーム側に集約する)。
var lines = [body, ''];
// R4 (2026-11-22 ユーザー決定): メールの回答導線は回答フォームのみに一本化し、
// 番号返信セクション (「番号でご返信ください 1: 詳細希望…」) はメール本文から外す。
// SMS 側の文面・導線は変更しない。配信停止リンクは従来どおり下のブロックに残す。
lines.push('----------------------------------------');
// R6.6 include_form: フォームURLが無い配信ではフォーム案内ブロック自体を載せない。
// 配信停止リンクは常時残す (特定電子メール法)。区切り線は残す。
if (formUrl) {
  lines.push('【回答フォームのご案内】');
  lines.push('詳しいご希望は、下記の回答フォームからお知らせください。');
  lines.push('回答フォーム: ' + formUrl);
}
lines.push('配信停止をご希望の方はこちら: ' + optoutUrl);
// R4 (2026-11-22 ユーザー実地指摘): 署名ブロックと特定電子メール法フッターが
// 二重に付いて会社名・メールが繰り返される問題を解消し、末尾は1つの閉じブロックに
// 統合する。署名文に既に含まれる項目は二重に出さず、不足する法定項目 (送信者・
// 連絡先・住所) だけを同じブロック内へ補う。住所行は必ずこのブロック内に置く。
// 配信停止リンクは上の【回答フォームのご案内】ブロックに既にある (欠かさない)。
var sig = str_(operator.signature);
lines.push('');
if (sig) lines.push(sig);
var senderName = str_(operator.display_name) || str_(delivery.sender_name) || str_(delivery.sender_email);
var senderPhone = str_(getSettingValue_('sender_phone', ''));
var company = str_(getSettingValue_('company_name', ''));
var senderEmail = str_(delivery.sender_email);
function sigHas_(needle) { return !!needle && sig.indexOf(needle) >= 0; }
if (company && !sigHas_(company)) lines.push('会社名: ' + company);
if (senderName && !sigHas_(senderName)) lines.push('送信者: ' + senderName);
if (senderEmail && !sigHas_(senderEmail)) {
  lines.push('連絡先: ' + senderEmail + (senderPhone ? ' / 電話: ' + senderPhone : ''));
} else if (senderPhone && !/0\d{1,4}-\d{1,4}-\d{3,4}/.test(sig)) {
  // R4 (LEGAL §1 改善案2): 窓口電話が署名にも無ければ併記する (署名の自由文頼みにしない)。
  lines.push('電話: ' + senderPhone);
}
// R4 (法令ブロッカー): 特定電子メール法の送信者表示には住所が要る。
// 値は settings の sender_address (運用開始前に会社の住所を設定すること)。
// 新規作成はガードで止まるため、ここに来る滞留配信では未設定を明示する。
var senderAddress = str_(getSettingValue_('sender_address', ''));
lines.push('住所: ' + (senderAddress || '(住所未設定)'));
return lines.join('\n');
}

/**
 * 宛名クリーニング (フロント index.html の smsRecipientName と同一ロジックの移植)。
 * 対象: 先頭の記号類の連続、英数字1〜10文字+アンダースコアの接頭辞 (F_ / AB_ / A1_ /
 * 記号混在の *A_ 等)、角括弧ブロックの除去。姓だけを取り出すところまでを行い、
 * 空になった場合は '' を返す (呼び出し側が次候補・最終フォールバックを決める)。
 */
function cleanSurname_(value) {
var s = str_(value).replace(/\u3010[^\u3011]*\u3011/g, '');
for (var i = 0; i < 10; i++) {
var t = s.replace(/^[\s　]+/, '')
.replace(/^[A-Za-z0-9Ａ-Ｚａ-ｚ０-９]{1,10}[\s　]*[_＿][\s　]*/, '')
.replace(/^[^\p{L}\p{N}]+/u, '');
if (t === s) break;
s = t;
}
var clean = s.replace(/[\/／]住所仮入力.*$/, '').replace(/様\s*$/, '').trim();
return clean.split(/[\s　]+/)[0] || '';
}

/**
 * {担当者} の置換値: 運営者の display_name から会社名部分を除いた姓のみ
 * (サーバー側 display_name は「会社名 + 姓」形式で統一されている)。
 * 取れなければ '' (呼び出し側で展開せず、残存ガードに倒す)。
 */
function operatorShortName_(operator) {
var dn = str_(operator && operator.display_name);
if (!dn) return '';
var s = dn.replace(/株式会社ファーストスタッフィング/g, '').replace(/ファーストスタッフィング/g, '').trim();
return cleanSurname_(s);
}

function expandTemplate_(template, applicant, recipient, formUrl, optoutUrl, operator) {
var out = String(template || '');
// {宛名}: surname・name の双方に cleanSurname_ を適用し、空なら次候補、最終的に ご登録者。
var surname = cleanSurname_(applicant.surname) || cleanSurname_(applicant.name) || 'ご登録者';
out = out.split('{宛名}').join(surname);
out = out.split('{回答フォームURL}').join(formUrl || '');
out = out.split('{フォームURL}').join(formUrl || ''); // R4 レーンD §0.1: フロント側タグの別名展開
out = out.split('{配信停止URL}').join(optoutUrl || '');
out = out.split('{不足ヒヤリング}').join(missingHearingText_(applicant));
if (out.indexOf('{不足項目名}') >= 0) {
// R4 レーンJ 項目3: 未確認項目の名前だけを畳む。0 項目ならタグを含む行ごと省略する。
var names = missingHearingNamesText_(applicant);
if (names) {
out = out.split('{不足項目名}').join(names);
} else {
out = out.split('\n').filter(function (ln) { return ln.indexOf('{不足項目名}') < 0; }).join('\n');
}
}
// {担当者} (R4 レーンD 13-#7 / P6): operator を渡せる経路でのみ展開する。
// 渡せない経路では展開しない (残存として assertNoLeftoverTags_ が検出する側に倒す)。
if (operator) {
var opName = operatorShortName_(operator);
if (opName) out = out.split('{担当者}').join(opName);
}
if (out.indexOf('{おすすめ案件}') >= 0) {
out = out.split('{おすすめ案件}').join(recommendText_(recipient));
}
return out;
}

/** おすすめ案件の差し込み文 (delivery_recipients.recommended_case_ids から組み立てる) */
function recommendText_(recipient) {
var ids = toList_(recipient && recipient.recommended_case_ids);
if (!ids.length) return '';
var lines = [];
var openCount = 0;
var jobKinds = [];
ids.forEach(function (id) {
try {
var c = findRow_('cases', 'case_id', id);
// R4 11-#3: 募集終了した案件は本文に出さない (行が消えた場合と同じ扱い)。
if (!toBool_(c.is_open)) return;
openCount++;
// R4 (2026-11-22 ユーザー実地指摘): メール本文に載せる案件は最大2件まで。
// 残りのおすすめは回答フォーム側で提示する (recommended_case_ids 自体は全件保持)。
if (lines.length >= 2) return;
// 長さ規律: 要点 (施設名・エリア・時給帯) のみ。案件固有の salary_text・title・
// description (固有の勤務時間を含みうる) は対外ブロックに出さない。
var line = '・' + str_(c.facility_name);
var area = str_(c.municipality) || str_(c.prefecture);
if (area) line += '\n　' + area;
line += '\n　時給目安: ' + publicSalaryBandText_(c.job_type);
lines.push(line);
var k = publicJobKind_(c.job_type);
if (jobKinds.indexOf(k) < 0) jobKinds.push(k);
} catch (e) { /* 案件が消えていたらその行は出さない */ }
});
if (!lines.length) return '';
if (openCount > lines.length) {
lines.push('その他のおすすめ案件は、回答フォームでご覧いただけます。');
}
// R4 (2026-11-22 ユーザー実地指摘): 勤務時間の例と相談可能の注記は案件ごとに
// 繰り返さず、メール全体で1回に集約する (勤務時間を固定と断定しないルールは維持)。
jobKinds.forEach(function (k) { lines.push(publicCaseHoursText_(k)); });
lines.push(PUBLIC_SALARY_NOTE_);
return lines.join('\n');
}

/** ===== 送信スナップショット (配信時点の写し。参照ではなく値のコピー) =====
 * cases_snapshot: その時点でその人に見せた案件の一覧を、並び順 (order) つきで
 * 表示用フィールドだけに絞った配列の JSON 文字列。案件マスター側が後で変わっても、
 * ここに保存した写しは変わらない (不変性はバックエンドテストで担保する)。
 * body_snapshot: その配信で使った文面そのもの (作成時はテンプレ展開文、
 * 送信確定時は processSendQueue が実際に送った全文で確定させる)。 */
function snapshotCaseItem_(c, order) {
  return {
    order: order,
    case_id: str_(c.case_id),
    facility_name: str_(c.facility_name),
    service_type: str_(c.service_type),
    prefecture: str_(c.prefecture),
    municipality: str_(c.municipality),
    address: str_(c.address),
    job_type: str_(c.job_type),
    employment_type: str_(c.employment_type),
    title: str_(c.title),
    description: publicDescription_(c.description).substring(0, SNAPSHOT_DESC_CHARS),
    nearest_station: str_(c.nearest_station),
    salary_text: publicSalaryBandText_(c.job_type),
    salary_band_text: publicSalaryBandText_(c.job_type),
    salary_note: PUBLIC_SALARY_NOTE_,
    hours_text: publicCaseHoursText_(c.job_type),
    hours_short_text: publicCaseHoursShortText_(c.job_type),
    updated_at_src: cellDateIso_(c.updated_at_src)
  };
}

/** case_id の並び順どおりに案件マスターの現在値を写し取る (見つからない ID は落とす) */
function buildCasesSnapshot_(caseIds) {
  var items = [];
  toList_(caseIds).forEach(function (id) {
    try { items.push(snapshotCaseItem_(findRow_('cases', 'case_id', id), items.length + 1)); }
    catch (e) { /* 案件が既に無い場合は写しに含めない */ }
  });
  // 上限を超える場合は JSON 文字列を途中で切らず、末尾の案件から落として
  // 必ずパース可能な JSON にする (R3 検証 #12 周辺: 途中切断で写し全体が
  // 読めなくなる不具合の修正)。
  var json = JSON.stringify(items);
  while (json.length > SNAPSHOT_TOTAL_CHARS && items.length > 1) {
    items.pop();
    json = JSON.stringify(items);
  }
  if (json.length > SNAPSHOT_TOTAL_CHARS) {
    // 1件でも上限を超える異常ケース: その1件の写し自体を諦める (壊れた JSON は残さない)。
    return '[]';
  }
  return json;
}

function parseCasesSnapshot_(json) {
  if (!json) return [];
  var s = String(json);
  try { var v = JSON.parse(s); return Object.prototype.toString.call(v) === '[object Array]' ? v : []; }
  catch (e) {
    // 旧形式で途中切断された写しから、完結している要素だけを復元する。
    try {
      var cut = s.lastIndexOf('},');
      if (cut < 0) cut = s.lastIndexOf('}');
      if (cut > 0) {
        var v2 = JSON.parse(s.slice(0, cut + 1) + ']');
        return Object.prototype.toString.call(v2) === '[object Array]' ? v2 : [];
      }
    } catch (e2) {}
    return [];
  }
}

function snapshotBody_(body) { return str_(body).substring(0, SNAPSHOT_BODY_CHARS); }

/** 本人の配信スナップショット一覧 (getApplicant のタイムライン返却用。新しい順) */
function deliverySnapshotsForApplicant_(applicantId) {
  var out = [];
  try {
    // R4 S-06/S-12: 配信側の情報 (テスト配信の除外・チャネル判定) を引く。
    var delivById = {};
    try {
      readTable_('deliveries').rows.forEach(function (d) { delivById[String(d.delivery_id)] = d; });
    } catch (eD) { delivById = {}; }
    readTable_('delivery_recipients').rows.forEach(function (r) {
      if (String(r.applicant_id) !== String(applicantId)) return;
      if (!str_(r.cases_snapshot) && !str_(r.body_snapshot)) return;
      var deliv = delivById[String(r.delivery_id)] || null;
      var fj = {};
      try { fj = deliv ? JSON.parse(String(deliv.filter_json || '{}')) : {}; } catch (eJ) { fj = {}; }
      if (fj && (fj._test === true || fj.test === true)) return; // R4 S-12: テスト配信は受信者スナップショットとして返さない
      // R4 S-06: 仮文面 (作成時) と実文 (送信確定) の区別。snapshot_finalized 列が
      // ある環境では列を正とし、列自体が無い旧環境では status='sent' を確定扱いにする。
      var hasFinCol = Object.prototype.hasOwnProperty.call(r, 'snapshot_finalized');
      var finalized = hasFinCol ? toBool_(r.snapshot_finalized) : (String(r.status) === 'sent');
      // 確定フラグが正: SMS記録で確定した form_link 行も 'final' (発行だけの行は
      // フラグが立たないので 'issuance' のまま画面に出ない)。
      var state = 'provisional';
      if (finalized) state = 'final';
      else if (deliv && String(deliv.status) === 'form_link') state = 'issuance'; // R4 S-07: 発行記録
      var channel = 'mail';
      if (fj && fj.form_invite) channel = String(fj.channel || 'sms') === 'mail' ? 'mail' : 'sms';
      out.push({
        delivery_id: str_(r.delivery_id),
        status: str_(r.status),
        snapshot_state: state,
        channel: channel,
        sent_at: cellDateIso_(r.sent_at),
        created_at: cellDateIso_(r.created_at),
        recommended_case_ids: toList_(r.recommended_case_ids),
        cases_snapshot: parseCasesSnapshot_(r.cases_snapshot),
        body_snapshot: str_(r.body_snapshot),
        template_version: str_(r.template_version) // R4 Lane J: 使ったテンプレートの版キー
      });
    });
  } catch (e) { return []; }
  out.sort(function (a, b) {
    var x = a.sent_at || a.created_at, y = b.sent_at || b.created_at;
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  return out.slice(0, 50);
}

/** {不足項目名} 用の短縮名 (R4 レーンJ 項目3。フロントの名前版と表記を一致させる) */
var HEARING_SHORT_NAMES_ = {
  desired_start_date: '勤務開始の希望日',
  qualifications: '資格',
  experience_years: '経験年数',
  nearest_station: '最寄駅',
  desired_days_per_week: '週の希望日数',
  desired_time_slots: '希望時間帯'
};

/** {不足項目名} の展開文: 未確認項目の短縮名だけを「・」で連結する (0 項目なら '') */
function missingHearingNamesText_(applicant) {
return missingHearing_(applicant).map(function (h) {
return HEARING_SHORT_NAMES_[h.key] || h.label;
}).join('・');
}

/** {不足ヒヤリング} の展開文 (未確認項目だけを質問文にする) */
function missingHearingText_(applicant) {
var missing = missingHearing_(applicant);
if (!missing.length) return 'ご登録内容はすべて確認済みです。お仕事のご案内をさせていただきます。';
var lines = ['お仕事をご案内するにあたり、以下を教えていただけますでしょうか。'];
missing.forEach(function (h) { lines.push('・' + h.label);});
lines.push('分かる範囲でご返信いただければ大丈夫です。');
return lines.join('\n');
}

// ===== 回答フォーム送信 (ログイン不要・ドメイン認証なし。form_token で検証) =====
/**
* デプロイB (自分として実行 / 全員公開) で動く前提のアクション。
* form_token が delivery_recipients に存在することだけを検証する。
*/
function findRecipientByToken_(token) {
  var t = readTable_('delivery_recipients');
  for (var i = 0; i < t.rows.length; i++) {
    if (String(t.rows[i].form_token) === token) return t.rows[i];
  }
  return null;
}

/**
 * フォームトークンの有効期限 (R3 検証 #28)。発行 (配信作成) から30日。
 * 中継 (Cloudflare KV) のコンテキスト保持期間30日と揃えてある。
 * 基準時刻が取れない旧行は失効扱いにしない (移行時の誤爆防止)。
 * なお配信停止 (optout) のトークン照合は失効の対象外 — 停止はいつでも受け付ける。
 */
var FORM_TOKEN_TTL_DAYS = 30;
function formTokenExpired_(rec) {
  if (!rec) return false;
  // トークンの生まれた時刻 = 宛先行の created_at (発行・配信作成の両経路で刻印される)。
  var base = cellDateIso_(rec.created_at);
  if (!base) {
    try {
      var d = findRow_('deliveries', 'delivery_id', str_(rec.delivery_id));
      if (d) base = cellDateIso_(d.created_at);
    } catch (e) {}
  }
  if (!base) base = cellDateIso_(rec.sent_at);
  if (!base) return false;
  var t = new Date(base).getTime();
  if (!(t > 0)) return false;
  return (new Date().getTime() - t) > FORM_TOKEN_TTL_DAYS * 86400000;
}
var FORM_TOKEN_EXPIRED_MSG = 'フォームの有効期限が切れています。お手数ですが、担当者からの新しい案内をお待ちください';

/**
 * フォーム表示用コンテキスト (公開側・ドメイン認証なし。form_token 検証のみ)。
 * 返すのは宛名用の氏名・職種とおすすめ案件上位約5件のみ (電話・メールは返さない)。
 * おすすめは recommendForApplicants と同じ照合 (recommendCasesFor_: 20km以内・減衰スコア順)。
 */
function actionGetFormContext_(req) {
  var token = String(req.form_token || '').trim();
  var a = null, senderName = '', senderUnknown = false, channel = '', deliveryId = '';
  var presented = null;
  if (token) {
    var rec = findRecipientByToken_(token);
    if (!rec) throw new Error('無効なフォームトークンです');
    if (formTokenExpired_(rec)) throw new Error(FORM_TOKEN_EXPIRED_MSG);
    a = findApplicant_(rec.applicant_id);
    deliveryId = str_(rec.delivery_id);
    var resolved = resolveDeliveryAttribution_(deliveryId);
    senderName = resolved.sender_name; channel = resolved.channel;
    senderUnknown = !resolved.sender_email;
    // Cases actually presented in that delivery come first (token attribution);
    // fall back to fresh recommendations only when the recipient row has none.
    var presentedIds = toList_(rec.recommended_case_ids);
    if (presentedIds.length) {
      presented = [];
      var allCases = openCases_();
      presentedIds.forEach(function (id) {
        for (var i = 0; i < allCases.length; i++) {
          if (String(allCases[i].case_id) === String(id)) {
            presented.push(publicCaseItem_(allCases[i],
              distanceKm_(a.lat, a.lon, allCases[i].lat, allCases[i].lon)));
            break;
          }
        }
      });
    }
  } else {
    // Fallback (supplement 20): generic URL without a token -> identify by phone number.
    a = findApplicantByPhone_(req.phone || req.applicant_phone || '');
    if (!a) throw new Error('リンクの情報だけでは本人を特定できませんでした。電話番号での照合が必要です');
    senderUnknown = true; channel = 'generic_url';
  }
  var recs = presented && presented.length ? presented
    : recommendCasesFor_(a, openCases_(), SMS_RECOMMEND_DEFAULT).map(publicFromListItem_);
  return {
    applicant_id: str_(a.applicant_id),
    name: str_(a.name), surname: str_(a.surname),
    job_type: str_(a.job_type),
    prefecture: str_(a.prefecture), municipality: str_(a.municipality),
    // Sender display on the form (supplement 20-2): the applicant can see whose
    // invitation this is. Empty + sender_unknown=true when attribution failed.
    sender_name: senderName,
    sender_unknown: senderUnknown,
    source_channel: channel,
    delivery_id: deliveryId,
    recommended_cases: recs, recommend_count: recs.length,
    presented_case_ids: recs.map(function (c) { return c.case_id; }),
    missing_hearing: missingHearing_(a).map(function (h) { return h.key; }),
    form_fields: FORM_ONLY_FIELDS_.slice()
  };
}

/**
 * 回答の重複検出 (R3 / F-08)。同一応募者について、直近15分以内に
 * 同一内容 (配信・意図・入職希望日・電話相談希望・自由文・選択案件) の
 * 回答が保存済みなら、その行を返す。submit_id があれば relay_id 列の
 * 'submit:<id>' で優先照合する (内容が変わっていても同一送信として扱う)。
 */
/* ===== フォーム専用チーム (追補37/38): 電話の幅選択・経験帯・希望時給帯 =====
   電話可能タイミングは「日付 (複数) × 時間帯 (複数) + いつでも可」の構造化データで
   保持する (phone_dates / phone_bands / phone_anytime)。phone_consult_datetime は
   人間可読の合成文字列として従来どおり併記し、旧形式の回答 (自由入力のみ) とも
   互換を保つ。カレンダー開始時刻は「最も早い日付 × 最も早い時間帯の開始時刻」。 */
var PHONE_BAND_DEFS_ = [
  { code: 'morning', label: '午前（9〜12時）', startHour: 9 },
  { code: 'daytime', label: '昼（12〜15時）', startHour: 12 },
  { code: 'evening', label: '夕方（15〜18時）', startHour: 15 },
  { code: 'night', label: '夜（18〜21時）', startHour: 18 }
];
function phoneBandDef_(code) {
  for (var i = 0; i < PHONE_BAND_DEFS_.length; i++) {
    if (PHONE_BAND_DEFS_[i].code === code) return PHONE_BAND_DEFS_[i];
  }
  return null;
}
var EXPERIENCE_BAND_CODES_ = ['none', 'lt1', '1-3', '3-5', '5-10', 'gte10'];
var EXPERIENCE_BAND_LABELS_ = { none: '未経験', lt1: '1年未満', '1-3': '1〜3年',
  '3-5': '3〜5年', '5-10': '5〜10年', gte10: '10年以上' };

/** 日付リストの正規化: YYYY-MM-DD の実在日だけを残し、重複除去・昇順・最大5件 */
function sanitizePhoneDates_(v) {
  var list = Array.isArray(v) ? v : String(v == null ? '' : v).split(',');
  var seen = {}, out = [];
  list.forEach(function (x) {
    var s = String(x == null ? '' : x).trim();
    var m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return;
    var y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
    var dt = new Date(Date.UTC(y, mo - 1, d));
    if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return;
    if (!seen[s]) { seen[s] = 1; out.push(s); }
  });
  out.sort();
  return out.slice(0, 5);
}

/** 時間帯コードの正規化: 許可コードだけを定義順で残す */
function sanitizePhoneBands_(v) {
  var list = Array.isArray(v) ? v : String(v == null ? '' : v).split(',');
  var picked = {};
  list.forEach(function (x) {
    var s = String(x == null ? '' : x).trim();
    if (phoneBandDef_(s)) picked[s] = 1;
  });
  return PHONE_BAND_DEFS_.filter(function (d) { return picked[d.code]; })
    .map(function (d) { return d.code; });
}

var PHONE_WEEKDAYS_ = ['日', '月', '火', '水', '木', '金', '土'];
function phoneDateLabel_(ymd) {
  var m = String(ymd || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return String(ymd || '');
  var wd = PHONE_WEEKDAYS_[new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]))).getUTCDay()];
  return Number(m[2]) + '/' + Number(m[3]) + '（' + wd + '）';
}

/** 構造化された電話の幅 → 人間可読文字列 (フロント buildCallDatetime_ と同形式) */
function composePhoneTextFromParts_(dates, bands, anytime, note) {
  var out = [];
  var dl = sanitizePhoneDates_(dates).map(phoneDateLabel_);
  var bl = sanitizePhoneBands_(bands).map(function (b) { return phoneBandDef_(b).label; });
  if (dl.length) out.push(dl.join('・'));
  if (bl.length) out.push(bl.join('・'));
  if (anytime) out.push('いつでも可');
  var n = String(note || '').trim();
  if (n) out.push(n);
  return out.join(' ');
}

/** 回答行 (または同形オブジェクト) の構造化された電話の幅の表示文字列。無ければ '' */
function phoneStructuredText_(r) {
  if (!r) return '';
  var dates = sanitizePhoneDates_(r.phone_dates);
  var bands = sanitizePhoneBands_(r.phone_bands);
  var any = toBool_(r.phone_anytime);
  if (!dates.length && !bands.length && !any) return '';
  return composePhoneTextFromParts_(dates, bands, any, '');
}

/** 構造化された電話の幅から「今日連絡」判定用の日付ヒントを出す。無ければ '' */
function phoneStructuredHint_(r, today) {
  var dates = sanitizePhoneDates_(r && r.phone_dates);
  if (dates.length) {
    for (var i = 0; i < dates.length; i++) if (dates[i] >= today) return dates[i];
    return dates[dates.length - 1];
  }
  if (toBool_(r && r.phone_anytime)) return today;
  return '';
}

/** リスト系フィールドの順序非依存の正規形 (L07-09: 冪等判定は順序で割らない) */
function sortedListCsv_(v) {
  return toList_(v).map(function (s) { return s.trim(); }).sort().join(',');
}

function findDuplicateResponse_(applicantId, deliveryId, intent, desiredStart,
                                phoneConsult, freeText, caseIdsCsv, submitId, extra) {
  var rows = readTable_('responses').rows;
  var nowMs = new Date().getTime();
  // submit_id の照合は時間窓の対象外 (R3 検証 #31): 中継の取り込みが15分を
  // 超えて遅れても、同一送信は同一として扱う (内容が変わっていても)。
  if (submitId) {
    for (var j = rows.length - 1; j >= 0; j--) {
      if (String(rows[j].applicant_id) !== String(applicantId)) continue;
      if (String(rows[j].relay_id || '') === 'submit:' + submitId) return rows[j];
    }
  }
  var ex = extra || {};
  for (var i = rows.length - 1; i >= 0; i--) {
    var r = rows[i];
    if (String(r.applicant_id) !== String(applicantId)) continue;
    var createdMs = new Date(cellDateIso_(r.created_at)).getTime();
    if (!(createdMs > 0) || nowMs - createdMs > 15 * 60 * 1000) continue;
    if (String(r.delivery_id || '') !== String(deliveryId || '')) continue;
    if (String(r.intent || '') !== String(intent || '')) continue;
    if (String(r.desired_start_date || '') !== String(desiredStart || '')) continue;
    // R4 レーンJ 項目2: 電話希望は統一後の文字列で照合する (旧行は interview 側を読み替え)。
    if (unifiedPhoneText_(r) !== String(phoneConsult || '')) continue;
    if (String(r.free_text || '') !== String(freeText || '')) continue;
    if (sortedListCsv_(r.selected_case_ids) !== sortedListCsv_(caseIdsCsv)) continue;
    // L07-09: 中継が運ぶ残りの回答フィールドも内容一致の対象にする
    // (面談希望日だけ変えた再送を「重複」として握り潰さない)。
    // contact_time_slots は responses に保存されていないため比較対象外。
    if (String(r.experience || '') !== String(ex.experience || '')) continue;
    if (sortedListCsv_(r.qualifications) !== sortedListCsv_(ex.qualifications)) continue;
    var rYears = (r.experience_years === '' || r.experience_years == null) ? '' : toNum_(r.experience_years);
    var eYears = (ex.experience_years === '' || ex.experience_years == null) ? '' : toNum_(ex.experience_years);
    if (String(rYears) !== String(eYears)) continue;
    // R4 レーンJ 項目2: 面談希望日は phone_consult_datetime へ寄せたため、個別比較は
    // 上の統一文字列の照合に吸収された (希望日だけ変えた再送は電話文字列の差で検出できる)。
    if (String(r.desired_tour_date || '') !== String(ex.desired_tour_date || '')) continue;
    // フォーム専用チーム (追補37/38): 構造化フィールドも内容一致の対象にする
    // (電話の日付だけ変えた再送を重複として握り潰さない)。
    if (sortedListCsv_(r.phone_dates) !== sortedListCsv_(ex.phone_dates)) continue;
    if (sortedListCsv_(r.phone_bands) !== sortedListCsv_(ex.phone_bands)) continue;
    if (toBool_(r.phone_anytime) !== !!ex.phone_anytime) continue;
    if (String(r.experience_band || '') !== String(ex.experience_band || '')) continue;
    if (String(r.experience_detail || '') !== String(ex.experience_detail || '')) continue;
    if (String(r.desired_rate_band || '') !== String(ex.desired_rate_band || '')) continue;
    return r;
  }
  return null;
}

/** R4 O-02: フォーム回答に同梱された optout=true の処理。
 * 回答保存と同じロック文脈から呼び、registerOptoutCore_ で実登録する。
 * 停止登録の失敗で回答保存まで失敗にしない (例外は握って戻り値に残す)。
 * channel は optouts の既存値域 (mail/sms) に寄せる暫定対応 (発行元配信の
 * channel 伝播が入るまでの間)。 */
function applySubmitOptout_(req, applicant, applicantId, sourceChannel) {
if (!toBool_(req.optout)) return null;
try {
return registerOptoutCore_(str_(applicant.email), applicantId,
  sourceChannel === 'sms' ? 'sms' : 'mail', 'form_submit', 'system');
} catch (eOpt) {
try { Logger.log('submitResponse optout failed applicant=' + applicantId + ': ' + errMsg_(eOpt)); } catch (e2) {}
return { error: errMsg_(eOpt) };
}
}

function actionSubmitResponse_(req) {
  var token = String(req.form_token || '').trim();
  return withLock_(function () {
    // --- Attribution (supplement 20): token -> delivery_recipients -> deliveries.
    // The token alone identifies applicant + original sender + channel + presented
    // cases. Without a token, fall back to phone-number matching; if that also
    // fails to identify a sender, the response is stored as sender-unknown and
    // enters the unhandled queue (assignable later via assignResponseSender).
    var applicantId = '', deliveryId = '', senderEmail = '', senderName = '';
    var sourceChannel = '', deliveryCreatedAt = '', deliveryMode = '';
    var applicant = null;
    if (token) {
      var rec = findRecipientByToken_(token);
      if (!rec) throw new Error('無効なフォームトークンです');
      if (formTokenExpired_(rec)) throw new Error(FORM_TOKEN_EXPIRED_MSG);
      applicantId = str_(rec.applicant_id);
      deliveryId = str_(rec.delivery_id);
      var attr = resolveDeliveryAttribution_(deliveryId);
      senderEmail = attr.sender_email; senderName = attr.sender_name;
      sourceChannel = attr.channel; deliveryCreatedAt = attr.delivery_created_at;
      deliveryMode = attr.mode;
      applicant = findApplicant_(applicantId);
    } else {
      applicant = findApplicantByPhone_(req.phone || req.applicant_phone || '');
      if (!applicant) {
        throw new Error('本人を特定できませんでした。電話番号を入力のうえ再送信してください');
      }
      applicantId = str_(applicant.applicant_id);
      sourceChannel = 'generic_url'; // sender unknown by definition on this path
    }
    var responseId = nextId_('responses');
    var intent = String(req.intent || '');
    if (['detail', 'tour', 'other_case'].indexOf(intent) < 0) {
      throw new Error('intent は detail / tour / other_case のいずれかです');
    }
    // 追補9: 入職希望日は desired_start_date に統一する (旧 available_start_date は互換入力として受ける)
    var desiredStart = String(req.desired_start_date || req.available_start_date || '');
    // R4 レーンJ 項目2: 電話希望は phone_consult_datetime に一本化する。
    // 旧クライアント・旧中継が interview_desired_date だけを送ってきても受けられる
    // 互換受理とし、両方ある場合は phone 側を正として interview 側は破棄する。
    var phoneUnified = String(req.phone_consult_datetime || '').trim()
      ? String(req.phone_consult_datetime) : String(req.interview_desired_date || '');
    // フォーム専用チーム (追補37/38): 電話の幅選択と経験帯・希望時給帯の構造化入力。
    // 合成文字列が無い経路 (API直叩き等) では構造化データから合成して併記する。
    var phoneDates = sanitizePhoneDates_(req.phone_dates);
    var phoneBands = sanitizePhoneBands_(req.phone_bands);
    var phoneAnytime = toBool_(req.phone_anytime);
    if (!String(phoneUnified || '').trim() &&
        (phoneDates.length || phoneBands.length || phoneAnytime)) {
      phoneUnified = composePhoneTextFromParts_(phoneDates, phoneBands, phoneAnytime, '');
    }
    var experienceBand = EXPERIENCE_BAND_CODES_.indexOf(String(req.experience_band || '')) >= 0
      ? String(req.experience_band) : '';
    var experienceDetail = String(req.experience_detail || '').slice(0, 1000);
    var desiredRateBand = String(req.desired_rate_band || '').slice(0, 100);
    var expYears = (req.experience_years === '' || req.experience_years == null) ? '' : toNum_(req.experience_years);
    // R4 04-03: 回答の「発生時刻」と「取り込み時刻」を分離する。中継経由では
    // relay_received_at (中継の受信時刻) が妥当な範囲 (未来+5分以内・30日以内)
    // にある場合だけ created_at (発生時刻) として採用し、取り込み時刻は
    // imported_at に常時保存する。直接経路は従来どおり両方とも現在時刻。
    var importedAt = nowIso_();
    var responseCreatedAt = importedAt;
    var relayReceivedAt = str_(req.relay_received_at || '');
    if (relayReceivedAt) {
      var rMs = Date.parse(relayReceivedAt), iMs = Date.parse(importedAt);
      if (isFinite(rMs) && isFinite(iMs) &&
          rMs <= iMs + 5 * 60 * 1000 && rMs >= iMs - 30 * 24 * 3600 * 1000) {
        responseCreatedAt = new Date(rMs).toISOString();
      }
    }
    // R3 (F-08 対応): 回答の冪等化。同一内容の再送 (ボタンの連打・通信リトライ・
    // 中継の再取り込み) では新規行を作らず既存の回答を返し、通知メールと
    // カレンダー自動作成も再実行しない。クライアント生成の submit_id があれば
    // relay_id 列に 'submit:<id>' として保存し、最優先で照合する。
    var submitId = String(req.submit_id || '');
    var dupResponse = findDuplicateResponse_(applicantId, deliveryId, intent, desiredStart,
      phoneUnified, String(req.free_text || ''),
      toList_(req.selected_case_ids).join(','), submitId, {
        experience: String(req.experience || ''),
        qualifications: req.qualifications,
        experience_years: (req.experience_years === '' || req.experience_years == null)
          ? '' : req.experience_years,
        desired_tour_date: String(req.desired_tour_date || ''),
        phone_dates: phoneDates.join(','), phone_bands: phoneBands.join(','),
        phone_anytime: phoneAnytime, experience_band: experienceBand,
        experience_detail: experienceDetail, desired_rate_band: desiredRateBand
      });
    if (dupResponse) {
      // R4 O-02: 重複回答でも、同梱された配信停止だけは処理する
      // (前に回答した人が今回あらためて停止だけチェックして送ったケースを落とさない)。
      var dupOptout = applySubmitOptout_(req, applicant, applicantId, sourceChannel);
      return { response_id: str_(dupResponse.response_id), accepted: true, duplicate: true,
        profile_filled: [], response_notify: 'skipped_duplicate',
        calendar_auto: { created: false, reason: 'duplicate' },
        optout: dupOptout,
        sender_unknown: !senderEmail, source_channel: sourceChannel };
    }
    appendRow_('responses', {
      response_id: responseId,
      delivery_id: deliveryId,
      applicant_id: applicantId,
      sender_email: senderEmail,
      intent: intent,
      experience: String(req.experience || ''),
      // R4 レーンJ 項目2: interview_desired_date への新規書き込みは停止する (列は互換読み取り専用に残す)
      interview_desired_date: '',
      desired_start_date: desiredStart,
      available_start_date: desiredStart, // 互換列にも同値を入れる (読み取りは desired_start_date 優先)
      desired_tour_date: String(req.desired_tour_date || ''),
      selected_case_ids: toList_(req.selected_case_ids).join(','),
      experience_years: (expYears == null ? '' : expYears),
      qualifications: toList_(req.qualifications).join(','),
      phone_consult_datetime: phoneUnified, // 合成文字列 (追補37で構造化と併記)。面談希望日もここへ寄せる
      phone_dates: phoneDates.join(','), phone_bands: phoneBands.join(','),
      phone_anytime: phoneAnytime,
      experience_band: experienceBand, experience_detail: experienceDetail,
      desired_rate_band: desiredRateBand,
      free_text: String(req.free_text || ''),
      handled: false, handled_by: '', handled_at: '',
      // Supplement 20: every response starts as unhandled and stays in the queue
      // until it reaches status=handled. source_channel records mail / sms /
      // generic_url (generic_url = sender unknown, needs assignment).
      status: 'unhandled', status_by: '', status_at: importedAt,
      source_channel: sourceChannel,
      relay_id: submitId ? 'submit:' + submitId : '',
      created_at: responseCreatedAt,
      // R4 04-01/04-03: 通知の永続状態の初期値と取り込み時刻。
      // status_at は「サーバーで unhandled になった時刻」なので importedAt を使う
      // (04-05 の expected 照合の版トークンもサーバー処理時刻で揃える)。
      notify_status: 'not_attempted', notify_attempts: 0,
      imported_at: importedAt
    });
    // R4 O-02: 回答に同梱された配信停止 (optout=true) を同じロック内で実登録する。
    var optoutResult = applySubmitOptout_(req, applicant, applicantId, sourceChannel);
    // F-08 対応 (R3): 回答行は保存済み。イベント記録は保存後処理として隔離し、
    // 失敗してもクライアントへ失敗を返さない (再送による二重回答の窓を塞ぐ)。
    // 併せて上記の findDuplicateResponse_ による冪等化で、再送が来ても
    // 既存の回答を返す。
    try {
      appendEvent_(applicantId, 'response_received', 'system',
        'フォーム回答 (' + intent + ') response=' + responseId +
        (senderEmail ? '' : ' 送信元不明'), deliveryId, responseId);
    } catch (eventErr) {
      try { Logger.log('submitResponse: response_received event failed response=' +
        responseId + ': ' + errMsg_(eventErr)); } catch (e) {}
    }
    // 追補9: プロフィール補完。未確認 (空) の項目だけを回答で埋め、既存値は上書きしない。
    // 補完の事実は applicant_events に response_profile_fill として本人のタイムラインへ残す。
    var patch = {}, filled = [];
    if ((applicant.experience_years === '' || applicant.experience_years == null) && expYears != null) {
      patch.experience_years = expYears; filled.push('experience_years');
    }
    if (!str_(applicant.qualifications) && toList_(req.qualifications).length) {
      patch.qualifications = toList_(req.qualifications).join(','); filled.push('qualifications');
    }
    if (!cellDateYmd_(applicant.desired_start_date) && desiredStart) {
      patch.desired_start_date = desiredStart; filled.push('desired_start_date');
    }
    if (filled.length) {
      patch.updated_at = nowIso_();
      updateRowByPk_('applicants', applicantId, patch);
      appendEvent_(applicantId, 'response_profile_fill', 'system',
        'フォーム回答でプロフィール補完: ' + filled.join(',') + ' response=' + responseId,
        deliveryId, responseId);
    }
    // 追補23: 【電話アポ】自動作成 (杉本のみ)。回答保存とは分離し、本処理の失敗が
    // 回答保存・後続の通知を止めることはない (tryAutoCreatePhoneAppointment_ 内で完結)。
    var calendarAuto = tryAutoCreatePhoneAppointment_({
      response_id: responseId, delivery_id: deliveryId, applicant_id: applicantId,
      sender_email: senderEmail,
      interview_desired_date: '',
      phone_consult_datetime: phoneUnified,
      phone_dates: phoneDates.join(','), phone_bands: phoneBands.join(','),
      phone_anytime: phoneAnytime,
      experience_band: experienceBand, experience_detail: experienceDetail,
      desired_rate_band: desiredRateBand,
      desired_start_date: desiredStart,
      available_start_date: desiredStart,
      desired_tour_date: String(req.desired_tour_date || ''),
      selected_case_ids: toList_(req.selected_case_ids).join(','),
      experience: String(req.experience || ''),
      experience_years: (expYears == null ? '' : expYears),
      qualifications: toList_(req.qualifications).join(','),
      free_text: String(req.free_text || ''),
      created_at: responseCreatedAt, calendar_event_id: ''
    });
    // 回答時の送信者通知 (追補20-1: 要約 + 本人カード導線 + 送信元情報つき)。
    // ここまでで回答の保存は完了している。通知は notifySenderOfResponse_ 内で
    // try/catch により完全に隔離され、失敗しても回答保存は失敗扱いにならない。
    // 送信元不明 (senderEmail 空) のときは通知を送らず、その旨がイベントに残る。
    var notify = notifySenderOfResponse_({
      senderEmail: senderEmail,
      senderName: senderName,
      applicantId: applicantId,
      applicantName: str_(applicant.name),
      deliveryId: deliveryId,
      deliveryCreatedAt: deliveryCreatedAt,
      deliveryMode: deliveryMode,
      sourceChannel: sourceChannel,
      responseId: responseId,
      intent: intent,
      desiredStartDate: desiredStart,
      desiredTourDate: String(req.desired_tour_date || ''),
      selectedCaseIds: toList_(req.selected_case_ids),
      phoneConsultDatetime: phoneUnified,
      phoneDates: phoneDates, phoneBands: phoneBands, phoneAnytime: phoneAnytime,
      experience: String(req.experience || ''),
      experienceYears: (expYears == null ? '' : expYears),
      experienceBand: experienceBand, experienceDetail: experienceDetail,
      desiredRateBand: desiredRateBand,
      qualifications: toList_(req.qualifications).join(','),
      freeText: String(req.free_text || ''),
      createdAt: responseCreatedAt
    });
    return { response_id: responseId, accepted: true, profile_filled: filled,
      response_notify: notify.status,
      calendar_auto: calendarAuto,
      optout: optoutResult,
      sender_unknown: !senderEmail, source_channel: sourceChannel };
  });
}

// ===== 回答時の送信者通知 =====
/**
 * 送信者への通知メール。文面の前提 (運用メモ):
 * - 求職者のメールは Indeed の転送アドレスが中心で、求職者への直接返信は
 *   届き方・追跡が不安定になり得る。そのため本システムでは「直接返信に頼らず、
 *   フォーム回答 (responses) を正とする」。通知はあくまで社内担当者への知らせであり、
 *   求職者への返信手段ではない。回答内容の確認・対応は回答一覧で行う。
 * - 送信は GmailApp.sendEmail を使う。本関数はデプロイB (自分として実行=
 *   プロジェクトオーナー) の文脈で動くため、From は実行アカウント (オーナー) に
 *   なるが、To は配信の送信者 (deliveries.sender_email / responses.sender_email) で、
 *   通知はその送信者の自分の Gmail 受信箱に届く。これが「通知が送信元に行く」運用。
 * - 通知の成否は呼び出し元の回答保存に影響させない (本関数内で完結して隔離する)。
 */
/**
 * R4 09-A-09: 通知の実宛先を「現在の」operators 状態から解決する。
 * responses.sender_email は帰属の記録 (誰の送信への回答か) として不変であり、
 * 宛先決定にそのまま使わない。解決順: 本人 (can_send) → handover_email →
 * settings notify_fallback_email → role=manager の運営者 → 解決不能。
 */
function resolveNotifyDestination_(senderEmail) {
  var email = normalizeEmail_(senderEmail);
  if (email) {
    var op = null;
    try { op = operatorByEmail_(email); } catch (e) {}
    if (op && toBool_(op.can_send)) {
      return { to: email, is_fallback: false, reason: 'operator', prefix: '' };
    }
    if (op && str_(op.handover_email)) {
      return { to: normalizeEmail_(op.handover_email), is_fallback: true,
        reason: 'handover', prefix: '\\u3010引き継ぎ先へ転送\\u3011' };
    }
  }
  var fb = normalizeEmail_(getSettingValue_('notify_fallback_email', ''));
  if (!fb) {
    try {
      var ops = readTable_('operators').rows;
      for (var i = 0; i < ops.length; i++) {
        if (str_(ops[i].role) === 'manager' && normalizeEmail_(ops[i].email)) {
          fb = normalizeEmail_(ops[i].email);
          break;
        }
      }
    } catch (e2) {}
  }
  if (fb) {
    return { to: fb, is_fallback: true, reason: email ? 'fallback' : 'no_sender_fallback',
      prefix: '\\u3010宛先フォールバック\\u3011' };
  }
  return { to: '', is_fallback: true, reason: 'unresolved', prefix: '' };
}

/** 通知 ctx の電話希望テキスト (R4 レーンJ 項目2: 通常は phoneConsultDatetime に
 * 統一済み。旧形 ctx の interviewDesiredDate も互換として読み替える) */
function notifyPhoneText_(ctx) {
  return str_(ctx && ctx.phoneConsultDatetime) || str_(ctx && ctx.interviewDesiredDate);
}

function notifySenderOfResponse_(ctx) {
  var status = 'failed', detail = '';
  var dest = { to: '', is_fallback: true, reason: 'unresolved', prefix: '' };
  try { dest = resolveNotifyDestination_(ctx.senderEmail); } catch (eD) {}
  try {
    if (!dest.to) {
      // R4 04-02: 送信元不明でも、フォールバック宛先が解決できれば「不明である
      // こと自体」を通知する (下の else 経路)。ここに来るのは宛先が本当に
      // 解決できない場合だけ。
      status = !ctx.senderEmail ? 'skipped_no_sender' : 'failed';
      detail = !ctx.senderEmail
        ? '送信元不明かつフォールバック宛先も解決できないため通知をスキップ (未対応キューで引き取り待ち)'
        : '通知の宛先を解決できませんでした (operators / notify_fallback_email を確認してください)';
    } else {
      var intentLabels = { detail: '詳細希望', tour: '見学希望', other_case: '別案件希望' };
      var when = '';
      try { when = Utilities.formatDate(new Date(ctx.createdAt), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'); }
      catch (e) { when = ctx.createdAt; }
      var sentWhen = '';
      if (ctx.deliveryCreatedAt) {
        try { sentWhen = Utilities.formatDate(new Date(ctx.deliveryCreatedAt), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'); }
        catch (e2) { sentWhen = ctx.deliveryCreatedAt; }
      }
      var channelLabel = ctx.sourceChannel === 'sms' ? 'SMS案内'
        : (ctx.sourceChannel === 'generic_url' ? '汎用URL (送信元不明)' : 'Gmail配信');
      var lines = [];
      if (!ctx.senderEmail) {
        lines.push('送信元が特定できない回答です。回答一覧の「送信元不明」から引き取ってください。');
        lines.push('');
      }
      lines.push('フォーム回答がありました。回答一覧で内容を確認し、対応してください。');
      lines.push('');
      lines.push('■ 回答の要約');
      lines.push('応募者名: ' + (ctx.applicantName || '(氏名なし)'));
      lines.push('希望区分: ' + (intentLabels[ctx.intent] || ctx.intent));
      // R4 レーンJ 項目2: 電話相談希望と面談希望日は「お電話できる日時」の1行に統一する。
      lines.push('お電話できる日時: ' + (notifyPhoneText_(ctx) || '(未入力)'));
      // フォーム専用チーム (追補37): 構造化された幅選択があれば内訳も併記する。
      var phoneStructLine = phoneStructuredText_({ phone_dates: ctx.phoneDates,
        phone_bands: ctx.phoneBands, phone_anytime: ctx.phoneAnytime });
      if (phoneStructLine) lines.push('お電話できる日時（選択内容）: ' + phoneStructLine);
      // R3 検証 #29 (FIRST_CONTACT_PLAN 1): 電話即応導線。応募者の電話番号と
      // tel: リンクを通知に含め、ワンタップで発信できるようにする。
      var applicantPhone = '';
      try {
        var apForTel = ctx.applicantId ? findApplicant_(ctx.applicantId) : null;
        if (apForTel) applicantPhone = str_(apForTel.phone);
      } catch (eTel) {}
      var telDigits = applicantPhone ? normalizePhoneDigits_(applicantPhone) : '';
      if (applicantPhone) {
        lines.push('電話番号: ' + applicantPhone);
        if (telDigits) lines.push('電話をかける: tel:' + telDigits);
      }
      if (ctx.desiredTourDate) lines.push('見学希望日: ' + ctx.desiredTourDate);
      lines.push('入職希望日: ' + (ctx.desiredStartDate || '(未入力)'));
      lines.push('選択案件: ' + selectedCaseLabels_(ctx.selectedCaseIds));
      var prof = [];
      if (ctx.experienceYears !== '' && ctx.experienceYears != null) prof.push('経験 ' + ctx.experienceYears + '年');
      else if (ctx.experience) prof.push('経験: ' + ctx.experience);
      if (ctx.qualifications) prof.push('資格: ' + ctx.qualifications);
      // フォーム専用チーム (追補38): 経験帯・希望時給・経験の内容を通知にも出す。
      if (ctx.experienceBand) prof.push('経験帯: ' +
        (EXPERIENCE_BAND_LABELS_[ctx.experienceBand] || ctx.experienceBand));
      if (prof.length) lines.push(prof.join(' / '));
      if (ctx.desiredRateBand) lines.push('希望時給: ' + ctx.desiredRateBand);
      if (ctx.experienceDetail) lines.push('経験の内容: ' + String(ctx.experienceDetail).slice(0, 120));
      if (ctx.freeText) lines.push('自由記述: ' + String(ctx.freeText).slice(0, 120));
      lines.push('');
      lines.push('■ 送信元 (誰の送信に対する回答か)');
      lines.push('送信者: ' + (ctx.senderName || '(表示名なし)') + ' (' + (ctx.senderEmail || '送信元不明') + ')');
      lines.push('送信種別: ' + channelLabel + (ctx.deliveryMode ? ' / モード: ' + ctx.deliveryMode : ''));
      lines.push('配信ID: ' + (ctx.deliveryId || '(なし)') + (sentWhen ? ' / 配信作成: ' + sentWhen : ''));
      lines.push('回答日時: ' + when + ' / 回答ID: ' + ctx.responseId);
      lines.push('');
      lines.push('■ 対応はこちら (本人カードへ直接進めます)');
      lines.push('本人カード: ' + applicantCardUrl_(ctx.applicantId));
      lines.push('回答一覧: ' + responseFocusUrl_(ctx.responseId));
      // Supplement 21: when the response carries an interview / phone-consult
      // wish, add the calendar lead. The link opens the response detail in the
      // app (#/responses?focus=...); the calendar event itself is created ONLY
      // from the app button (createPhoneAppointment). Mail links never create
      // a calendar event directly: via mail the acting user cannot be pinned
      // down reliably and the idempotency check (calendar_event_id) cannot be
      // enforced, so a mail click could double-register or land on the wrong
      // person's calendar. See FORM_SYSTEM.md supplement 21.
      if (notifyPhoneText_(ctx).trim()) {
        lines.push('');
        lines.push('■ カレンダーに追加 (電話希望あり)');
        lines.push('回答詳細を開き、「カレンダーに追加」ボタンからあなたのGoogleカレンダーへ');
        lines.push('【電話アポ】予定を作成できます (メール内リンクからは直接作成しません):');
        lines.push('回答詳細: ' + responseFocusUrl_(ctx.responseId));
      }
      lines.push('');
      lines.push('※ 求職者の連絡先は Indeed 転送アドレスが中心のため、直接返信に頼らず、');
      lines.push('　 フォーム回答を正として回答一覧から対応してください。');
      // R3 検証 #29: 電話相談希望が「本日」なら件名にフラグを立てて即応を促す。
      // R4 04-03: 件名フラグの基準日は「今日」ではなく回答の発生日に揃える
      // (中継の遅延取り込みで行の urgency と件名が食い違わないように)。
      var phoneBaseYmd = String(ctx.createdAt || '').slice(0, 10) || todayYmd_();
      var phoneHint = '';
      try { phoneHint = parsePhoneConsultHint_(notifyPhoneText_(ctx), phoneBaseYmd); } catch (eHint) {}
      var subjectPrefix = (ctx.resend ? '\\u3010再送\\u3011' : '') +
        (!ctx.senderEmail ? '\\u3010送信元不明・引き取り待ち\\u3011' : (dest.prefix || ''));
      var subject = (phoneHint && phoneHint === phoneBaseYmd ? '\u3010本日電話希望\u3011' : '') +
        '\u3010応募者配信\u3011フォーム回答がありました' +
        (ctx.applicantName ? ' (' + ctx.applicantName + '様)' : '');
      subject = subjectPrefix + subject;
      // R3 検証 #29: HTML 版も併送し、電話発信と本人カードへの導線をタップ可能にする。
      var escH = function (v) {
        return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
          .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      };
      var htmlBody = '<div style="font-family:sans-serif;font-size:14px;line-height:1.7">' +
        lines.map(function (ln) { return escH(ln); }).join('<br>') +
        (telDigits ? '<p><a href="tel:' + escH(telDigits) + '" style="display:inline-block;padding:10px 18px;background:#2e7d32;color:#fff;border-radius:8px;text-decoration:none">電話をかける (' + escH(applicantPhone) + ')</a></p>' : '') +
        '<p><a href="' + escH(applicantCardUrl_(ctx.applicantId)) + '">本人カードを開く</a> / <a href="' + escH(responseFocusUrl_(ctx.responseId)) + '">回答詳細を開く</a></p>' +
        '</div>';
      GmailApp.sendEmail(dest.to, subject, lines.join('\n'), { htmlBody: htmlBody });
      status = ctx.afterAssign ? 'sent_after_assign'
        : (dest.is_fallback ? 'sent_fallback' : 'sent');
      detail = '通知送信成功 to=' + dest.to +
        (dest.is_fallback ? ' (宛先解決: ' + dest.reason + ')' : '');
    }
  } catch (err) {
    status = 'failed'; detail = '通知送信失敗: ' + errMsg_(err);
  }
  // R4 04-01: 成否は回答行にも永続化する (未達の一覧化・再送の対象特定のため)。
  // 行書き込みが失敗してもイベントには残るよう、両方へ書く。
  try {
    var rowNow = findRow_('responses', 'response_id', ctx.responseId);
    var attempts = (rowNow ? (toNum_(rowNow.notify_attempts) || 0) : 0) + 1;
    updateRowByPk_('responses', ctx.responseId, {
      notify_status: status, notify_attempts: attempts,
      notify_last_at: nowIso_(),
      notify_last_error: status === 'failed' ? String(detail).slice(0, 200) : '',
      notify_sent_to: dest.to || '', notify_is_fallback: !!dest.is_fallback
    });
  } catch (eP) {
    try { Logger.log('notifySenderOfResponse_: 行への記録に失敗 response=' + ctx.responseId + ': ' + errMsg_(eP)); } catch (e4) {}
  }
  // 成否はイベントにも残す (イベント記録自体の失敗で本処理を落とさない)。
  try {
    appendEvent_(ctx.applicantId, 'response_notify', 'system',
      detail + ' response=' + ctx.responseId, ctx.deliveryId, ctx.responseId);
  } catch (e3) { /* ログ失敗は無視する (回答保存を守ることを優先) */ }
  return { status: status, detail: detail, sent_to: dest.to || '', is_fallback: !!dest.is_fallback };
}

// ===== 回答まわり共通ヘルパー (追補20) =====
var RESPONSE_STATUSES_ = ['unhandled', 'in_progress', 'handled'];

/** status の正規化。status 列が正、無い旧行は handled から導出する (互換) */
function responseStatus_(r) {
  var st = str_(r && r.status);
  if (RESPONSE_STATUSES_.indexOf(st) >= 0) return st;
  return toBool_(r && r.handled) ? 'handled' : 'unhandled';
}

function todayYmd_() { return Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd'); }

function diffDaysYmd_(aYmd, bYmd) {
  var a = new Date(aYmd + 'T00:00:00+09:00'), b = new Date(bYmd + 'T00:00:00+09:00');
  if (isNaN(a.getTime()) || isNaN(b.getTime())) return null;
  return Math.round((a.getTime() - b.getTime()) / 86400000);
}

/**
 * 電話相談希望 (自由入力) から日付ヒントを抽出する。対応形式:
 * YYYY-MM-DD / YYYY/MM/DD / M月D日 / M/D / 今日・明日・明後日。
 * baseYmd (回答日) 基準で年を補う。抽出できなければ ''。
 */
/** 実在する日付か (R4 04-11: 2026-02-30 のような入力を翌年化せず unparsed に倒す) */
function isRealYmd_(y, m, d) {
  if (m < 1 || m > 12 || d < 1 || d > 31) return false;
  var dt = new Date(Date.UTC(y, m - 1, d));
  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
}

function parsePhoneConsultHint_(text, baseYmd) {
  var t = str_(text);
  if (!t) return '';
  var base = /^\d{4}-\d{2}-\d{2}$/.test(baseYmd || '') ? baseYmd : todayYmd_();
  if (t.indexOf('明後日') >= 0) return addDaysYmd_(base, 2);
  if (t.indexOf('明日') >= 0) return addDaysYmd_(base, 1);
  if (t.indexOf('今日') >= 0 || t.indexOf('本日') >= 0) return base;
  var m = t.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) {
    if (!isRealYmd_(Number(m[1]), Number(m[2]), Number(m[3]))) return '';
    return m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2);
  }
  m = t.match(/(\d{1,2})月(\d{1,2})日/);
  if (!m) m = t.match(/(\d{1,2})\/(\d{1,2})/);
  if (m) {
    var y = Number(base.slice(0, 4));
    if (!isRealYmd_(y, Number(m[1]), Number(m[2]))) {
      // 年をまたいだ先で実在する場合だけ翌年で再判定する (2/29 等)
      if (!isRealYmd_(y + 1, Number(m[1]), Number(m[2]))) return '';
    }
    var ymd = y + '-' + ('0' + m[1]).slice(-2) + '-' + ('0' + m[2]).slice(-2);
    // 回答日より半年以上前になる場合は翌年の同日とみなす (年末年始の自由入力対策)
    var dd = diffDaysYmd_(ymd, base);
    if (dd != null && dd < -180) ymd = (y + 1) + ymd.slice(4);
    return ymd;
  }
  // R4 04-09: 曜日・「来週」の最小限の解釈 (基準日=回答発生日)。
  // 「平日午前」「いつでも」等は無理に日付化せず未特定区分に残す。
  var wd = t.match(/(来週|今週)?\s*([月火水木金土日])曜/);
  if (wd) {
    var target = '日月火水木金土'.indexOf(wd[2]); // 日=0..土=6 (文字の並び順)
    var baseDow = ymdDow_(base);
    var delta = (target - baseDow + 7) % 7;
    if (wd[1] === '来週') delta += 7;
    else if (delta === 0 && wd[1] !== '今週') delta = 7; // 「○曜」だけなら直近の次の同曜日
    return addDaysYmd_(base, delta);
  }
  if (t.indexOf('来週') >= 0) {
    // 「来週」は月曜始まりの週で解釈し、翌週の月曜を hint とする
    // (日曜が基準日なら翌日の月曜が翌週の開始になる)。
    var toMonday = (8 - ymdDow_(base)) % 7 || 7;
    return addDaysYmd_(base, toMonday);
  }
  return '';
}

/** YMD の曜日 (日=0..土=6)。実行環境のタイムゾーンに依存しない UTC 算術で求める */
function ymdDow_(ymd) {
  var p = String(ymd || '').split('-');
  if (p.length !== 3) return 0;
  var days = Math.floor(Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])) / 86400000);
  return ((days + 4) % 7 + 7) % 7; // 1970-01-01 は木曜 (=4)
}

/** 電話希望の緊急度。overdue < today < soon (3日以内) < unparsed < future < none */
function phoneUrgency_(hintYmd, hasPhoneText, today) {
  if (!hasPhoneText) return '';
  if (!hintYmd) return 'unparsed';
  var d = diffDaysYmd_(hintYmd, today || todayYmd_());
  if (d == null) return 'unparsed';
  if (d < 0) return 'overdue';
  if (d === 0) return 'today';
  if (d <= 3) return 'soon';
  return 'future';
}
var PHONE_URGENCY_RANK_ = { overdue: 0, today: 1, soon: 2, unparsed: 3, future: 4, '': 5 };

/** 配信IDから送信元 attribution を解決する (トークン→受信者→配信の解決の配信側) */
function resolveDeliveryAttribution_(deliveryId) {
  var out = { sender_email: '', sender_name: '', channel: '', delivery_created_at: '', mode: '' };
  if (!deliveryId) { out.channel = 'generic_url'; return out; }
  var delivery = null;
  try { delivery = findRow_('deliveries', 'delivery_id', deliveryId); } catch (e) { delivery = null; }
  if (!delivery) { out.channel = 'sms'; return out; } // 受信者行のみ先行する SMS ボタン起点を想定
  out.sender_email = str_(delivery.sender_email);
  out.sender_name = str_(delivery.sender_name);
  out.delivery_created_at = cellDateIso_(delivery.created_at);
  out.mode = str_(delivery.mode);
  out.channel = 'mail';
  try {
    var fj = JSON.parse(str_(delivery.filter_json) || '{}');
    if (fj && fj.form_invite && fj.channel) out.channel = String(fj.channel); // issueFormToken の発行種別
  } catch (e2) {}
  return out;
}

/** 電話番号の正規化 (数字のみ・国際表記 81 始まりは 0 始まりへ) */
function normalizePhoneDigits_(v) {
  // R3 (F5): 全角数字を半角化してから数字以外を除く (全角のままだと [^0-9] で
  // 数字そのものが消えて照合不能になっていた)。+81 形式は 0 始まりへ寄せる。
  var s = str_(v).replace(/[０-９]/g, function (c) {
    return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
  });
  var d = s.replace(/[^0-9]/g, '');
  if (d.length >= 11 && d.slice(0, 2) === '81') d = '0' + d.slice(2);
  return d;
}

/** 電話番号で applicants を一意照合する。0件・複数件は null (誤照合で他人を特定しない) */
function findApplicantByPhone_(phone) {
  var target = normalizePhoneDigits_(phone);
  if (!target || target.length < 10) return null;
  var rows = readTable_('applicants').rows;
  var hit = null, count = 0;
  for (var i = 0; i < rows.length; i++) {
    if (normalizePhoneDigits_(rows[i].phone) === target) { hit = rows[i]; count++; }
  }
  return count === 1 ? hit : null;
}

/** アプリのベースURL (ハッシュ除去済み)。設定が無ければ '' */
function appBaseUrl_() {
  try {
    var explicit = getSettingValue_('app_base_url', '') || getSettingValue_('admin_url', '') ||
      getSettingValue_('responses_url', '') || getSettingValue_('form_base_url', '');
    if (!explicit) return '';
    var h = explicit.indexOf('#');
    return h >= 0 ? explicit.slice(0, h) : explicit;
  } catch (e) { return ''; }
}

/** 本人カードへの導線URL (応募者一覧で本人を開く。フロント配線仕様は FORM_SYSTEM.md) */
function applicantCardUrl_(applicantId) {
  var base = appBaseUrl_();
  if (!base) return '(本人カードURL未設定: settings に app_base_url を設定してください) applicant_id=' + applicantId;
  return base + '#/list?applicant=' + encodeURIComponent(applicantId);
}

/** 回答一覧で当該回答にフォーカスする導線URL */
function responseFocusUrl_(responseId) {
  var base = appBaseUrl_();
  if (!base) return responseListUrl_();
  return base + '#/responses?focus=' + encodeURIComponent(responseId);
}

/** 本人専用フォームURL (issueFormToken 用) */
function formUrlForToken_(token) {
  var base = '';
  try { base = getSettingValue_('form_base_url', '') || appBaseUrl_(); } catch (e) {}
  if (!base) return '';
  if (base.indexOf('#') >= 0) return base + (base.indexOf('?') >= 0 ? '&' : '?') + 'token=' + encodeURIComponent(token);
  return base + '#/form?token=' + encodeURIComponent(token);
}

/**
 * 朝の棚卸し用サマリ (軽量・件数のみ)。rows は responses の生行。
 * open = 未対応 + 対応中 (対応済みにするまでキューから消えない)。
 */
function computeResponseSummary_(rows) {
  var today = todayYmd_();
  var counts = { unhandled: 0, in_progress: 0, handled: 0 };
  var oldestOpen = null, nearestPhone = '', phoneToday = 0, phoneApproaching = false;
  var senderUnknownOpen = 0;
  // Supplement 21: calendar linkage counts. calendar_unregistered_count counts
  // OPEN responses (not handled) that carry an interview wish but have no
  // calendar_event_id yet, so an unregistered phone appointment surfaces in
  // the morning inventory / unhandled queue instead of being left behind.
  // calendar_registered_count counts rows (any status) that have an event id.
  var calendarUnregistered = 0, calendarRegistered = 0;
  // Supplement 23: responses whose Sugimoto-only auto-creation failed. Counted
  // for OPEN rows that still have no event id, so a failure stays visible in
  // the morning inventory until the one-tap fallback registers it.
  var calendarAutoFailed = 0;
  // R4 04-01/04-02/04-09: 通知未達・送信元不明の最古・未特定電話希望の集計。
  var notifyFailed = 0, senderUnknownOldest = null;
  var phoneUnparsed = 0, phoneUnparsedOldestDays = 0;
  (rows || []).forEach(function (r) {
    var st = responseStatus_(r);
    counts[st]++;
    if (str_(r.calendar_event_id)) calendarRegistered++;
    if (st !== 'handled' && toBool_(r.calendar_auto_failed) && !str_(r.calendar_event_id)) calendarAutoFailed++;
    if (st !== 'handled' &&
        (str_(r.notify_status) === 'failed' || str_(r.notify_status) === 'not_attempted')) {
      notifyFailed++;
    }
    if (st === 'handled') return;
    if (responseHasInterviewWish_(r) && !str_(r.calendar_event_id)) calendarUnregistered++;
    if (!str_(r.sender_email)) {
      senderUnknownOpen++;
      var uCreated = cellDateIso_(r.created_at);
      if (uCreated && (!senderUnknownOldest || uCreated < senderUnknownOldest.created_at)) {
        senderUnknownOldest = { response_id: str_(r.response_id),
          applicant_id: str_(r.applicant_id), created_at: uCreated,
          age_days: diffDaysYmd_(today, uCreated.slice(0, 10)) };
      }
    }
    var created = cellDateIso_(r.created_at);
    if (created && (!oldestOpen || created < oldestOpen.created_at)) {
      oldestOpen = { response_id: str_(r.response_id), applicant_id: str_(r.applicant_id),
        created_at: created, age_days: diffDaysYmd_(today, created.slice(0, 10)) };
    }
    var phoneText = unifiedPhoneText_(r); // R4 レーンJ 項目2: 旧行 (interview のみ) も集計対象に含める
    if (phoneText) {
      // フォーム専用チーム (追補37): 構造化された幅があれば今日連絡判定はそちらを正とする。
      var hint = phoneStructuredHint_(r, today) ||
        parsePhoneConsultHint_(phoneText, created ? created.slice(0, 10) : today);
      var urg = phoneUrgency_(hint, true, today);
      if (urg === 'overdue' || urg === 'today') phoneToday++;
      if (urg === 'overdue' || urg === 'today' || urg === 'soon') phoneApproaching = true;
      if (hint && (!nearestPhone || hint < nearestPhone)) nearestPhone = hint;
      // R4 04-09: 日時未特定の電話希望は phone_today に混ぜず独立に数える。
      if (urg === 'unparsed') {
        phoneUnparsed++;
        var pAge = created ? diffDaysYmd_(today, created.slice(0, 10)) : 0;
        if (pAge != null && pAge > phoneUnparsedOldestDays) phoneUnparsedOldestDays = pAge;
      }
    }
  });
  return {
    counts: counts,
    unhandled_count: counts.unhandled,
    open_count: counts.unhandled + counts.in_progress,
    oldest_open: oldestOpen,
    phone_today_count: phoneToday,
    phone_approaching: phoneApproaching,
    nearest_phone_hint: nearestPhone,
    sender_unknown_open_count: senderUnknownOpen,
    sender_unknown_oldest: senderUnknownOldest,
    notify_failed_count: notifyFailed,
    phone_unparsed_count: phoneUnparsed,
    phone_unparsed_oldest_days: phoneUnparsedOldestDays,
    calendar_unregistered_count: calendarUnregistered,
    calendar_registered_count: calendarRegistered,
    calendar_auto_failed_count: calendarAutoFailed
  };
}

function responseSummarySafe_() {
  try { return computeResponseSummary_(readTable_('responses').rows); }
  catch (e) { return null; }
}

/** 回答1件の返却形 (status・電話優先度・送信元不明フラグつき) */
function responseItem_(r) {
  var name = '';
  try { name = str_(findApplicant_(r.applicant_id).name); } catch (e) {}
  var st = responseStatus_(r);
  var phoneText = unifiedPhoneText_(r); // R4 レーンJ 項目2: phone 優先・interview 互換の統一読み取り
  var created = cellDateIso_(r.created_at);
  // フォーム専用チーム (追補37): 構造化された電話の幅があればテキスト解釈より優先する。
  var structuredHint = phoneStructuredHint_(r, todayYmd_());
  var hint = structuredHint ||
    (phoneText ? parsePhoneConsultHint_(phoneText, created ? created.slice(0, 10) : todayYmd_()) : '');
  var urg = phoneUrgency_(hint, !!phoneText, todayYmd_());
  return {
    response_id: str_(r.response_id), delivery_id: str_(r.delivery_id),
    applicant_id: str_(r.applicant_id), applicant_name: name,
    sender_email: str_(r.sender_email),
    sender_unknown: !str_(r.sender_email),
    source_channel: str_(r.source_channel),
    intent: str_(r.intent),
    experience: str_(r.experience),
    interview_desired_date: cellDateYmd_(r.interview_desired_date) || str_(r.interview_desired_date),
    desired_start_date: cellDateYmd_(r.desired_start_date) || cellDateYmd_(r.available_start_date),
    selected_case_ids: str_(r.selected_case_ids),
    experience_years: toNum_(r.experience_years),
    qualifications: str_(r.qualifications),
    available_start_date: cellDateYmd_(r.available_start_date),
    // 追補39/フォーム専用チーム: 見学希望日は複数日 (カンマ区切り文字列) で届く
    // ため、単日変換で落ちる場合は文字列のまま返す。
    desired_tour_date: cellDateYmd_(r.desired_tour_date) || str_(r.desired_tour_date),
    phone_consult_datetime: phoneText,
    // フォーム専用チーム (追補37/38): 構造化された回答項目 (キュー表示・今日連絡判定用)
    phone_dates: sanitizePhoneDates_(r.phone_dates).join(','),
    phone_bands: sanitizePhoneBands_(r.phone_bands).join(','),
    phone_anytime: toBool_(r.phone_anytime),
    experience_band: str_(r.experience_band),
    experience_detail: str_(r.experience_detail),
    desired_rate_band: str_(r.desired_rate_band),
    has_phone_consult: !!phoneText,
    phone_date_hint: hint,
    phone_urgency: urg,
    phone_priority: (PHONE_URGENCY_RANK_[urg] != null ? PHONE_URGENCY_RANK_[urg] : 5),
    // 追客「今日対応」と統合するための判定: 電話希望があり期限が今日以前のもの
    phone_due_today: (urg === 'overdue' || urg === 'today'),
    // R4 04-09: 日時未特定の電話希望 (due_today には混ぜない独立区分)
    phone_unparsed: (urg === 'unparsed'),
    // R4 04-01: 通知の永続状態 (未達の行だけ再送ボタンを出すために使う)
    notify_status: str_(r.notify_status),
    notify_attempts: toNum_(r.notify_attempts) || 0,
    free_text: str_(r.free_text),
    // Supplement 21: calendar linkage per item. has_interview_wish = the
    // response carries interview_desired_date or phone_consult_datetime.
    // calendar_unregistered (item flag) = wish present and no event id yet
    // (regardless of status; the summary count narrows this to open rows).
    has_interview_wish: responseHasInterviewWish_(r),
    calendar_event_id: str_(r.calendar_event_id),
    calendar_registered: !!str_(r.calendar_event_id),
    calendar_unregistered: responseHasInterviewWish_(r) && !str_(r.calendar_event_id),
    calendar_registered_by: str_(r.calendar_registered_by),
    calendar_registered_at: cellDateIso_(r.calendar_registered_at),
    // Supplement 23: true when the Sugimoto-only auto-creation failed for this
    // response (cleared once any registration succeeds). Front-end should
    // highlight it; the one-tap createPhoneAppointment remains the fallback.
    calendar_auto_failed: toBool_(r.calendar_auto_failed) && !str_(r.calendar_event_id),
    status: st,
    status_by: str_(r.status_by), status_at: cellDateIso_(r.status_at),
    handled: st === 'handled', handled_by: str_(r.handled_by),
    handled_at: cellDateIso_(r.handled_at), created_at: created
  };
}

/** 選択案件IDを「施設名 (case_id)」表記に解決する。解決できないIDはそのまま出す */
function selectedCaseLabels_(caseIds) {
  if (!caseIds || !caseIds.length) return '(選択なし)';
  return caseIds.map(function (id) {
    try {
      var c = findRow_('cases', 'case_id', id);
      return str_(c.facility_name) ? str_(c.facility_name) + ' (' + id + ')' : id;
    } catch (e) { return id; }
  }).join(', ');
}

/**
 * 回答一覧への導線URL。優先順: settings.responses_url > admin_url > app_base_url >
 * form_base_url から組み立て (末尾に #responses)。いずれも無ければプレースホルダ文。
 */
function responseListUrl_() {
  try {
    var explicit = getSettingValue_('responses_url', '') || getSettingValue_('admin_url', '') ||
      getSettingValue_('app_base_url', '');
    if (explicit) return explicit;
    var formBase = getSettingValue_('form_base_url', '');
    if (formBase) return formBase + (formBase.indexOf('#') >= 0 ? '' : '#responses');
  } catch (e) { /* 設定が読めなくても通知本文の組み立ては続ける */ }
  return '(回答一覧URL未設定: settings に responses_url または form_base_url を設定してください)';
}

// ===== 回答一覧 / 対応済み化 =====
function actionGetResponses_(req) {
  // R3 (P2): 回答は個人情報を含むため、他の読み取り系と同じくキカリ認証を必須にする
  // (従来は未認証で all_senders の全件返却が可能だった)。
  requireKikariUser_();
  var sender = String(req.sender_email || '');
  if (req.all_senders !== true && !sender) {
    var me = currentUserEmail_();
    if (me && me.slice(-DOMAIN_SUFFIX.length) === DOMAIN_SUFFIX) sender = me; // 初期値は自分
  }
  // Summary is computed over the sender scope BEFORE status filtering, so the
  // badge / morning-inventory numbers stay stable whichever tab is open.
  var allResponseRows = readTable_('responses').rows;
  var scoped = allResponseRows.filter(function (r) {
    if (sender && String(r.sender_email).toLowerCase() !== sender.toLowerCase()) return false;
    return true;
  });
  var summary = computeResponseSummary_(scoped);
  applyGlobalSenderUnknown_(summary, allResponseRows);
  var wantStatus = RESPONSE_STATUSES_.indexOf(String(req.status || '')) >= 0 ? String(req.status) : '';
  var rows = scoped.filter(function (r) {
    var st = responseStatus_(r);
    if (wantStatus && st !== wantStatus) return false;
    if (req.handled === true && st !== 'handled') return false;
    if (req.handled === false && st === 'handled') return false;
    if (req.sender_unknown === true && str_(r.sender_email)) return false;
    if (req.phone_only === true && !unifiedPhoneText_(r)) return false;
    if (req.calendar_unregistered === true &&
        !(responseHasInterviewWish_(r) && !str_(r.calendar_event_id))) return false;
    if (req.calendar_registered === true && !str_(r.calendar_event_id)) return false;
    if (req.phone_due_today === true) {
      var it = responseItem_(r);
      if (st === 'handled' || !it.phone_due_today) return false;
    }
    return true;
  });
  // Sort (supplement 20-3): open first (unhandled -> in_progress -> handled),
  // then phone urgency (overdue/today first, nearest hint first), newest first.
  // req.sort='recent' restores the legacy newest-first order.
  if (req.sort === 'recent') {
    rows.sort(function (a, b) {
      var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
      return x < y ? 1 : (x > y ? -1 : 0);
    });
  } else {
    var statusRank = { unhandled: 0, in_progress: 1, handled: 2 };
    var decorated = rows.map(function (r) { return { row: r, item: responseItem_(r) }; });
    decorated.sort(function (a, b) {
      var sa = statusRank[a.item.status], sb = statusRank[b.item.status];
      if (sa !== sb) return sa - sb;
      if (a.item.phone_priority !== b.item.phone_priority) return a.item.phone_priority - b.item.phone_priority;
      var ha = a.item.phone_date_hint || '9999-99-99', hb = b.item.phone_date_hint || '9999-99-99';
      if (ha !== hb) return ha < hb ? -1 : 1;
      var x = a.item.created_at, y = b.item.created_at;
      return x < y ? 1 : (x > y ? -1 : 0);
    });
    var limitR = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
    var offsetR = Math.max(0, parseInt(req.offset, 10) || 0);
    return { total: rows.length, unhandled_count: summary.unhandled_count,
      open_count: summary.open_count, summary: summary,
      items: decorated.slice(offsetR, offsetR + limitR).map(function (d) { return d.item; }) };
  }
  var limit = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
  var offset = Math.max(0, parseInt(req.offset, 10) || 0);
  var items = rows.slice(offset, offset + limit).map(function (r) { return responseItem_(r); });
  return { total: rows.length, unhandled_count: summary.unhandled_count,
    open_count: summary.open_count, summary: summary, items: items };
}

/** Light summary only (badge / morning inventory). No items are returned. */
/**
 * R4 04-02/A-07: 送信元不明の件数はスコープ (送信者絞り込み) の外で常時数える。
 * 不明分の引き取りは全員の仕事であり、既定スコープの summary で 0 に潰れると
 * 「誰にも見えないまま滞留する」事故になるため、全行基準で上書きする。
 */
function applyGlobalSenderUnknown_(summary, allRows) {
  var global = computeResponseSummary_(allRows || []);
  summary.sender_unknown_open_count = global.sender_unknown_open_count;
  summary.sender_unknown_oldest = global.sender_unknown_oldest;
  summary.sender_unknown_is_global = true;
  return summary;
}

function actionGetResponseSummary_(req) {
  requireKikariUser_(); // R3 (P2): actionGetResponses_ と同じ認証を必須にする
  var sender = String(req.sender_email || '');
  if (req.all_senders !== true && !sender) {
    var me = currentUserEmail_();
    if (me && me.slice(-DOMAIN_SUFFIX.length) === DOMAIN_SUFFIX) sender = me;
  }
  var allRows = readTable_('responses').rows;
  var rows = allRows.filter(function (r) {
    if (sender && String(r.sender_email).toLowerCase() !== sender.toLowerCase()) return false;
    return true;
  });
  return applyGlobalSenderUnknown_(computeResponseSummary_(rows), allRows);
}

/**
 * 3-stage status transition (supplement 20-2): unhandled / in_progress / handled.
 * handled mirror columns are kept in sync (handled=true <=> status=handled).
 * Who/when is recorded both on the row (status_by/status_at) and as an
 * applicant_events entry (response_handled for handled, response_status otherwise).
 */
function actionSetResponseStatus_(req) {
  var me = requireKikariUser_();
  var status = String(req.status || '');
  if (RESPONSE_STATUSES_.indexOf(status) < 0) {
    throw new Error('status は unhandled / in_progress / handled のいずれかです');
  }
  if (!req.response_id) throw new Error('response_id が必要です');
  return withLock_(function () {
    var resp = findRow_('responses', 'response_id', req.response_id);
    var previousStatus = responseStatus_(resp);
    // R4 04-05: 楽観ロック。expected が両方指定された場合のみ照合する
    // (未指定の旧経路は移行期間として許可し、イベントに記録する)。
    var hasExpected = !!(req.expected_status && req.expected_status_at);
    if (hasExpected) {
      if (previousStatus !== String(req.expected_status) ||
          cellDateIso_(resp.status_at) !== String(req.expected_status_at)) {
        throw new Error('CONFLICT: 現在は ' + previousStatus + ' (' +
          str_(resp.status_by) + ' / ' + cellDateIso_(resp.status_at) + ') です');
      }
    }
    var now = nowIso_();
    var patch = { status: status, status_by: me, status_at: now,
      handled: status === 'handled' };
    if (status === 'handled') { patch.handled_by = me; patch.handled_at = now; }
    else { patch.handled_by = ''; patch.handled_at = ''; } // R4 04-06: 両方向クリア
    updateRowByPk_('responses', req.response_id, patch);
    if (str_(resp.applicant_id)) {
      appendEvent_(str_(resp.applicant_id),
        status === 'handled' ? 'response_handled' : 'response_status', me,
        '回答ステータスを ' + status + ' に変更 response=' + req.response_id +
        (hasExpected ? '' : ' (expectedなし)'),
        str_(resp.delivery_id), req.response_id);
    }
    return { response_id: req.response_id, status: status, status_by: me,
      status_at: now, previous_status: previousStatus,
      handled: status === 'handled' };
  });
}

/** Legacy entry point: mark handled = setResponseStatus(handled). */
function actionMarkResponseHandled_(req) {
  var r = actionSetResponseStatus_({ response_id: req.response_id, status: 'handled' });
  return { handled: r.response_id, handled_by: r.status_by };
}

/**
 * Claim / assign a sender for a response (supplement 20 fallback flow).
 * Used for sender-unknown responses (generic URL): any kikari user can claim
 * it for themselves (default) or assign it to another kikari operator.
 */
function actionAssignResponseSender_(req) {
  var me = requireKikariUser_();
  if (!req.response_id) throw new Error('response_id が必要です');
  var target = String(req.sender_email || me).trim().toLowerCase();
  if (target.slice(-DOMAIN_SUFFIX.length) !== DOMAIN_SUFFIX) {
    throw new Error('割り当て先は @kikari.co.jp のメールアドレスです');
  }
  // R3 (P2): 割り当て先は登録済みの運営者に限る (未登録アドレスへの誤割当を防ぐ)
  if (!operatorByEmail_(target)) {
    throw new Error('割り当て先が運営者として登録されていません: ' + target);
  }
  return withLock_(function () {
    var resp = findRow_('responses', 'response_id', req.response_id);
    var prev = str_(resp.sender_email);
    // R3 (P2): 帰属済み (送信者が確定している) 回答は上書きしない。
    // 本来の用途は「送信元不明」への割り当てであり、帰属の付け替えは
    // 通知先・対応責任を黙って変えてしまうため拒否する。
    if (prev && prev.toLowerCase() !== target) {
      throw new Error('この回答には既に送信者が割り当てられています: ' + prev);
    }
    updateRowByPk_('responses', req.response_id, { sender_email: target });
    if (str_(resp.applicant_id)) {
      appendEvent_(str_(resp.applicant_id), 'response_assigned', me,
        '回答の送信元を割り当て: ' + (prev || '送信元不明') + ' -> ' + target +
        ' response=' + req.response_id,
        str_(resp.delivery_id), req.response_id);
    }
    // R4 04-02: 引き取り後に「未実行だった後処理」をやり直す (失敗しても
    // 引き取り自体は成功として返し、結果は戻り値で表面化させる)。
    // - 通知: 新しい送信者へ再送する (notify_status は sent_after_assign)。
    // - カレンダー自動作成: 再判定する。実行アカウントが新しい送信者と
    //   一致しない場合は executor_mismatch が返る (他人のカレンダーに作る
    //   方向へガードを緩めない)。
    var post = { notify: null, calendar_auto: null };
    try {
      var fresh = findRow_('responses', 'response_id', req.response_id);
      var nctx = buildResponseNotifyCtx_(fresh);
      nctx.afterAssign = true;
      var n = notifySenderOfResponse_(nctx);
      post.notify = { status: n.status, sent_to: n.sent_to };
    } catch (eN) { post.notify = { status: 'failed', detail: errMsg_(eN) }; }
    try {
      var fresh2 = findRow_('responses', 'response_id', req.response_id);
      post.calendar_auto = tryAutoCreatePhoneAppointment_(fresh2);
    } catch (eC) { post.calendar_auto = { created: false, reason: 'error', detail: errMsg_(eC) }; }
    return { response_id: req.response_id, sender_email: target,
      previous_sender_email: prev, notify: post.notify, calendar_auto: post.calendar_auto };
  });
}

/** 回答行から通知 ctx を再構築する (再送・引き取り後通知で共用。04-01/04-02) */
function buildResponseNotifyCtx_(row) {
  var attr = { sender_name: '', channel: '', delivery_created_at: '', mode: '' };
  try {
    var a = resolveDeliveryAttribution_(str_(row.delivery_id));
    attr.sender_name = a.sender_name; attr.channel = a.channel;
    attr.delivery_created_at = a.delivery_created_at; attr.mode = a.mode;
  } catch (e) {}
  var applicant = null;
  try { applicant = findApplicant_(str_(row.applicant_id)); } catch (e2) {}
  return {
    senderEmail: str_(row.sender_email),
    senderName: attr.sender_name,
    applicantId: str_(row.applicant_id),
    applicantName: applicant ? str_(applicant.name) : '',
    deliveryId: str_(row.delivery_id),
    deliveryCreatedAt: attr.delivery_created_at,
    deliveryMode: attr.mode,
    sourceChannel: str_(row.source_channel) || attr.channel,
    responseId: str_(row.response_id),
    intent: str_(row.intent),
    desiredStartDate: str_(row.desired_start_date),
    desiredTourDate: str_(row.desired_tour_date),
    selectedCaseIds: toList_(row.selected_case_ids),
    // R4 レーンJ 項目2: 旧行 (interview のみ) も読み替えて通知に載せる。
    phoneConsultDatetime: unifiedPhoneText_(row),
    // フォーム専用チーム (追補37/38): 再送・引き取り後通知でも構造化データを載せる。
    phoneDates: sanitizePhoneDates_(row.phone_dates),
    phoneBands: sanitizePhoneBands_(row.phone_bands),
    phoneAnytime: toBool_(row.phone_anytime),
    experience: str_(row.experience),
    experienceYears: (row.experience_years === '' || row.experience_years == null) ? '' : row.experience_years,
    experienceBand: str_(row.experience_band),
    experienceDetail: str_(row.experience_detail),
    desiredRateBand: str_(row.desired_rate_band),
    qualifications: str_(row.qualifications),
    freeText: str_(row.free_text),
    createdAt: cellDateIso_(row.created_at)
  };
}

/**
 * R4 04-01: 通知の再送。宛先は再送時点の operators 状態で再解決される。
 * 送信済み (sent かつ試行あり) の行は force:true が無ければ二重送信防止で止める。
 */
function actionResendResponseNotification_(req) {
  var me = requireKikariUser_();
  if (!req.response_id) throw new Error('response_id が必要です');
  return withLock_(function () {
    var row = findRow_('responses', 'response_id', req.response_id);
    if (!row) throw new Error('回答が見つかりません: ' + req.response_id);
    if (str_(row.notify_status) === 'sent' && (toNum_(row.notify_attempts) || 0) >= 1 &&
        req.force !== true) {
      throw new Error('この回答の通知は送信済みです。再送する場合は force を指定してください');
    }
    var ctx = buildResponseNotifyCtx_(row);
    ctx.resend = true;
    var n = notifySenderOfResponse_(ctx);
    return { response_id: req.response_id, notify_status: n.status,
      sent_to: n.sent_to, is_fallback: n.is_fallback, resent_by: me };
  });
}

/**
 * Issue an attributed form token from an app button (supplement 20-1/3).
 * Sending must start from an app button: this creates the delivery record
 * (sender = caller, applicant, channel sms/mail, campaign, presented cases)
 * plus the recipient row carrying the unguessable form_token, BEFORE the
 * sms: hand-off / mail send. Hand-typed messages cannot create attribution.
 * This action itself sends nothing.
 */
function actionIssueFormToken_(req) {
  var me = requireKikariUser_();
  var applicantId = String(req.applicant_id || '');
  if (!applicantId) throw new Error('applicant_id が必要です');
  var applicant = findApplicant_(applicantId);
  // R4 O-06: 配信停止中の人にはフォーム案内 (トークン+中継Push) を発行しない。
  if (smsBlockedReason_(applicant)) throw new Error('配信停止中のためフォーム案内は発行できません');
  var channel = String(req.channel || 'sms') === 'mail' ? 'mail' : 'sms';
  var caseIds = toList_(req.case_ids || req.selected_case_ids || req.presented_case_ids);
  if (!caseIds.length) {
    var n = channel === 'sms' ? SMS_RECOMMEND_DEFAULT : clampRecommendCount_(req.recommend_count);
    caseIds = recommendCasesFor_(applicant, openCases_(), n).map(function (c) { return c.case_id; });
  }
  var op = {};
  try { op = operatorByEmail_(me) || {}; } catch (e) { op = {}; }
  // R4 レーンJ 項目1 (c)2: 案内文面の版キー。文面が渡されていればその本文、
  // 無ければ templates 行の body から作る。req.template_version は素通しで記録する。
  var issueBodyText = String(req.body_snapshot || req.body_template || req.body || '');
  var issueTplVer = req.template_version
    ? { template_id: String(req.template_id || ''), template_version: String(req.template_version) }
    : templateVersionFor_({ template_id: req.template_id, template_kind: req.template_kind }, issueBodyText);
  var issued = withLock_(function () {
    var deliveryId = nextId_('deliveries');
    var now = nowIso_();
    appendRow_('deliveries', {
      delivery_id: deliveryId, sender_email: me,
      sender_name: str_(op.display_name), subject: '(フォーム案内リンク)',
      body_template: '', mode: 'per_person', recommend_count: caseIds.length,
      filter_json: JSON.stringify({ form_invite: true, channel: channel,
        campaign_id: String(req.campaign_id || '') }),
      target_count: 1, sent_count: 0, failed_count: 0,
      status: 'form_link', scheduled_at: '', created_by: me,
      created_at: now, started_at: '', finished_at: '',
      template_id: issueTplVer.template_id, template_version: issueTplVer.template_version
    });
    var token = Utilities.getUuid() + Utilities.getUuid().replace(/-/g, '');
    appendRow_('delivery_recipients', {
      delivery_id: deliveryId, applicant_id: applicantId, email: str_(applicant.email),
      recommended_case_ids: caseIds.join(','),
      status: 'form_link', error: '', sent_at: '',
      form_token: token, created_at: now, updated_at: now,
      // R4 S-07: 発行記録ではスナップショットを作らない (未送信なのに提示実績の
      // 写しが残る問題の解消)。写しは SMS 記録がこの delivery_id を伴って来た
      // 時点で actionRecordSmsSent_ が実績ベースで書く。ここでは提示予定の
      // 案件 ID (recommended_case_ids) と form_token だけを保持する。
      cases_snapshot: '',
      body_snapshot: '',
      template_version: issueTplVer.template_version
    });
    return { delivery_id: deliveryId, form_token: token,
      form_url: formUrlForToken_(token),
      sender_email: me, sender_name: str_(op.display_name),
      channel: channel, case_ids: caseIds };
  });
  try {
    relayPushContextForToken_(issued.form_token);
  } catch (e) {
    Logger.log('relay push (issueFormToken) failed: ' + errMsg_(e));
  }
  return issued;
}

// ===== カレンダー連携: 電話アポ登録 (追補21) =====
// 前提: Web App A は「アクセスしたユーザーとして実行」なので、
// CalendarApp.getDefaultCalendar() は実行した運営者本人のカレンダーを指す。
// そのため共有設定なしで全運営者が各自のカレンダーへ登録できる。
// タイトルは必ず【電話アポ】で始める。既存の【面談】パイプライン
// (カレンダーの【面談】イベントを起点に動く tour 系ジョブ) と衝突させないため、
// 【面談】とは決して名付けない。
var PHONE_APPOINTMENT_DEFAULT_HOUR_ = 10;   // 時刻が特定できない場合の既定開始時刻 (JST)
var PHONE_APPOINTMENT_DEFAULT_MINUTE_ = 0;
var PHONE_APPOINTMENT_DURATION_MIN_ = 15;   // 電話アポの所要時間 (現行の電話アポ15分に合わせる)

/**
 * 「面談希望あり」の定義 (追補21): お電話できる日時 (unifiedPhoneText_:
 * phone_consult_datetime 優先、旧行は interview_desired_date を読み替え) が
 * 入っていること。この定義は createPhoneAppointment / responseItem_ /
 * computeResponseSummary_ / 通知メールのカレンダー導線で共通に使う (判定点は本関数のみ)。
 */
/**
 * 電話希望の統一読み取り (R4 レーンJ 項目2): 正は phone_consult_datetime。
 * interview_desired_date は新規書き込みを停止した互換列であり、旧行 (interview のみ)
 * はここで読み替える。既存行の書き換え migration は行わない。
 */
function unifiedPhoneText_(r) {
  if (!r) return '';
  var p = str_(r.phone_consult_datetime);
  if (p.trim()) return p;
  return str_(r.interview_desired_date);
}

function responseHasInterviewWish_(r) {
  if (!r) return false;
  return !!unifiedPhoneText_(r).trim();
}

/** 自由入力テキストから時刻 (HH:MM) を抽出する。抽出できなければ null */
function extractTimeHm_(text) {
  var t = str_(text);
  if (!t) return null;
  var isPm = t.indexOf('午後') >= 0;
  var m = t.match(/(\d{1,2})[:：](\d{2})/);
  if (!m) m = t.match(/(\d{1,2})時(?:(\d{1,2})分)?/);
  if (!m) return null;
  var hour = parseInt(m[1], 10), minute = m[2] ? parseInt(m[2], 10) : 0;
  if (isPm && hour < 12) hour += 12;
  if (hour > 23 || minute > 59) return null;
  return { hour: hour, minute: minute };
}

/**
 * 回答行から電話アポの開始日時を作る。
 * 日付・時刻とも unifiedPhoneText_ (phone 優先・interview 互換) の1本から取る。
 * 完全表記 (YYYY-MM-DD / YYYY/MM/DD) を優先し、無ければ
 * parsePhoneConsultHint_ (M月D日・明日 等、回答日基準) で日付ヒントを取る。
 * 時刻が無ければ既定 10:00 (JST) とする。
 * 既定時刻の扱い (明記): 終日予定にはしない。電話アポは「その時刻に電話する」
 * 対応であり、終日予定ではリマインドも当日の対応順も定まらないため、
 * 時刻が無くても 10:00 開始・15分 の時間指定予定として作る。
 * 日付自体を特定できない場合は null を返す (呼び出し側でエラーにする)。
 */
function parseAppointmentStart_(r) {
  var baseYmd = cellDateYmd_(r && r.created_at) || todayYmd_();
  // フォーム専用チーム (追補37): 構造化された幅があれば「最も早い日付 ×
  // 最も早い時間帯の開始時刻」で開始時刻を決める (テキスト解釈は使わない)。
  if (r) {
    var sDates = sanitizePhoneDates_(r.phone_dates);
    var sBands = sanitizePhoneBands_(r.phone_bands);
    if (sDates.length) {
      var sHour = sBands.length ? phoneBandDef_(sBands[0]).startHour
        : PHONE_APPOINTMENT_DEFAULT_HOUR_;
      var sStart = new Date(sDates[0] + 'T' + ('0' + sHour).slice(-2) + ':00:00+09:00');
      if (!isNaN(sStart.getTime())) {
        return { start: sStart,
          end: new Date(sStart.getTime() + PHONE_APPOINTMENT_DURATION_MIN_ * 60000),
          ymd: sDates[0], has_explicit_time: sBands.length > 0 };
      }
    }
  }
  // R4 レーンJ 項目2: 候補は統一読み取り (phone 優先・interview 互換) の1本にする。
  var unified = r ? unifiedPhoneText_(r) : '';
  var candidates = [unified];
  var ymd = '';
  for (var i = 0; i < candidates.length; i++) {
    var v = candidates[i];
    if (v == null || v === '') continue;
    if (v instanceof Date) { ymd = cellDateYmd_(v); if (ymd) break; continue; }
    var t = str_(v);
    var m = t.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
    if (m) { ymd = m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2); break; }
    var hint = parsePhoneConsultHint_(t, baseYmd);
    if (hint) { ymd = hint; break; }
  }
  if (!ymd) return null;
  var hm = extractTimeHm_(unified);
  var hasExplicitTime = !!hm;
  if (!hm) hm = { hour: PHONE_APPOINTMENT_DEFAULT_HOUR_, minute: PHONE_APPOINTMENT_DEFAULT_MINUTE_ };
  var hh = ('0' + hm.hour).slice(-2), mm = ('0' + hm.minute).slice(-2);
  var start = new Date(ymd + 'T' + hh + ':' + mm + ':00+09:00');
  if (isNaN(start.getTime())) return null;
  var end = new Date(start.getTime() + PHONE_APPOINTMENT_DURATION_MIN_ * 60000);
  return { start: start, end: end, ymd: ymd, has_explicit_time: hasExplicitTime };
}

/**
 * 電話アポを運営者本人の Google カレンダーへ登録する (要ドメイン認証)。
 * req: { response_id }
 * 冪等性: responses.calendar_event_id が既に入っていれば予定を作り直さず、
 * 既存の event_id を already_registered:true で返す (再実行しても二重登録しない)。
 * 登録先は実行ユーザーの既定カレンダー (Web App A = アクセスユーザー実行)。
 */
function createPhoneAppointmentCore_(resp, registeredBy, actor, eventType) {
  {
    var req = { response_id: str_(resp.response_id) };
    var existingId = str_(resp.calendar_event_id);
    if (existingId) {
      // F-06 (堅牢化): 保存済み ID の実在確認を試みる。カレンダー側で手動削除
      // されていた場合は ID をクリアして下で作り直す。取得 API が使えない
      // 環境 (スタブ等) や取得自体が失敗した場合は、確認できないので従来どおり
      // 登録済みとして扱う (誤って二重作成するより安全な側に倒す)。
      var existingEvent = null, existenceChecked = false;
      try {
        var calForCheck = CalendarApp.getDefaultCalendar();
        if (calForCheck && typeof calForCheck.getEventById === 'function') {
          existingEvent = calForCheck.getEventById(existingId); existenceChecked = true;
        } else if (typeof CalendarApp.getEventById === 'function') {
          existingEvent = CalendarApp.getEventById(existingId); existenceChecked = true;
        }
      } catch (checkErr) { existenceChecked = false; }
      if (!existenceChecked || existingEvent) {
        return { response_id: req.response_id, calendar_event_id: existingId,
          calendar_registered_by: str_(resp.calendar_registered_by),
          calendar_registered_at: cellDateIso_(resp.calendar_registered_at),
          already_registered: true, calendar_existence_checked: existenceChecked };
      }
      try {
        updateRowByPk_('responses', req.response_id,
          { calendar_event_id: '', calendar_registered_by: '', calendar_registered_at: '' });
      } catch (clearErr) { /* クリア失敗でも作り直しは試みる (下の保存で上書きされる) */ }
      resp = Object.assign({}, resp, { calendar_event_id: '' });
    }
    if (!responseHasInterviewWish_(resp)) {
      throw new Error('お電話できる日時 (phone_consult_datetime) が無い回答ではカレンダー登録できません');
    }
    var parsed = parseAppointmentStart_(resp);
    if (!parsed) {
      throw new Error('お電話できる日時から日時を特定できませんでした (原文: ' +
        unifiedPhoneText_(resp) + ')');
    }
    var applicant = null;
    try { applicant = findApplicant_(resp.applicant_id); } catch (e) { applicant = null; }
    var applicantName = applicant ? str_(applicant.name) : '';
    // Title must start with 【電話アポ】 (never 【面談】: avoids the tour pipeline).
    var title = '【電話アポ】' + (applicantName || '(氏名なし)') + '様（電話面談）';
    // Description: job-seeker info (name / phone / desired conditions /
    // selected cases / link to the applicant card).
    var wishes = [];
    var desiredStart = cellDateYmd_(resp.desired_start_date) || cellDateYmd_(resp.available_start_date);
    if (desiredStart) wishes.push('入職希望日: ' + desiredStart);
    if (str_(resp.qualifications)) wishes.push('資格: ' + str_(resp.qualifications));
    if (resp.experience_years !== '' && resp.experience_years != null) wishes.push('経験年数: ' + resp.experience_years + '年');
    else if (str_(resp.experience)) wishes.push('経験: ' + str_(resp.experience));
    // フォーム専用チーム (追補38): 経験帯・希望時給・経験の内容も希望条件に載せる。
    if (str_(resp.experience_band)) wishes.push('経験帯: ' +
      (EXPERIENCE_BAND_LABELS_[str_(resp.experience_band)] || str_(resp.experience_band)));
    if (str_(resp.desired_rate_band)) wishes.push('希望時給: ' + str_(resp.desired_rate_band));
    if (str_(resp.experience_detail)) wishes.push('経験の内容: ' + str_(resp.experience_detail));
    // 追補39: 見学希望日は複数日 (カンマ区切り) のまま扱う (単日に確定しない)。
    var tourYmd = cellDateYmd_(resp.desired_tour_date) || str_(resp.desired_tour_date);
    if (tourYmd) wishes.push('見学希望日: ' + tourYmd);
    var lines = [];
    lines.push('氏名: ' + (applicantName || '(氏名なし)'));
    lines.push('電話番号: ' + (applicant ? (str_(applicant.phone) || '(未登録)') : '(応募者特定不可)'));
    lines.push('希望条件: ' + (wishes.length ? wishes.join(' / ') : '(未入力)'));
    lines.push('選んだ案件: ' + selectedCaseLabels_(toList_(resp.selected_case_ids)));
    lines.push('お電話できる日時: ' + (unifiedPhoneText_(resp) || '(未入力)'));
    // フォーム専用チーム (追補37): 選択した幅の全体を説明欄にも保持する
    // (予定は最も早い組合せで作るが、候補の全幅が担当者に見えるように)。
    var phoneStructDesc = phoneStructuredText_(resp);
    if (phoneStructDesc) lines.push('お電話できる日時（選択内容）: ' + phoneStructDesc);
    if (!parsed.has_explicit_time) lines.push('※ 希望時刻の指定が無かったため既定の10:00で登録しています');
    if (str_(resp.free_text)) lines.push('自由記述: ' + str_(resp.free_text));
    lines.push('本人カード: ' + applicantCardUrl_(str_(resp.applicant_id)));
    lines.push('回答詳細: ' + responseFocusUrl_(req.response_id));
    lines.push('回答ID: ' + req.response_id);
    var calendar = CalendarApp.getDefaultCalendar();
    if (!calendar) throw new Error('既定のカレンダーを取得できませんでした');
    var event = calendar.createEvent(title, parsed.start, parsed.end,
      { description: lines.join('\n') });
    var eventId = event && event.getId ? String(event.getId()) : '';
    if (!eventId) throw new Error('カレンダー予定の作成に失敗しました (event id が返りませんでした)');
    var now = nowIso_();
    // F-06 窓(1) への補償: 予定作成後にシート記録が失敗すると ID が残らず、
    // 再試行で二重予定ができる。その場合は作った予定を削除してから失敗を返し、
    // 「予定だけが残って ID が無い」状態を作らない (削除も失敗したら元の例外を返す)。
    try {
      updateRowByPk_('responses', req.response_id, {
        calendar_event_id: eventId, calendar_registered_by: registeredBy, calendar_registered_at: now,
        calendar_auto_failed: '' // 登録できたら自動作成失敗フラグはクリアする (追補23)
      });
    } catch (saveErr) {
      try { if (event && typeof event.deleteEvent === 'function') event.deleteEvent(); } catch (delErr) {}
      throw saveErr;
    }
    if (str_(resp.applicant_id)) {
      appendEvent_(str_(resp.applicant_id), eventType, actor,
        '電話アポをカレンダー登録: ' + title + ' event=' + eventId +
        ' response=' + req.response_id, str_(resp.delivery_id), req.response_id);
    }
    return { response_id: req.response_id, calendar_event_id: eventId,
      calendar_registered_by: registeredBy, calendar_registered_at: now,
      already_registered: false, title: title,
      start: parsed.start.toISOString(), end: parsed.end.toISOString() };
  }
}

/** ワンタップ登録 (従来どおり全運営者の標準経路)。ロック内で共通作成処理を呼ぶ */
function actionCreatePhoneAppointment_(req) {
  var me = requireKikariUser_();
  if (!req.response_id) throw new Error('response_id が必要です');
  return withLock_(function () {
    var resp = findRow_('responses', 'response_id', req.response_id);
    return createPhoneAppointmentCore_(resp, me, me, 'phone_appointment');
  });
}

// ===== 【電話アポ】自動作成 (追補23・杉本のみ完全自動) =====
/**
 * submitResponse の保存後に呼ばれる追加経路。呼び出し側は withLock_ 取得済みの文脈。
 * 発火条件 (全て満たす場合だけ作成する):
 *  (a) 送信元 (responses.sender_email) が特定できている
 *  (b) その運営者の operators.auto_calendar が ON
 *  (c) フォーム処理の実行アカウント (Session.getEffectiveUser) が送信元と一致する
 *      ← 必須ガード。デプロイBは杉本のアカウントで動くため、現状この条件を満たすのは
 *        杉本宛ての回答だけ。他の運営者を ON にしても、実行アカウントが杉本である限り
 *        予定は作らない (作れば杉本のカレンダーに他人の予定が入ってしまうため)。
 *  (d) 面談希望日または電話相談希望がある (responseHasInterviewWish_)
 * 二重作成防止: calendar_event_id が既にあれば作らない (ワンタップ済み・自動済み共通の冪等キー)。
 * 失敗時: 例外を外へ出さず、responses.calendar_auto_failed=true と
 * applicant_events の phone_appointment_auto_failed (実行者つき) を残して通常 return する。
 * 回答保存・通知は止めない。回復は従来のワンタップ (createPhoneAppointment) がそのまま使える。
 * 成功時: calendar_registered_by は 'auto:<sender_email>' とし、自動作成だと分かる値にする。
 * applicant_events には phone_appointment_auto を実行者 (実行アカウント) つきで残す。
 */
function tryAutoCreatePhoneAppointment_(respInput) {
  var out = { attempted: false, created: false, reason: '' };
  var sender = String((respInput && respInput.sender_email) || '').trim().toLowerCase();
  try {
    if (!sender) { out.reason = 'no_sender'; return out; }
    if (!autoCalendarEnabledFor_(sender)) { out.reason = 'disabled'; return out; }
    var eff = effectiveUserEmail_();
    if (!eff || eff !== sender) { out.reason = 'executor_mismatch'; return out; }
    if (!responseHasInterviewWish_(respInput)) { out.reason = 'no_wish'; return out; }
    out.attempted = true;
    var fresh = respInput;
    try { fresh = findRow_('responses', 'response_id', respInput.response_id); } catch (e) { fresh = respInput; }
    if (str_(fresh.calendar_event_id)) {
      out.reason = 'already_registered';
      out.calendar_event_id = str_(fresh.calendar_event_id);
      return out;
    }
    var r = createPhoneAppointmentCore_(fresh, 'auto:' + sender, eff, 'phone_appointment_auto');
    out.created = !r.already_registered;
    out.calendar_event_id = r.calendar_event_id;
    out.reason = r.already_registered ? 'already_registered' : 'created';
    return out;
  } catch (err) {
    try {
      updateRowByPk_('responses', respInput.response_id, { calendar_auto_failed: true });
    } catch (e2) { /* フラグ書き込み失敗でも回答保存は守る */ }
    try {
      appendEvent_(str_(respInput.applicant_id), 'phone_appointment_auto_failed',
        effectiveUserEmail_() || 'system',
        '電話アポ自動作成に失敗: ' + errMsg_(err) + ' response=' + respInput.response_id,
        str_(respInput.delivery_id), respInput.response_id);
    } catch (e3) { /* ログ失敗は無視する */ }
    out.failed = true;
    out.reason = 'failed';
    out.error = errMsg_(err);
    return out;
  }
}

// ===== 送信者 (operators) =====
function actionGetOperators_() {
var me = currentUserEmail_();
var rows = readTable_('operators').rows.map(function (r) {
var isMe = String(r.email).toLowerCase() === me;
return {
email: str_(r.email), display_name: str_(r.display_name), role: str_(r.role),
reply_to: str_(r.reply_to), can_send: toBool_(r.can_send),
auto_calendar: toBool_(r.auto_calendar), // 追補23: 【電話アポ】自動作成フラグ (杉本のみ初期ON)
signature: isMe? str_(r.signature): '', // 署名は本人の分だけ返す
is_placeholder: str_(r.email).indexOf('@') < 0 || str_(r.display_name).indexOf('未登録') >= 0
};
});
return { operators: rows, my_email: me};
}

/** 送信者・署名の保存 (要ドメイン認証)。自分の行だけ編集可。@kikari.co.jp 以外は保存拒否 */
function actionUpdateOperator_(req) {
var me = requireKikariUser_();
// R3 検証 #15: email が空のときに自分の行へフォールバックしない。メール未登録の
// 他人行の保存が「自分の行の上書き」に化ける経路を断つ (空なら明示的に失敗させる)。
if (!req.email || !String(req.email).trim()) {
throw new Error('メールアドレスが必要です (対象の運営者を特定できません)');
}
var target = String(req.email).trim().toLowerCase();
if (target!== me) throw new Error('編集できるのは自分の行だけです');
if (target.slice(-DOMAIN_SUFFIX.length)!== DOMAIN_SUFFIX) {
throw new Error('@kikari.co.jp 以外のメールは保存できません');
}
return withLock_(function () {
var patch = { updated_at: nowIso_()};
if (req.display_name!== undefined) patch.display_name = String(req.display_name);
if (req.signature!== undefined) patch.signature = String(req.signature);
if (req.reply_to!== undefined) patch.reply_to = String(req.reply_to);
if (req.role!== undefined) patch.role = String(req.role);
// 追補23: 自動作成フラグは本人が自分の行だけ切り替えられる。ただし ON でも実行アカウントが
// 本人でない限り発火しない (tryAutoCreatePhoneAppointment_ のガード。FORM_SYSTEM.md 追補23)。
if (req.auto_calendar!== undefined) patch.auto_calendar = toBool_(req.auto_calendar);
// can_send の自己付与は不可 (管理者がシート側で付ける)。ここでは変更しない。
try {
updateRowByPk_('operators', target, patch);
return { saved: target, updated: true};
} catch (e) {
appendRow_('operators', {
email: target, display_name: patch.display_name || '', role: patch.role || 'sender',
signature: patch.signature || '', reply_to: patch.reply_to || '',
can_send: false, created_at: nowIso_(), updated_at: nowIso_()
});
return { saved: target, updated: false, note: '新規行を作成しました (can_send は管理者がシートで true にしてください)'};
}
});
}

// ===== テンプレート =====
/** FNV-1a 32bit ハッシュの16進8桁 (版キー用。暗号用途ではない) */
function fnv1aHash8_(text) {
  var s = String(text == null ? '' : text);
  var h = 0x811c9dc5;
  for (var i = 0; i < s.length; i++) {
    h = Math.imul(h ^ s.charCodeAt(i), 0x01000193);
  }
  return ('0000000' + (h >>> 0).toString(16)).slice(-8);
}

/**
 * テンプレ版キー (R4 レーンJ 項目1): <template_id>@<updated_at ISO>#<hash8(body)>。
 * updated_at だけではシート直接編集や同一秒の連続編集を区別できず、ハッシュだけでは
 * 同文の再保存を区別できないため複合を正とする。行が無い場合は adhoc#<hash8>。
 */
function templateVersionKey_(templateRow, bodyText) {
  var body = String(bodyText == null ? (templateRow ? templateRow.body : '') : bodyText);
  if (!templateRow) return 'adhoc#' + fnv1aHash8_(body);
  var updated = cellDateIso_(templateRow.updated_at) || str_(templateRow.updated_at);
  return str_(templateRow.template_id) + '@' + updated + '#' + fnv1aHash8_(body);
}

/**
 * 配信作成系から使う版の確定 (R4 レーンJ 項目1 (a) の解決規則)。
 * template_id 優先で templates 行を引き、配信に使う本文が行の body と一致すれば
 * その行の版キー。一致しない (画面で編集した派生文・カスタム文面) 場合は adhoc#<hash8>。
 * 本文が空で kind だけ分かる場合は行の body から作る。何も引けなければ版キーは空。
 * 戻り値: { template_id, template_version }
 */
function templateVersionFor_(req, bodyText) {
  req = req || {};
  var body = String(bodyText == null ? '' : bodyText);
  var rows = [];
  try { rows = readTable_('templates').rows; } catch (e) { rows = []; }
  var row = null, i;
  if (req.template_id) {
    for (i = 0; i < rows.length; i++) {
      if (String(rows[i].template_id) === String(req.template_id)) { row = rows[i]; break; }
    }
  }
  var kind = String(req.template_kind || req.kind || '');
  if (!row && kind) {
    for (i = 0; i < rows.length; i++) {
      if (String(rows[i].kind) === kind) { row = rows[i]; break; }
    }
    if (!row) {
      // 正規 kind で引けない場合は旧 kind (別名) でも引く
      var aliasKinds = Object.keys(TEMPLATE_KIND_ALIASES_).filter(function (k) {
        return TEMPLATE_KIND_ALIASES_[k] === kind || k === kind;
      });
      for (i = 0; i < rows.length && !row; i++) {
        if (aliasKinds.some(function (k) {
          return String(rows[i].kind) === TEMPLATE_KIND_ALIASES_[k] || String(rows[i].kind) === k;
        })) row = rows[i];
      }
    }
  }
  if (row) {
    if (body && body === str_(row.body)) {
      return { template_id: str_(row.template_id), template_version: templateVersionKey_(row, body) };
    }
    if (!body) {
      return { template_id: str_(row.template_id), template_version: templateVersionKey_(row, str_(row.body)) };
    }
    return { template_id: str_(row.template_id), template_version: 'adhoc#' + fnv1aHash8_(body) };
  }
  return { template_id: String(req.template_id || ''),
    template_version: body ? 'adhoc#' + fnv1aHash8_(body) : '' };
}

function actionGetTemplates_(req) {
var rows = readTable_('templates').rows.slice();
if (req.kind) rows = rows.filter(function (r) { return String(r.kind) === String(req.kind);});
// R4 レーンD 13-#1 修正1: 読み取り時の別名フォールバック。既存シートには旧 kind
// (sms_reply_detail 等) の行だけが残っている場合があるため、正規 kind の行が無ければ
// 旧 kind の行を正規 kind として返す (保存は正規名のみ。旧行は削除しない)。
Object.keys(TEMPLATE_KIND_ALIASES_).forEach(function (canonical) {
if (req.kind && String(req.kind) !== canonical) return;
if (rows.some(function (r) { return String(r.kind) === canonical;})) return;
var legacy = readTable_('templates').rows.filter(function (r) {
return String(r.kind) === TEMPLATE_KIND_ALIASES_[canonical];
})[0];
if (legacy) rows.push(Object.assign({}, legacy, { kind: canonical }));
});
return { templates: rows.map(function (r) {
return {
template_id: str_(r.template_id), kind: str_(r.kind), name: str_(r.name),
body: str_(r.body), updated_by: str_(r.updated_by), updated_at: cellDateIso_(r.updated_at),
version_key: templateVersionKey_(r, str_(r.body))
};
})};
}

function actionUpdateTemplate_(req) {
var me = requireKikariUser_();
if (!req.template_id &&!req.kind) throw new Error('template_id か kind が必要です');
// R4 レーンD 13-#1 修正4: サーバー側検証。kind ホワイトリスト (正規名のみで保存する)。
if (req.kind && TEMPLATE_KINDS_.indexOf(String(req.kind)) < 0) {
throw new Error('kind が不正です: ' + String(req.kind) + ' (使える kind: ' + TEMPLATE_KINDS_.join(' / ') + ')');
}
// body は改行正規化 + trim のうえで検証する (SPEC §1.4: 本文 6,000 字まで)。
var normalizedBody;
if (req.body!== undefined) {
normalizedBody = String(req.body).replace(/\r\n?/g, '\n').replace(/\u2028/g, '\n').replace(/\u2029/g, '\n').trim();
if (!normalizedBody) throw new Error('本文が空です (空のテンプレートは保存できません)');
if (normalizedBody.length > 6000) {
throw new Error('本文が長すぎます (' + normalizedBody.length + ' 字)。上限は 6,000 字です');
}
assertTemplateTagsAllowed_(normalizedBody, req.kind || '', 'テンプレート');
}
if (req.kind === 'sms_mode' && req.name!== undefined) {
var modeName = String(req.name);
if (modeName.length > 30 || /[\r\n]/.test(modeName)) {
throw new Error('sms_mode の名前は 30 字以内・改行なしで入力してください');
}
}
return withLock_(function () {
var t = readTable_('templates');
var target = null;
for (var i = 0; i < t.rows.length; i++) {
if ((req.template_id && String(t.rows[i].template_id) === String(req.template_id)) ||
(req.kind && String(t.rows[i].kind) === String(req.kind))) { target = t.rows[i]; break;}
}
// template_id 指定のみの更新でも、対象行の kind でタグ検証する (経路が変わらないように)。
if (normalizedBody!== undefined && !req.kind && target) {
assertTemplateTagsAllowed_(normalizedBody, str_(target.kind), 'テンプレート');
}
var patch = { updated_by: me, updated_at: nowIso_()};
if (req.name!== undefined) patch.name = String(req.name);
if (req.body!== undefined) patch.body = normalizedBody;
if (target) {
updateRowByPk_('templates', target.template_id, patch);
return { saved: target.template_id, updated: true};
}
var id = 'T' + Utilities.getUuid().substring(0, 8);
appendRow_('templates', {
template_id: id, kind: String(req.kind || ''), name: patch.name || '',
body: patch.body || '', updated_by: me, updated_at: patch.updated_at, created_at: nowIso_()
});
return { saved: id, updated: false};
});
}

// ===== 配信停止登録 =====
/**
* optouts テーブルへ追記し、applicants.mail_optout も true にする。
* 配信停止は optouts テーブル側を正として二重管理する:
* CSV 再取り込み (importCommit) は optouts を必ず参照し、mail_optout=true を
* 強制するため、CSV 側の値で停止が復活することはない。
* 呼び出し経路: (a) キカリユーザーの手動登録 (b) 配信停止フォームからの
* form_token 検証つき登録。どちらでもない場合は拒否する。
*/
function actionRegisterOptout_(req) {
var email = normalizeEmail_(req.email);
var applicantId = String(req.applicant_id || '');
var actor = 'form';
var me = currentUserEmail_();
if (me && me.slice(-DOMAIN_SUFFIX.length) === DOMAIN_SUFFIX) {
actor = me; // 手動登録
} else if (req.form_token) {
var rec = null;
var t = readTable_('delivery_recipients');
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i].form_token) === String(req.form_token)) { rec = t.rows[i]; break;}
}
if (!rec) throw new Error('無効なフォームトークンです');
email = normalizeEmail_(rec.email);
applicantId = str_(rec.applicant_id);
} else {
throw new Error('配信停止の登録にはキカリのアカウントか有効なフォームトークンが必要です');
}
if (!email) {
  // R3 (C5): メールアドレスの無い応募者は email キーでは登録できないため、
  // applicant_id / 電話番号キーでの登録を成立させる (従来は必ず例外になり、
  // フロントが成功表示する一方で停止が記録されなかった)。
  if (applicantId) {
    try { email = normalizeEmail_(findApplicant_(applicantId).email); } catch (e) { /* 見つからなければ applicant_id のみで登録 */ }
  } else if (req.phone) {
    var byPhoneHit = findApplicantByPhone_(String(req.phone));
    if (byPhoneHit) { applicantId = str_(byPhoneHit.applicant_id); email = normalizeEmail_(byPhoneHit.email); }
  }
  if (!applicantId) throw new Error('配信停止の対象を特定できません (email か applicant_id か phone が必要です)');
}
var channel = String(req.channel || 'mail');
var source = String(req.source || (actor === 'form'? 'form': 'manual'));
return withLock_(function () {
return registerOptoutCore_(email, applicantId, channel, source, actor);
});
}

/** 配信停止の実登録 (R4 O-02: ロックを取らない内部関数として切り出し)。
 * ロック取得済みの文脈から呼ぶこと。optouts へ追記し (重複は登録しない)、
 * 特定できれば applicants.mail_optout を立ててイベントを残す。 */
function registerOptoutCore_(email, applicantId, channel, source, actor) {
email = normalizeEmail_(email);
applicantId = str_(applicantId);
if (!applicantId && email) {
try {
var t2 = readTable_('applicants');
for (var j = 0; j < t2.rows.length; j++) {
if (normalizeEmail_(t2.rows[j].email) === email) { applicantId = str_(t2.rows[j].applicant_id); break;}
}
} catch (e) {}
}
var dupOpt = readTable_('optouts').rows.some(function (o) {
  if (email && normalizeEmail_(o.email) === email) return true;
  if (applicantId && str_(o.applicant_id) === applicantId) return true;
  return false;
});
if (!dupOpt) appendRow_('optouts', {
optout_id: nextId_('optouts'), email: email, applicant_id: applicantId,
channel: channel || 'mail', created_at: nowIso_(),
source: source || 'manual'
});
if (applicantId) {
try {
updateRowByPk_('applicants', applicantId, { mail_optout: true, updated_at: nowIso_()});
appendEvent_(applicantId, 'optout', actor, '配信停止登録 (' + (channel || 'mail') + ')', '', '');
} catch (e) { /* 応募者が特定できない場合も optouts への登録だけで停止は有効 */}
}
return { registered: email, applicant_id: applicantId, key_type: email ? 'email' : 'applicant_id', already_registered: dupOpt };
}

/** 保存済みメールアドレスの一括正規化 (R4 O-03・手動実行専用。dispatch には載せない)。
 * optouts.email と applicants.email を走査し、normalizeEmail_ と異なる行だけ書き換える。
 * 正規化後に衝突する applicants は自動統合せず、組を Logger に出して人手確認に回す。 */
function migrateNormalizeEmails_() {
var changed = { optouts: 0, applicants: 0 };
readTable_('optouts').rows.forEach(function (r) {
var em = normalizeEmail_(r.email);
if (em !== str_(r.email)) { updateRowByPk_('optouts', r.optout_id, { email: em }); changed.optouts++; }
});
var seen = {}, collisions = [];
readTable_('applicants').rows.forEach(function (r) {
var em = normalizeEmail_(r.email);
if (!em) return;
if (seen[em] && seen[em] !== str_(r.applicant_id)) collisions.push(seen[em] + ' / ' + str_(r.applicant_id) + ' (' + em + ')');
else seen[em] = str_(r.applicant_id);
if (em !== str_(r.email)) { updateRowByPk_('applicants', r.applicant_id, { email: em }); changed.applicants++; }
});
Logger.log('migrateNormalizeEmails_: changed=' + JSON.stringify(changed) + ' collisions=' + JSON.stringify(collisions));
return { changed: changed, collisions: collisions };
}
