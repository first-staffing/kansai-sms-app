    var added = 0, updated = 0, failedRows = 0, rowErrors = [];
    // 新規行の書き込みバッファ (200行ごとに appendRows_ で一括フラッシュ)
    var pendingNew = []; // {row, srcRow, sKey}
    var newCaseIds = [];
    function flushNew_() {
