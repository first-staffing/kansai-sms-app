      var okCount = 0;
      batch.forEach(function (p, i) {
        if (failedIdx[i]) {
          failedRows++;
          if (rowErrors.length < 5) rowErrors.push('案件の書き込みに失敗しました: ' + p.row.case_id);
          // 書けなかった行は索引から外す (後続行が実在しない行を更新対象にしない)
