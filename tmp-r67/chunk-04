  summary.sender_unknown_is_global = true;
  return summary;
}

function actionGetResponseSummary_(req) {
  requireKikariUser_(); // R3 (P2): actionGetResponses_ と同じ認証を必須にする
  var sender = String(req.sender_email || '');
  if (req.all_senders !== true && !sender) {
    var me = currentUserEmail_();
    if (me && me.slice(-DOMAIN_SUFFIX.length) === DOMAIN_SUFFIX) sender = me;
  }
  var allRows = readTable_('responses').rows;
  var rows = allRows.filter(function (r) {
    if (sender && String(r.sender_email).toLowerCase() !== sender.toLowerCase()) return false;
    return true;
  });
  return applyGlobalSenderUnknown_(computeResponseSummary_(rows), allRows);
}

/**
 * 3-stage status transition (supplement 20-2): unhandled / in_progress / handled.
 * handled mirror columns are kept in sync (handled=true <=> status=handled).
 * Who/when is recorded both on the row (status_by/status_at) and as an
 * applicant_events entry (response_handled for handled, response_status otherwise).
 */
function actionSetResponseStatus_(req) {
  var me = requireKikariUser_();
  var status = String(req.status || '');
  if (RESPONSE_STATUSES_.indexOf(status) < 0) {
    throw new Error('status は unhandled / in_progress / handled のいずれかです');
  }
  if (!req.response_id) throw new Error('response_id が必要です');
  return withLock_(function () {
    var resp = findRow_('responses', 'response_id', req.response_id);
    var previousStatus = responseStatus_(resp);
    // R4 04-05: 楽観ロック。expected が両方指定された場合のみ照合する
    // (未指定の旧経路は移行期間として許可し、イベントに記録する)。
    var hasExpected = !!(req.expected_status && req.expected_status_at);
    if (hasExpected) {
      if (previousStatus !== String(req.expected_status) ||
          cellDateIso_(resp.status_at) !== String(req.expected_status_at)) {
        throw new Error('CONFLICT: 現在は ' + previousStatus + ' (' +
          str_(resp.status_by) + ' / ' + cellDateIso_(resp.status_at) + ') です');
      }
    }
    var now = nowIso_();
    var patch = { status: status, status_by: me, status_at: now,
      handled: status === 'handled' };
    if (status === 'handled') { patch.handled_by = me; patch.handled_at = now; }
    else { patch.handled_by = ''; patch.handled_at = ''; } // R4 04-06: 両方向クリア
    updateRowByPk_('responses', req.response_id, patch);
    if (str_(resp.applicant_id)) {
      appendEvent_(str_(resp.applicant_id),
        status === 'handled' ? 'response_handled' : 'response_status', me,
        '回答ステータスを ' + status + ' に変更 response=' + req.response_id +
        (hasExpected ? '' : ' (expectedなし)'),
        str_(resp.delivery_id), req.response_id);
    }
    return { response_id: req.response_id, status: status, status_by: me,
      status_at: now, previous_status: previousStatus,
      handled: status === 'handled' };
  });
}

/** Legacy entry point: mark handled = setResponseStatus(handled). */
function actionMarkResponseHandled_(req) {
  var r = actionSetResponseStatus_({ response_id: req.response_id, status: 'handled' });
  return { handled: r.response_id, handled_by: r.status_by };
}

/**
 * Claim / assign a sender for a response (supplement 20 fallback flow).
 * Used for sender-unknown responses (generic URL): any kikari user can claim
 * it for themselves (default) or assign it to another kikari operator.
 */
function actionAssignResponseSender_(req) {
  var me = requireKikariUser_();
  if (!req.response_id) throw new Error('response_id が必要です');
  var target = String(req.sender_email || me).trim().toLowerCase();
  if (target.slice(-DOMAIN_SUFFIX.length) !== DOMAIN_SUFFIX) {
    throw new Error('割り当て先は @kikari.co.jp のメールアドレスです');
  }
  // R3 (P2): 割り当て先は登録済みの運営者に限る (未登録アドレスへの誤割当を防ぐ)
  if (!operatorByEmail_(target)) {
    throw new Error('割り当て先が運営者として登録されていません: ' + target);
  }
  return withLock_(function () {
    var resp = findRow_('responses', 'response_id', req.response_id);
    var prev = str_(resp.sender_email);
    // R3 (P2): 帰属済み (送信者が確定している) 回答は上書きしない。
    // 本来の用途は「送信元不明」への割り当てであり、帰属の付け替えは
    // 通知先・対応責任を黙って変えてしまうため拒否する。
    if (prev && prev.toLowerCase() !== target) {
      throw new Error('この回答には既に送信者が割り当てられています: ' + prev);
    }
    updateRowByPk_('responses', req.response_id, { sender_email: target });
    if (str_(resp.applicant_id)) {
      appendEvent_(str_(resp.applicant_id), 'response_assigned', me,
        '回答の送信元を割り当て: ' + (prev || '送信元不明') + ' -> ' + target +
        ' response=' + req.response_id,
        str_(resp.delivery_id), req.response_id);
    }
    // R4 04-02: 引き取り後に「未実行だった後処理」をやり直す (失敗しても
    // 引き取り自体は成功として返し、結果は戻り値で表面化させる)。
    // - 通知: 新しい送信者へ再送する (notify_status は sent_after_assign)。
    // - カレンダー自動作成: 再判定する。実行アカウントが新しい送信者と
    //   一致しない場合は executor_mismatch が返る (他人のカレンダーに作る
    //   方向へガードを緩めない)。
    var post = { notify: null, calendar_auto: null };
    try {
      var fresh = findRow_('responses', 'response_id', req.response_id);
      var nctx = buildResponseNotifyCtx_(fresh);
      nctx.afterAssign = true;
      var n = notifySenderOfResponse_(nctx);
      post.notify = { status: n.status, sent_to: n.sent_to };
    } catch (eN) { post.notify = { status: 'failed', detail: errMsg_(eN) }; }
    try {
      var fresh2 = findRow_('responses', 'response_id', req.response_id);
      post.calendar_auto = tryAutoCreatePhoneAppointment_(fresh2);
    } catch (eC) { post.calendar_auto = { created: false, reason: 'error', detail: errMsg_(eC) }; }
    return { response_id: req.response_id, sender_email: target,
      previous_sender_email: prev, notify: post.notify, calendar_auto: post.calendar_auto };
  });
}

/** 回答行から通知 ctx を再構築する (再送・引き取り後通知で共用。04-01/04-02) */
function buildResponseNotifyCtx_(row) {
  var attr = { sender_name: '', channel: '', delivery_created_at: '', mode: '' };
  try {
    var a = resolveDeliveryAttribution_(str_(row.delivery_id));
    attr.sender_name = a.sender_name; attr.channel = a.channel;
    attr.delivery_created_at = a.delivery_created_at; attr.mode = a.mode;
  } catch (e) {}
  var applicant = null;
  try { applicant = findApplicant_(str_(row.applicant_id)); } catch (e2) {}
  return {
    senderEmail: str_(row.sender_email),
    senderName: attr.sender_name,
    applicantId: str_(row.applicant_id),
    applicantName: applicant ? str_(applicant.name) : '',
    deliveryId: str_(row.delivery_id),
    deliveryCreatedAt: attr.delivery_created_at,
    deliveryMode: attr.mode,
    sourceChannel: str_(row.source_channel) || attr.channel,
    responseId: str_(row.response_id),
    intent: str_(row.intent),
    desiredStartDate: str_(row.desired_start_date),
    desiredTourDate: str_(row.desired_tour_date),
    selectedCaseIds: toList_(row.selected_case_ids),
    // R4 レーンJ 項目2: 旧行 (interview のみ) も読み替えて通知に載せる。
    phoneConsultDatetime: unifiedPhoneText_(row),
    // フォーム専用チーム (追補37/38): 再送・引き取り後通知でも構造化データを載せる。
    phoneDates: sanitizePhoneDates_(row.phone_dates),
    phoneBands: sanitizePhoneBands_(row.phone_bands),
    phoneAnytime: toBool_(row.phone_anytime),
    experience: str_(row.experience),
    experienceYears: (row.experience_years === '' || row.experience_years == null) ? '' : row.experience_years,
    experienceBand: str_(row.experience_band),
    experienceDetail: str_(row.experience_detail),
    desiredRateBand: str_(row.desired_rate_band),
    qualifications: str_(row.qualifications),
    freeText: str_(row.free_text),
    createdAt: cellDateIso_(row.created_at)
  };
}

/**
 * R4 04-01: 通知の再送。宛先は再送時点の operators 状態で再解決される。
 * 送信済み (sent かつ試行あり) の行は force:true が無ければ二重送信防止で止める。
 */
function actionResendResponseNotification_(req) {
  var me = requireKikariUser_();
  if (!req.response_id) throw new Error('response_id が必要です');
  return withLock_(function () {
    var row = findRow_('responses', 'response_id', req.response_id);
    if (!row) throw new Error('回答が見つかりません: ' + req.response_id);
    if (str_(row.notify_status) === 'sent' && (toNum_(row.notify_attempts) || 0) >= 1 &&
        req.force !== true) {
      throw new Error('この回答の通知は送信済みです。再送する場合は force を指定してください');
    }
    var ctx = buildResponseNotifyCtx_(row);
    ctx.resend = true;
    var n = notifySenderOfResponse_(ctx);
    return { response_id: req.response_id, notify_status: n.status,
      sent_to: n.sent_to, is_fallback: n.is_fallback, resent_by: me };
  });
}

/**
 * Issue an attributed form token from an app button (supplement 20-1/3).
 * Sending must start from an app button: this creates the delivery record
 * (sender = caller, applicant, channel sms/mail, campaign, presented cases)
 * plus the recipient row carrying the unguessable form_token, BEFORE the
 * sms: hand-off / mail send. Hand-typed messages cannot create attribution.
 * This action itself sends nothing.
 */
function actionIssueFormToken_(req) {
  var me = requireKikariUser_();
  var applicantId = String(req.applicant_id || '');
  if (!applicantId) throw new Error('applicant_id が必要です');
  var applicant = findApplicant_(applicantId);
  // R4 O-06: 配信停止中の人にはフォーム案内 (トークン+中継Push) を発行しない。
  if (smsBlockedReason_(applicant)) throw new Error('配信停止中のためフォーム案内は発行できません');
  var channel = String(req.channel || 'sms') === 'mail' ? 'mail' : 'sms';
  var caseIds = toList_(req.case_ids || req.selected_case_ids || req.presented_case_ids);
  if (!caseIds.length) {
    var n = channel === 'sms' ? SMS_RECOMMEND_DEFAULT : clampRecommendCount_(req.recommend_count);
    caseIds = recommendCasesFor_(applicant, openCases_(), n).map(function (c) { return c.case_id; });
  }
  var op = {};
  try { op = operatorByEmail_(me) || {}; } catch (e) { op = {}; }
  // R4 レーンJ 項目1 (c)2: 案内文面の版キー。文面が渡されていればその本文、
  // 無ければ templates 行の body から作る。req.template_version は素通しで記録する。
  var issueBodyText = String(req.body_snapshot || req.body_template || req.body || '');
  var issueTplVer = req.template_version
    ? { template_id: String(req.template_id || ''), template_version: String(req.template_version) }
    : templateVersionFor_({ template_id: req.template_id, template_kind: req.template_kind }, issueBodyText);
  var issued = withLock_(function () {
    var deliveryId = nextId_('deliveries');
    var now = nowIso_();
    appendRow_('deliveries', {
      delivery_id: deliveryId, sender_email: me,
      sender_name: str_(op.display_name), subject: '(フォーム案内リンク)',
      body_template: '', mode: 'per_person', recommend_count: caseIds.length,
      filter_json: JSON.stringify({ form_invite: true, channel: channel,
        campaign_id: String(req.campaign_id || '') }),
      target_count: 1, sent_count: 0, failed_count: 0,
      status: 'form_link', scheduled_at: '', created_by: me,
      created_at: now, started_at: '', finished_at: '',
      template_id: issueTplVer.template_id, template_version: issueTplVer.template_version
    });
    var token = Utilities.getUuid() + Utilities.getUuid().replace(/-/g, '');
    appendRow_('delivery_recipients', {
      delivery_id: deliveryId, applicant_id: applicantId, email: str_(applicant.email),
      recommended_case_ids: caseIds.join(','),
      status: 'form_link', error: '', sent_at: '',
      form_token: token, created_at: now, updated_at: now,
      // R4 S-07: 発行記録ではスナップショットを作らない (未送信なのに提示実績の
      // 写しが残る問題の解消)。写しは SMS 記録がこの delivery_id を伴って来た
      // 時点で actionRecordSmsSent_ が実績ベースで書く。ここでは提示予定の
      // 案件 ID (recommended_case_ids) と form_token だけを保持する。
      cases_snapshot: '',
      body_snapshot: '',
      template_version: issueTplVer.template_version
    });
    return { delivery_id: deliveryId, form_token: token,
      form_url: formUrlForToken_(token),
      sender_email: me, sender_name: str_(op.display_name),
      channel: channel, case_ids: caseIds };
  });
  try {
    relayPushContextForToken_(issued.form_token);
  } catch (e) {
    Logger.log('relay push (issueFormToken) failed: ' + errMsg_(e));
  }
  return issued;
}

// ===== カレンダー連携: 電話アポ登録 (追補21) =====
// 前提: Web App A は「アクセスしたユーザーとして実行」なので、
// CalendarApp.getDefaultCalendar() は実行した運営者本人のカレンダーを指す。
// そのため共有設定なしで全運営者が各自のカレンダーへ登録できる。
// タイトルは必ず【電話アポ】で始める。既存の【面談】パイプライン
// (カレンダーの【面談】イベントを起点に動く tour 系ジョブ) と衝突させないため、
// 【面談】とは決して名付けない。
var PHONE_APPOINTMENT_DEFAULT_HOUR_ = 10;   // 時刻が特定できない場合の既定開始時刻 (JST)
var PHONE_APPOINTMENT_DEFAULT_MINUTE_ = 0;
var PHONE_APPOINTMENT_DURATION_MIN_ = 15;   // 電話アポの所要時間 (現行の電話アポ15分に合わせる)

/**
 * 「面談希望あり」の定義 (追補21): お電話できる日時 (unifiedPhoneText_:
 * phone_consult_datetime 優先、旧行は interview_desired_date を読み替え) が
 * 入っていること。この定義は createPhoneAppointment / responseItem_ /
 * computeResponseSummary_ / 通知メールのカレンダー導線で共通に使う (判定点は本関数のみ)。
 */
/**
 * 電話希望の統一読み取り (R4 レーンJ 項目2): 正は phone_consult_datetime。
 * interview_desired_date は新規書き込みを停止した互換列であり、旧行 (interview のみ)
 * はここで読み替える。既存行の書き換え migration は行わない。
 */
function unifiedPhoneText_(r) {
  if (!r) return '';
  var p = str_(r.phone_consult_datetime);
  if (p.trim()) return p;
  return str_(r.interview_desired_date);
}

function responseHasInterviewWish_(r) {
  if (!r) return false;
  return !!unifiedPhoneText_(r).trim();
}

/** 自由入力テキストから時刻 (HH:MM) を抽出する。抽出できなければ null */
function extractTimeHm_(text) {
  var t = str_(text);
  if (!t) return null;
  var isPm = t.indexOf('午後') >= 0;
  var m = t.match(/(\d{1,2})[:：](\d{2})/);
  if (!m) m = t.match(/(\d{1,2})時(?:(\d{1,2})分)?/);
  if (!m) return null;
  var hour = parseInt(m[1], 10), minute = m[2] ? parseInt(m[2], 10) : 0;
  if (isPm && hour < 12) hour += 12;
  if (hour > 23 || minute > 59) return null;
  return { hour: hour, minute: minute };
}

/**
 * 回答行から電話アポの開始日時を作る。
 * 日付・時刻とも unifiedPhoneText_ (phone 優先・interview 互換) の1本から取る。
 * 完全表記 (YYYY-MM-DD / YYYY/MM/DD) を優先し、無ければ
 * parsePhoneConsultHint_ (M月D日・明日 等、回答日基準) で日付ヒントを取る。
 * 時刻が無ければ既定 10:00 (JST) とする。
 * 既定時刻の扱い (明記): 終日予定にはしない。電話アポは「その時刻に電話する」
 * 対応であり、終日予定ではリマインドも当日の対応順も定まらないため、
 * 時刻が無くても 10:00 開始・15分 の時間指定予定として作る。
 * 日付自体を特定できない場合は null を返す (呼び出し側でエラーにする)。
 */
function parseAppointmentStart_(r) {
  var baseYmd = cellDateYmd_(r && r.created_at) || todayYmd_();
  // フォーム専用チーム (追補37): 構造化された幅があれば「最も早い日付 ×
  // 最も早い時間帯の開始時刻」で開始時刻を決める (テキスト解釈は使わない)。
  if (r) {
    var sDates = sanitizePhoneDates_(r.phone_dates);
    var sBands = sanitizePhoneBands_(r.phone_bands);
    if (sDates.length) {
      var sHour = sBands.length ? phoneBandDef_(sBands[0]).startHour
        : PHONE_APPOINTMENT_DEFAULT_HOUR_;
      var sStart = new Date(sDates[0] + 'T' + ('0' + sHour).slice(-2) + ':00:00+09:00');
      if (!isNaN(sStart.getTime())) {
        return { start: sStart,
          end: new Date(sStart.getTime() + PHONE_APPOINTMENT_DURATION_MIN_ * 60000),
          ymd: sDates[0], has_explicit_time: sBands.length > 0 };
      }
    }
  }
  // R4 レーンJ 項目2: 候補は統一読み取り (phone 優先・interview 互換) の1本にする。
  var unified = r ? unifiedPhoneText_(r) : '';
  var candidates = [unified];
  var ymd = '';
  for (var i = 0; i < candidates.length; i++) {
    var v = candidates[i];
    if (v == null || v === '') continue;
    if (v instanceof Date) { ymd = cellDateYmd_(v); if (ymd) break; continue; }
    var t = str_(v);
    var m = t.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
    if (m) { ymd = m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2); break; }
    var hint = parsePhoneConsultHint_(t, baseYmd);
    if (hint) { ymd = hint; break; }
  }
  if (!ymd) return null;
  var hm = extractTimeHm_(unified);
  var hasExplicitTime = !!hm;
  if (!hm) hm = { hour: PHONE_APPOINTMENT_DEFAULT_HOUR_, minute: PHONE_APPOINTMENT_DEFAULT_MINUTE_ };
  var hh = ('0' + hm.hour).slice(-2), mm = ('0' + hm.minute).slice(-2);
  var start = new Date(ymd + 'T' + hh + ':' + mm + ':00+09:00');
  if (isNaN(start.getTime())) return null;
  var end = new Date(start.getTime() + PHONE_APPOINTMENT_DURATION_MIN_ * 60000);
  return { start: start, end: end, ymd: ymd, has_explicit_time: hasExplicitTime };
}

/**
 * 電話アポを運営者本人の Google カレンダーへ登録する (要ドメイン認証)。
 * req: { response_id }
 * 冪等性: responses.calendar_event_id が既に入っていれば予定を作り直さず、
 * 既存の event_id を already_registered:true で返す (再実行しても二重登録しない)。
 * 登録先は実行ユーザーの既定カレンダー (Web App A = アクセスユーザー実行)。
 */
function createPhoneAppointmentCore_(resp, registeredBy, actor, eventType) {
  {
    var req = { response_id: str_(resp.response_id) };
    var existingId = str_(resp.calendar_event_id);
    if (existingId) {
      // F-06 (堅牢化): 保存済み ID の実在確認を試みる。カレンダー側で手動削除
      // されていた場合は ID をクリアして下で作り直す。取得 API が使えない
      // 環境 (スタブ等) や取得自体が失敗した場合は、確認できないので従来どおり
      // 登録済みとして扱う (誤って二重作成するより安全な側に倒す)。
      var existingEvent = null, existenceChecked = false;
      try {
        var calForCheck = CalendarApp.getDefaultCalendar();
        if (calForCheck && typeof calForCheck.getEventById === 'function') {
          existingEvent = calForCheck.getEventById(existingId); existenceChecked = true;
        } else if (typeof CalendarApp.getEventById === 'function') {
          existingEvent = CalendarApp.getEventById(existingId); existenceChecked = true;
        }
      } catch (checkErr) { existenceChecked = false; }
      if (!existenceChecked || existingEvent) {
        return { response_id: req.response_id, calendar_event_id: existingId,
          calendar_registered_by: str_(resp.calendar_registered_by),
          calendar_registered_at: cellDateIso_(resp.calendar_registered_at),
          already_registered: true, calendar_existence_checked: existenceChecked };
      }
      try {
        updateRowByPk_('responses', req.response_id,
          { calendar_event_id: '', calendar_registered_by: '', calendar_registered_at: '' });
      } catch (clearErr) { /* クリア失敗でも作り直しは試みる (下の保存で上書きされる) */ }
      resp = Object.assign({}, resp, { calendar_event_id: '' });
    }
    if (!responseHasInterviewWish_(resp)) {
      throw new Error('お電話できる日時 (phone_consult_datetime) が無い回答ではカレンダー登録できません');
    }
    var parsed = parseAppointmentStart_(resp);
    if (!parsed) {
      throw new Error('お電話できる日時から日時を特定できませんでした (原文: ' +
        unifiedPhoneText_(resp) + ')');
    }
    var applicant = null;
    try { applicant = findApplicant_(resp.applicant_id); } catch (e) { applicant = null; }
    var applicantName = applicant ? str_(applicant.name) : '';
    // Title must start with 【電話アポ】 (never 【面談】: avoids the tour pipeline).
    var title = '【電話アポ】' + (applicantName || '(氏名なし)') + '様（電話面談）';
    // Description: job-seeker info (name / phone / desired conditions /
    // selected cases / link to the applicant card).
    var wishes = [];
    var desiredStart = cellDateYmd_(resp.desired_start_date) || cellDateYmd_(resp.available_start_date);
    if (desiredStart) wishes.push('入職希望日: ' + desiredStart);
    if (str_(resp.qualifications)) wishes.push('資格: ' + str_(resp.qualifications));
    if (resp.experience_years !== '' && resp.experience_years != null) wishes.push('経験年数: ' + resp.experience_years + '年');
    else if (str_(resp.experience)) wishes.push('経験: ' + str_(resp.experience));
    // フォーム専用チーム (追補38): 経験帯・希望時給・経験の内容も希望条件に載せる。
    if (str_(resp.experience_band)) wishes.push('経験帯: ' +
      (EXPERIENCE_BAND_LABELS_[str_(resp.experience_band)] || str_(resp.experience_band)));
    if (str_(resp.desired_rate_band)) wishes.push('希望時給: ' + str_(resp.desired_rate_band));
    if (str_(resp.experience_detail)) wishes.push('経験の内容: ' + str_(resp.experience_detail));
    // 追補39: 見学希望日は複数日 (カンマ区切り) のまま扱う (単日に確定しない)。
    var tourYmd = cellDateYmd_(resp.desired_tour_date) || str_(resp.desired_tour_date);
    if (tourYmd) wishes.push('見学希望日: ' + tourYmd);
    var lines = [];
    lines.push('氏名: ' + (applicantName || '(氏名なし)'));
    lines.push('電話番号: ' + (applicant ? (str_(applicant.phone) || '(未登録)') : '(応募者特定不可)'));
    lines.push('希望条件: ' + (wishes.length ? wishes.join(' / ') : '(未入力)'));
    lines.push('選んだ案件: ' + selectedCaseLabels_(toList_(resp.selected_case_ids)));
    lines.push('お電話できる日時: ' + (unifiedPhoneText_(resp) || '(未入力)'));
    // フォーム専用チーム (追補37): 選択した幅の全体を説明欄にも保持する
    // (予定は最も早い組合せで作るが、候補の全幅が担当者に見えるように)。
    var phoneStructDesc = phoneStructuredText_(resp);
    if (phoneStructDesc) lines.push('お電話できる日時（選択内容）: ' + phoneStructDesc);
    if (!parsed.has_explicit_time) lines.push('※ 希望時刻の指定が無かったため既定の10:00で登録しています');
    if (str_(resp.free_text)) lines.push('自由記述: ' + str_(resp.free_text));
    lines.push('本人カード: ' + applicantCardUrl_(str_(resp.applicant_id)));
    lines.push('回答詳細: ' + responseFocusUrl_(req.response_id));
    lines.push('回答ID: ' + req.response_id);
    var calendar = CalendarApp.getDefaultCalendar();
    if (!calendar) throw new Error('既定のカレンダーを取得できませんでした');
    var event = calendar.createEvent(title, parsed.start, parsed.end,
      { description: lines.join('\n') });
    var eventId = event && event.getId ? String(event.getId()) : '';
    if (!eventId) throw new Error('カレンダー予定の作成に失敗しました (event id が返りませんでした)');
    var now = nowIso_();
    // F-06 窓(1) への補償: 予定作成後にシート記録が失敗すると ID が残らず、
    // 再試行で二重予定ができる。その場合は作った予定を削除してから失敗を返し、
    // 「予定だけが残って ID が無い」状態を作らない (削除も失敗したら元の例外を返す)。
    try {
      updateRowByPk_('responses', req.response_id, {
        calendar_event_id: eventId, calendar_registered_by: registeredBy, calendar_registered_at: now,
        calendar_auto_failed: '' // 登録できたら自動作成失敗フラグはクリアする (追補23)
      });
    } catch (saveErr) {
      try { if (event && typeof event.deleteEvent === 'function') event.deleteEvent(); } catch (delErr) {}
      throw saveErr;
    }
    if (str_(resp.applicant_id)) {
      appendEvent_(str_(resp.applicant_id), eventType, actor,
        '電話アポをカレンダー登録: ' + title + ' event=' + eventId +
        ' response=' + req.response_id, str_(resp.delivery_id), req.response_id);
    }
    return { response_id: req.response_id, calendar_event_id: eventId,
      calendar_registered_by: registeredBy, calendar_registered_at: now,
      already_registered: false, title: title,
      start: parsed.start.toISOString(), end: parsed.end.toISOString() };
  }
}

