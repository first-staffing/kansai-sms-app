    // 内訳 + 行失敗) を含む。フロントはこれを集計してプレビューと突合する。
    return { batch_id: batchId, row_count: rows.length, added: added, updated: updated, skipped: skipped,
      attr_updated: attrUpdated,
      failed: failedRows, status: finalStatus, row_errors: rowErrors,
      coord_downgraded: coordDowngraded, coord_reasons: coordReasons,
