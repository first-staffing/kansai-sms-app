  // 自配信の送信実績だけではブロックしない (再試行・回収行を自分で止めないため)。
  if (opts && opts.sent_today_map) {
    var sentFrom = opts.sent_today_map[str_(applicant.applicant_id)] || [];
    var ownDeliveryId = str_(opts.delivery_id || '');
    var blockedToday = sentFrom.some(function (did) { return !did || did !== ownDeliveryId; });
    if (blockedToday) return '本日すでに送信済みのため送信しません';
  }
  var ageV = ageFromBirth_(applicant.birth_date);
  if (ageV != null && ageV > MAIL_TARGET_MAX_AGE) return '年齢上限 (62歳) を超えるため送信しません';
  if (isTestApplicant_(applicant)) {
    var isTestDelivery = false;
    try { isTestDelivery = !!recEmail && recEmail === String(testSendEmail_()).toLowerCase(); } catch (e) {}
    if (!isTestDelivery) return 'テスト求職者のため送信しません';
  }
  return '';
}

/**
 * 送信キューの処理。呼び出し経路は2つ:
 *  (a) 時間トリガー (引数 = トリガーイベント。batch_limit は無いので既定上限)
 *  (b) 画面からのバッチ送信 (actionSendNextBatch_ 経由で { batch_limit: 25 })
 * どちらでも「送信対象は sender_email が実行ユーザー本人の行だけ」という
 * 帰属仕様は同じ。画面を閉じれば (b) は止まるが、キューの状態はサーバーに
 * 残るため、次に開いたとき getSendQueueStats / sendNextBatch で再開できる。
 */
/**
 * 送信トリガーの自動設置 (ベストエフォート / R3 方式変更)。
 * 主経路は「画面からのバッチ送信」(actionSendNextBatch_) であり、トリガーは
 * 必須ではない。運営者 (can_send) の API 利用時に、実行ユーザーとして
 * processSendQueue の時間トリガーが無ければ設置を試みる。失敗しても
 * 無言で継続し (画面方式で送信は成立する)、成否は Script Properties に
 * 記録して getSendQueueStats の trigger_auto で本人に見えるようにする。
 * 再試行は24時間に1回まで (失敗の連打防止)。
 * 制約: Web App の「アクセスユーザーとして実行」文脈での ScriptApp は、
 * そのユーザーがプロジェクトの編集者である場合にのみトリガーを作れる。
 * 本プロジェクトの運営者4名は全員編集者として共有済みのため設置できる
 * 見込みだが、保証はされない — だからこそ必須にはしない。
 */
function maybeInstallSendTrigger_() {
  var me = '';
  try { me = currentUserEmail_(); } catch (e) { return { attempted: false }; }
  if (!me) return { attempted: false };
  try {
    var op = operatorByEmail_(me);
    if (!op || !toBool_(op.can_send)) return { attempted: false };
    var props = PropertiesService.getScriptProperties();
    var key = 'TRIGGER_AUTO_' + me;
    var prev = {};
    try { prev = JSON.parse(props.getProperty(key) || '{}'); } catch (e) { prev = {}; }
    if (prev.installed) return { attempted: false, installed: true };
    var nowMs = new Date().getTime();
    if (prev.attempt_at && nowMs - prev.attempt_at < 24 * 3600 * 1000) {
      return { attempted: false, installed: false, error: String(prev.error || '') };
    }
    var exists = false;
    ScriptApp.getProjectTriggers().forEach(function (t) {
      try { if (t.getHandlerFunction && t.getHandlerFunction() === 'processSendQueue') exists = true; } catch (e) {}
    });
    if (!exists) {
      ScriptApp.newTrigger('processSendQueue').timeBased().everyMinutes(5).create();
    }
    props.setProperty(key, JSON.stringify({ installed: true, attempt_at: nowMs, via: exists ? 'existing' : 'auto' }));
    return { attempted: true, installed: true };
  } catch (err) {
    try {
      PropertiesService.getScriptProperties().setProperty('TRIGGER_AUTO_' + me,
        JSON.stringify({ installed: false, attempt_at: new Date().getTime(), error: errMsg_(err) }));
    } catch (e2) {}
    return { attempted: true, installed: false, error: errMsg_(err) };
  }
}

/** getSendQueueStats 用: トリガー自動設置の状態 (本人の分のみ)。 */
function triggerAutoStatus_() {
  var me = '';
  try { me = currentUserEmail_(); } catch (e) { return null; }
  if (!me) return null;
  var st = { installed: false, attempted: false };
  try {
    var raw = PropertiesService.getScriptProperties().getProperty('TRIGGER_AUTO_' + me);
    if (raw) {
      var p = JSON.parse(raw);
      st.installed = !!p.installed;
      st.attempted = !!p.attempt_at;
      if (p.error) st.error = String(p.error);
      if (p.attempt_at) st.attempt_at = new Date(p.attempt_at).toISOString();
    }
  } catch (e) {}
  st.note = '送信の主経路は画面からのバッチ送信です。トリガーは補助 (未送信分の自動再開) で、無くても送信できます。';
  return st;
}

/**
 * 画面からのバッチ送信 (R3 方式変更: 施設メール配信と同じ方式)。
 * 1回の呼び出しで最大 batch_size 件 (既定25・上限50) を自分のキューから送り、
 * 進捗 (今回の送信結果 + 残り件数 + キュー統計) を返す。フロントは
 * remaining が 0 になるまで繰り返し呼び、中断ボタンで止める。
 * 実行はアクセスユーザーとして走るため、送信はその人の Gmail から行われ、
 * 送信済みフォルダにも残る。
 */
function actionSendNextBatch_(req) {
  requireKikariUser_();
  var size = parseInt(req && req.batch_size, 10);
  if (!(size > 0)) size = 25;
  size = Math.min(50, Math.max(1, size));
  maybeInstallSendTrigger_();
  var res = processSendQueue({ batch_limit: size });
  var out = Object.assign({}, res);
  out.stats = actionGetSendQueueStats_({});
  return out;
}

function processSendQueue(e) {
  var batchLimit = (e && typeof e.batch_limit === 'number' && e.batch_limit > 0)
    ? Math.floor(e.batch_limit) : 0;
  // R4 O-05(3): 送信直前に中継の未取り込み分 (特に配信停止) を取り込む。
  // Pull は1分トリガーでも回っているが、停止が届いた直後の送信で競合する
  // 窓を塞ぐ。失敗しても送信は止めない (fail-open)。relay 未配置の環境
  // (code_additions.gs 未導入) では typeof ガードで素通りする。
  try {
    if (typeof relayPullResponses === 'function' && relayEnabled_()) {
      relayPullResponses();
    }
  } catch (pullErr) {
    try { Logger.log('processSendQueue: 送信前 Pull に失敗 (送信は継続): ' + errMsg_(pullErr)); } catch (e2) {}
  }
  var me = currentUserEmail_();
  if (!me || me.slice(-DOMAIN_SUFFIX.length) !== DOMAIN_SUFFIX) {
    Logger.log('processSendQueue: 実行者が @kikari.co.jp ではないため終了 (' + (me || '不明') + ')');
    return { sent: 0, skipped: 'not_kikari_user' };
  }
  var quota = Math.min(remainingMailQuota_(), GMAIL_DAILY_HARD_CAP);
  if (quota <= 0) return { sent: 0, skipped: 'quota_exhausted' };

  // F-01/F-02: サマリには復旧・再試行・諦め・後処理失敗の件数も含め、
  // 宙吊りや記録失敗が「件数で分かる」形にする。
  var result = { sent: 0, failed: 0, recovered: 0, recovered_as_sent: 0, retried: 0,
    gave_up: 0, stale_sending_kept: 0, claim_errors: 0, recovery_errors: 0,
    post_errors: 0, post_error_details: [] };
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return { sent: 0, skipped: 'locked' };
  try {
    var nowMs = new Date().getTime();
    recoverStaleSending_(me, nowMs, result);

    var myRows = readTable_('send_queue').rows.filter(function (q) {
      return String(q.sender_email).toLowerCase() === me;
    });
    myRows.forEach(function (q) {
      if (String(q.status) === 'failed' && (toNum_(q.try_count) || 0) >= QUEUE_MAX_TRY_COUNT) result.gave_up++;
    });
    function due_(q) {
      var sc = cellDateIso_(q.scheduled_at);
      return !sc || new Date(sc).getTime() <= nowMs;
    }
    var dueRows = myRows.filter(function (q) {
      if (!due_(q)) return false;
      if (String(q.status) === 'waiting') return true;
      // F-02: failed は try_count が上限未満の間だけ再試行対象に含める
      if (String(q.status) === 'failed') return (toNum_(q.try_count) || 0) < QUEUE_MAX_TRY_COUNT;
      return false;
    });
    var dueCount = dueRows.length;
    var processedCount = 0; // claim まで進んだ件数 (remaining の算出用)
    var queue = dueRows.sort(function (a, b) {
      var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
      return x < y ? -1 : (x > y ? 1 : 0);
    }).slice(0, Math.min(quota, QUEUE_BATCH_LIMIT, batchLimit > 0 ? batchLimit : QUEUE_BATCH_LIMIT));

    var deliveriesCache = {};
    var queueOptoutSet = optoutEmailSet_();
    // R4 01-#10 / 11-#3: バッチ内で1回だけ構築する (行ごとの読み直しはしない)。
    var queueSentTodayMap = mailSentTodayMap_();
    // R4 I-2: 回答キュー対応中の集合もバッチ冒頭で1回だけ作る。
    var queueRespInProgressIds = responseTargetSets_().in_progress;
    var queueCaseOpenMap = {};
    try {
      readTable_('cases').rows.forEach(function (c) {
        queueCaseOpenMap[str_(c.case_id)] = toBool_(c.is_open);
      });
    } catch (eCaseMap) {}
    queue.forEach(function (q) {
      var isRetry = String(q.status) === 'failed';
      // claim (先行更新) 自体の失敗も行ごとに隔離し、残りを止めない。
      try {
        updateRowByPk_('send_queue', q.queue_id,
          { status: 'sending', try_count: (toNum_(q.try_count) || 0) + 1, updated_at: nowIso_() });
      } catch (claimErr) {
        result.claim_errors++;
        if (result.post_error_details.length < 10) {
          result.post_error_details.push('claim ' + q.queue_id + ': ' + errMsg_(claimErr));
        }
        return;
      }
      processedCount++;
      if (isRetry) result.retried++;
      try {
        var delivery = deliveriesCache[q.delivery_id] ||
          (deliveriesCache[q.delivery_id] = findRow_('deliveries', 'delivery_id', q.delivery_id));
        var recipient = findRecipient_(q.delivery_id, q.applicant_id);
        var applicant = findApplicant_(q.applicant_id);
        // R3 Z4: 送信直前の再チェック (optout / terminal 終了系 / age 上限 / test)。
        // 作成時点では対象でも、実行までに 配信停止・終了系 になった行は送らない。
        // R3 検証 #4: 対応中への状態変化も再チェックする。作成時の include_active は
        // 配信の filter_json に保存してあるので、配信ごとに読み取って渡す。
        var sendOpts = { include_active: false, sent_today_map: queueSentTodayMap, delivery_id: str_(q.delivery_id),
          response_in_progress_ids: queueRespInProgressIds, include_response_in_progress: false };
        try {
          var fjq = JSON.parse(str_(delivery && delivery.filter_json) || '{}');
          sendOpts.include_active = fjq.include_active === true;
          sendOpts.include_response_in_progress = fjq.include_response_in_progress === true;
        } catch (eFj) {}
        var skipReason = sendTimeExclusionReason_(applicant, recipient, queueOptoutSet, sendOpts);
        // R4 11-#3: 送信直前に案件の募集状態を再判定する。終了した案件は本文から
        // 除き (recipient の複製を渡す。保存済みの写しは変えない)、おすすめが
        // すべて終了していたら送らない。same_body 等でおすすめを使わない配信
        // (recommended_case_ids が空) は対象外。
        var sendRecipient = recipient;
        var closedCaseIds = [];
        if (!skipReason) {
          var recIds0 = toList_(recipient.recommended_case_ids);
          if (recIds0.length) {
            var validIds = recIds0.filter(function (cid) { return queueCaseOpenMap[cid] === true; });
            closedCaseIds = recIds0.filter(function (cid) { return queueCaseOpenMap[cid] !== true; });
            if (!validIds.length) {
              skipReason = 'おすすめ案件がすべて募集終了のため送信しません';
            } else if (closedCaseIds.length) {
              sendRecipient = Object.assign({}, recipient, { recommended_case_ids: validIds.join(',') });
            }
          }
        }
        if (skipReason) {
          result.skipped_excluded = (result.skipped_excluded || 0) + 1;
          queuePostStep_(result, 'queue->skipped ' + q.queue_id, function () {
            updateRowByPk_('send_queue', q.queue_id, { status: 'skipped', updated_at: nowIso_() });
          });
          queuePostStep_(result, 'recipient->skipped ' + q.queue_id, function () {
            updateRecipientStatus_(q.delivery_id, q.applicant_id, { status: 'skipped', error: skipReason });
          });
          queuePostStep_(result, 'event mail_skipped ' + q.queue_id, function () {
            appendEvent_(q.applicant_id, 'mail_skipped', me,
              'Gmail配信 ' + q.delivery_id + ' を送信しませんでした: ' + skipReason, q.delivery_id, '');
          });
          queuePostStep_(result, 'bump skipped ' + q.queue_id, function () {
            // 初回は failed 側に数えて配信を完了判定に進める。再試行行は加算済みのため 0 で状態だけ再計算する。
            bumpDeliveryCounts_(q.delivery_id, 0, isRetry ? 0 : 1);
          });
          return;
        }
        var op = operatorByEmail_(me) || {};
        var body = buildMailBody_(delivery, applicant, sendRecipient, op);
        // R4 レーンD 13-#5: 件名にも expandTemplate_ を適用してから残存検査し、
        // 展開後の件名を GmailApp へ渡す (従来は delivery.subject が無展開で送られていた)。
        var subjectUrls = mailUrlsForRecipient_(sendRecipient, deliveryIncludeForm_(delivery));
        var subject = expandTemplate_(str_(delivery.subject), applicant, sendRecipient,
          subjectUrls.formUrl, subjectUrls.optoutUrl, op);
        assertNoLeftoverTags_(subject, '件名');
        var options = {};
        if (str_(op.reply_to)) options.replyTo = str_(op.reply_to);
        if (str_(op.display_name)) options.name = str_(op.display_name);
        GmailApp.sendEmail(str_(recipient.email), subject, body, options);

        // 送信成功。ここからの記録処理は1つずつ隔離し (F-01)、失敗しても
        // 送信済みの行を failed に倒さない・残りの行を止めない。
        result.sent++;
        var sentAt = nowIso_();
        queuePostStep_(result, 'queue->sent ' + q.queue_id, function () {
          updateRowByPk_('send_queue', q.queue_id, { status: 'sent', sent_at: sentAt, updated_at: sentAt });
        });
        queuePostStep_(result, 'recipient->sent ' + q.queue_id, function () {
          updateRecipientStatus_(q.delivery_id, q.applicant_id, { status: 'sent', sent_at: sentAt, error: '' });
        });
        queuePostStep_(result, 'recipient snapshot ' + q.queue_id, function () {
          // 実際に送った全文を body_snapshot として確定させる (写しのため以後不変)。
          // cases_snapshot は配信作成時の写しが正なので、無い場合だけここで補う。
          // R4 S-06: 実文で上書きするのと同時に確定フラグを立てる (仮文面との区別)。
          var patch = { body_snapshot: snapshotBody_(body), snapshot_finalized: 1 };
          if (!str_(recipient.cases_snapshot)) {
            patch.cases_snapshot = buildCasesSnapshot_(toList_(recipient.recommended_case_ids));
          }
          updateRecipientStatus_(q.delivery_id, q.applicant_id, patch);
        });
        queuePostStep_(result, 'event mail_sent ' + q.queue_id, function () {
          appendEvent_(q.applicant_id, 'mail_sent', me,
            'Gmail配信 ' + q.delivery_id + ' / ' + subject +
            (closedCaseIds.length ? ' (募集終了のため除外した案件: ' + closedCaseIds.join(',') + ')' : ''), q.delivery_id, '');
        });
        queuePostStep_(result, 'bump sent ' + q.queue_id, function () {
          // 再試行で成功した行は、前回加算済みの failed_count を取り消してから sent を加算する
          bumpDeliveryCounts_(q.delivery_id, 1, isRetry ? -1 : 0);
        });
      } catch (err) {
        // 送信 (または送信前の参照解決) の失敗。後処理も1つずつ隔離し、
        // 後処理の例外で forEach の外へ伝播させない (F-01: 監査シナリオA)。
        result.failed++;
        queuePostStep_(result, 'queue->failed ' + q.queue_id, function () {
          updateRowByPk_('send_queue', q.queue_id, { status: 'failed', updated_at: nowIso_() });
        });
        queuePostStep_(result, 'recipient->failed ' + q.queue_id, function () {
          updateRecipientStatus_(q.delivery_id, q.applicant_id, { status: 'failed', error: errMsg_(err) });
        });
        queuePostStep_(result, 'bump failed ' + q.queue_id, function () {
          // 再試行の再失敗は failed_count を二重加算しない (初回失敗で加算済み)
          if (!isRetry) bumpDeliveryCounts_(q.delivery_id, 0, 1);
        });
      }
    });
    // 画面バッチ送信の進捗表示用: この実行で処理しきれなかった到期分と、
    // 予約分も含む waiting の総数を返す。
    result.remaining = Math.max(0, dueCount - processedCount);
    result.waiting_total = myRows.filter(function (q) { return String(q.status) === 'waiting'; }).length;
    result.batch_limit_applied = batchLimit > 0 ? batchLimit : QUEUE_BATCH_LIMIT;
    return result;
  } finally {
    lock.releaseLock();
  }
}

function findRow_(tableName, key, value) {
var t = readTable_(tableName);
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i][key]) === String(value)) return t.rows[i];
}
throw new Error(tableName + ' に ' + key + '=' + value + ' が見つかりません');
}

function findRecipient_(deliveryId, applicantId) {
var t = readTable_('delivery_recipients');
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i].delivery_id) === String(deliveryId) &&
String(t.rows[i].applicant_id) === String(applicantId)) return t.rows[i];
}
throw new Error('delivery_recipients が見つかりません: ' + deliveryId + '/' + applicantId);
}

function updateRecipientStatus_(deliveryId, applicantId, patch) {
var r = findRecipient_(deliveryId, applicantId);
var sh = sheet_('delivery_recipients');
var headers = readTable_('delivery_recipients').headers;
patch.updated_at = nowIso_();
Object.keys(patch).forEach(function (k) {
var col = headers.indexOf(k);
if (col >= 0) sh.getRange(r._row, col + 1).setValue(patch[k]);
});
}

function bumpDeliveryCounts_(deliveryId, sentDelta, failedDelta) {
var d = findRow_('deliveries', 'delivery_id', deliveryId);
var sent = (toNum_(d.sent_count) || 0) + sentDelta;
var failed = (toNum_(d.failed_count) || 0) + failedDelta;
var patch = { sent_count: sent, failed_count: failed};
if (!str_(d.started_at)) patch.started_at = nowIso_();
if (sent + failed >= (toNum_(d.target_count) || 0)) {
patch.status = 'done';
patch.finished_at = nowIso_();
} else {
patch.status = 'sending';
}
updateRowByPk_('deliveries', deliveryId, patch);
}

// ===== メール本文の組み立て (差し込み + フッター) =====
/**
* テンプレ差し込み: {宛名} {おすすめ案件} {回答フォームURL} {配信停止URL} {不足ヒヤリング}
* 末尾には必ず: 回答フォームリンク、配信停止リンク、署名+特定電子メール法の
* 統合ブロックを付ける (DESIGN_V2 §6.2 / R4: 番号返信はメールでは廃止しフォーム一本化)。
* フォーム/停止の URL は settings の form_base_url / optout_base_url に
*?token=<form_token> を付けたもの。未設定時はプレースホルダ文になる (README 参照)。
*/
/** 受信者ごとのフォーム/配信停止 URL の組み立て (件名展開と本文生成で共用。R4 レーンD 13-#5)。
 * R6.6 include_form: includeForm===false のとき formUrl は '' を返す
 * (文面にフォーム案内を載せない)。optoutUrl は常に従来どおりトークン付きで返す
 * (配信停止リンクの本人確認に同じトークンを使うため。空にしないこと)。
 * トークン自体が空の場合も formUrl は '' (従来の '?token=' 垂れ流しをやめる)。 */
function mailUrlsForRecipient_(recipient, includeForm) {
var token = str_(recipient && recipient.form_token);
var formBase = getSettingValue_('form_base_url', '');
var optoutBase = getSettingValue_('optout_base_url', '');
var showForm = includeForm !== false && !!token;
return {
formUrl: showForm ? (formBase ? formBase + (formBase.indexOf('?') >= 0 ? '&' : '?') + 'token=' + token : '(回答フォームURL未設定)') : '',
optoutUrl: optoutBase? optoutBase + (optoutBase.indexOf('?') >= 0? '&': '?') + 'token=' + token: '(配信停止URL未設定)'
};
}

/** R6.6: 配信行の include_form 判定。列追加前の旧行 (空欄) は既定 true。 */
function deliveryIncludeForm_(delivery) {
  if (!delivery) return true;
  var v = delivery.include_form;
  if (v === undefined || v === null || v === '') return true;
  if (v === false || v === 0) return false;
  var s = String(v).trim().toLowerCase();
  return s !== 'false' && s !== '0' && s !== 'no';
}

function buildMailBody_(delivery, applicant, recipient, operator) {
var urls = mailUrlsForRecipient_(recipient, deliveryIncludeForm_(delivery));
var formUrl = urls.formUrl;
var optoutUrl = urls.optoutUrl;

var body = str_(delivery.body_template);
body = expandTemplate_(body, applicant, recipient, formUrl, optoutUrl, operator);
// R4 レーンD 13-#5: 送信直前の残存ガード。未展開の {…} が残る文面は送らない
// (processSendQueue の行単位失敗処理に乗り、その受信者だけが failed になる)。
assertNoLeftoverTags_(body, 'メール本文');

// 構成分離 (2026-11-21): 本文 = 案内文 + 案件紹介 + 番号返信の案内 まで。
// フォーム導線は区切り線 + 独立ブロックとして末尾側に置き、フォーム項目
// (経験年数・資格・入職可能日・見学希望日・電話相談希望日時・連絡のつく時間帯・
//  自由記入 等) の説明文は本文に混ぜ込まない (それらはフォーム側に集約する)。
var lines = [body, ''];
// R4 (2026-11-22 ユーザー決定): メールの回答導線は回答フォームのみに一本化し、
// 番号返信セクション (「番号でご返信ください 1: 詳細希望…」) はメール本文から外す。
// SMS 側の文面・導線は変更しない。配信停止リンクは従来どおり下のブロックに残す。
lines.push('----------------------------------------');
// R6.6 include_form: フォームURLが無い配信ではフォーム案内ブロック自体を載せない。
// 配信停止リンクは常時残す (特定電子メール法)。区切り線は残す。
if (formUrl) {
  lines.push('【回答フォームのご案内】');
  lines.push('詳しいご希望は、下記の回答フォームからお知らせください。');
  lines.push('回答フォーム: ' + formUrl);
}
lines.push('配信停止をご希望の方はこちら: ' + optoutUrl);
// R4 (2026-11-22 ユーザー実地指摘): 署名ブロックと特定電子メール法フッターが
// 二重に付いて会社名・メールが繰り返される問題を解消し、末尾は1つの閉じブロックに
// 統合する。署名文に既に含まれる項目は二重に出さず、不足する法定項目 (送信者・
// 連絡先・住所) だけを同じブロック内へ補う。住所行は必ずこのブロック内に置く。
// 配信停止リンクは上の【回答フォームのご案内】ブロックに既にある (欠かさない)。
var sig = str_(operator.signature);
lines.push('');
if (sig) lines.push(sig);
var senderName = str_(operator.display_name) || str_(delivery.sender_name) || str_(delivery.sender_email);
var senderPhone = str_(getSettingValue_('sender_phone', ''));
var company = str_(getSettingValue_('company_name', ''));
var senderEmail = str_(delivery.sender_email);
function sigHas_(needle) { return !!needle && sig.indexOf(needle) >= 0; }
if (company && !sigHas_(company)) lines.push('会社名: ' + company);
if (senderName && !sigHas_(senderName)) lines.push('送信者: ' + senderName);
if (senderEmail && !sigHas_(senderEmail)) {
  lines.push('連絡先: ' + senderEmail + (senderPhone ? ' / 電話: ' + senderPhone : ''));
} else if (senderPhone && !/0\d{1,4}-\d{1,4}-\d{3,4}/.test(sig)) {
  // R4 (LEGAL §1 改善案2): 窓口電話が署名にも無ければ併記する (署名の自由文頼みにしない)。
  lines.push('電話: ' + senderPhone);
}
// R4 (法令ブロッカー): 特定電子メール法の送信者表示には住所が要る。
// 値は settings の sender_address (運用開始前に会社の住所を設定すること)。
// 新規作成はガードで止まるため、ここに来る滞留配信では未設定を明示する。
var senderAddress = str_(getSettingValue_('sender_address', ''));
lines.push('住所: ' + (senderAddress || '(住所未設定)'));
return lines.join('\n');
}

/**
 * 宛名クリーニング (フロント index.html の smsRecipientName と同一ロジックの移植)。
 * 対象: 先頭の記号類の連続、英数字1〜10文字+アンダースコアの接頭辞 (F_ / AB_ / A1_ /
 * 記号混在の *A_ 等)、角括弧ブロックの除去。姓だけを取り出すところまでを行い、
 * 空になった場合は '' を返す (呼び出し側が次候補・最終フォールバックを決める)。
 */
function cleanSurname_(value) {
var s = str_(value).replace(/\u3010[^\u3011]*\u3011/g, '');
for (var i = 0; i < 10; i++) {
var t = s.replace(/^[\s　]+/, '')
.replace(/^[A-Za-z0-9Ａ-Ｚａ-ｚ０-９]{1,10}[\s　]*[_＿][\s　]*/, '')
.replace(/^[^\p{L}\p{N}]+/u, '');
if (t === s) break;
s = t;
}
var clean = s.replace(/[\/／]住所仮入力.*$/, '').replace(/様\s*$/, '').trim();
return clean.split(/[\s　]+/)[0] || '';
}

/**
 * {担当者} の置換値: 運営者の display_name から会社名部分を除いた姓のみ
 * (サーバー側 display_name は「会社名 + 姓」形式で統一されている)。
 * 取れなければ '' (呼び出し側で展開せず、残存ガードに倒す)。
 */
function operatorShortName_(operator) {
var dn = str_(operator && operator.display_name);
if (!dn) return '';
var s = dn.replace(/株式会社ファーストスタッフィング/g, '').replace(/ファーストスタッフィング/g, '').trim();
return cleanSurname_(s);
}

function expandTemplate_(template, applicant, recipient, formUrl, optoutUrl, operator) {
var out = String(template || '');
// {宛名}: surname・name の双方に cleanSurname_ を適用し、空なら次候補、最終的に ご登録者。
var surname = cleanSurname_(applicant.surname) || cleanSurname_(applicant.name) || 'ご登録者';
out = out.split('{宛名}').join(surname);
out = out.split('{回答フォームURL}').join(formUrl || '');
out = out.split('{フォームURL}').join(formUrl || ''); // R4 レーンD §0.1: フロント側タグの別名展開
out = out.split('{配信停止URL}').join(optoutUrl || '');
out = out.split('{不足ヒヤリング}').join(missingHearingText_(applicant));
if (out.indexOf('{不足項目名}') >= 0) {
// R4 レーンJ 項目3: 未確認項目の名前だけを畳む。0 項目ならタグを含む行ごと省略する。
var names = missingHearingNamesText_(applicant);
if (names) {
out = out.split('{不足項目名}').join(names);
} else {
out = out.split('\n').filter(function (ln) { return ln.indexOf('{不足項目名}') < 0; }).join('\n');
}
}
// {担当者} (R4 レーンD 13-#7 / P6): operator を渡せる経路でのみ展開する。
// 渡せない経路では展開しない (残存として assertNoLeftoverTags_ が検出する側に倒す)。
if (operator) {
var opName = operatorShortName_(operator);
if (opName) out = out.split('{担当者}').join(opName);
}
if (out.indexOf('{おすすめ案件}') >= 0) {
out = out.split('{おすすめ案件}').join(recommendText_(recipient));
}
return out;
}

/** おすすめ案件の差し込み文 (delivery_recipients.recommended_case_ids から組み立てる) */
function recommendText_(recipient) {
var ids = toList_(recipient && recipient.recommended_case_ids);
if (!ids.length) return '';
var lines = [];
var openCount = 0;
var jobKinds = [];
ids.forEach(function (id) {
try {
var c = findRow_('cases', 'case_id', id);
// R4 11-#3: 募集終了した案件は本文に出さない (行が消えた場合と同じ扱い)。
if (!toBool_(c.is_open)) return;
openCount++;
// R4 (2026-11-22 ユーザー実地指摘): メール本文に載せる案件は最大2件まで。
// 残りのおすすめは回答フォーム側で提示する (recommended_case_ids 自体は全件保持)。
if (lines.length >= 2) return;
// 長さ規律: 要点 (施設名・エリア・時給帯) のみ。案件固有の salary_text・title・
// description (固有の勤務時間を含みうる) は対外ブロックに出さない。
var line = '・' + str_(c.facility_name);
var area = str_(c.municipality) || str_(c.prefecture);
if (area) line += '\n　' + area;
line += '\n　時給目安: ' + publicSalaryBandText_(c.job_type);
lines.push(line);
var k = publicJobKind_(c.job_type);
if (jobKinds.indexOf(k) < 0) jobKinds.push(k);
} catch (e) { /* 案件が消えていたらその行は出さない */ }
});
if (!lines.length) return '';
if (openCount > lines.length) {
lines.push('その他のおすすめ案件は、回答フォームでご覧いただけます。');
}
// R4 (2026-11-22 ユーザー実地指摘): 勤務時間の例と相談可能の注記は案件ごとに
// 繰り返さず、メール全体で1回に集約する (勤務時間を固定と断定しないルールは維持)。
jobKinds.forEach(function (k) { lines.push(publicCaseHoursText_(k)); });
lines.push(PUBLIC_SALARY_NOTE_);
return lines.join('\n');
}

/** ===== 送信スナップショット (配信時点の写し。参照ではなく値のコピー) =====
 * cases_snapshot: その時点でその人に見せた案件の一覧を、並び順 (order) つきで
 * 表示用フィールドだけに絞った配列の JSON 文字列。案件マスター側が後で変わっても、
 * ここに保存した写しは変わらない (不変性はバックエンドテストで担保する)。
 * body_snapshot: その配信で使った文面そのもの (作成時はテンプレ展開文、
 * 送信確定時は processSendQueue が実際に送った全文で確定させる)。 */
function snapshotCaseItem_(c, order) {
  return {
    order: order,
    case_id: str_(c.case_id),
    facility_name: str_(c.facility_name),
    service_type: str_(c.service_type),
    prefecture: str_(c.prefecture),
    municipality: str_(c.municipality),
    address: str_(c.address),
    job_type: str_(c.job_type),
    employment_type: str_(c.employment_type),
    title: str_(c.title),
    description: publicDescription_(c.description).substring(0, SNAPSHOT_DESC_CHARS),
    nearest_station: str_(c.nearest_station),
    salary_text: publicSalaryBandText_(c.job_type),
    salary_band_text: publicSalaryBandText_(c.job_type),
    salary_note: PUBLIC_SALARY_NOTE_,
    hours_text: publicCaseHoursText_(c.job_type),
    hours_short_text: publicCaseHoursShortText_(c.job_type),
    updated_at_src: cellDateIso_(c.updated_at_src)
  };
}

/** case_id の並び順どおりに案件マスターの現在値を写し取る (見つからない ID は落とす) */
function buildCasesSnapshot_(caseIds) {
  var items = [];
  toList_(caseIds).forEach(function (id) {
    try { items.push(snapshotCaseItem_(findRow_('cases', 'case_id', id), items.length + 1)); }
    catch (e) { /* 案件が既に無い場合は写しに含めない */ }
  });
  // 上限を超える場合は JSON 文字列を途中で切らず、末尾の案件から落として
  // 必ずパース可能な JSON にする (R3 検証 #12 周辺: 途中切断で写し全体が
  // 読めなくなる不具合の修正)。
  var json = JSON.stringify(items);
  while (json.length > SNAPSHOT_TOTAL_CHARS && items.length > 1) {
    items.pop();
    json = JSON.stringify(items);
  }
  if (json.length > SNAPSHOT_TOTAL_CHARS) {
    // 1件でも上限を超える異常ケース: その1件の写し自体を諦める (壊れた JSON は残さない)。
    return '[]';
  }
  return json;
}

function parseCasesSnapshot_(json) {
  if (!json) return [];
  var s = String(json);
  try { var v = JSON.parse(s); return Object.prototype.toString.call(v) === '[object Array]' ? v : []; }
  catch (e) {
    // 旧形式で途中切断された写しから、完結している要素だけを復元する。
    try {
      var cut = s.lastIndexOf('},');
      if (cut < 0) cut = s.lastIndexOf('}');
      if (cut > 0) {
        var v2 = JSON.parse(s.slice(0, cut + 1) + ']');
        return Object.prototype.toString.call(v2) === '[object Array]' ? v2 : [];
      }
    } catch (e2) {}
    return [];
  }
}

function snapshotBody_(body) { return str_(body).substring(0, SNAPSHOT_BODY_CHARS); }

/** 本人の配信スナップショット一覧 (getApplicant のタイムライン返却用。新しい順) */
function deliverySnapshotsForApplicant_(applicantId) {
  var out = [];
  try {
    // R4 S-06/S-12: 配信側の情報 (テスト配信の除外・チャネル判定) を引く。
    var delivById = {};
    try {
      readTable_('deliveries').rows.forEach(function (d) { delivById[String(d.delivery_id)] = d; });
    } catch (eD) { delivById = {}; }
    readTable_('delivery_recipients').rows.forEach(function (r) {
      if (String(r.applicant_id) !== String(applicantId)) return;
      if (!str_(r.cases_snapshot) && !str_(r.body_snapshot)) return;
      var deliv = delivById[String(r.delivery_id)] || null;
      var fj = {};
      try { fj = deliv ? JSON.parse(String(deliv.filter_json || '{}')) : {}; } catch (eJ) { fj = {}; }
      if (fj && (fj._test === true || fj.test === true)) return; // R4 S-12: テスト配信は受信者スナップショットとして返さない
      // R4 S-06: 仮文面 (作成時) と実文 (送信確定) の区別。snapshot_finalized 列が
      // ある環境では列を正とし、列自体が無い旧環境では status='sent' を確定扱いにする。
      var hasFinCol = Object.prototype.hasOwnProperty.call(r, 'snapshot_finalized');
      var finalized = hasFinCol ? toBool_(r.snapshot_finalized) : (String(r.status) === 'sent');
      // 確定フラグが正: SMS記録で確定した form_link 行も 'final' (発行だけの行は
      // フラグが立たないので 'issuance' のまま画面に出ない)。
      var state = 'provisional';
      if (finalized) state = 'final';
      else if (deliv && String(deliv.status) === 'form_link') state = 'issuance'; // R4 S-07: 発行記録
      var channel = 'mail';
      if (fj && fj.form_invite) channel = String(fj.channel || 'sms') === 'mail' ? 'mail' : 'sms';
      out.push({
        delivery_id: str_(r.delivery_id),
        status: str_(r.status),
        snapshot_state: state,
        channel: channel,
        sent_at: cellDateIso_(r.sent_at),
        created_at: cellDateIso_(r.created_at),
        recommended_case_ids: toList_(r.recommended_case_ids),
        cases_snapshot: parseCasesSnapshot_(r.cases_snapshot),
        body_snapshot: str_(r.body_snapshot),
        template_version: str_(r.template_version) // R4 Lane J: 使ったテンプレートの版キー
      });
    });
  } catch (e) { return []; }
  out.sort(function (a, b) {
    var x = a.sent_at || a.created_at, y = b.sent_at || b.created_at;
    return x < y ? 1 : (x > y ? -1 : 0);
  });
  return out.slice(0, 50);
}

/** {不足項目名} 用の短縮名 (R4 レーンJ 項目3。フロントの名前版と表記を一致させる) */
var HEARING_SHORT_NAMES_ = {
  desired_start_date: '勤務開始の希望日',
  qualifications: '資格',
  experience_years: '経験年数',
  nearest_station: '最寄駅',
  desired_days_per_week: '週の希望日数',
  desired_time_slots: '希望時間帯'
};

/** {不足項目名} の展開文: 未確認項目の短縮名だけを「・」で連結する (0 項目なら '') */
function missingHearingNamesText_(applicant) {
return missingHearing_(applicant).map(function (h) {
return HEARING_SHORT_NAMES_[h.key] || h.label;
}).join('・');
}

/** {不足ヒヤリング} の展開文 (未確認項目だけを質問文にする) */
function missingHearingText_(applicant) {
var missing = missingHearing_(applicant);
if (!missing.length) return 'ご登録内容はすべて確認済みです。お仕事のご案内をさせていただきます。';
var lines = ['お仕事をご案内するにあたり、以下を教えていただけますでしょうか。'];
missing.forEach(function (h) { lines.push('・' + h.label);});
lines.push('分かる範囲でご返信いただければ大丈夫です。');
return lines.join('\n');
}

// ===== 回答フォーム送信 (ログイン不要・ドメイン認証なし。form_token で検証) =====
/**
* デプロイB (自分として実行 / 全員公開) で動く前提のアクション。
* form_token が delivery_recipients に存在することだけを検証する。
*/
function findRecipientByToken_(token) {
  var t = readTable_('delivery_recipients');
  for (var i = 0; i < t.rows.length; i++) {
    if (String(t.rows[i].form_token) === token) return t.rows[i];
  }
  return null;
}

/**
 * フォームトークンの有効期限 (R3 検証 #28)。発行 (配信作成) から30日。
 * 中継 (Cloudflare KV) のコンテキスト保持期間30日と揃えてある。
 * 基準時刻が取れない旧行は失効扱いにしない (移行時の誤爆防止)。
 * なお配信停止 (optout) のトークン照合は失効の対象外 — 停止はいつでも受け付ける。
 */
var FORM_TOKEN_TTL_DAYS = 30;
function formTokenExpired_(rec) {
  if (!rec) return false;
  // トークンの生まれた時刻 = 宛先行の created_at (発行・配信作成の両経路で刻印される)。
  var base = cellDateIso_(rec.created_at);
  if (!base) {
    try {
      var d = findRow_('deliveries', 'delivery_id', str_(rec.delivery_id));
      if (d) base = cellDateIso_(d.created_at);
    } catch (e) {}
  }
  if (!base) base = cellDateIso_(rec.sent_at);
  if (!base) return false;
  var t = new Date(base).getTime();
  if (!(t > 0)) return false;
  return (new Date().getTime() - t) > FORM_TOKEN_TTL_DAYS * 86400000;
}
var FORM_TOKEN_EXPIRED_MSG = 'フォームの有効期限が切れています。お手数ですが、担当者からの新しい案内をお待ちください';

/**
 * フォーム表示用コンテキスト (公開側・ドメイン認証なし。form_token 検証のみ)。
 * 返すのは宛名用の氏名・職種とおすすめ案件上位約5件のみ (電話・メールは返さない)。
 * おすすめは recommendForApplicants と同じ照合 (recommendCasesFor_: 20km以内・減衰スコア順)。
 */
function actionGetFormContext_(req) {
  var token = String(req.form_token || '').trim();
  var a = null, senderName = '', senderUnknown = false, channel = '', deliveryId = '';
  var presented = null;
  if (token) {
    var rec = findRecipientByToken_(token);
    if (!rec) throw new Error('無効なフォームトークンです');
    if (formTokenExpired_(rec)) throw new Error(FORM_TOKEN_EXPIRED_MSG);
    a = findApplicant_(rec.applicant_id);
    deliveryId = str_(rec.delivery_id);
    var resolved = resolveDeliveryAttribution_(deliveryId);
    senderName = resolved.sender_name; channel = resolved.channel;
    senderUnknown = !resolved.sender_email;
    // Cases actually presented in that delivery come first (token attribution);
    // fall back to fresh recommendations only when the recipient row has none.
    var presentedIds = toList_(rec.recommended_case_ids);
    if (presentedIds.length) {
      presented = [];
      var allCases = openCases_();
      presentedIds.forEach(function (id) {
        for (var i = 0; i < allCases.length; i++) {
          if (String(allCases[i].case_id) === String(id)) {
            presented.push(publicCaseItem_(allCases[i],
              distanceKm_(a.lat, a.lon, allCases[i].lat, allCases[i].lon)));
            break;
          }
        }
      });
    }
  } else {
    // Fallback (supplement 20): generic URL without a token -> identify by phone number.
    a = findApplicantByPhone_(req.phone || req.applicant_phone || '');
    if (!a) throw new Error('リンクの情報だけでは本人を特定できませんでした。電話番号での照合が必要です');
    senderUnknown = true; channel = 'generic_url';
  }
  var recs = presented && presented.length ? presented
    : recommendCasesFor_(a, openCases_(), SMS_RECOMMEND_DEFAULT).map(publicFromListItem_);
  return {
    applicant_id: str_(a.applicant_id),
    name: str_(a.name), surname: str_(a.surname),
    job_type: str_(a.job_type),
    prefecture: str_(a.prefecture), municipality: str_(a.municipality),
    // Sender display on the form (supplement 20-2): the applicant can see whose
    // invitation this is. Empty + sender_unknown=true when attribution failed.
    sender_name: senderName,
    sender_unknown: senderUnknown,
    source_channel: channel,
    delivery_id: deliveryId,
    recommended_cases: recs, recommend_count: recs.length,
    presented_case_ids: recs.map(function (c) { return c.case_id; }),
    missing_hearing: missingHearing_(a).map(function (h) { return h.key; }),
    form_fields: FORM_ONLY_FIELDS_.slice()
  };
}

/**
 * 回答の重複検出 (R3 / F-08)。同一応募者について、直近15分以内に
 * 同一内容 (配信・意図・入職希望日・電話相談希望・自由文・選択案件) の
 * 回答が保存済みなら、その行を返す。submit_id があれば relay_id 列の
 * 'submit:<id>' で優先照合する (内容が変わっていても同一送信として扱う)。
 */
/* ===== フォーム専用チーム (追補37/38): 電話の幅選択・経験帯・希望時給帯 =====
   電話可能タイミングは「日付 (複数) × 時間帯 (複数) + いつでも可」の構造化データで
   保持する (phone_dates / phone_bands / phone_anytime)。phone_consult_datetime は
   人間可読の合成文字列として従来どおり併記し、旧形式の回答 (自由入力のみ) とも
   互換を保つ。カレンダー開始時刻は「最も早い日付 × 最も早い時間帯の開始時刻」。 */
var PHONE_BAND_DEFS_ = [
  { code: 'morning', label: '午前（9〜12時）', startHour: 9 },
  { code: 'daytime', label: '昼（12〜15時）', startHour: 12 },
  { code: 'evening', label: '夕方（15〜18時）', startHour: 15 },
  { code: 'night', label: '夜（18〜21時）', startHour: 18 }
];
function phoneBandDef_(code) {
  for (var i = 0; i < PHONE_BAND_DEFS_.length; i++) {
    if (PHONE_BAND_DEFS_[i].code === code) return PHONE_BAND_DEFS_[i];
  }
  return null;
}
var EXPERIENCE_BAND_CODES_ = ['none', 'lt1', '1-3', '3-5', '5-10', 'gte10'];
var EXPERIENCE_BAND_LABELS_ = { none: '未経験', lt1: '1年未満', '1-3': '1〜3年',
  '3-5': '3〜5年', '5-10': '5〜10年', gte10: '10年以上' };

/** 日付リストの正規化: YYYY-MM-DD の実在日だけを残し、重複除去・昇順・最大5件 */
function sanitizePhoneDates_(v) {
  var list = Array.isArray(v) ? v : String(v == null ? '' : v).split(',');
  var seen = {}, out = [];
  list.forEach(function (x) {
    var s = String(x == null ? '' : x).trim();
    var m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return;
    var y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
    var dt = new Date(Date.UTC(y, mo - 1, d));
    if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return;
    if (!seen[s]) { seen[s] = 1; out.push(s); }
  });
  out.sort();
  return out.slice(0, 5);
}

/** 時間帯コードの正規化: 許可コードだけを定義順で残す */
function sanitizePhoneBands_(v) {
  var list = Array.isArray(v) ? v : String(v == null ? '' : v).split(',');
  var picked = {};
  list.forEach(function (x) {
    var s = String(x == null ? '' : x).trim();
    if (phoneBandDef_(s)) picked[s] = 1;
  });
  return PHONE_BAND_DEFS_.filter(function (d) { return picked[d.code]; })
    .map(function (d) { return d.code; });
}

var PHONE_WEEKDAYS_ = ['日', '月', '火', '水', '木', '金', '土'];
function phoneDateLabel_(ymd) {
  var m = String(ymd || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return String(ymd || '');
  var wd = PHONE_WEEKDAYS_[new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]))).getUTCDay()];
  return Number(m[2]) + '/' + Number(m[3]) + '（' + wd + '）';
}

/** 構造化された電話の幅 → 人間可読文字列 (フロント buildCallDatetime_ と同形式) */
function composePhoneTextFromParts_(dates, bands, anytime, note) {
  var out = [];
  var dl = sanitizePhoneDates_(dates).map(phoneDateLabel_);
  var bl = sanitizePhoneBands_(bands).map(function (b) { return phoneBandDef_(b).label; });
  if (dl.length) out.push(dl.join('・'));
  if (bl.length) out.push(bl.join('・'));
  if (anytime) out.push('いつでも可');
  var n = String(note || '').trim();
  if (n) out.push(n);
  return out.join(' ');
}

/** 回答行 (または同形オブジェクト) の構造化された電話の幅の表示文字列。無ければ '' */
function phoneStructuredText_(r) {
  if (!r) return '';
  var dates = sanitizePhoneDates_(r.phone_dates);
  var bands = sanitizePhoneBands_(r.phone_bands);
  var any = toBool_(r.phone_anytime);
  if (!dates.length && !bands.length && !any) return '';
  return composePhoneTextFromParts_(dates, bands, any, '');
}

/** 構造化された電話の幅から「今日連絡」判定用の日付ヒントを出す。無ければ '' */
function phoneStructuredHint_(r, today) {
  var dates = sanitizePhoneDates_(r && r.phone_dates);
  if (dates.length) {
    for (var i = 0; i < dates.length; i++) if (dates[i] >= today) return dates[i];
    return dates[dates.length - 1];
  }
  if (toBool_(r && r.phone_anytime)) return today;
  return '';
}

/** リスト系フィールドの順序非依存の正規形 (L07-09: 冪等判定は順序で割らない) */
function sortedListCsv_(v) {
  return toList_(v).map(function (s) { return s.trim(); }).sort().join(',');
}

function findDuplicateResponse_(applicantId, deliveryId, intent, desiredStart,
                                phoneConsult, freeText, caseIdsCsv, submitId, extra) {
  var rows = readTable_('responses').rows;
  var nowMs = new Date().getTime();
  // submit_id の照合は時間窓の対象外 (R3 検証 #31): 中継の取り込みが15分を
  // 超えて遅れても、同一送信は同一として扱う (内容が変わっていても)。
  if (submitId) {
    for (var j = rows.length - 1; j >= 0; j--) {
      if (String(rows[j].applicant_id) !== String(applicantId)) continue;
      if (String(rows[j].relay_id || '') === 'submit:' + submitId) return rows[j];
    }
  }
  var ex = extra || {};
  for (var i = rows.length - 1; i >= 0; i--) {
    var r = rows[i];
    if (String(r.applicant_id) !== String(applicantId)) continue;
    var createdMs = new Date(cellDateIso_(r.created_at)).getTime();
    if (!(createdMs > 0) || nowMs - createdMs > 15 * 60 * 1000) continue;
    if (String(r.delivery_id || '') !== String(deliveryId || '')) continue;
    if (String(r.intent || '') !== String(intent || '')) continue;
    if (String(r.desired_start_date || '') !== String(desiredStart || '')) continue;
    // R4 レーンJ 項目2: 電話希望は統一後の文字列で照合する (旧行は interview 側を読み替え)。
    if (unifiedPhoneText_(r) !== String(phoneConsult || '')) continue;
    if (String(r.free_text || '') !== String(freeText || '')) continue;
    if (sortedListCsv_(r.selected_case_ids) !== sortedListCsv_(caseIdsCsv)) continue;
    // L07-09: 中継が運ぶ残りの回答フィールドも内容一致の対象にする
    // (面談希望日だけ変えた再送を「重複」として握り潰さない)。
    // contact_time_slots は responses に保存されていないため比較対象外。
    if (String(r.experience || '') !== String(ex.experience || '')) continue;
    if (sortedListCsv_(r.qualifications) !== sortedListCsv_(ex.qualifications)) continue;
    var rYears = (r.experience_years === '' || r.experience_years == null) ? '' : toNum_(r.experience_years);
    var eYears = (ex.experience_years === '' || ex.experience_years == null) ? '' : toNum_(ex.experience_years);
    if (String(rYears) !== String(eYears)) continue;
    // R4 レーンJ 項目2: 面談希望日は phone_consult_datetime へ寄せたため、個別比較は
    // 上の統一文字列の照合に吸収された (希望日だけ変えた再送は電話文字列の差で検出できる)。
    if (String(r.desired_tour_date || '') !== String(ex.desired_tour_date || '')) continue;
    // フォーム専用チーム (追補37/38): 構造化フィールドも内容一致の対象にする
    // (電話の日付だけ変えた再送を重複として握り潰さない)。
    if (sortedListCsv_(r.phone_dates) !== sortedListCsv_(ex.phone_dates)) continue;
    if (sortedListCsv_(r.phone_bands) !== sortedListCsv_(ex.phone_bands)) continue;
    if (toBool_(r.phone_anytime) !== !!ex.phone_anytime) continue;
    if (String(r.experience_band || '') !== String(ex.experience_band || '')) continue;
    if (String(r.experience_detail || '') !== String(ex.experience_detail || '')) continue;
    if (String(r.desired_rate_band || '') !== String(ex.desired_rate_band || '')) continue;
    return r;
  }
  return null;
}

/** R4 O-02: フォーム回答に同梱された optout=true の処理。
 * 回答保存と同じロック文脈から呼び、registerOptoutCore_ で実登録する。
 * 停止登録の失敗で回答保存まで失敗にしない (例外は握って戻り値に残す)。
 * channel は optouts の既存値域 (mail/sms) に寄せる暫定対応 (発行元配信の
 * channel 伝播が入るまでの間)。 */
function applySubmitOptout_(req, applicant, applicantId, sourceChannel) {
if (!toBool_(req.optout)) return null;
try {
return registerOptoutCore_(str_(applicant.email), applicantId,
  sourceChannel === 'sms' ? 'sms' : 'mail', 'form_submit', 'system');
} catch (eOpt) {
try { Logger.log('submitResponse optout failed applicant=' + applicantId + ': ' + errMsg_(eOpt)); } catch (e2) {}
return { error: errMsg_(eOpt) };
}
}

function actionSubmitResponse_(req) {
  var token = String(req.form_token || '').trim();
  return withLock_(function () {
    // --- Attribution (supplement 20): token -> delivery_recipients -> deliveries.
    // The token alone identifies applicant + original sender + channel + presented
    // cases. Without a token, fall back to phone-number matching; if that also
    // fails to identify a sender, the response is stored as sender-unknown and
    // enters the unhandled queue (assignable later via assignResponseSender).
    var applicantId = '', deliveryId = '', senderEmail = '', senderName = '';
    var sourceChannel = '', deliveryCreatedAt = '', deliveryMode = '';
    var applicant = null;
    if (token) {
      var rec = findRecipientByToken_(token);
      if (!rec) throw new Error('無効なフォームトークンです');
      if (formTokenExpired_(rec)) throw new Error(FORM_TOKEN_EXPIRED_MSG);
      applicantId = str_(rec.applicant_id);
      deliveryId = str_(rec.delivery_id);
      var attr = resolveDeliveryAttribution_(deliveryId);
      senderEmail = attr.sender_email; senderName = attr.sender_name;
      sourceChannel = attr.channel; deliveryCreatedAt = attr.delivery_created_at;
      deliveryMode = attr.mode;
      applicant = findApplicant_(applicantId);
    } else {
      applicant = findApplicantByPhone_(req.phone || req.applicant_phone || '');
      if (!applicant) {
        throw new Error('本人を特定できませんでした。電話番号を入力のうえ再送信してください');
      }
      applicantId = str_(applicant.applicant_id);
      sourceChannel = 'generic_url'; // sender unknown by definition on this path
    }
    var responseId = nextId_('responses');
    var intent = String(req.intent || '');
    if (['detail', 'tour', 'other_case'].indexOf(intent) < 0) {
      throw new Error('intent は detail / tour / other_case のいずれかです');
    }
    // 追補9: 入職希望日は desired_start_date に統一する (旧 available_start_date は互換入力として受ける)
    var desiredStart = String(req.desired_start_date || req.available_start_date || '');
    // R4 レーンJ 項目2: 電話希望は phone_consult_datetime に一本化する。
    // 旧クライアント・旧中継が interview_desired_date だけを送ってきても受けられる
    // 互換受理とし、両方ある場合は phone 側を正として interview 側は破棄する。
    var phoneUnified = String(req.phone_consult_datetime || '').trim()
      ? String(req.phone_consult_datetime) : String(req.interview_desired_date || '');
    // フォーム専用チーム (追補37/38): 電話の幅選択と経験帯・希望時給帯の構造化入力。
    // 合成文字列が無い経路 (API直叩き等) では構造化データから合成して併記する。
    var phoneDates = sanitizePhoneDates_(req.phone_dates);
    var phoneBands = sanitizePhoneBands_(req.phone_bands);
    var phoneAnytime = toBool_(req.phone_anytime);
    if (!String(phoneUnified || '').trim() &&
        (phoneDates.length || phoneBands.length || phoneAnytime)) {
      phoneUnified = composePhoneTextFromParts_(phoneDates, phoneBands, phoneAnytime, '');
    }
    var experienceBand = EXPERIENCE_BAND_CODES_.indexOf(String(req.experience_band || '')) >= 0
      ? String(req.experience_band) : '';
    var experienceDetail = String(req.experience_detail || '').slice(0, 1000);
    var desiredRateBand = String(req.desired_rate_band || '').slice(0, 100);
    var expYears = (req.experience_years === '' || req.experience_years == null) ? '' : toNum_(req.experience_years);
    // R4 04-03: 回答の「発生時刻」と「取り込み時刻」を分離する。中継経由では
    // relay_received_at (中継の受信時刻) が妥当な範囲 (未来+5分以内・30日以内)
    // にある場合だけ created_at (発生時刻) として採用し、取り込み時刻は
    // imported_at に常時保存する。直接経路は従来どおり両方とも現在時刻。
    var importedAt = nowIso_();
    var responseCreatedAt = importedAt;
    var relayReceivedAt = str_(req.relay_received_at || '');
    if (relayReceivedAt) {
      var rMs = Date.parse(relayReceivedAt), iMs = Date.parse(importedAt);
      if (isFinite(rMs) && isFinite(iMs) &&
          rMs <= iMs + 5 * 60 * 1000 && rMs >= iMs - 30 * 24 * 3600 * 1000) {
        responseCreatedAt = new Date(rMs).toISOString();
      }
    }
    // R3 (F-08 対応): 回答の冪等化。同一内容の再送 (ボタンの連打・通信リトライ・
    // 中継の再取り込み) では新規行を作らず既存の回答を返し、通知メールと
    // カレンダー自動作成も再実行しない。クライアント生成の submit_id があれば
    // relay_id 列に 'submit:<id>' として保存し、最優先で照合する。
    var submitId = String(req.submit_id || '');
    var dupResponse = findDuplicateResponse_(applicantId, deliveryId, intent, desiredStart,
      phoneUnified, String(req.free_text || ''),
      toList_(req.selected_case_ids).join(','), submitId, {
        experience: String(req.experience || ''),
        qualifications: req.qualifications,
        experience_years: (req.experience_years === '' || req.experience_years == null)
          ? '' : req.experience_years,
        desired_tour_date: String(req.desired_tour_date || ''),
        phone_dates: phoneDates.join(','), phone_bands: phoneBands.join(','),
        phone_anytime: phoneAnytime, experience_band: experienceBand,
        experience_detail: experienceDetail, desired_rate_band: desiredRateBand
      });
    if (dupResponse) {
      // R4 O-02: 重複回答でも、同梱された配信停止だけは処理する
      // (前に回答した人が今回あらためて停止だけチェックして送ったケースを落とさない)。
      var dupOptout = applySubmitOptout_(req, applicant, applicantId, sourceChannel);
      return { response_id: str_(dupResponse.response_id), accepted: true, duplicate: true,
        profile_filled: [], response_notify: 'skipped_duplicate',
        calendar_auto: { created: false, reason: 'duplicate' },
        optout: dupOptout,
        sender_unknown: !senderEmail, source_channel: sourceChannel };
    }
    appendRow_('responses', {
      response_id: responseId,
      delivery_id: deliveryId,
      applicant_id: applicantId,
      sender_email: senderEmail,
      intent: intent,
      experience: String(req.experience || ''),
      // R4 レーンJ 項目2: interview_desired_date への新規書き込みは停止する (列は互換読み取り専用に残す)
      interview_desired_date: '',
      desired_start_date: desiredStart,
      available_start_date: desiredStart, // 互換列にも同値を入れる (読み取りは desired_start_date 優先)
      desired_tour_date: String(req.desired_tour_date || ''),
      selected_case_ids: toList_(req.selected_case_ids).join(','),
      experience_years: (expYears == null ? '' : expYears),
      qualifications: toList_(req.qualifications).join(','),
      phone_consult_datetime: phoneUnified, // 合成文字列 (追補37で構造化と併記)。面談希望日もここへ寄せる
      phone_dates: phoneDates.join(','), phone_bands: phoneBands.join(','),
      phone_anytime: phoneAnytime,
      experience_band: experienceBand, experience_detail: experienceDetail,
      desired_rate_band: desiredRateBand,
      free_text: String(req.free_text || ''),
      handled: false, handled_by: '', handled_at: '',
      // Supplement 20: every response starts as unhandled and stays in the queue
      // until it reaches status=handled. source_channel records mail / sms /
      // generic_url (generic_url = sender unknown, needs assignment).
      status: 'unhandled', status_by: '', status_at: importedAt,
      source_channel: sourceChannel,
      relay_id: submitId ? 'submit:' + submitId : '',
      created_at: responseCreatedAt,
      // R4 04-01/04-03: 通知の永続状態の初期値と取り込み時刻。
      // status_at は「サーバーで unhandled になった時刻」なので importedAt を使う
      // (04-05 の expected 照合の版トークンもサーバー処理時刻で揃える)。
      notify_status: 'not_attempted', notify_attempts: 0,
      imported_at: importedAt
    });
    // R4 O-02: 回答に同梱された配信停止 (optout=true) を同じロック内で実登録する。
    var optoutResult = applySubmitOptout_(req, applicant, applicantId, sourceChannel);
    // F-08 対応 (R3): 回答行は保存済み。イベント記録は保存後処理として隔離し、
    // 失敗してもクライアントへ失敗を返さない (再送による二重回答の窓を塞ぐ)。
    // 併せて上記の findDuplicateResponse_ による冪等化で、再送が来ても
    // 既存の回答を返す。
    try {
      appendEvent_(applicantId, 'response_received', 'system',
        'フォーム回答 (' + intent + ') response=' + responseId +
        (senderEmail ? '' : ' 送信元不明'), deliveryId, responseId);
    } catch (eventErr) {
      try { Logger.log('submitResponse: response_received event failed response=' +
        responseId + ': ' + errMsg_(eventErr)); } catch (e) {}
    }
    // 追補9: プロフィール補完。未確認 (空) の項目だけを回答で埋め、既存値は上書きしない。
    // 補完の事実は applicant_events に response_profile_fill として本人のタイムラインへ残す。
    var patch = {}, filled = [];
    if ((applicant.experience_years === '' || applicant.experience_years == null) && expYears != null) {
      patch.experience_years = expYears; filled.push('experience_years');
    }
    if (!str_(applicant.qualifications) && toList_(req.qualifications).length) {
      patch.qualifications = toList_(req.qualifications).join(','); filled.push('qualifications');
    }
    if (!cellDateYmd_(applicant.desired_start_date) && desiredStart) {
      patch.desired_start_date = desiredStart; filled.push('desired_start_date');
    }
    if (filled.length) {
      patch.updated_at = nowIso_();
      updateRowByPk_('applicants', applicantId, patch);
      appendEvent_(applicantId, 'response_profile_fill', 'system',
        'フォーム回答でプロフィール補完: ' + filled.join(',') + ' response=' + responseId,
        deliveryId, responseId);
    }
    // 追補23: 【電話アポ】自動作成 (杉本のみ)。回答保存とは分離し、本処理の失敗が
    // 回答保存・後続の通知を止めることはない (tryAutoCreatePhoneAppointment_ 内で完結)。
    var calendarAuto = tryAutoCreatePhoneAppointment_({
      response_id: responseId, delivery_id: deliveryId, applicant_id: applicantId,
      sender_email: senderEmail,
      interview_desired_date: '',
      phone_consult_datetime: phoneUnified,
      phone_dates: phoneDates.join(','), phone_bands: phoneBands.join(','),
      phone_anytime: phoneAnytime,
      experience_band: experienceBand, experience_detail: experienceDetail,
      desired_rate_band: desiredRateBand,
      desired_start_date: desiredStart,
      available_start_date: desiredStart,
      desired_tour_date: String(req.desired_tour_date || ''),
      selected_case_ids: toList_(req.selected_case_ids).join(','),
      experience: String(req.experience || ''),
      experience_years: (expYears == null ? '' : expYears),
      qualifications: toList_(req.qualifications).join(','),
      free_text: String(req.free_text || ''),
      created_at: responseCreatedAt, calendar_event_id: ''
    });
    // 回答時の送信者通知 (追補20-1: 要約 + 本人カード導線 + 送信元情報つき)。
    // ここまでで回答の保存は完了している。通知は notifySenderOfResponse_ 内で
    // try/catch により完全に隔離され、失敗しても回答保存は失敗扱いにならない。
    // 送信元不明 (senderEmail 空) のときは通知を送らず、その旨がイベントに残る。
    var notify = notifySenderOfResponse_({
      senderEmail: senderEmail,
      senderName: senderName,
      applicantId: applicantId,
      applicantName: str_(applicant.name),
      deliveryId: deliveryId,
      deliveryCreatedAt: deliveryCreatedAt,
      deliveryMode: deliveryMode,
      sourceChannel: sourceChannel,
      responseId: responseId,
      intent: intent,
      desiredStartDate: desiredStart,
      desiredTourDate: String(req.desired_tour_date || ''),
      selectedCaseIds: toList_(req.selected_case_ids),
      phoneConsultDatetime: phoneUnified,
      phoneDates: phoneDates, phoneBands: phoneBands, phoneAnytime: phoneAnytime,
      experience: String(req.experience || ''),
      experienceYears: (expYears == null ? '' : expYears),
      experienceBand: experienceBand, experienceDetail: experienceDetail,
      desiredRateBand: desiredRateBand,
      qualifications: toList_(req.qualifications).join(','),
      freeText: String(req.free_text || ''),
      createdAt: responseCreatedAt
    });
    return { response_id: responseId, accepted: true, profile_filled: filled,
      response_notify: notify.status,
      calendar_auto: calendarAuto,
      optout: optoutResult,
      sender_unknown: !senderEmail, source_channel: sourceChannel };
  });
}

// ===== 回答時の送信者通知 =====
/**
 * 送信者への通知メール。文面の前提 (運用メモ):
 * - 求職者のメールは Indeed の転送アドレスが中心で、求職者への直接返信は
 *   届き方・追跡が不安定になり得る。そのため本システムでは「直接返信に頼らず、
 *   フォーム回答 (responses) を正とする」。通知はあくまで社内担当者への知らせであり、
 *   求職者への返信手段ではない。回答内容の確認・対応は回答一覧で行う。
 * - 送信は GmailApp.sendEmail を使う。本関数はデプロイB (自分として実行=
 *   プロジェクトオーナー) の文脈で動くため、From は実行アカウント (オーナー) に
 *   なるが、To は配信の送信者 (deliveries.sender_email / responses.sender_email) で、
 *   通知はその送信者の自分の Gmail 受信箱に届く。これが「通知が送信元に行く」運用。
 * - 通知の成否は呼び出し元の回答保存に影響させない (本関数内で完結して隔離する)。
 */
/**
 * R4 09-A-09: 通知の実宛先を「現在の」operators 状態から解決する。
 * responses.sender_email は帰属の記録 (誰の送信への回答か) として不変であり、
 * 宛先決定にそのまま使わない。解決順: 本人 (can_send) → handover_email →
 * settings notify_fallback_email → role=manager の運営者 → 解決不能。
 */
function resolveNotifyDestination_(senderEmail) {
  var email = normalizeEmail_(senderEmail);
  if (email) {
    var op = null;
    try { op = operatorByEmail_(email); } catch (e) {}
    if (op && toBool_(op.can_send)) {
      return { to: email, is_fallback: false, reason: 'operator', prefix: '' };
    }
    if (op && str_(op.handover_email)) {
      return { to: normalizeEmail_(op.handover_email), is_fallback: true,
        reason: 'handover', prefix: '\\u3010引き継ぎ先へ転送\\u3011' };
    }
  }
  var fb = normalizeEmail_(getSettingValue_('notify_fallback_email', ''));
  if (!fb) {
    try {
      var ops = readTable_('operators').rows;
      for (var i = 0; i < ops.length; i++) {
        if (str_(ops[i].role) === 'manager' && normalizeEmail_(ops[i].email)) {
          fb = normalizeEmail_(ops[i].email);
          break;
        }
      }
    } catch (e2) {}
  }
  if (fb) {
    return { to: fb, is_fallback: true, reason: email ? 'fallback' : 'no_sender_fallback',
      prefix: '\\u3010宛先フォールバック\\u3011' };
  }
  return { to: '', is_fallback: true, reason: 'unresolved', prefix: '' };
}

/** 通知 ctx の電話希望テキスト (R4 レーンJ 項目2: 通常は phoneConsultDatetime に
 * 統一済み。旧形 ctx の interviewDesiredDate も互換として読み替える) */
function notifyPhoneText_(ctx) {
  return str_(ctx && ctx.phoneConsultDatetime) || str_(ctx && ctx.interviewDesiredDate);
}

function notifySenderOfResponse_(ctx) {
  var status = 'failed', detail = '';
  var dest = { to: '', is_fallback: true, reason: 'unresolved', prefix: '' };
  try { dest = resolveNotifyDestination_(ctx.senderEmail); } catch (eD) {}
  try {
    if (!dest.to) {
      // R4 04-02: 送信元不明でも、フォールバック宛先が解決できれば「不明である
      // こと自体」を通知する (下の else 経路)。ここに来るのは宛先が本当に
      // 解決できない場合だけ。
      status = !ctx.senderEmail ? 'skipped_no_sender' : 'failed';
      detail = !ctx.senderEmail
        ? '送信元不明かつフォールバック宛先も解決できないため通知をスキップ (未対応キューで引き取り待ち)'
        : '通知の宛先を解決できませんでした (operators / notify_fallback_email を確認してください)';
    } else {
      var intentLabels = { detail: '詳細希望', tour: '見学希望', other_case: '別案件希望' };
      var when = '';
      try { when = Utilities.formatDate(new Date(ctx.createdAt), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'); }
      catch (e) { when = ctx.createdAt; }
      var sentWhen = '';
      if (ctx.deliveryCreatedAt) {
        try { sentWhen = Utilities.formatDate(new Date(ctx.deliveryCreatedAt), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'); }
        catch (e2) { sentWhen = ctx.deliveryCreatedAt; }
      }
      var channelLabel = ctx.sourceChannel === 'sms' ? 'SMS案内'
        : (ctx.sourceChannel === 'generic_url' ? '汎用URL (送信元不明)' : 'Gmail配信');
      var lines = [];
      if (!ctx.senderEmail) {
        lines.push('送信元が特定できない回答です。回答一覧の「送信元不明」から引き取ってください。');
        lines.push('');
      }
      lines.push('フォーム回答がありました。回答一覧で内容を確認し、対応してください。');
      lines.push('');
      lines.push('■ 回答の要約');
      lines.push('応募者名: ' + (ctx.applicantName || '(氏名なし)'));
      lines.push('希望区分: ' + (intentLabels[ctx.intent] || ctx.intent));
      // R4 レーンJ 項目2: 電話相談希望と面談希望日は「お電話できる日時」の1行に統一する。
      lines.push('お電話できる日時: ' + (notifyPhoneText_(ctx) || '(未入力)'));
      // フォーム専用チーム (追補37): 構造化された幅選択があれば内訳も併記する。
      var phoneStructLine = phoneStructuredText_({ phone_dates: ctx.phoneDates,
        phone_bands: ctx.phoneBands, phone_anytime: ctx.phoneAnytime });
      if (phoneStructLine) lines.push('お電話できる日時（選択内容）: ' + phoneStructLine);
      // R3 検証 #29 (FIRST_CONTACT_PLAN 1): 電話即応導線。応募者の電話番号と
      // tel: リンクを通知に含め、ワンタップで発信できるようにする。
      var applicantPhone = '';
      try {
        var apForTel = ctx.applicantId ? findApplicant_(ctx.applicantId) : null;
        if (apForTel) applicantPhone = str_(apForTel.phone);
      } catch (eTel) {}
      var telDigits = applicantPhone ? normalizePhoneDigits_(applicantPhone) : '';
      if (applicantPhone) {
        lines.push('電話番号: ' + applicantPhone);
        if (telDigits) lines.push('電話をかける: tel:' + telDigits);
      }
      if (ctx.desiredTourDate) lines.push('見学希望日: ' + ctx.desiredTourDate);
      lines.push('入職希望日: ' + (ctx.desiredStartDate || '(未入力)'));
      lines.push('選択案件: ' + selectedCaseLabels_(ctx.selectedCaseIds));
      var prof = [];
      if (ctx.experienceYears !== '' && ctx.experienceYears != null) prof.push('経験 ' + ctx.experienceYears + '年');
      else if (ctx.experience) prof.push('経験: ' + ctx.experience);
      if (ctx.qualifications) prof.push('資格: ' + ctx.qualifications);
      // フォーム専用チーム (追補38): 経験帯・希望時給・経験の内容を通知にも出す。
      if (ctx.experienceBand) prof.push('経験帯: ' +
        (EXPERIENCE_BAND_LABELS_[ctx.experienceBand] || ctx.experienceBand));
      if (prof.length) lines.push(prof.join(' / '));
      if (ctx.desiredRateBand) lines.push('希望時給: ' + ctx.desiredRateBand);
      if (ctx.experienceDetail) lines.push('経験の内容: ' + String(ctx.experienceDetail).slice(0, 120));
      if (ctx.freeText) lines.push('自由記述: ' + String(ctx.freeText).slice(0, 120));
      lines.push('');
      lines.push('■ 送信元 (誰の送信に対する回答か)');
      lines.push('送信者: ' + (ctx.senderName || '(表示名なし)') + ' (' + (ctx.senderEmail || '送信元不明') + ')');
      lines.push('送信種別: ' + channelLabel + (ctx.deliveryMode ? ' / モード: ' + ctx.deliveryMode : ''));
      lines.push('配信ID: ' + (ctx.deliveryId || '(なし)') + (sentWhen ? ' / 配信作成: ' + sentWhen : ''));
      lines.push('回答日時: ' + when + ' / 回答ID: ' + ctx.responseId);
      lines.push('');
      lines.push('■ 対応はこちら (本人カードへ直接進めます)');
      lines.push('本人カード: ' + applicantCardUrl_(ctx.applicantId));
      lines.push('回答一覧: ' + responseFocusUrl_(ctx.responseId));
      // Supplement 21: when the response carries an interview / phone-consult
      // wish, add the calendar lead. The link opens the response detail in the
      // app (#/responses?focus=...); the calendar event itself is created ONLY
      // from the app button (createPhoneAppointment). Mail links never create
      // a calendar event directly: via mail the acting user cannot be pinned
      // down reliably and the idempotency check (calendar_event_id) cannot be
      // enforced, so a mail click could double-register or land on the wrong
      // person's calendar. See FORM_SYSTEM.md supplement 21.
      if (notifyPhoneText_(ctx).trim()) {
        lines.push('');
        lines.push('■ カレンダーに追加 (電話希望あり)');
        lines.push('回答詳細を開き、「カレンダーに追加」ボタンからあなたのGoogleカレンダーへ');
        lines.push('【電話アポ】予定を作成できます (メール内リンクからは直接作成しません):');
        lines.push('回答詳細: ' + responseFocusUrl_(ctx.responseId));
      }
      lines.push('');
      lines.push('※ 求職者の連絡先は Indeed 転送アドレスが中心のため、直接返信に頼らず、');
      lines.push('　 フォーム回答を正として回答一覧から対応してください。');
      // R3 検証 #29: 電話相談希望が「本日」なら件名にフラグを立てて即応を促す。
      // R4 04-03: 件名フラグの基準日は「今日」ではなく回答の発生日に揃える
      // (中継の遅延取り込みで行の urgency と件名が食い違わないように)。
      var phoneBaseYmd = String(ctx.createdAt || '').slice(0, 10) || todayYmd_();
      var phoneHint = '';
      try { phoneHint = parsePhoneConsultHint_(notifyPhoneText_(ctx), phoneBaseYmd); } catch (eHint) {}
      var subjectPrefix = (ctx.resend ? '\\u3010再送\\u3011' : '') +
        (!ctx.senderEmail ? '\\u3010送信元不明・引き取り待ち\\u3011' : (dest.prefix || ''));
      var subject = (phoneHint && phoneHint === phoneBaseYmd ? '\u3010本日電話希望\u3011' : '') +
        '\u3010応募者配信\u3011フォーム回答がありました' +
        (ctx.applicantName ? ' (' + ctx.applicantName + '様)' : '');
      subject = subjectPrefix + subject;
      // R3 検証 #29: HTML 版も併送し、電話発信と本人カードへの導線をタップ可能にする。
      var escH = function (v) {
        return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
          .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      };
      var htmlBody = '<div style="font-family:sans-serif;font-size:14px;line-height:1.7">' +
        lines.map(function (ln) { return escH(ln); }).join('<br>') +
        (telDigits ? '<p><a href="tel:' + escH(telDigits) + '" style="display:inline-block;padding:10px 18px;background:#2e7d32;color:#fff;border-radius:8px;text-decoration:none">電話をかける (' + escH(applicantPhone) + ')</a></p>' : '') +
        '<p><a href="' + escH(applicantCardUrl_(ctx.applicantId)) + '">本人カードを開く</a> / <a href="' + escH(responseFocusUrl_(ctx.responseId)) + '">回答詳細を開く</a></p>' +
        '</div>';
      GmailApp.sendEmail(dest.to, subject, lines.join('\n'), { htmlBody: htmlBody });
      status = ctx.afterAssign ? 'sent_after_assign'
        : (dest.is_fallback ? 'sent_fallback' : 'sent');
      detail = '通知送信成功 to=' + dest.to +
        (dest.is_fallback ? ' (宛先解決: ' + dest.reason + ')' : '');
    }
  } catch (err) {
    status = 'failed'; detail = '通知送信失敗: ' + errMsg_(err);
  }
  // R4 04-01: 成否は回答行にも永続化する (未達の一覧化・再送の対象特定のため)。
  // 行書き込みが失敗してもイベントには残るよう、両方へ書く。
  try {
    var rowNow = findRow_('responses', 'response_id', ctx.responseId);
    var attempts = (rowNow ? (toNum_(rowNow.notify_attempts) || 0) : 0) + 1;
    updateRowByPk_('responses', ctx.responseId, {
      notify_status: status, notify_attempts: attempts,
      notify_last_at: nowIso_(),
      notify_last_error: status === 'failed' ? String(detail).slice(0, 200) : '',
      notify_sent_to: dest.to || '', notify_is_fallback: !!dest.is_fallback
    });
  } catch (eP) {
    try { Logger.log('notifySenderOfResponse_: 行への記録に失敗 response=' + ctx.responseId + ': ' + errMsg_(eP)); } catch (e4) {}
  }
  // 成否はイベントにも残す (イベント記録自体の失敗で本処理を落とさない)。
  try {
    appendEvent_(ctx.applicantId, 'response_notify', 'system',
      detail + ' response=' + ctx.responseId, ctx.deliveryId, ctx.responseId);
  } catch (e3) { /* ログ失敗は無視する (回答保存を守ることを優先) */ }
  return { status: status, detail: detail, sent_to: dest.to || '', is_fallback: !!dest.is_fallback };
}

// ===== 回答まわり共通ヘルパー (追補20) =====
var RESPONSE_STATUSES_ = ['unhandled', 'in_progress', 'handled'];

/** status の正規化。status 列が正、無い旧行は handled から導出する (互換) */
function responseStatus_(r) {
  var st = str_(r && r.status);
  if (RESPONSE_STATUSES_.indexOf(st) >= 0) return st;
  return toBool_(r && r.handled) ? 'handled' : 'unhandled';
}

function todayYmd_() { return Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd'); }

function diffDaysYmd_(aYmd, bYmd) {
  var a = new Date(aYmd + 'T00:00:00+09:00'), b = new Date(bYmd + 'T00:00:00+09:00');
  if (isNaN(a.getTime()) || isNaN(b.getTime())) return null;
  return Math.round((a.getTime() - b.getTime()) / 86400000);
}

/**
 * 電話相談希望 (自由入力) から日付ヒントを抽出する。対応形式:
 * YYYY-MM-DD / YYYY/MM/DD / M月D日 / M/D / 今日・明日・明後日。
 * baseYmd (回答日) 基準で年を補う。抽出できなければ ''。
 */
/** 実在する日付か (R4 04-11: 2026-02-30 のような入力を翌年化せず unparsed に倒す) */
function isRealYmd_(y, m, d) {
  if (m < 1 || m > 12 || d < 1 || d > 31) return false;
  var dt = new Date(Date.UTC(y, m - 1, d));
  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
}

function parsePhoneConsultHint_(text, baseYmd) {
  var t = str_(text);
  if (!t) return '';
  var base = /^\d{4}-\d{2}-\d{2}$/.test(baseYmd || '') ? baseYmd : todayYmd_();
  if (t.indexOf('明後日') >= 0) return addDaysYmd_(base, 2);
  if (t.indexOf('明日') >= 0) return addDaysYmd_(base, 1);
  if (t.indexOf('今日') >= 0 || t.indexOf('本日') >= 0) return base;
  var m = t.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) {
    if (!isRealYmd_(Number(m[1]), Number(m[2]), Number(m[3]))) return '';
    return m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2);
  }
  m = t.match(/(\d{1,2})月(\d{1,2})日/);
  if (!m) m = t.match(/(\d{1,2})\/(\d{1,2})/);
  if (m) {
    var y = Number(base.slice(0, 4));
    if (!isRealYmd_(y, Number(m[1]), Number(m[2]))) {
      // 年をまたいだ先で実在する場合だけ翌年で再判定する (2/29 等)
      if (!isRealYmd_(y + 1, Number(m[1]), Number(m[2]))) return '';
    }
    var ymd = y + '-' + ('0' + m[1]).slice(-2) + '-' + ('0' + m[2]).slice(-2);
    // 回答日より半年以上前になる場合は翌年の同日とみなす (年末年始の自由入力対策)
    var dd = diffDaysYmd_(ymd, base);
    if (dd != null && dd < -180) ymd = (y + 1) + ymd.slice(4);
    return ymd;
  }
  // R4 04-09: 曜日・「来週」の最小限の解釈 (基準日=回答発生日)。
  // 「平日午前」「いつでも」等は無理に日付化せず未特定区分に残す。
  var wd = t.match(/(来週|今週)?\s*([月火水木金土日])曜/);
  if (wd) {
    var target = '日月火水木金土'.indexOf(wd[2]); // 日=0..土=6 (文字の並び順)
    var baseDow = ymdDow_(base);
    var delta = (target - baseDow + 7) % 7;
    if (wd[1] === '来週') delta += 7;
    else if (delta === 0 && wd[1] !== '今週') delta = 7; // 「○曜」だけなら直近の次の同曜日
    return addDaysYmd_(base, delta);
  }
  if (t.indexOf('来週') >= 0) {
    // 「来週」は月曜始まりの週で解釈し、翌週の月曜を hint とする
    // (日曜が基準日なら翌日の月曜が翌週の開始になる)。
    var toMonday = (8 - ymdDow_(base)) % 7 || 7;
    return addDaysYmd_(base, toMonday);
  }
  return '';
}

/** YMD の曜日 (日=0..土=6)。実行環境のタイムゾーンに依存しない UTC 算術で求める */
function ymdDow_(ymd) {
  var p = String(ymd || '').split('-');
  if (p.length !== 3) return 0;
  var days = Math.floor(Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])) / 86400000);
  return ((days + 4) % 7 + 7) % 7; // 1970-01-01 は木曜 (=4)
}

/** 電話希望の緊急度。overdue < today < soon (3日以内) < unparsed < future < none */
function phoneUrgency_(hintYmd, hasPhoneText, today) {
  if (!hasPhoneText) return '';
  if (!hintYmd) return 'unparsed';
  var d = diffDaysYmd_(hintYmd, today || todayYmd_());
  if (d == null) return 'unparsed';
  if (d < 0) return 'overdue';
  if (d === 0) return 'today';
  if (d <= 3) return 'soon';
  return 'future';
}
var PHONE_URGENCY_RANK_ = { overdue: 0, today: 1, soon: 2, unparsed: 3, future: 4, '': 5 };

/** 配信IDから送信元 attribution を解決する (トークン→受信者→配信の解決の配信側) */
function resolveDeliveryAttribution_(deliveryId) {
  var out = { sender_email: '', sender_name: '', channel: '', delivery_created_at: '', mode: '' };
  if (!deliveryId) { out.channel = 'generic_url'; return out; }
  var delivery = null;
  try { delivery = findRow_('deliveries', 'delivery_id', deliveryId); } catch (e) { delivery = null; }
  if (!delivery) { out.channel = 'sms'; return out; } // 受信者行のみ先行する SMS ボタン起点を想定
  out.sender_email = str_(delivery.sender_email);
  out.sender_name = str_(delivery.sender_name);
  out.delivery_created_at = cellDateIso_(delivery.created_at);
  out.mode = str_(delivery.mode);
  out.channel = 'mail';
  try {
    var fj = JSON.parse(str_(delivery.filter_json) || '{}');
    if (fj && fj.form_invite && fj.channel) out.channel = String(fj.channel); // issueFormToken の発行種別
  } catch (e2) {}
  return out;
}

/** 電話番号の正規化 (数字のみ・国際表記 81 始まりは 0 始まりへ) */
function normalizePhoneDigits_(v) {
  // R3 (F5): 全角数字を半角化してから数字以外を除く (全角のままだと [^0-9] で
  // 数字そのものが消えて照合不能になっていた)。+81 形式は 0 始まりへ寄せる。
  var s = str_(v).replace(/[０-９]/g, function (c) {
    return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
  });
  var d = s.replace(/[^0-9]/g, '');
  if (d.length >= 11 && d.slice(0, 2) === '81') d = '0' + d.slice(2);
  return d;
}

/** 電話番号で applicants を一意照合する。0件・複数件は null (誤照合で他人を特定しない) */
function findApplicantByPhone_(phone) {
  var target = normalizePhoneDigits_(phone);
  if (!target || target.length < 10) return null;
  var rows = readTable_('applicants').rows;
  var hit = null, count = 0;
  for (var i = 0; i < rows.length; i++) {
    if (normalizePhoneDigits_(rows[i].phone) === target) { hit = rows[i]; count++; }
  }
  return count === 1 ? hit : null;
}

/** アプリのベースURL (ハッシュ除去済み)。設定が無ければ '' */
function appBaseUrl_() {
  try {
    var explicit = getSettingValue_('app_base_url', '') || getSettingValue_('admin_url', '') ||
      getSettingValue_('responses_url', '') || getSettingValue_('form_base_url', '');
    if (!explicit) return '';
    var h = explicit.indexOf('#');
    return h >= 0 ? explicit.slice(0, h) : explicit;
  } catch (e) { return ''; }
}

/** 本人カードへの導線URL (応募者一覧で本人を開く。フロント配線仕様は FORM_SYSTEM.md) */
function applicantCardUrl_(applicantId) {
  var base = appBaseUrl_();
  if (!base) return '(本人カードURL未設定: settings に app_base_url を設定してください) applicant_id=' + applicantId;
  return base + '#/list?applicant=' + encodeURIComponent(applicantId);
}

/** 回答一覧で当該回答にフォーカスする導線URL */
function responseFocusUrl_(responseId) {
  var base = appBaseUrl_();
  if (!base) return responseListUrl_();
  return base + '#/responses?focus=' + encodeURIComponent(responseId);
}

/** 本人専用フォームURL (issueFormToken 用) */
function formUrlForToken_(token) {
  var base = '';
  try { base = getSettingValue_('form_base_url', '') || appBaseUrl_(); } catch (e) {}
  if (!base) return '';
  if (base.indexOf('#') >= 0) return base + (base.indexOf('?') >= 0 ? '&' : '?') + 'token=' + encodeURIComponent(token);
  return base + '#/form?token=' + encodeURIComponent(token);
}

/**
 * 朝の棚卸し用サマリ (軽量・件数のみ)。rows は responses の生行。
 * open = 未対応 + 対応中 (対応済みにするまでキューから消えない)。
 */
function computeResponseSummary_(rows) {
  var today = todayYmd_();
  var counts = { unhandled: 0, in_progress: 0, handled: 0 };
  var oldestOpen = null, nearestPhone = '', phoneToday = 0, phoneApproaching = false;
  var senderUnknownOpen = 0;
  // Supplement 21: calendar linkage counts. calendar_unregistered_count counts
  // OPEN responses (not handled) that carry an interview wish but have no
  // calendar_event_id yet, so an unregistered phone appointment surfaces in
  // the morning inventory / unhandled queue instead of being left behind.
  // calendar_registered_count counts rows (any status) that have an event id.
  var calendarUnregistered = 0, calendarRegistered = 0;
  // Supplement 23: responses whose Sugimoto-only auto-creation failed. Counted
  // for OPEN rows that still have no event id, so a failure stays visible in
  // the morning inventory until the one-tap fallback registers it.
  var calendarAutoFailed = 0;
  // R4 04-01/04-02/04-09: 通知未達・送信元不明の最古・未特定電話希望の集計。
  var notifyFailed = 0, senderUnknownOldest = null;
  var phoneUnparsed = 0, phoneUnparsedOldestDays = 0;
  (rows || []).forEach(function (r) {
    var st = responseStatus_(r);
    counts[st]++;
    if (str_(r.calendar_event_id)) calendarRegistered++;
    if (st !== 'handled' && toBool_(r.calendar_auto_failed) && !str_(r.calendar_event_id)) calendarAutoFailed++;
    if (st !== 'handled' &&
        (str_(r.notify_status) === 'failed' || str_(r.notify_status) === 'not_attempted')) {
      notifyFailed++;
    }
    if (st === 'handled') return;
    if (responseHasInterviewWish_(r) && !str_(r.calendar_event_id)) calendarUnregistered++;
    if (!str_(r.sender_email)) {
      senderUnknownOpen++;
      var uCreated = cellDateIso_(r.created_at);
      if (uCreated && (!senderUnknownOldest || uCreated < senderUnknownOldest.created_at)) {
        senderUnknownOldest = { response_id: str_(r.response_id),
          applicant_id: str_(r.applicant_id), created_at: uCreated,
          age_days: diffDaysYmd_(today, uCreated.slice(0, 10)) };
      }
    }
    var created = cellDateIso_(r.created_at);
    if (created && (!oldestOpen || created < oldestOpen.created_at)) {
      oldestOpen = { response_id: str_(r.response_id), applicant_id: str_(r.applicant_id),
        created_at: created, age_days: diffDaysYmd_(today, created.slice(0, 10)) };
    }
    var phoneText = unifiedPhoneText_(r); // R4 レーンJ 項目2: 旧行 (interview のみ) も集計対象に含める
    if (phoneText) {
      // フォーム専用チーム (追補37): 構造化された幅があれば今日連絡判定はそちらを正とする。
      var hint = phoneStructuredHint_(r, today) ||
        parsePhoneConsultHint_(phoneText, created ? created.slice(0, 10) : today);
      var urg = phoneUrgency_(hint, true, today);
      if (urg === 'overdue' || urg === 'today') phoneToday++;
      if (urg === 'overdue' || urg === 'today' || urg === 'soon') phoneApproaching = true;
      if (hint && (!nearestPhone || hint < nearestPhone)) nearestPhone = hint;
      // R4 04-09: 日時未特定の電話希望は phone_today に混ぜず独立に数える。
      if (urg === 'unparsed') {
        phoneUnparsed++;
        var pAge = created ? diffDaysYmd_(today, created.slice(0, 10)) : 0;
        if (pAge != null && pAge > phoneUnparsedOldestDays) phoneUnparsedOldestDays = pAge;
      }
    }
  });
  return {
    counts: counts,
    unhandled_count: counts.unhandled,
    open_count: counts.unhandled + counts.in_progress,
    oldest_open: oldestOpen,
    phone_today_count: phoneToday,
    phone_approaching: phoneApproaching,
    nearest_phone_hint: nearestPhone,
    sender_unknown_open_count: senderUnknownOpen,
    sender_unknown_oldest: senderUnknownOldest,
    notify_failed_count: notifyFailed,
    phone_unparsed_count: phoneUnparsed,
    phone_unparsed_oldest_days: phoneUnparsedOldestDays,
    calendar_unregistered_count: calendarUnregistered,
    calendar_registered_count: calendarRegistered,
    calendar_auto_failed_count: calendarAutoFailed
  };
}

function responseSummarySafe_() {
  try { return computeResponseSummary_(readTable_('responses').rows); }
  catch (e) { return null; }
}

/** 回答1件の返却形 (status・電話優先度・送信元不明フラグつき) */
function responseItem_(r) {
  var name = '';
  try { name = str_(findApplicant_(r.applicant_id).name); } catch (e) {}
  var st = responseStatus_(r);
  var phoneText = unifiedPhoneText_(r); // R4 レーンJ 項目2: phone 優先・interview 互換の統一読み取り
  var created = cellDateIso_(r.created_at);
  // フォーム専用チーム (追補37): 構造化された電話の幅があればテキスト解釈より優先する。
  var structuredHint = phoneStructuredHint_(r, todayYmd_());
  var hint = structuredHint ||
    (phoneText ? parsePhoneConsultHint_(phoneText, created ? created.slice(0, 10) : todayYmd_()) : '');
  var urg = phoneUrgency_(hint, !!phoneText, todayYmd_());
  return {
    response_id: str_(r.response_id), delivery_id: str_(r.delivery_id),
    applicant_id: str_(r.applicant_id), applicant_name: name,
    sender_email: str_(r.sender_email),
    sender_unknown: !str_(r.sender_email),
    source_channel: str_(r.source_channel),
    intent: str_(r.intent),
    experience: str_(r.experience),
    interview_desired_date: cellDateYmd_(r.interview_desired_date) || str_(r.interview_desired_date),
    desired_start_date: cellDateYmd_(r.desired_start_date) || cellDateYmd_(r.available_start_date),
    selected_case_ids: str_(r.selected_case_ids),
    experience_years: toNum_(r.experience_years),
    qualifications: str_(r.qualifications),
    available_start_date: cellDateYmd_(r.available_start_date),
    // 追補39/フォーム専用チーム: 見学希望日は複数日 (カンマ区切り文字列) で届く
    // ため、単日変換で落ちる場合は文字列のまま返す。
    desired_tour_date: cellDateYmd_(r.desired_tour_date) || str_(r.desired_tour_date),
    phone_consult_datetime: phoneText,
    // フォーム専用チーム (追補37/38): 構造化された回答項目 (キュー表示・今日連絡判定用)
    phone_dates: sanitizePhoneDates_(r.phone_dates).join(','),
    phone_bands: sanitizePhoneBands_(r.phone_bands).join(','),
    phone_anytime: toBool_(r.phone_anytime),
    experience_band: str_(r.experience_band),
    experience_detail: str_(r.experience_detail),
    desired_rate_band: str_(r.desired_rate_band),
    has_phone_consult: !!phoneText,
    phone_date_hint: hint,
    phone_urgency: urg,
    phone_priority: (PHONE_URGENCY_RANK_[urg] != null ? PHONE_URGENCY_RANK_[urg] : 5),
    // 追客「今日対応」と統合するための判定: 電話希望があり期限が今日以前のもの
    phone_due_today: (urg === 'overdue' || urg === 'today'),
    // R4 04-09: 日時未特定の電話希望 (due_today には混ぜない独立区分)
    phone_unparsed: (urg === 'unparsed'),
    // R4 04-01: 通知の永続状態 (未達の行だけ再送ボタンを出すために使う)
    notify_status: str_(r.notify_status),
    notify_attempts: toNum_(r.notify_attempts) || 0,
    free_text: str_(r.free_text),
    // Supplement 21: calendar linkage per item. has_interview_wish = the
    // response carries interview_desired_date or phone_consult_datetime.
    // calendar_unregistered (item flag) = wish present and no event id yet
    // (regardless of status; the summary count narrows this to open rows).
    has_interview_wish: responseHasInterviewWish_(r),
    calendar_event_id: str_(r.calendar_event_id),
    calendar_registered: !!str_(r.calendar_event_id),
    calendar_unregistered: responseHasInterviewWish_(r) && !str_(r.calendar_event_id),
    calendar_registered_by: str_(r.calendar_registered_by),
    calendar_registered_at: cellDateIso_(r.calendar_registered_at),
    // Supplement 23: true when the Sugimoto-only auto-creation failed for this
    // response (cleared once any registration succeeds). Front-end should
    // highlight it; the one-tap createPhoneAppointment remains the fallback.
    calendar_auto_failed: toBool_(r.calendar_auto_failed) && !str_(r.calendar_event_id),
    status: st,
    status_by: str_(r.status_by), status_at: cellDateIso_(r.status_at),
    handled: st === 'handled', handled_by: str_(r.handled_by),
    handled_at: cellDateIso_(r.handled_at), created_at: created
  };
}

/** 選択案件IDを「施設名 (case_id)」表記に解決する。解決できないIDはそのまま出す */
function selectedCaseLabels_(caseIds) {
  if (!caseIds || !caseIds.length) return '(選択なし)';
  return caseIds.map(function (id) {
    try {
      var c = findRow_('cases', 'case_id', id);
      return str_(c.facility_name) ? str_(c.facility_name) + ' (' + id + ')' : id;
    } catch (e) { return id; }
  }).join(', ');
}

/**
 * 回答一覧への導線URL。優先順: settings.responses_url > admin_url > app_base_url >
 * form_base_url から組み立て (末尾に #responses)。いずれも無ければプレースホルダ文。
 */
function responseListUrl_() {
  try {
    var explicit = getSettingValue_('responses_url', '') || getSettingValue_('admin_url', '') ||
      getSettingValue_('app_base_url', '');
    if (explicit) return explicit;
    var formBase = getSettingValue_('form_base_url', '');
    if (formBase) return formBase + (formBase.indexOf('#') >= 0 ? '' : '#responses');
  } catch (e) { /* 設定が読めなくても通知本文の組み立ては続ける */ }
  return '(回答一覧URL未設定: settings に responses_url または form_base_url を設定してください)';
}

// ===== 回答一覧 / 対応済み化 =====
function actionGetResponses_(req) {
  // R3 (P2): 回答は個人情報を含むため、他の読み取り系と同じくキカリ認証を必須にする
  // (従来は未認証で all_senders の全件返却が可能だった)。
  requireKikariUser_();
  var sender = String(req.sender_email || '');
  if (req.all_senders !== true && !sender) {
    var me = currentUserEmail_();
    if (me && me.slice(-DOMAIN_SUFFIX.length) === DOMAIN_SUFFIX) sender = me; // 初期値は自分
  }
  // Summary is computed over the sender scope BEFORE status filtering, so the
  // badge / morning-inventory numbers stay stable whichever tab is open.
  var allResponseRows = readTable_('responses').rows;
  var scoped = allResponseRows.filter(function (r) {
    if (sender && String(r.sender_email).toLowerCase() !== sender.toLowerCase()) return false;
    return true;
  });
  var summary = computeResponseSummary_(scoped);
  applyGlobalSenderUnknown_(summary, allResponseRows);
  var wantStatus = RESPONSE_STATUSES_.indexOf(String(req.status || '')) >= 0 ? String(req.status) : '';
  var rows = scoped.filter(function (r) {
    var st = responseStatus_(r);
    if (wantStatus && st !== wantStatus) return false;
    if (req.handled === true && st !== 'handled') return false;
    if (req.handled === false && st === 'handled') return false;
    if (req.sender_unknown === true && str_(r.sender_email)) return false;
    if (req.phone_only === true && !unifiedPhoneText_(r)) return false;
    if (req.calendar_unregistered === true &&
        !(responseHasInterviewWish_(r) && !str_(r.calendar_event_id))) return false;
    if (req.calendar_registered === true && !str_(r.calendar_event_id)) return false;
    if (req.phone_due_today === true) {
      var it = responseItem_(r);
      if (st === 'handled' || !it.phone_due_today) return false;
    }
    return true;
  });
  // Sort (supplement 20-3): open first (unhandled -> in_progress -> handled),
  // then phone urgency (overdue/today first, nearest hint first), newest first.
  // req.sort='recent' restores the legacy newest-first order.
  if (req.sort === 'recent') {
    rows.sort(function (a, b) {
      var x = cellDateIso_(a.created_at), y = cellDateIso_(b.created_at);
      return x < y ? 1 : (x > y ? -1 : 0);
    });
  } else {
    var statusRank = { unhandled: 0, in_progress: 1, handled: 2 };
    var decorated = rows.map(function (r) { return { row: r, item: responseItem_(r) }; });
    decorated.sort(function (a, b) {
      var sa = statusRank[a.item.status], sb = statusRank[b.item.status];
      if (sa !== sb) return sa - sb;
      if (a.item.phone_priority !== b.item.phone_priority) return a.item.phone_priority - b.item.phone_priority;
      var ha = a.item.phone_date_hint || '9999-99-99', hb = b.item.phone_date_hint || '9999-99-99';
      if (ha !== hb) return ha < hb ? -1 : 1;
      var x = a.item.created_at, y = b.item.created_at;
      return x < y ? 1 : (x > y ? -1 : 0);
    });
    var limitR = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
    var offsetR = Math.max(0, parseInt(req.offset, 10) || 0);
    return { total: rows.length, unhandled_count: summary.unhandled_count,
      open_count: summary.open_count, summary: summary,
      items: decorated.slice(offsetR, offsetR + limitR).map(function (d) { return d.item; }) };
  }
  var limit = Math.min(500, Math.max(1, parseInt(req.limit, 10) || 200));
  var offset = Math.max(0, parseInt(req.offset, 10) || 0);
  var items = rows.slice(offset, offset + limit).map(function (r) { return responseItem_(r); });
  return { total: rows.length, unhandled_count: summary.unhandled_count,
    open_count: summary.open_count, summary: summary, items: items };
}

/** Light summary only (badge / morning inventory). No items are returned. */
/**
 * R4 04-02/A-07: 送信元不明の件数はスコープ (送信者絞り込み) の外で常時数える。
 * 不明分の引き取りは全員の仕事であり、既定スコープの summary で 0 に潰れると
 * 「誰にも見えないまま滞留する」事故になるため、全行基準で上書きする。
 */
function applyGlobalSenderUnknown_(summary, allRows) {
  var global = computeResponseSummary_(allRows || []);
  summary.sender_unknown_open_count = global.sender_unknown_open_count;
  summary.sender_unknown_oldest = global.sender_unknown_oldest;
