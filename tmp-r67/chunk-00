function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
function errMsg_(err) { return String(err && err.message ? err.message : err); }

function dispatch_(req) {
  var action = String(req.action || '');
  switch (action) {
    // 疎通
    case 'ping': return actionPing_(req);
    // 応募者
    case 'searchApplicants': return actionSearchApplicants_(req);
    case 'getApplicantSummary': return actionGetApplicantSummary_(req);
    case 'getApplicant': return actionGetApplicant_(req);
    case 'updateWorkflow': return actionUpdateWorkflow_(req);
    case 'markSmsSent': return actionRecordSmsSent_(req);
