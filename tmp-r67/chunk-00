// ===== Script Properties / ブック / シート =====
function prop_(key) {
var v = PropertiesService.getScriptProperties().getProperty(key);
if (!v) throw new Error('Script Properties に ' + key + ' が未設定です。init_sheets.gs の createAllBooks() を実行してください');
return v;
}

var bookCache_ = {};
function book_(propKey) {
if (!bookCache_[propKey]) bookCache_[propKey] = SpreadsheetApp.openById(prop_(propKey));
return bookCache_[propKey];
}

function sheet_(tableName) {
var def = TABLE_DEFS_[tableName];
if (!def) throw new Error('未知のテーブル: ' + tableName);
var sh = book_(def.book).getSheetByName(tableName);
if (!sh) throw new Error('シート「' + tableName + '」がありません。createAllBooks() を実行してください');
return sh;
}

// ===== 汎用テーブル IO (列はヘッダー名で解決する) =====
/** シートを { headers:[...], rows:[{列名:値, _row: シート行番号}]} で読む */
function readTable_(tableName) {
var sh = sheet_(tableName);
var values = sh.getDataRange().getValues();
if (!values.length) return { headers: TABLE_DEFS_[tableName].headers.slice(), rows: []};
var headers = values[0].map(function (h) { return String(h || '').trim();});
var rows = [];
for (var i = 1; i < values.length; i++) {
var obj = { _row: i + 1};
var empty = true;
for (var c = 0; c < headers.length; c++) {
if (!headers[c]) continue;
obj[headers[c]] = values[i][c];
if (values[i][c]!== '' && values[i][c]!= null) empty = false;
}
if (!empty) rows.push(obj);
}
return { headers: headers, rows: rows};
}

/** オブジェクトを1行追記する (ヘッダーに無いキーは無視、無い列は空) */
function appendRow_(tableName, obj) {
var sh = sheet_(tableName);
var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (h) { return String(h || '').trim();});
var row = headers.map(function (h) { return obj[h] == null? '': obj[h];});
sh.appendRow(row);
return sh.getLastRow();
}

/** 複数行をまとめて追記する (R4 06-07 のバッチ書き込みヘルパー)。
 * 内部は現行の書き込み経路 (appendRow_) を行ごとに呼ぶが、1行の失敗で残りを
 * 止めず、行ごとの成否を返す。呼び出し側は「一括で渡し、失敗分だけを数える」
 * 一括前提の構造にすること。実シートへの setValues 一括書き込みは appendRow_
 * 抽象の内側の最適化であり、本ヘルパーの契約 (戻り値) は変えない。 */
function appendRows_(tableName, objs) {
objs = objs || [];
if (!objs.length) return { written: 0, errors: [] };
// R6: 実シートでは setValues 一括書き込みにする (行ごとの appendRow は
// ヘッダー再読込+appendRow を行数分繰り返し、数千行で分単位に膨らむ)。
// 一括が使えない環境 (テストスタブ等) や一括自体が失敗した場合は、
// 従来の行単位書き込みにフォールバックして行ごとの成否契約を守る。
try {
var sh = sheet_(tableName);
var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (h) { return String(h || '').trim(); });
var rng = sh.getRange(sh.getLastRow() + 1, 1, objs.length, headers.length);
if (!rng || typeof rng.setValues !== 'function') throw new Error('bulk write unavailable');
var matrix = objs.map(function (obj) { return headers.map(function (h) { return obj[h] == null ? '' : obj[h]; }); });
rng.setValues(matrix);
return { written: objs.length, errors: [] };
} catch (bulkErr) {
var written = 0, errors = [];
objs.forEach(function (obj, i) {
try { appendRow_(tableName, obj); written++; }
catch (e) { errors.push({ index: i, message: errMsg_(e) }); }
});
return { written: written, errors: errors };
}
}

/** 主キーで1行を探して部分更新する。見つからなければ throw */
function updateRowByPk_(tableName, pkValue, patch) {
var pk = TABLE_PK_[tableName];
var t = readTable_(tableName);
var headers = t.headers;
for (var i = 0; i < t.rows.length; i++) {
if (String(t.rows[i][pk]) === String(pkValue)) {
var sh = sheet_(tableName);
Object.keys(patch).forEach(function (k) {
var col = headers.indexOf(k);
if (col >= 0) sh.getRange(t.rows[i]._row, col + 1).setValue(patch[k] == null? '': patch[k]);
});
return t.rows[i];
}
}
throw new Error(tableName + ' に ' + pk + '=' + pkValue + ' が見つかりません');
}

/** 連番IDを採番する (既存の最大番号+1。シート走査ベースの簡易実装) */
function nextId_(tableName) {
var pk = TABLE_PK_[tableName];
var prefix = ID_PREFIX_[tableName] || 'X';
var t = readTable_(tableName);
var max = 0;
t.rows.forEach(function (r) {
var m = String(r[pk] || '').match(new RegExp('^' + prefix + '(\\d+)$'));
if (m) max = Math.max(max, parseInt(m[1], 10));
});
var n = String(max + 1);
while (n.length < 6) n = '0' + n;
return prefix + n;
}

// ===== 小物ユーティリティ =====
function nowIso_() { return new Date().toISOString();}

function str_(v) { return v == null? '': String(v);}

/** メールアドレス正規化の唯一の実装 (R4 O-03: trim + NFKC + 小文字化)。
 * 前後空白・全角空白・全角英字/＠の表記ゆれを吸収する。照合・保存は全てこれを通す。 */
function normalizeEmail_(v) {
var s = str_(v);
try { s = s.normalize('NFKC'); } catch (e) {}
return s.replace(/^[\s　]+|[\s　]+$/g, '').toLowerCase();
}

/** メール形式の検証 (R4 01-#7: フロントと同じ簡易式)。正規化済み文字列に当てる。 */
function isValidEmail_(v) {
return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(str_(v));
}

/** 対応中 (進行中) 判定の正本 (R4 01-#3): csvStageRank_ の正規化判定で見る。
 * stage>=2 (誘致待ち〜稼働中) が対応中。接触待ち (stage1) は対象内に残す。
 * 表記ゆれ (内定済み/稼働済み/FIX済み 等) も正規化で拾う。 */
function isActiveCsvStatus_(raw) {
var st = csvStageRank_(raw);
return !!(st.inFlow && st.stage >= 2);
}

/** 本日 (JST) すでにメール送信済みの応募者 (R4 01-#10)。
 * 戻り値: applicant_id -> 送信元 delivery_id の配列 (自配信の自己ブロック回避に使う)。
 * delivery_recipients (status=sent) を主、applicant_events の mail_sent を補助とする。 */
function mailSentTodayMap_() {
var today = todayYmd_();
var map = {};
var add = function (aid, did) {
if (!aid) return;
map[aid] = map[aid] || [];
if (did && map[aid].indexOf(did) < 0) map[aid].push(did);
};
try {
readTable_('delivery_recipients').rows.forEach(function (r) {
if (str_(r.status) !== 'sent') return;
if (cellDateYmd_(r.sent_at) !== today) return;
add(str_(r.applicant_id), str_(r.delivery_id));
});
} catch (e) {}
try {
readTable_('applicant_events').rows.forEach(function (r) {
if (str_(r.event_type) !== 'mail_sent') return;
if (cellDateYmd_(r.created_at) !== today) return;
add(str_(r.applicant_id), str_(r.delivery_id));
});
} catch (e) {}
return map;
}

/** 本日作成され未送信 (pending) の宛先がある応募者の集合 (R4 01-#10: 警告表示用)。 */
function mailQueuedTodaySet_() {
var today = todayYmd_();
var set = {};
try {
readTable_('delivery_recipients').rows.forEach(function (r) {
if (str_(r.status) !== 'pending') return;
if (cellDateYmd_(r.created_at) !== today) return;
var aid = str_(r.applicant_id);
if (aid) set[aid] = true;
});
} catch (e) {}
return set;
}

function toBool_(v) {
if (v === true) return true;
var s = String(v == null? '': v).trim().toLowerCase();
return s === 'true' || s === '1' || s === 'yes';
}

function toNum_(v) {
if (v === '' || v == null) return null;
var n = Number(v);
return isFinite(n)? n: null;
}

/** セル値 (Date / 文字列) を ISO 文字列にする。空は '' */
function cellDateIso_(v) {
if (v == null || v === '') return '';
if (v instanceof Date) return v.toISOString();
var d = new Date(v);
return isNaN(d.getTime())? String(v): d.toISOString();
}

/** YYYY-MM-DD を返す (表示・比較用)。
 * R4 T-4: Date 型セルは Asia/Tokyo 基準で整形する。toISOString (UTC) 基準だと
 * JST 深夜0時のセルが前日にずれる (応募期間・年齢・カレンダー・掘り起こしに波及)。 */
function cellDateYmd_(v) {
if (v == null || v === '') return '';
if (v instanceof Date) {
if (isNaN(v.getTime())) return '';
try { return Utilities.formatDate(v, 'Asia/Tokyo', 'yyyy-MM-dd'); } catch (e) { /* フォールバックへ */ }
}
var iso = cellDateIso_(v);
return iso? iso.substring(0, 10): '';
}

/**
 * 日時文字列 / Date を Date に変換する (変換できなければ null)。
 * relay.gs の relayFormExpiresAt_ が依存する共通ユーティリティ。
 * R6.7: relay 単体テストではスタブで与えられていたため本番 Code.gs 側の
 * 定義漏れが検出されず、relay プッシュが毎回 ReferenceError になっていた。
 */
function parseDateTime_(v) {
if (v == null || v === '') return null;
var d = (v instanceof Date) ? v : new Date(v);
return isNaN(d.getTime()) ? null : d;
}

/** ハバーシン距離 (km)。座標が欠けていれば null */
function distanceKm_(lat1, lon1, lat2, lon2) {
var a = toNum_(lat1), b = toNum_(lon1), c = toNum_(lat2), d = toNum_(lon2);
if (a == null || b == null || c == null || d == null) return null;
// R4 I-3 (多層防御): 既存マスターに混入済みの異常座標 (0,0・入替・域外) は
// 距離として効かせない。ok でないペアは「距離不明」に倒し、同一市区町村
// フォールバックだけが残るようにする。
if (coordBasicCheck_(a, b).state !== 'ok' || coordBasicCheck_(c, d).state !== 'ok') return null;
var R = 6371, rad = Math.PI / 180;
var dLat = (c - a) * rad, dLon = (d - b) * rad;
var h = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
Math.cos(a * rad) * Math.cos(c * rad) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
return 2 * R * Math.asin(Math.sqrt(h));
}

// ===== R4 I-3: 座標チェック3点 (11-#7/#8 への組み込み) =====
// 範囲と40kmの閾値の出典は CHATGPT_INTEL §2 の ChatGPT 自己報告 (旧アプリ
// コードの直接検証ではない)。重複閾値10件は出典のない新規パラメータで、
// 運用開始後に computeCaseIntegrity_ の集計を見て調整する前提。
var COORD_JP_ = { latMin: 20, latMax: 46, lonMin: 122, lonMax: 154 };
var COORD_REP_LIMIT_KM = 40;
var COORD_DUP_THRESHOLD = 10;

/** 座標の基本チェック。第1層 (単体で判定できる範囲・入替・欠落)。
 * 戻り値: { state:'none'|'ok'|'invalid', lat, lon, reason } */
function coordBasicCheck_(latRaw, lonRaw) {
  var hasLat = !(latRaw === '' || latRaw == null);
  var hasLon = !(lonRaw === '' || lonRaw == null);
  if (!hasLat && !hasLon) return { state: 'none', lat: '', lon: '', reason: '' };
  if (hasLat !== hasLon) return { state: 'invalid', lat: '', lon: '', reason: 'partial' };
  var lat = toNum_(latRaw), lon = toNum_(lonRaw);
  if (lat == null || lon == null) return { state: 'invalid', lat: '', lon: '', reason: 'non_numeric' };
  if (lat === 0 && lon === 0) return { state: 'invalid', lat: '', lon: '', reason: 'zero' };
  if (lat >= COORD_JP_.latMin && lat <= COORD_JP_.latMax &&
      lon >= COORD_JP_.lonMin && lon <= COORD_JP_.lonMax) {
    return { state: 'ok', lat: lat, lon: lon, reason: '' };
  }
  // 入替検出: 交換すると日本域に入る場合だけ 'swapped' と断定する (自動補正はしない)。
  if (lon >= COORD_JP_.latMin && lon <= COORD_JP_.latMax &&
      lat >= COORD_JP_.lonMin && lat <= COORD_JP_.lonMax) {
    return { state: 'invalid', lat: '', lon: '', reason: 'swapped' };
  }
  return { state: 'invalid', lat: '', lon: '', reason: 'out_of_range' };
}

/** 精密扱いの判定 (第2層)。repPoint が引けない場合は (b) を判定しない。
 * dupCount は同一座標を使う「異なる住所」の件数 (代表点一致の座標は母数外)。 */
function coordPrecisionCheck_(lat, lon, repPoint, dupCount) {
  if (repPoint) {
    var d = distanceKm_(lat, lon, repPoint.lat, repPoint.lon);
    if (d != null && d > COORD_REP_LIMIT_KM) return { precise: false, reason: 'far_from_rep' };
  }
  if (dupCount != null && dupCount >= COORD_DUP_THRESHOLD) {
    return { precise: false, reason: 'duplicated' };
  }
  return { precise: true, reason: '' };
}

/** municipalities の代表点マップ (同一実行内はメモ化。bulk 取り込みでの再読みを防ぐ) */
var MUNICIPALITY_REP_MAP_ = null;
function municipalityRepMap_() {
  if (MUNICIPALITY_REP_MAP_) return MUNICIPALITY_REP_MAP_;
  var map = {};
  try {
    readTable_('municipalities').rows.forEach(function (m) {
      var chk = coordBasicCheck_(m.lat, m.lon);
      if (chk.state === 'ok') {
        map[str_(m.prefecture) + '|' + str_(m.municipality)] = { lat: chk.lat, lon: chk.lon };
      }
    });
  } catch (e) {}
  MUNICIPALITY_REP_MAP_ = map;
  return map;
}

/** municipalities マスターから代表点を引く (基本チェックを通ったものだけ返す) */
function municipalityRepPoint_(prefecture, municipality) {
  return municipalityRepMap_()[str_(prefecture) + '|' + str_(municipality)] || null;
}

/** 持ち込み座標の受け入れ判定。NG または精密でない場合は座標なしへ降格する
 * (サーバーに精度列が無いため。座標なしでも市区町村フォールバックで候補化される)。
 * 戻り値: { lat, lon, verdict:'none'|'precise'|'downgraded', reason } */
function acceptCoord_(latRaw, lonRaw, repPoint, dupCount) {
  var basic = coordBasicCheck_(latRaw, lonRaw);
  if (basic.state === 'none') return { lat: '', lon: '', verdict: 'none', reason: '' };
  if (basic.state === 'invalid') return { lat: '', lon: '', verdict: 'downgraded', reason: basic.reason };
  var prec = coordPrecisionCheck_(basic.lat, basic.lon, repPoint, dupCount);
  if (!prec.precise) return { lat: '', lon: '', verdict: 'downgraded', reason: prec.reason };
  return { lat: basic.lat, lon: basic.lon, verdict: 'precise', reason: '' };
}

/** 座標の正規キー (小数6桁)。基本チェック NG は空文字。 */
function coordKey_(lat, lon) {
  var chk = coordBasicCheck_(lat, lon);
  return chk.state === 'ok' ? chk.lat.toFixed(6) + ',' + chk.lon.toFixed(6) : '';
}

/** 同一座標キー → 異なる住所の件数マップ ((c) の集計用)。
 * rows: [{lat, lon, addressKey}]。excludeKeys にある座標 (市区町村代表点など、
 * 正常な共有) は 0 を返して母数から除く。 */
function coordDupCountMap_(rows, excludeKeys) {
  var byKey = {};
  rows.forEach(function (r) {
    var key = coordKey_(r.lat, r.lon);
    if (!key) return;
    if (!byKey[key]) byKey[key] = {};
    byKey[key][String(r.addressKey || '')] = true;
  });
  var out = {};
  Object.keys(byKey).forEach(function (key) {
    out[key] = (excludeKeys && excludeKeys[key]) ? 0 : Object.keys(byKey[key]).length;
  });
  return out;
}

/** municipalities 全行の代表点キー集合 ((c) の母数から除く用) */
function municipalityRepKeys_() {
  var keys = {};
  Object.keys(municipalityRepMap_()).forEach(function (k) {
    var p = municipalityRepMap_()[k];
    keys[p.lat.toFixed(6) + ',' + p.lon.toFixed(6)] = true;
  });
  return keys;
}

/** 書き込み系の直列化ラッパー
 * R6: インポート確定のチャンクが連続する運用では、短時間の競合を
 * エラーにせず待機して処理する。Apps Script の waitLock を優先し、
 * 利用できない実行環境/テストスタブでは tryLock を最大120秒まで
 * 小刻みに再試行する。待機し切れない場合だけ従来の競合エラーを返す。 */
function withLock_(fn) {
var lock = LockService.getScriptLock();
var acquired = false;
if (lock && typeof lock.waitLock === 'function') {
  try { lock.waitLock(120000); acquired = true; }
  catch (e) { throw new Error('別の書き込み処理が実行中です。少し待ってから再試行してください'); }
} else {
  var deadline = Date.now() + 120000;
  while (!acquired && Date.now() <= deadline) {
    if (lock.tryLock(5000)) { acquired = true; break; }
    if (typeof Utilities !== 'undefined' && Utilities && typeof Utilities.sleep === 'function') Utilities.sleep(250);
    else break;
  }
}
if (!acquired) throw new Error('別の書き込み処理が実行中です。少し待ってから再試行してください');
try { return fn();} finally { lock.releaseLock();}
}

/** applicant_events へ append-only で記録する (ロック取得済みの文脈から呼ぶこと) */
function appendEvent_(applicantId, eventType, actor, detail, deliveryId, responseId, extra) {
var row = {
event_id: nextId_('applicant_events'),
applicant_id: applicantId,
event_type: eventType,
actor: actor || 'system',
delivery_id: deliveryId || '',
response_id: responseId || '',
detail: detail || '',
created_at: nowIso_()
};
// R3: 送信スナップショット (本文・提示案件) をイベントにも残す (追補24)。
// シート側に body_snapshot / case_ids 列が無い環境では appendRow_ が黙って落とす。
if (extra && extra.body_snapshot) row.body_snapshot = extra.body_snapshot;
if (extra && extra.case_ids) row.case_ids = extra.case_ids;
// R4 S-02/S-11: 案件の写し JSON と冪等キーもイベントに残す (列が無い環境では appendRow_ が落とす)。
if (extra && extra.cases_snapshot) row.cases_snapshot = extra.cases_snapshot;
if (extra && extra.client_request_id) row.client_request_id = extra.client_request_id;
return appendRow_('applicant_events', row);
}

