/**
 * filter のキー:
 *  keyword (氏名 部分一致), phone (電話 部分一致), area, prefecture,
 *  prefectures (配列 or カンマ区切り: 複数都道府県。単一 prefecture と併用した場合は両方を満たす AND),
 *  desired_keyword (希望条件キーワード: desired_days_per_week + desired_time_slots への部分一致),
 *  municipalities (配列 or カンマ区切り), job_type,
 *  sms_state ('sent'|'unsent'|''), csv_statuses (配列), app_status,
 *  applied_from / applied_to (YYYY-MM-DD), source_companies (配列),
 *  start_from / start_to (入職希望日範囲),
 *  has_past_fs (bool, 追補7。追補17以降は has_fs_history フィールドが正で、has_fs_history でも同じ絞り込み可),
 *  due_next_contact (bool: next_contact_date が今日以前, 追補7),
 *  mail_only (bool: メールありのみ。Gmail 用), qualifications (コード配列, OR),
 *  include_test (bool, 追補22: 既定 false。is_test=true のテスト求職者は既定で除外し、
 *    true を明示したときだけ含める。searchApplicants / mailPreviewTargets /
 *    computeMailTargets_ / getDigList はすべて本関数経由なので、ここが除外の唯一の判定点)
 */
/**
 * 資格マッチ (R3・G2 でフロント qualMatch と統一した唯一のルール):
 * 保有資格文字列 (カンマ/読点/スラッシュ区切り) の各トークンと希望資格を
 * NFKC+空白除去で正規化して比較し、次のいずれかで一致とする。
 *  - 完全一致
 *  - 希望「看護師」× 保有「正看護師」(正看護師は看護師に含める)
 *  - 希望「正看護師」× 保有「看護師」(登録表記が略称のケース)
 *  - 保有トークンが希望資格を含む (例: 介護福祉士（登録済）等)
 *    ただし希望「看護師」× 保有「准看護師」は別資格なので一致させない。
 */
function qualTokenMatch_(haveStr, want) {
  var w = str_(want).normalize('NFKC').replace(/\s/g, '');
  if (!w) return false;
  var tokens = str_(haveStr).split(/[,、\/／・]/).map(function (s) {
    return s.normalize('NFKC').replace(/\s/g, '');
  }).filter(function (s) { return s !== ''; });
  for (var i = 0; i < tokens.length; i++) {
    var t = tokens[i];
    if (t === w) return true;
    if (w === '看護師' && t === '正看護師') return true;
    if (w === '正看護師' && t === '看護師') return true;
    if (t.indexOf(w) >= 0 && !(w === '看護師' && t === '准看護師')) return true;
  }
  return false;
}

/** セグメント分類のサーバー正本 (R4 10-#1)。
 * フロント segmentOfCalc (index.html) と同じ優先順で分類する。定義を変えたら
 * フロント側も合わせること (表示用と送信用の二重実装である点に注意)。
