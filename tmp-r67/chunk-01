          // (applied_at / source_company) とステータス類は守ったまま、応募属性の
          // 差分だけを反映し「更新」に数える (冪等性 = 差分のみ)。
          var attrPatch = diffApplicantAttrs_(existing, attrs);
          if (Object.keys(attrPatch).length) {
            attrPatch.updated_at = now;
            attrPatch.import_batch_id = batchId;
            if (incomingFs || existingFs) attrPatch.has_fs_history = true;
            if (email && optoutSet[email]) attrPatch.mail_optout = true;
            ensurePersisted_(existing);
            queuePatch_(existing, attrPatch);
            queueEvent_(existing.applicant_id,
              '属性のみ更新 (応募日は既存が最新) batch=' + batchId);
            updated++; attrUpdated++;
            return;
          }
          skip_('既存と同じ・古い応募'); return;
        }
        // 会社照合は canonical で行う (原文は attrs.source_company のまま保持する)
        if (attrs.source_company) attrs.source_company = str_(input.source_company);
        ensurePersisted_(existing);
        queuePatch_(existing, attrs);
        queueEvent_(existing.applicant_id,
          '新規応募あり (再応募として最新化) batch=' + batchId +
          (attrs.source_company ? ' / ' + attrs.source_company : ''));
        updated++;
      } else {
        attrs.applicant_id = allocApplicantId_(); // R4 06-07: 連番予約から採番
        attrs.created_at = now;
        // 追補17: 新規行はフラグを明示値で永続化する (FS応募なら true、それ以外は false)
        attrs.has_fs_history = !!incomingFs;
        // R3 (T4): 新規行の csv_status は CSV の値をそのまま保持する
        // (従来は pickApplicantAttrs_ の対象外で常に '未対応' に潰れていた)。
        // 空のときだけ '未対応'。未知の値は未分類として表示側で扱う。
        attrs.csv_status = str_(input.csv_status) || '未対応';
