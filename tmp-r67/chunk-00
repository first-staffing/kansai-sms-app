function ageFromBirth_(v) {
  var ymd = cellDateYmd_(v);
  if (!ymd) return null;
  var b = new Date(ymd + 'T00:00:00+09:00');
  if (isNaN(b.getTime())) return null;
  var now = new Date();
  var age = now.getFullYear() - b.getFullYear();
  var m = now.getMonth() - b.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
  return age;
}

/**
 * ファーストスタッフィング登録歴フラグ (追補7 -> 追補17で永続化)。
 * 正は applicants.has_fs_history (永続フィールド, bool) であり、掘り起こしタブ・
 * 一覧検索・Gmail対象条件・SMSセグメントの絞り込みはすべてこのフィールドを参照する。
 * 定義: 取り込み時に、会社正規化 (normalizeCompany_) 後の応募履歴 (全CSVの応募 +
 * ファースト親データ突合で得た応募歴) の中に canonical=ファーストスタッフィング の
 * 応募が1件でもあれば true。一度 true になったら再取り込み・上書き更新でも
 * false に戻さない (履歴が増えることはあっても登録歴が消えることはないため)。
 * 応募履歴そのものは (a) applicants.source_company (最新の応募元) と
 * (b) hearing_json 内の history (過去の応募履歴。例: {"history":[{company, applied_at}, ...]}
 *     または import 時に hearing_json へマージされる会社名) で保持する。
 * applicant_events の import イベント detail にも会社名が残るが、全件走査は重いため
 * 導出は applicants 行内 (source_company + hearing_json) で完結させる。
 */
var FS_COMPANY = 'ファーストスタッフィング';
/** 会社名 (原文) の canonical がファーストスタッフィングか */
function isFsCompany_(company) {
  return normalizeCompany_(company) === FS_COMPANY;
}
/**
 * history からの導出 (フォールバック専用)。
 * source_company と hearing_json.history の各 company を正規化して canonical 比較する。
 * hearing_json が構造化されていない旧データ向けに、文字列としての含有チェックも残す。
 */
function deriveFsHistory_(r) {
  if (isFsCompany_(r.source_company)) return true;
  var hj = str_(r.hearing_json);
  if (!hj) return false;
  try {
    var parsed = JSON.parse(hj);
    var history = (parsed && parsed.history) || [];
    if (Object.prototype.toString.call(history) === '[object Array]') {
      for (var i = 0; i < history.length; i++) {
        var h = history[i];
        var co = (h && typeof h === 'object') ? (h.company || h.source_company || h.name || '') : h;
        if (isFsCompany_(co)) return true;
      }
    }
  } catch (e) { /* JSONでない旧 hearing_json は下の文字列チェックで拾う */ }
  return hj.indexOf(FS_COMPANY) >= 0;
}
/**
 * 登録歴フラグの正 (追補17)。
 * has_fs_history フィールドが入っている行はフィールドを正とする (明示 false も尊重する)。
 * フィールドが空 (未設定) の旧レコードだけ、history からの導出にフォールバックする。
 */
function hasFsHistory_(r) {
  var v = r ? r.has_fs_history : undefined;
  if (v !== undefined && v !== null && v !== '') return toBool_(v);
  return deriveFsHistory_(r || {});
}
/** 旧名の互換エイリアス (値は has_fs_history フィールド基準) */
function hasPastFs_(r) { return hasFsHistory_(r); }
/**
 * 親データ突合からフラグを立てる入口 (追補17)。
 * ステージング取り込みや将来のファースト親データ照合が、突合で得た
 * applicant_id の配列を渡して呼ぶ想定。true を立てるだけで、false には戻さない。
 * 書き込み系の文脈 (withLock_ 取得中) から呼ぶこと。存在しない ID は落とさず not_found に返す。
 * @param {Array} applicantIds applicant_id の配列
 * @param {string} [actor] applicant_events に残す実行者 (既定 'system')
 * @return {{marked:number, already:number, not_found:Array, total:number}}
 */
function markFsHistoryFromParent_(applicantIds, actor) {
  var ids = toList_(applicantIds);
  var seen = {}, marked = 0, already = 0, notFound = [];
  ids.forEach(function (id) {
    if (seen[id]) return;
    seen[id] = true;
    var row = null;
    try { row = findApplicant_(id); } catch (e) { row = null; }
    if (!row) { notFound.push(id); return; }
    if (toBool_(row.has_fs_history)) { already++; return; }
    updateRowByPk_('applicants', id, { has_fs_history: true, updated_at: nowIso_() });
    appendEvent_(id, 'import', actor || 'system',
      'ファーストスタッフィング登録歴あり (親データ突合でフラグ永続化)', '', '');
    marked++;
  });
  return { marked: marked, already: already, not_found: notFound, total: Object.keys(seen).length };
}

// ===== 会社名の正規化 (DATA_MODEL §11 / LIVE §3) =====
// 短縮名 -> 正式名 (canonical) の対応表。companies マスターの variants が正だが、
// マスター未投入でも効くよう主要な短縮名はコード側にも持つ。
var COMPANY_SHORT_MAP_ = {
  'カナミック': 'カナミックネットワーク',
  'ファーストスタッフィング': 'ファーストスタッフィング',
  'グローバルヒューマンブリッジ': 'グローバルヒューマンブリッジ',
  'ジョブコレ大阪': 'ジョブコレ大阪',
  'FIDIASOLUTIONS': 'FIDIA SOLUTIONS',
  'FIDIA SOLUTIONS': 'FIDIA SOLUTIONS'
};
var companyCanonicalCache_ = null;
function companyVariantMap_() {
  if (companyCanonicalCache_) return companyCanonicalCache_;
  var map = {};
  Object.keys(COMPANY_SHORT_MAP_).forEach(function (k) { map[k] = COMPANY_SHORT_MAP_[k]; });
  try {
    readTable_('companies').rows.forEach(function (r) {
      var canonical = str_(r.canonical).trim();
      if (!canonical) return;
      map[canonical] = canonical;
      toList_(r.variants).forEach(function (v) { map[v] = canonical; });
    });
  } catch (e) { /* companies シート未作成時はコード側マップのみで動く */ }
  companyCanonicalCache_ = map;
  return map;
}
/**
 * 会社名を canonical (正規化名) に寄せる。原文は保持せず変換結果だけを返す純関数寄りヘルパー。
 * ルール: 全角/半角・空白正規化 -> 法人格 (株式会社/有限会社等) 除去 ->
 * (数字)・-コピー等のサフィックス除去 -> 短縮名マッピング (companies マスター + コード側表)。
 */
function normalizeCompany_(name) {
  var s = str_(name).trim();
  if (!s) return '';
  // 全角英数 -> 半角, 空白正規化
  s = s.replace(/[\uFF01-\uFF5E]/g, function (ch) { return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0); });
  s = s.replace(/\s+/g, ' ').trim();
  // サフィックス除去: (数字) / -コピー / コピー (末尾)
  s = s.replace(/\(\d+\)\s*$/, '').replace(/[-\u30FC]?コピー\s*$/, '').trim();
  // 法人格の除去 (接頭辞・接尾辞とも)
  s = s.replace(/^(株式会社|有限会社|合同会社|合資会社|合名会社)\s*/, '');
  s = s.replace(/\s*(株式会社|有限会社|合同会社|合資会社|合名会社)$/, '');
  s = s.replace(/\s+/g, ' ').trim();
  var map = companyVariantMap_();
  if (map[s]) return map[s];
  // 空白ゆれ (FIDIA SOLUTIONS 等) もマップで拾う
  var noSpace = s.replace(/ /g, '');
  if (map[noSpace]) return map[noSpace];
  return s;
}
function sameCompany_(a, b) { return normalizeCompany_(a) !== '' && normalizeCompany_(a) === normalizeCompany_(b); }

