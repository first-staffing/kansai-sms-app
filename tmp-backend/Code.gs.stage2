/**
* 応募者SMS・Gmail配信システム (作り直し) - バックエンド (Google Apps Script) / 叩き台
*
* =====================================================================
* 前提 (どのデプロイで動くか) — DESIGN_V2 §3
* =====================================================================
* このプロジェクトは 2 つの Web App デプロイを使い分ける。
*
* デプロイA (書き込み/送信用):
* 実行ユーザー = 「アクセスしたユーザーとして実行」
* 公開範囲 = ドメイン内 (キカリ) のみ
* 用途: 書き込み系・送信系の全アクション。
* サーバー側で Session.getActiveUser() のメールが @kikari.co.jp で
* 終わることを必須チェックする (requireKikariUser_)。
* Gmail 送信は実行者本人のアカウントから GmailApp で行う
* (施設メーラー方式)。送信キューは sender_email が実行者本人の行だけを
* 処理するため、送信者 = ログイン中の本人に自動で一致する。
*
* デプロイB (回答フォーム/閲覧用):
* 実行ユーザー = 「自分として実行」 (プロジェクトオーナー)
* 公開範囲 = 全員 (ログイン不要)
* 用途: submitResponse (回答フォーム送信) と読み取り専用アクション。
* 回答フォームは求職者がログインなしで開くため、ドメイン認証は掛けない。
* 代わりに delivery_recipients.form_token (推測不能・受信者ごとに一意) で検証する。
* ※ デプロイB から書き込み系アクションを呼ばれても、requireKikariUser_ が
* オーナー実行でも「アクセスユーザー」がドメイン外なら拒否する設計にすること。
* (Session.getActiveUser() はデプロイBでは空/オーナーになり得るため、
* 書き込み系は必ずデプロイA経由で使うこと。README_DEPLOY.md 参照)
*
* =====================================================================
* データ配置 (DESIGN_V2 §2 / DATA_MODEL.md)
* =====================================================================
* ブックは用途別に 4 分割し、ID は Script Properties から取得する。
* APPLICANT_BOOK_ID: 応募者DB (applicants / applicant_events / optouts / import_batches)
* CASE_BOOK_ID: 案件マスター (cases / case_sources / stations)
* DELIVERY_BOOK_ID: 配信DB (deliveries / delivery_recipients / responses / send_queue)
* SETTINGS_BOOK_ID: 設定 (templates / settings / operators / campaigns / qualifications / municipalities)
* ブック/シートの作成は init_sheets.gs の createAllBooks() が行う。
*
* =====================================================================
* 共通ルール
* =====================================================================
* - 書き込みはすべて LockService.getScriptLock() で直列化する (withLock_)。
* - 変更履歴は applicant_events へ append-only で残す。
* - シートの列は「ヘッダー行の名前」で解決する (列順が変わっても壊れない)。
* - 一覧系では電話・メールを返さない (詳細 getApplicant でのみ返す)。DESIGN_V2 §10。
* - 本ファイルは叩き台であり、デプロイも実送信も行っていない。
*/

// ===== セットアップ定数 =====
var DOMAIN_SUFFIX = '@kikari.co.jp';
var GMAIL_DAILY_HARD_CAP = 1500; // Google 仕様の上限 (通/日/人)
// ===== 送信キューの復旧・再試行 (品質監査 F-02, 2026-11-21 堅牢化) =====
// QUEUE_STALE_SENDING_MINUTES: 'sending' のままこの分数を超えた行は、前回実行が
//   送信直後に落ちて残った行とみなし、次回 processSendQueue の開始時に回収する。
//   根拠: トリガー間隔と6分の実行上限より十分長く、正常な送信がこの時間
//   'sending' のままになることはない (1回の実行は最大200件・6分以内に終わる)。
//   判定時刻は send_queue.updated_at (状態遷移のたびに更新)、無い旧行は created_at。
var QUEUE_STALE_SENDING_MINUTES = 30;
// QUEUE_MAX_TRY_COUNT: try_count (送信試行回数) の上限。'failed' 行は try_count が
//   この値未満の間だけ再試行対象に含め、上限到達後は再試行せず gave_up として
//   processSendQueue の戻り値サマリに件数を出す (DATA_MODEL §8 と一致させること)。
var QUEUE_MAX_TRY_COUNT = 3;
var QUEUE_BATCH_LIMIT = 200; // 1回の実行で処理する上限 (F-07: ロック保持時間の上限にもなる)
// ===== 革新 (INNOVATION.md 確定仕様, 2026-11-21) =====
// 横断ブレーキ (革新3): 他者の送信が72時間以内=強 / 4〜7日=弱 / 8〜14日=詳細のみ。
// 新しい記録は作らず、既存の events / deliveries / responses から導出する。
var BRAKE_STRONG_HOURS = 72;
var BRAKE_WEAK_DAYS = 7;
var BRAKE_DETAIL_DAYS = 14;
// 新着案件マッチ提案 (革新5): 1案件あたりの候補上限と、同一案件の再提示を避ける期間。
var PROPOSAL_CANDIDATE_LIMIT = 50;
var PROPOSAL_REPRESENTED_DAYS = 14;
var MATCH_QUEUE_SETTING_KEY = 'pending_match_case_ids'; // 生成待ち案件 (settings のキュー)
// 送信スナップショット: Sheets セル上限に配慮し、表示用フィールドと長さに絞る。
var SNAPSHOT_DESC_CHARS = 200;
var SNAPSHOT_BODY_CHARS = 10000;
var SNAPSHOT_TOTAL_CHARS = 30000;
var PAGE_SIZE = 50; // 一覧ページング (現行踏襲)
var MAX_RECOMMEND_APPLICANT_IDS = 50; // recommendForApplicants の対象ID上限 (全件総当たり防止)
var MAX_TOP_N = 2000; // mailPreviewTargets / mailCreateDelivery の上限Nの最大値
var MAX_RECOMMEND_COUNT = 5; // 1人あたりおすすめ件数の最大
// SMS側おすすめの既定件数 (LIVE §6): 上位5件。これがサーバー側 recommendForApplicants /
// getFormContext の既定。Gmail の recommend_count (初期3・最大5・1〜5可変, settings の
// default_recommend_count) とは別パラメータなので混同しないこと。
var SMS_RECOMMEND_DEFAULT = 5;
// ===== 対外表示ルール (ユーザー確定 2026-11-21) =====
// 求職者向け表示 (Gmail本文・SMS・フォーム提示・スナップショット) では:
//  (1) 勤務時間を断定しない: 案件固有の時間は出さず職種別の例 + 相談可能文にする。
//  (2) 時給は標準帯 + 注記にする (案件固有の salary_text / 請求単価は出さない)。
// 内部向け (運営者画面 actionSearchCases_ / mailPreviewTargets の preview、案件マスター原文、
// 順位付けの salaryNum_) は対象外で従来どおり原文を使う。
var PUBLIC_SALARY_BAND_KAIGO_ = '1,450\u301c1,800\u5186';
var PUBLIC_SALARY_BAND_KANGO_ = '2,100\u301c2,500\u5186';
var PUBLIC_SALARY_NOTE_ = '\u203b\u6642\u7d66\u306f\u8cc7\u683c\u30fb\u7d4c\u9a13\u30fb\u52e4\u52d9\u65e5\u6570\u306a\u3069\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059';
var PUBLIC_HOURS_EXAMPLE_KANGO_ = '08:30\u301c17:30\uff0f09:00\u301c18:00';
var PUBLIC_HOURS_EXAMPLE_KAIGO_ = '07:00\u301c16:00\u300108:30\u301c17:30\u300109:00\u301c17:00\u300110:00\u301c19:00\u300117:00\u301c09:00\uff08\u591c\u52e4\uff09';
var PUBLIC_HOURS_CONSULT_ = '\u3054\u672c\u4eba\u306e\u5e0c\u671b\u306b\u6cbf\u3063\u3066\u76f8\u8ac7\u53ef\u80fd\u3067\u3059\uff08\u66dc\u65e5\u56fa\u5b9a\u30fb\u6642\u9593\u56fa\u5b9a\u30fb\u591c\u52e4\u5c02\u5f93\u306a\u3069\u3082\u53ef\u80fd\u3067\u3059\uff09';
var PUBLIC_HOURS_SHORT_ = '\u52e4\u52d9\u6642\u9593\u306f\u3054\u5e0c\u671b\u306b\u5408\u308f\u305b\u3066\u76f8\u8ac7\u53ef\u80fd';
// フォーム側に集約する項目 (メール本文には項目説明を混ぜ込まない。SPEC_REFERENCE 対外表示ルール節)
var FORM_ONLY_FIELDS_ = ['selected_case_ids','experience_years','qualifications','desired_start_date','desired_tour_date','phone_consult_datetime','contact_time_slots','free_text','optout'];

// ===== プレースホルダ正規セット (R4 レーンD §0.1: タグレジストリの単一定義) =====
// フロント index.html の KNOWN_TAGS と内容を同一に保つこと (backend テストで一致を固定)。
// 経路別許可リスト: mail 系テンプレ (mail_subject / mail_body) で使えるタグと、
// SMS 系テンプレで使えるタグ (SMS 専用タグ {最寄り} {希望条件} {新着案件} を含む)。
// {不足ヒアリング} は誤字の別名であり正規タグではない (保存時に付け替えを促して拒否する)。
var KNOWN_TAGS_ = {
  mail: ['{宛名}','{不足ヒヤリング}','{不足項目名}','{おすすめ案件}','{回答フォームURL}','{配信停止URL}','{フォームURL}','{担当者}'],
  sms: ['{宛名}','{不足ヒヤリング}','{不足項目名}','{おすすめ案件}','{回答フォームURL}','{配信停止URL}','{フォームURL}','{担当者}','{最寄り}','{希望条件}','{新着案件}']
};
// テンプレート kind の正規名 (フロント体系に統一。R4 レーンD 13-#1)。
// sms_mode はカスタム案件文面 (複数行)、sms_first_compact は初回SMS圧縮版 (レーンJ 項目3)。
var TEMPLATE_KINDS_ = ['sms_first','sms_follow','reply_detail','reply_tour','reply_other','mail_subject','mail_body','sms_mode','sms_first_compact'];
// 読み取り時の別名フォールバック (旧シード kind -> 正規 kind)。保存は正規名のみ。
var TEMPLATE_KIND_ALIASES_ = { reply_detail: 'sms_reply_detail', reply_tour: 'sms_reply_tour', reply_other: 'sms_reply_other', sms_follow: 'special_sms' };

/** 文面中の {…} プレースホルダ候補をすべて返す (残存検査・許可リスト検査の共通抽出) */
function extractTags_(text) {
  var m = String(text == null ? '' : text).match(/\{[^}\n]{1,40}\}/g);
  return m || [];
}

/**
 * 残存プレースホルダ検査 (R4 レーンD 13-#5 の最終防衛線)。
 * 展開後に {…} が残っていれば、タグ名を列挙して throw する。
 */
function assertNoLeftoverTags_(text, label) {
  var left = extractTags_(text);
  if (left.length) {
    throw new Error((label || '文面') + ' に未展開のプレースホルダが残っています: ' + left.join(' '));
  }
}

/** 経路 (mail / sms) の許可リスト外タグを返す。空配列 = 問題なし */
function disallowedTags_(text, route) {
  var allowed = KNOWN_TAGS_[route] || KNOWN_TAGS_.sms;
  return extractTags_(text).filter(function (t) { return allowed.indexOf(t) < 0; });
}

/** テンプレ kind から検査経路を決める (mail_subject / mail_body は mail、それ以外は sms) */
function templateRouteForKind_(kind) {
  return String(kind || '').indexOf('mail_') === 0 ? 'mail' : 'sms';
}

/**
 * 保存時タグ検証 (R4 レーンD 13-#1 修正4 / 13-#5 修正2)。
 * 経路別許可リスト外のタグ・誤字別名 {不足ヒアリング} があればタグ名を明示して throw。
 */
function assertTemplateTagsAllowed_(body, kind, label) {
  if (String(body).indexOf('{不足ヒアリング}') >= 0) {
    throw new Error((label || 'テンプレート') + ' に {不足ヒアリング} が含まれています。正しくは {不足ヒヤリング} です。直してから保存してください');
  }
  var bad = disallowedTags_(body, templateRouteForKind_(kind));
  if (bad.length) {
    throw new Error((label || 'テンプレート') + ' にこの種別では使えないプレースホルダが含まれています: ' + bad.join(' '));
  }
}

