  '092', '093', '094', '095', '096', '097', '098', '099', '03', '06'];

/**
 * 属性差分 (R3 / I8)。最新応募の同一性 (applied_at / source_company)・
 * 履歴 (hearing_json)・運用フラグ類を除いた「応募属性」だけを比較し、
 * 既存行と異なるキーだけを返す。対象は「既存に値があり、それが変わった」
 * キーに限る: 空欄の補完は最新化 (応募日が新しい行) のときだけ行い、
 * 古い応募で既存の属性を書き換えない (従来仕様との両立)。空の入力値も
 * 既存を消さない。
 */
function diffApplicantAttrs_(existing, attrs) {
  var skipKeys = { applied_at: 1, source_company: 1, hearing_json: 1,
    import_batch_id: 1, updated_at: 1, has_fs_history: 1, mail_optout: 1,
    name_raw: 1 }; // name_raw は name の派生コピー (name 自体の差分で検出する)
  var patch = {};
  Object.keys(attrs || {}).forEach(function (k) {
    if (skipKeys[k]) return;
    var nv = attrs[k];
    if (nv === '' || nv == null) return;
    var ov = existing ? existing[k] : '';
    if (ov === '' || ov == null) return; // 補完は属性のみ更新の対象外
    if (String(ov) !== String(nv)) patch[k] = nv;
  });
  return patch;
}

// updateWorkflow で受け付ける対応ステータス (詳細画面のボタンに対応)
var WORKFLOW_STATUSES = ['アテンド', 'FIX', '内定', '稼働開始', '譲渡', 'NG'];
// applicant_events.event_type には上記のほか response_profile_fill (追補9: フォーム回答による
// プロフィール補完) も使う。event_type はシート側では自由文字列として保持する。

// {不足ヒヤリング} の展開対象 (DATA_MODEL §1。希望時給は聞かない)
var HEARING_FIELDS = [
{ key: 'desired_start_date', label: '勤務開始希望日'},
{ key: 'qualifications', label: 'お持ちの資格'},
{ key: 'experience_years', label: 'ご経験年数'},
{ key: 'nearest_station', label: '最寄り駅'},
{ key: 'desired_days_per_week', label: '週の希望勤務日数'},
{ key: 'desired_time_slots', label: '希望の時間帯'}
];

// ===== テーブル定義 (DATA_MODEL.md の列が正。ヘッダー行にそのまま書かれる) =====
var TABLE_DEFS_ = {
