/**
 * R6.6 P1: 取り込みプレビューのサーバー側ドライラン。
 * 背景 (POOL_DIAGNOSIS §2): フロントのプレビューは端末プール (サーバーモードでは
 * シード25行) で照合するため、新規/変化なしが原理的に出ない。判定そのものを
 * サーバー側で行い、フロントはこの結果を表示するだけにする。
 * 判定は importCommitCore_ と同一ロジック (索引: 電話/メール/氏名+生年月日、
 * 除外順序: 曖昧 → 必須情報不備 → 年齢不明 → 63歳以上 → 対象職種以外 →
 * 対象エリア以外、attr-only 更新は diffApplicantAttrs_) を、書き込みなしで流す。
 * 同期維持の要所: (a) 新規と判定した行は同一ファイル内の後続行の照合のため
 * メモリ上の索引へ入れる (commit の indexAdd_ と同一)。(b) 既存行への更新は
 * メモリ上の行オブジェクトへ patch を当ててから次行を判定する (commit の
 * queuePatch_ が in-memory の既存行を書き換えるのと同一。ただし _row がある
 * シート行だけ。チャンク内新規行は索引側が変わらないため当てない)。
 * (c) 座標降格・FSフラグ永続化・optout は件数に影響しないためプレビューでは行わない。
 * 読み取りは applicants テーブルのみ。applicants / applicant_events /
 * import_batches / import_queue への書き込みは一切しない (冪等リプレイの参照も
 * しない。プレビューは「今のシートに対する判定」を返す)。ロックも取らない。
 * req: { file_name, kind:'applicants', rows:[importRow...], client_op_id, chunk_seq }
 * (importCommitCore_ と同じ行形式。1回の呼び出しは1ファイル分 = 上限 5000 行)。
 * 戻り値は importCommitCore_ と同じキー体系 (added/updated/skipped/attr_updated/
 * skipped_reasons) に、フロント表示語彙の別名 (latest_application / excluded /
 * unclassified / counts / preview_counts_by_chunk) を加えたもの。
 * 注意: フロント判定は姓のみ+生年月日、サーバーは氏名全体+生年月日 (POOL_DIAGNOSIS
 * §2.5)。数行の差は想定内。サーバー実績 (import_batches) を正とする。
 */
function actionImportPreview_(req) {
  // 読み取り専用: searchApplicants / getApplicantSummary と同じ扱い
  // (requireKikariUser_ は不要)。
  return importPreviewCore_(req);
}

function importPreviewCore_(req) {
  var rows = req.rows || [];
  if (!rows.length) throw new Error('rows が空です');
  if (rows.length > 5000) throw new Error('1回のプレビューは 5000 行までです (分割してください)');
  var clientOpId = str_(req.client_op_id || '');
  var chunkSeq = (req.chunk_seq === undefined || req.chunk_seq === null || req.chunk_seq === '') ? '' : req.chunk_seq;
  // 索引構築は importCommitCore_ と同一 (電話/メール/氏名+生年月日)。
  var t = readTable_('applicants');
  var byPhone = {}, byEmail = {}, byNameBirth = {};
  function indexAdd_(map, key, row) {
    if (!key) return;
    (map[key] = map[key] || []).push(row);
  }
  t.rows.forEach(function (r) {
    var ph = normalizePhoneDigits_(r.phone);
    indexAdd_(byPhone, ph, r);
    var em = normalizeEmail_(r.email);
    indexAdd_(byEmail, em, r);
    var nb = str_(r.name) + '|' + cellDateYmd_(r.birth_date);
    if (str_(r.name)) indexAdd_(byNameBirth, nb, r);
  });
  var added = 0, updated = 0, skipped = 0, attrUpdated = 0;
  var skippedReasons = {
    'ファイル内の重複': 0, '対応履歴があり保護': 0, '既存と同じ・古い応募': 0,
    '年齢条件の対象外': 0, '対象エリア以外': 0, '対象職種以外': 0,
    '年齢不明': 0, '必須情報不備': 0, '重複の確認が必要': 0
  };
  function skip_(reason) { skipped++; if (skippedReasons[reason] != null) skippedReasons[reason]++; }
  var seenInFile = {};
  // 未分類ステータス (csv_status が CSV_STATUSES_ 18区分に無い行)。判定とは独立に
  // 全行を数える (除外行も含む。フロント renderImportPreview と同一ルール)。
  var unclassified = 0;
  rows.forEach(function (input) {
    if (str_(input.csv_status) && CSV_STATUSES_.indexOf(str_(input.csv_status)) < 0) unclassified++;
  });
  rows.forEach(function (input) {
    var fileKey = normalizePhoneDigits_(input.phone) + '|' + normalizeEmail_(input.email) + '|' + str_(input.name);
    if ((str_(input.phone) || str_(input.email)) && seenInFile[fileKey]) { skip_('ファイル内の重複'); return; }
    seenInFile[fileKey] = true;
    var phone = normalizePhoneDigits_(input.phone);
    var email = normalizeEmail_(input.email);
    var nbKey = str_(input.name) + '|' + cellDateYmd_(input.birth_date);
    var candById = {};
    function collectCands_(arr) {
      (arr || []).forEach(function (r) { candById[r.applicant_id] = r; });
    }
    if (phone) collectCands_(byPhone[phone]);
    if (email) collectCands_(byEmail[email]);
    if (str_(input.name)) collectCands_(byNameBirth[nbKey]);
    var candIds = Object.keys(candById);
    var existing = candIds.length === 1 ? candById[candIds[0]] : null;
    var attrs = pickApplicantAttrs_(input);
    var ageVal = null;
    if (input.birth_date) ageVal = ageFromBirth_(input.birth_date);
    else if (input.age !== undefined && input.age !== null && input.age !== '') ageVal = toNum_(input.age);
    // 除外順序は importCommitCore_ と同一。
    var exclusion = '';
    if (candIds.length > 1) exclusion = '重複の確認が必要';
    else if (!attrs.name || (!phone && !email)) exclusion = '必須情報不備';
    else if (ageVal == null) exclusion = '年齢不明';
    else if (ageVal >= 63) exclusion = '年齢条件の対象外';
    else if (['kaigo', 'kango'].indexOf(str_(input.job_type)) < 0) exclusion = '対象職種以外';
    else if (str_(input.prefecture) &&
             KANSAI_PREFECTURES_.indexOf(str_(input.prefecture)) < 0 &&
             KANTO_PREFECTURES_.indexOf(str_(input.prefecture)) < 0) exclusion = '対象エリア以外';
    if (exclusion) { skip_(exclusion); return; }
    if (existing) {
      var exApplied = cellDateIso_(existing.applied_at), inApplied = cellDateIso_(input.applied_at);
      if (inApplied && exApplied && inApplied <= exApplied) {
        var attrPatch = diffApplicantAttrs_(existing, attrs);
        if (Object.keys(attrPatch).length) {
          // メモリ上のみ patch を当てる (commit の queuePatch_ と同一。
          // _row があるシート行だけが in-memory で書き換わる。チャンク内新規行
          // (_row なし) は updateRowByPk_ でシートだけ書かれ、索引側は変わらない)。
          if (existing._row) Object.keys(attrPatch).forEach(function (k) { existing[k] = attrPatch[k]; });
          updated++; attrUpdated++;
          return;
        }
        skip_('既存と同じ・古い応募'); return;
      }
      // 新しい応募として最新化。メモリ上のみ attrs を当てる (commit と同一。_row がある行だけ)。
      if (existing._row) Object.keys(attrs).forEach(function (k) { existing[k] = attrs[k]; });
      updated++;
    } else {
      // 新規と判定した行は、同一ファイル内の後続行の照合のため索引へ入れる
      // (commit の新規行 indexAdd_ と同一。applicant_id は照合キーに使わない
      // ため、候補の一意化だけに使う仮IDでよい)。
      var newRow = {};
      Object.keys(attrs).forEach(function (k) { newRow[k] = attrs[k]; });
      newRow.applicant_id = 'PREVIEW_NEW_' + added;
      indexAdd_(byPhone, phone, newRow);
      indexAdd_(byEmail, email, newRow);
      if (str_(newRow.name)) indexAdd_(byNameBirth, nbKey, newRow);
      added++;
    }
  });
  var latest = updated - attrUpdated; // 「最新応募として登録」= 更新のうち属性のみ以外
  return {
    preview: true, dry_run: true, status: 'preview',
    file_name: String(req.file_name || ''), kind: String(req.kind || 'applicants'),
    row_count: rows.length, added: added, updated: updated, skipped: skipped,
    attr_updated: attrUpdated, latest_application: latest,
    failed: 0, row_errors: [],
    skipped_reasons: skippedReasons, excluded: skippedReasons,
    unclassified: unclassified,
    client_op_id: clientOpId, chunk_seq: chunkSeq,
    // importCommitCore_ へ渡す preview_counts と同じ三つ組 (確定時の突合せ用)。
    preview_counts: { added: added, updated: updated, skipped: skipped },
    // フロント表示語彙 (renderImportPreview の counts と同名)。
    counts: { new: added, latest: latest, updated: attrUpdated, skip: skipped,
      excluded: skipped, unclassified: unclassified },
    // 1回の呼び出しは1ファイル分。複数ファイルの合算はフロント側で行う。
    preview_counts_by_chunk: [{ chunk_seq: chunkSeq, file_name: String(req.file_name || ''),
      added: added, updated: updated, skipped: skipped }]
  };
}

/**
 * R6.5: 取り込み確定の本体。Web 経由は actionImportCommit_ から、
 * サーバー側継続処理 (processImportQueue) からは登録時の actor で呼ぶ。
 * 照合はチャンクごとに applicants を1回だけ読み、メモリ上の索引
 * (電話/メール/氏名+生年月日) で行う (行ごとの読み直しはしない)。
 */
function importCommitCore_(req, me) {
  var rows = req.rows || [];
  if (!rows.length) throw new Error('rows が空です');
  if (rows.length > 5000) throw new Error('1回の取り込みは 5000 行までです (分割してください)');
  // R4 06-06: 冪等キー。フロントの二重送信・outbox 再送で同一の
  // (client_op_id, chunk_seq) が再投入されても二重登録しない。
  // キーが無い旧経路は従来動作 (チェック自体をスキップする)。
  var clientOpId = str_(req.client_op_id || '');
  var chunkSeq = (req.chunk_seq === undefined || req.chunk_seq === null || req.chunk_seq === '') ? '' : req.chunk_seq;
  // R6.5: フロントのプレビュー件数 (任意)。確定後にサーバー実績と突合し、
  // 差異があればその内容をバッチの note に残す (プレビューと確定の一致保証)。
  var previewCounts = (req.preview_counts && typeof req.preview_counts === 'object') ? req.preview_counts : null;
  // R6.5: 処理開始後に致命的エラーで中断した場合に、そのバッチを failed として
  // 残すための受け渡し。ロック未取得など開始前の失敗では何も記録しない。
  var r65Batch = { id: null };
  try {
  return withLock_(function () {
    if (clientOpId) {
      var prevBatches = readTable_('import_batches').rows;
      for (var bi = 0; bi < prevBatches.length; bi++) {
        var pb = prevBatches[bi];
        if (str_(pb.client_op_id) === clientOpId &&
            String(pb.chunk_seq == null ? '' : pb.chunk_seq) === String(chunkSeq) &&
            str_(pb.status) === 'complete') {
          // committed 済みの再送: 書き込みを再実行せず、前回のサーバー実績を返す。
          // partial / running のバッチはここでは返さず再処理を続行する (適用済みの
          // 行は既存照合で skip / 属性更新に倒れるため、二重登録にはならない)。
          return { batch_id: pb.batch_id, row_count: toNum_(pb.row_count) || rows.length,
            added: toNum_(pb.added_count) || 0, updated: toNum_(pb.updated_count) || 0,
            skipped: toNum_(pb.skipped_count) || 0, attr_updated: 0,
            failed: toNum_(pb.failed_count) || 0, status: str_(pb.status),
            row_errors: [], skipped_reasons: {},
            note: str_(pb.note),
            idempotent_replay: true, client_op_id: clientOpId, chunk_seq: chunkSeq };
        }
      }
    }
    var batchId = nextId_('import_batches');
    var now = nowIso_();
    // R4 06-07 段階1: バッチレコードを status=running で先行作成し、完了時に
    // 結果で更新する。途中失敗や強制終了でもバッチの存在と進捗が残る。
    // バッチ記録自体の失敗で取り込み本体は止めない (記録は best-effort)。
    var batchRecorded = false;
    try {
      appendRow_('import_batches', {
        batch_id: batchId, kind: String(req.kind || 'applicants'), file_name: String(req.file_name || ''),
        row_count: rows.length, added_count: 0, updated_count: 0, skipped_count: 0,
        actor: me, created_at: now, status: 'running', failed_count: 0,
        client_op_id: clientOpId, chunk_seq: chunkSeq
      });
      batchRecorded = true;
      r65Batch.id = batchId;
    } catch (batchErr) {
      try { Logger.log('importCommit batch pre-create failed batch=' + batchId + ': ' + errMsg_(batchErr)); } catch (e) {}
    }
    var t = readTable_('applicants');
    // R4 06-13: 索引は「キー -> 既存応募者の配列」。同一キーに複数名いる場合も
    // 潰さず全員を候補に残し、候補が2名以上なら曖昧として自動統合しない
    // (フロントの配列索引 + ambiguous 除外と対称にする)。
    var byPhone = {}, byEmail = {}, byNameBirth = {};
    function indexAdd_(map, key, row) {
      if (!key) return;
      (map[key] = map[key] || []).push(row);
    }
    function indexRemove_(map, key, row) {
      var arr = key ? map[key] : null;
      if (!arr) return;
      var i = arr.indexOf(row);
      if (i >= 0) arr.splice(i, 1);
      if (!arr.length) delete map[key];
    }
    t.rows.forEach(function (r) {
      var ph = normalizePhoneDigits_(r.phone); // R3: 全角数字も照合可能にする
      indexAdd_(byPhone, ph, r);
      var em = normalizeEmail_(r.email);
      indexAdd_(byEmail, em, r);
      var nb = str_(r.name) + '|' + cellDateYmd_(r.birth_date);
      if (str_(r.name)) indexAdd_(byNameBirth, nb, r);
    });
    // R4 06-07: 新規応募者の採番は、開始時点に読み済みの既存最大番号からの
    // 連番予約に変える (行ごとの nextId_ 全表走査をやめる)。書き込みは
    // withLock_ 内に直列化されているため、メモリ上の連番で衝突しない。
    var appPrefix = ID_PREFIX_['applicants'] || 'A';
    var appSeq = 0;
    t.rows.forEach(function (r) {
      var m = String(r.applicant_id || '').match(new RegExp('^' + appPrefix + '(\\d+)$'));
      if (m) appSeq = Math.max(appSeq, parseInt(m[1], 10));
    });
    function allocApplicantId_() {
      appSeq++;
      var n = String(appSeq);
      while (n.length < 6) n = '0' + n;
